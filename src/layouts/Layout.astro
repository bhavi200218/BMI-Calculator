		<!-- Background Slideshow Script (Desktop Only) -->
		<script is:inline>
			(function() {
				let slideshowTimer = null;
				let currentSlide = 0;

				function startSlideshow() {
					if (window.innerWidth < 768) return;
					if (slideshowTimer) clearInterval(slideshowTimer);
					const slides = document.querySelectorAll('#bg-slideshow .bg-slide');
					if (!slides || slides.length <= 1) return;

					slides.forEach((s) => {
						if (s.dataset.bg && !s.style.backgroundImage) {
							s.style.backgroundImage = 'url(' + s.dataset.bg + ')';
						}
					});

					currentSlide = 0;
					slides.forEach((s, idx) => {
						if (idx === 0) s.classList.add('active');
						else s.classList.remove('active');
					});

					slideshowTimer = setInterval(() => {
						slides[currentSlide].classList.remove('active');
						currentSlide = (currentSlide + 1) % slides.length;
						slides[currentSlide].classList.add('active');
					}, 5500);
				}

				if (document.readyState === 'complete') {
					setTimeout(startSlideshow, 1500);
				} else {
					window.addEventListener('load', function() {
						setTimeout(startSlideshow, 1500);
					});
				}
				document.addEventListener('astro:after-swap', startSlideshow);
				document.addEventListener('astro:page-load', startSlideshow);
			})();
		</script>

