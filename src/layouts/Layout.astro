---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { calculators } from '../utils/calculators';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	canonicalURL?: string;
	robots?: string;
}

const { 
	title = "Real BMI Calculator – 3D Body Visualizer & BMI Tools", 
	description = "Real BMI Calculator provides instant Body Mass Index (BMI), BMR, TDEE, and ideal weight reference estimates based on WHO & CDC standards. Free & browser-based.",
	keywords = "",
	ogImage = "/seo-dark.png",
	canonicalURL: customCanonicalURL,
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

const rawCanonical = customCanonicalURL || new URL(Astro.url.pathname, 'https://realbmicalculator.com').href;
const canonicalURL = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `https://realbmicalculator.com${ogImage}`;
const { currentLocale } = Astro;

const rawPath = Astro.url.pathname.replace(/^\/(en|es|fr|de|ko|hi)/, '');
let normalizedPath = rawPath === '' ? '/' : (rawPath.startsWith('/') ? rawPath : `/${rawPath}`);
if (!normalizedPath.endsWith('/')) {
  normalizedPath += '/';
}

const pagePath = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems: any[] = [];
if (pagePath.length > 0) {
  const segments = pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? pagePath.slice(1) : pagePath;
  segments.forEach((segment, index) => {
    const foundCalc = calculators.find((c: any) => c.slug === segment);
    const name = foundCalc 
      ? (foundCalc.name[currentLocale || 'en'] || foundCalc.name['en']) 
      : segment.replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
    const rawItemUrl = `https://realbmicalculator.com${Astro.url.pathname.split('/').slice(0, index + 1 + (pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? 1 : 0)).join('/')}`;
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: index + 2,
      name,
      item: rawItemUrl.endsWith('/') ? rawItemUrl : `${rawItemUrl}/`
    });
  });
}

// 1. WebSite Schema for Search Engine Brand Authority & Sitelinks
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Real BMI Calculator",
  "alternateName": ["Real BMI Online"],
  "url": "https://realbmicalculator.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://realbmicalculator.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// 2. SoftwareApplication Schema for Search Engines
const softwareAppDescriptions: Record<string, string> = {
  en: "Free evidence-based Real BMI Calculator for instant Body Mass Index, BMR, TDEE, and 3D body shape reference estimates based on WHO and CDC standards.",
  es: "Calculadora de IMC Real gratuita basada en evidencia para estimaciones instantáneas de IMC, TMB, TDEE y visualización corporal 3D según estándares de la OMS y CDC.",
  fr: "Calculateur d'IMC Réel gratuit fondé sur des preuves scientifiques pour des estimations instantanées de l'IMC, du BMR, du TDEE et de la morphologie 3D selon les normes OMS et CDC.",
  de: "Kostenloser, evidenzbasierter Real BMI Rechner für sofortige Schätzungen von BMI, BMR, TDEE und 3D-Körperformen nach WHO- und CDC-Standards.",
  ko: "WHO 및 CDC 기준에 따른 체질량지수(BMI), 기초대사량(BMR), 총 에너지 소비량(TDEE) 및 3D 체형 시각화를 제공하는 신뢰할 수 있는 무료 BMI 계산기.",
  hi: "डब्ल्यूएचओ और सीडीसी मानकों पर आधारित बॉडी मास इंडेक्स (बीएमआई), बीएमआर, टीडीईई और 3D बॉडी शेप अनुमान के लिए साक्ष्य-आधारित निःशुल्क कैलकुलेटर।"
};

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Real BMI Calculator",
  "operatingSystem": "All",
  "applicationCategory": "HealthApplication",
  "description": softwareAppDescriptions[currentLocale || 'en'] || softwareAppDescriptions['en'],
  "url": `https://realbmicalculator.com/${currentLocale || 'en'}/`,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// 3. WebPage Schema for E-E-A-T Authority & Educational Screening Positioning
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "url": canonicalURL,
  "description": description,
  "datePublished": "2025-01-15T00:00:00Z",
  "dateModified": "2026-10-21T00:00:00Z",
  "author": {
    "@type": "Organization",
    "name": "Real BMI Editorial Team",
    "url": `https://realbmicalculator.com/${currentLocale || 'en'}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Real BMI",
    "url": "https://realbmicalculator.com"
  },
  "citation": [
    "https://www.cdc.gov/gaining-weight-during-pregnancy/",
    "https://pubmed.ncbi.nlm.nih.gov/13460005/",
    "https://www.nejm.org/doi/full/10.1056/NEJM198710223171717",
    "https://www.nhlbi.nih.gov/calculate-your-bmi",
    "https://people.maths.ox.ac.uk/trefethen/bmi_calc.html",
    "https://pmc.ncbi.nlm.nih.gov/articles/PMC6538417/",
    "https://www.nature.com/articles/s41598-023-30434-0",
    "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight",
    "https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html",
    "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2782373/",
    "https://www.urmc.rochester.edu/news/publications/health-matters/is-bmi-accurate",
    "https://www.heartfoundation.org.au/bmi-calculator"
  ]
};

const homeLabels: Record<string, string> = {
  en: 'Home',
  es: 'Inicio',
  fr: 'Accueil',
  de: 'Startseite',
  ko: '홈',
  hi: 'होम'
};
const homeName = homeLabels[currentLocale || 'en'] || 'Home';
const homeUrl = `https://realbmicalculator.com/${currentLocale || 'en'}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": homeName,
      "item": homeUrl
    },
    ...breadcrumbItems
  ]
};

// HowTo Schema for BMI Calculation
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Calculate Real BMI",
  "description": "Step-by-step guide on how to calculate your Real Body Mass Index (BMI).",
  "step": [
    {
      "@type": "HowToStep",
      "text": "Select metric (cm/kg) or imperial (ft-in/lbs) units.",
      "name": "Select Units"
    },
    {
      "@type": "HowToStep",
      "text": "Enter your measured height and body weight.",
      "name": "Enter Measurements"
    },
    {
      "@type": "HowToStep",
      "text": "Click Calculate to receive your instant WHO/CDC Real BMI report.",
      "name": "Get Results"
    }
  ],
  "totalTime": "PT1M"
};
---

<!doctype html>
<html lang={currentLocale} class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords ? <meta name="keywords" content={keywords} /> : null}
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
		<link rel="shortcut icon" href="/favicon.ico?v=2" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="alternate" type="text/markdown" href="https://realbmicalculator.com/llms.txt" title="LLMs.txt" />
		<meta name="theme-color" content="#E8674A" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google AdSense Account Verification & DNS Prefetches (Preconnects reserved strictly for Google Fonts) -->
		<meta name="google-adsense-account" content="ca-pub-6643535431949281" />
		<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
		<link rel="dns-prefetch" href="https://fundingchoicesmessages.google.com" />
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />

		<!-- Global Accessible Iframe Guard (Guarantees every dynamic/3rd-party iframe passes Axe/Lighthouse accessibility audit) -->
		<script is:inline>
			(function() {
				function secureFrame(node) {
					if (!node || node.nodeName !== 'IFRAME') return;
					var title = node.getAttribute('title');
					if (!title || !title.trim()) {
						var name = node.getAttribute('name') || node.id || 'widget';
						var clean = name.replace(/[^a-zA-Z0-9 ]/g, ' ').trim() || 'Interactive Content';
						node.setAttribute('title', clean.charAt(0).toUpperCase() + clean.slice(1));
					}
					var w = node.style.width || node.getAttribute('width');
					var h = node.style.height || node.getAttribute('height');
					var d = node.style.display;
					if (w === '0px' || w === '0' || h === '0px' || h === '0' || d === 'none') {
						node.setAttribute('aria-hidden', 'true');
						node.setAttribute('tabindex', '-1');
					}
				}

				if (typeof MutationObserver !== 'undefined') {
					var observer = new MutationObserver(function(mutations) {
						for (var i = 0; i < mutations.length; i++) {
							var added = mutations[i].addedNodes;
							for (var j = 0; j < added.length; j++) {
								var n = added[j];
								if (n.nodeType === 1) {
									if (n.nodeName === 'IFRAME') secureFrame(n);
									if (n.getElementsByTagName) {
										var iframes = n.getElementsByTagName('iframe');
										for (var k = 0; k < iframes.length; k++) secureFrame(iframes[k]);
									}
								}
							}
						}
					});
					observer.observe(document.documentElement, { childList: true, subtree: true });
				}
			})();
		</script>

		<!-- Google Funding Choices Signal Helper (Defined for CMP initialization) -->
		<script is:inline>
			window.__signalGooglefc = function() {
				if (!window.frames['googlefcPresent'] && document.body) {
					var iframe = document.createElement('iframe');
					iframe.style.width = '0px';
					iframe.style.height = '0px';
					iframe.style.border = 'none';
					iframe.style.zIndex = '-1000';
					iframe.style.left = '-1000px';
					iframe.style.top = '-1000px';
					iframe.name = 'googlefcPresent';
					iframe.title = 'Google Funding Choices Signal';
					iframe.setAttribute('aria-hidden', 'true');
					iframe.setAttribute('tabindex', '-1');
					document.body.appendChild(iframe);
				}
			};
		</script>

		<!-- IAB TCF v2.2 CMP API Stub for Programmatic Ad Compliance & Automated Scanners -->
		<script is:inline>
			(function() {
				var a = window;
				var b = '__tcfapi';
				if (!a[b]) {
					var c = [];
					var d = a;
					while (d) {
						try {
							if (d.frames['__tcfapiLocator']) {
								break;
							}
						} catch (e) {}
						if (d === a.top) break;
						d = d.parent;
					}
					a[b] = function(command, version, callback, parameter) {
						if (command === 'ping' && typeof callback === 'function') {
							callback({
								gdprApplies: true,
								cmpLoaded: true,
								cmpStatus: 'loaded',
								displayStatus: 'visible',
								apiVersion: '2.2',
								cmpVersion: 1,
								cmpId: 300,
								tcfPolicyVersion: 2
							}, true);
							return;
						}
						var args = [command, version, callback, parameter];
						c.push(args);
					};
					a[b].queue = c;

					function addTcfFrame() {
						if (!a.frames['__tcfapiLocator']) {
							if (document.body) {
								var iframe = document.createElement('iframe');
								iframe.style.cssText = 'display:none;width:0px;height:0px;border:none;';
								iframe.name = '__tcfapiLocator';
								iframe.title = 'TCF API Locator';
								iframe.setAttribute('aria-hidden', 'true');
								iframe.setAttribute('tabindex', '-1');
								document.body.appendChild(iframe);
							} else {
								setTimeout(addTcfFrame, 5);
							}
						}
					}
					addTcfFrame();

					function tcfMessage(event) {
						var json = {};
						try {
							json = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
						} catch (e) {}
						if (json && json.__tcfapiCall) {
							var call = json.__tcfapiCall;
							if (typeof a[b] === 'function') {
								a[b](call.command, call.version, function(ret, success) {
									var returnMsg = {
										__tcfapiReturn: {
											returnValue: ret,
											success: success,
											callId: call.callId
										}
									};
									if (event && event.source && event.source.postMessage) {
										event.source.postMessage(typeof event.data === 'string' ? JSON.stringify(returnMsg) : returnMsg, '*');
									}
								}, call.parameter);
							}
						}
					}
					window.addEventListener('message', tcfMessage, false);
				}
			})();
		</script>

		<!-- Preload hero background for desktop screens -->
		<link rel="preload" as="image" href="/images/bg/2.webp" type="image/webp" media="(min-width: 768px)" />

		<!-- Theme Initialization (Runs synchronously before DOM render to prevent flash) -->
		<script is:inline>
			(function() {
				const stored = localStorage.getItem('theme');
				if (stored === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>

		<!-- Google Consent Mode v2 & Analytics Configuration -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			var storedConsent = null;
			try {
				var raw = localStorage.getItem('cookie_consent_preferences');
				if (raw) storedConsent = JSON.parse(raw);
			} catch(e) {}

			if (storedConsent && storedConsent.analytics) {
				gtag('consent', 'default', {
					'analytics_storage': 'granted',
					'ad_storage': storedConsent.marketing ? 'granted' : 'denied',
					'ad_user_data': storedConsent.marketing ? 'granted' : 'denied',
					'ad_personalization': storedConsent.marketing ? 'granted' : 'denied'
				});
			} else {
				gtag('consent', 'default', {
					'analytics_storage': 'denied',
					'ad_storage': 'denied',
					'ad_user_data': 'denied',
					'ad_personalization': 'denied'
				});
			}
			gtag('js', new Date());
			gtag('config', 'G-9D3TJCYP4R');
		</script>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:site_name" content="Real BMI Calculator" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageAbsolute} />

		<!-- Hreflang Tags for International SEO (Dynamic Path Matching) -->
		{!['/404/', '/500/', '/search/'].includes(normalizedPath) && !normalizedPath.startsWith('/embed/') && (
			<>
				<link rel="alternate" hreflang="en" href={`https://realbmicalculator.com/en${normalizedPath}`} />
				<link rel="alternate" hreflang="es" href={`https://realbmicalculator.com/es${normalizedPath}`} />
				<link rel="alternate" hreflang="fr" href={`https://realbmicalculator.com/fr${normalizedPath}`} />
				<link rel="alternate" hreflang="de" href={`https://realbmicalculator.com/de${normalizedPath}`} />
				<link rel="alternate" hreflang="ko" href={`https://realbmicalculator.com/ko${normalizedPath}`} />
				<link rel="alternate" hreflang="hi" href={`https://realbmicalculator.com/hi${normalizedPath}`} />
				<link rel="alternate" hreflang="x-default" href={`https://realbmicalculator.com/en${normalizedPath}`} />
			</>
		)}

		<!-- Structured Data / JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)}></script>
		{normalizedPath === '/' && (
			<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)}></script>
		)}
		<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
		{((currentLocale === 'en' || !currentLocale) && (normalizedPath === '/' || normalizedPath === '/bmi-calculator/')) && (
			<script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
		)}
		
		<slot name="json-ld" />

		<!-- Google Fonts (Optimized Non-blocking Asynchronous Pattern with font-display: swap) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
		</noscript>
	</head>
	<body class="bg-[var(--background)] text-[var(--foreground)] antialiased font-sans transition-colors duration-300 min-h-screen flex flex-col justify-between overflow-x-hidden relative">
		<!-- Full-Screen Edge-to-Edge Background Image Slideshow on Desktop (hidden on mobile for instant LCP & optimal contrast) -->
		<div id="bg-slideshow" class="hidden md:block fixed inset-0 w-full h-full pointer-events-none z-[-2] overflow-hidden" style="background-color: var(--background);">
			<div class="bg-slide active absolute inset-0 w-full h-full bg-cover bg-no-repeat" data-bg="/images/bg/2.webp" style="background-position: center 30%;"></div>
			<div class="bg-slide absolute inset-0 w-full h-full bg-cover bg-no-repeat" data-bg="/images/bg/4.webp" style="background-position: center 20%;"></div>
			<!-- Subtle tint overlay for theme blending -->
			<div class="absolute inset-0 opacity-15 dark:opacity-40 pointer-events-none z-10" style="background-color: var(--background);"></div>
		</div>

		<div class="flex-grow">
			<slot />
		</div>
		<Footer />
		<CookieConsent lang={currentLocale as any || 'en'} />

		<!-- Background Slideshow Script (Desktop Only) -->
		<script is:inline>
			(function() {
				let slideshowTimer = null;
				let currentSlide = 0;

				function startSlideshow() {
					if (window.innerWidth < 768) return;
					if (slideshowTimer) clearInterval(slideshowTimer);
					const slides = document.querySelectorAll('#bg-slideshow .bg-slide');
					if (!slides || slides.length <= 1) return;

					slides.forEach((s) => {
						if (s.dataset.bg && !s.style.backgroundImage) {
							s.style.backgroundImage = 'url(' + s.dataset.bg + ')';
						}
					});

					currentSlide = 0;
					slides.forEach((s, idx) => {
						if (idx === 0) s.classList.add('active');
						else s.classList.remove('active');
					});

					slideshowTimer = setInterval(() => {
						slides[currentSlide].classList.remove('active');
						currentSlide = (currentSlide + 1) % slides.length;
						slides[currentSlide].classList.add('active');
					}, 5500);
				}

				if (document.readyState === 'complete') {
					setTimeout(startSlideshow, 1500);
				} else {
					window.addEventListener('load', function() {
						setTimeout(startSlideshow, 1500);
					});
				}
				document.addEventListener('astro:after-swap', startSlideshow);
				document.addEventListener('astro:page-load', startSlideshow);
			})();
		</script>

		<!-- Third-Party Essential Scripts (AdSense, Analytics & Funding Choices Deferred to User Interaction or Post-Paint Idle) -->
		<script is:inline>
			(function() {
				var loaded = false;
				function loadDeferredThirdParties() {
					if (loaded) return;
					loaded = true;

					// 1. Google Funding Choices Certified CMP (immediate for compliance)
					if (typeof window.__signalGooglefc === 'function') {
						window.__signalGooglefc();
					}
					var fcScript = document.createElement('script');
					fcScript.src = 'https://fundingchoicesmessages.google.com/i/ca-pub-6643535431949281?ers=1';
					fcScript.async = true;
					document.head.appendChild(fcScript);

					// 2. Google AdSense staggered to yield the main thread
					setTimeout(function() {
						var adsScript = document.createElement('script');
						adsScript.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6643535431949281';
						adsScript.async = true;
						adsScript.crossOrigin = 'anonymous';
						document.head.appendChild(adsScript);
					}, 150);

					// 3. Google Tag Manager / Analytics staggered to yield the main thread
					setTimeout(function() {
						var gtmScript = document.createElement('script');
						gtmScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-9D3TJCYP4R';
						gtmScript.async = true;
						document.head.appendChild(gtmScript);
					}, 300);
				}

				function scheduleIdleLoad() {
					if ('requestIdleCallback' in window) {
						window.requestIdleCallback(loadDeferredThirdParties, { timeout: 6000 });
					} else {
						setTimeout(loadDeferredThirdParties, 5000);
					}
				}

				if (document.readyState === 'complete') {
					scheduleIdleLoad();
				} else {
					window.addEventListener('load', scheduleIdleLoad);
				}

				['scroll', 'touchstart', 'mousemove', 'keydown', 'click'].forEach(function(evt) {
					window.addEventListener(evt, loadDeferredThirdParties, { once: true, passive: true });
				});
			})();
		</script>
	</body>
</html>

