---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { calculators } from '../utils/calculators';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	canonicalURL?: string;
	robots?: string;
}

const { 
	title = "Real BMI Calculator – 3D Body Visualizer & BMI Tools", 
	description = "Real BMI Calculator provides instant BMI, BMR, TDEE, and ideal weight estimates based on published WHO & CDC standards. Free, browser-based, and private.",
	keywords = "",
	ogImage = "/seo-dark.png",
	canonicalURL: customCanonicalURL,
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

const { currentLocale } = Astro;

function getHtmlLength(str: string): number {
	return str.replace(/&/g, '&amp;').replace(/'/g, '&#39;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;').length;
}

function sanitizeSeoTitle(rawTitle: string, locale: string = 'en'): string {
	if (!rawTitle) return "Real BMI Calculator — Free Health & Body Tools";
	let clean = rawTitle.replace(/\s+/g, ' ').trim();

	// If already optimal
	if (clean.length >= 40 && clean.length <= 60 && getHtmlLength(clean) <= 60) {
		return clean;
	}

	// If too short (< 40 chars), append informative suffixes
	if (clean.length < 40) {
		const brandSuffixes: Record<string, string[]> = {
			en: [" | Real BMI", " — Real BMI Calculator Tools", " | Real BMI Health Calculator", " – Free Online Health Calculator", " — Real BMI Official Hub"],
			es: [" | Real BMI", " — Calculadora Real BMI Oficial", " | Herramientas de Salud Real BMI", " – Calculadoras de Salud Online"],
			fr: [" | Real BMI", " — Calculateur Real BMI Officiel", " | Outils de Santé et Métabolisme", " – Calculateurs de Santé Gratuits"],
			de: [" | Real BMI", " — Real BMI Gesundheitsrechner", " | Offizieller Real BMI Rechner", " – Kostenloses Rechner Portal"],
			ko: [" | Real BMI", " — Real BMI 공식 건강 계산기", " | Real BMI 무료 헬스 계산기"],
			hi: [" | Real BMI", " — Real BMI आधिकारिक स्वास्थ्य कैलकुलेटर", " | Real BMI मुफ़्त टूल्स"]
		};

		if (/Real BMI/i.test(clean)) {
			const nonBrandSuffixes: Record<string, string[]> = {
				en: [" — Health Tools", " — Clinical Guidelines", " — Free Health Tools", " — Official Guidelines", " — Evidence-Based Guide"],
				es: [" — Herramientas", " — Pautas Clínicas", " — Valores de Referencia", " — Guía Oficial"],
				fr: [" — Outils Santé", " — Repères Cliniques", " — Normes et Outils", " — Guide Gratuit"],
				de: [" — Rechner Tools", " — Klinische Standards", " — Offizielle Werte", " — Leitfaden"],
				ko: [" — 건강 계산기", " — 공식 임상 지침", " — 신뢰할 수 있는 가이드"],
				hi: [" — स्वास्थ्य टूल्स", " — आधिकारिक दिशानिर्देश", " — स्वास्थ्य मानक"]
			};
			const list = nonBrandSuffixes[locale] || nonBrandSuffixes.en;
			for (const s of list) {
				const candidate = clean + s;
				if (candidate.length >= 40 && candidate.length <= 60 && getHtmlLength(candidate) <= 60) {
					clean = candidate;
					break;
				}
			}
		} else {
			const list = brandSuffixes[locale] || brandSuffixes.en;
			for (const s of list) {
				const candidate = clean + s;
				if (candidate.length >= 40 && candidate.length <= 60 && getHtmlLength(candidate) <= 60) {
					clean = candidate;
					break;
				}
			}
		}

		// Secondary fallback padding if still < 40
		if (clean.length < 40) {
			const pads: Record<string, string> = {
				en: " — Official Online Health Calculator",
				es: " — Calculadora Oficial de Salud",
				fr: " — Calculateur de Santé Officiel",
				de: " — Offizieller Gesundheitsrechner",
				ko: " — 신뢰할 수 있는 공식 온라인 헬스 케어 계산기 포털",
				hi: " — प्रामाणिक स्वास्थ्य कैलकुलेटर संदर्भ"
			};
			const p = pads[locale] || pads.en;
			const candidate = clean + p;
			if (candidate.length <= 60 && getHtmlLength(candidate) <= 60) {
				clean = candidate;
			} else {
				clean = candidate.slice(0, 58).replace(/[,;:\-\s|&]+$/, '');
			}
		}
	}

	// If too long (> 60 chars)
	if (clean.length > 60 || getHtmlLength(clean) > 60) {
		const withoutBrand = clean.replace(/\s*([\|\—–\-]\s*Real BMI(\s*Online)?)\s*$/i, '').trim();
		let base = (withoutBrand.length >= 40 && withoutBrand.length <= 60 && getHtmlLength(withoutBrand) <= 60) 
			? withoutBrand 
			: clean;

		while (base.length > 30 && (base.length > 60 || getHtmlLength(base) > 60)) {
			const lastSpace = base.lastIndexOf(' ');
			if (lastSpace > 30) {
				base = base.slice(0, lastSpace).replace(/[,;:\-\—–\s|/&]+$/, '').trim();
			} else {
				base = base.slice(0, 58).replace(/[,;:\-\—–\s|/&]+$/, '').trim();
				break;
			}
		}

		// Clean up trailing prepositions/conjunctions
		base = base.replace(/\s+(and|und|oder|et|ou|y|o|in|im|at|for|für|pour|de|des|der|die|das|den|dem|with|mit|avec|con|vs\.?|&|&amp;)$/i, '').trim();
		clean = base;

		// Post-trim guarantee: if dropping a long word reduced length below 40 chars, snap with compact brand
		if (clean.length < 40) {
			const postPads: Record<string, string> = {
				en: " | Real BMI",
				es: " | Real BMI",
				fr: " | Real BMI",
				de: " | Real BMI",
				ko: " | Real BMI",
				hi: " | Real BMI"
			};
			const candidate = clean + (postPads[locale] || " | Real BMI");
			if (candidate.length <= 60 && getHtmlLength(candidate) <= 60) {
				clean = candidate;
			}
		}
	}

	return clean;
}

function sanitizeSeoDescription(rawDesc: string, locale: string = 'en'): string {
	if (!rawDesc) {
		return "Real BMI Calculator provides evidence-based health and fitness calculations based on official WHO standards.";
	}
	let d = rawDesc.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

	// If too long (> 155 chars in HTML), find sentence boundary or word boundary
	if (getHtmlLength(d) > 155) {
		const sentences = d.match(/[^.!?]+[.!?]+/g) || [d];
		// Try first sentence
		if (sentences[0] && getHtmlLength(sentences[0].trim()) >= 50 && getHtmlLength(sentences[0].trim()) <= 155) {
			return sentences[0].trim();
		}
		// Try first two sentences
		if (sentences.length >= 2) {
			const two = (sentences[0] + ' ' + sentences[1]).trim();
			if (getHtmlLength(two) >= 50 && getHtmlLength(two) <= 155) {
				return two;
			}
		}
		// Otherwise cut cleanly at word boundary
		let base = d;
		while (base.length > 50 && getHtmlLength(base + '...') > 155) {
			const lastSpace = base.lastIndexOf(' ');
			if (lastSpace >= 50) {
				base = base.slice(0, lastSpace).replace(/[,;:\-\s.]+$/, '').trim();
			} else {
				base = base.slice(0, 150).replace(/[,;:\-\s.]+$/, '').trim();
				break;
			}
		}
		const candidate = base + '...';
		if (getHtmlLength(candidate) >= 50 && getHtmlLength(candidate) <= 160) {
			return candidate;
		}
		d = candidate;
	}

	// If too short (< 50 chars), pad with authoritative context
	if (d.length < 50) {
		const pad: Record<string, string> = {
			en: " Evidence-based, free, and private calculation tool.",
			es: " Herramienta de cálculo gratuita, privada y basada en evidencia.",
			fr: " Outil de calcul gratuit, privé et fondé sur des preuves.",
			de: " Evidenzbasierter, kostenloser und privater Onlinerechner.",
			ko: " WHO 표준 기반의 신뢰할 수 있는 무료 온라인 건강 계산기입니다.",
			hi: " डब्ल्यूएचओ मानकों पर आधारित निःशुल्क एवं सुरक्षित कैलकुलेटर।"
		};
		d = `${d}${pad[locale] || pad['en']}`;
	}

	return d;
}

const seoTitle = sanitizeSeoTitle(title, currentLocale || 'en');
const seoDescription = sanitizeSeoDescription(description, currentLocale || 'en');

const localeOgMap: Record<string, string> = {
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  de: 'de_DE',
  ko: 'ko_KR',
  hi: 'hi_IN'
};
const ogLocale = localeOgMap[currentLocale || 'en'] || 'en_US';

const rawCanonical = customCanonicalURL || new URL(Astro.url.pathname, 'https://realbmicalculator.com').href;
const canonicalURL = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `https://realbmicalculator.com${ogImage}`;

const rawPath = Astro.url.pathname.replace(/^\/(en|es|fr|de|ko|hi)/, '');
let normalizedPath = rawPath === '' ? '/' : (rawPath.startsWith('/') ? rawPath : `/${rawPath}`);
if (!normalizedPath.endsWith('/')) {
  normalizedPath += '/';
}

const pagePath = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems: any[] = [];
if (pagePath.length > 0) {
  const segments = pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? pagePath.slice(1) : pagePath;
  segments.forEach((segment, index) => {
    const foundCalc = calculators.find((c: any) => c.slug === segment);
    const name = foundCalc 
      ? (foundCalc.name[currentLocale || 'en'] || foundCalc.name['en']) 
      : segment.replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
    const rawItemUrl = `https://realbmicalculator.com${Astro.url.pathname.split('/').slice(0, index + 1 + (pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? 1 : 0)).join('/')}`;
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: index + 2,
      name,
      item: rawItemUrl.endsWith('/') ? rawItemUrl : `${rawItemUrl}/`
    });
  });
}

