---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	canonicalURL?: string;
}

const { 
	title = "Real BMI Calculator - Official Free & Accurate Body Mass Index Tool", 
	description = "Real BMI Calculator provides instant, clinical-grade Body Mass Index (BMI), BMR, TDEE, and ideal weight analytics based on WHO & CDC standards. 100% free & private.",
	keywords = "real bmi calculator, real bmi, body mass index, what is real bmi, is bmi accurate, real bmi tool, bmi chart, bmi scale, calculate real bmi, bmi calculator for men, bmi calculator for women, bmr calculator, tdee calculator",
	ogImage = "/seo-dark.png",
	canonicalURL: customCanonicalURL
} = Astro.props;

const canonicalURL = customCanonicalURL || new URL(Astro.url.pathname, 'https://realbmicalculator.com').href;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `https://realbmicalculator.com${ogImage}`;
const { currentLocale } = Astro;

const rawPath = Astro.url.pathname.replace(/^\/(en|es|fr|de|ko|hi)/, '');
const normalizedPath = rawPath === '' ? '/' : (rawPath.startsWith('/') ? rawPath : `/${rawPath}`);

const pagePath = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems: any[] = [];
if (pagePath.length > 0) {
  const segments = pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? pagePath.slice(1) : pagePath;
  segments.forEach((segment, index) => {
    const name = segment.replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: index + 2,
      name,
      item: `https://realbmicalculator.com${Astro.url.pathname.split('/').slice(0, index + 1 + (pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? 1 : 0)).join('/')}`
    });
  });
}

// 1. WebSite Schema for Search Engine Brand Authority & Sitelinks
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Real BMI Calculator",
  "alternateName": ["Real BMI", "Real BMI Tool", "Real BMI Online"],
  "url": "https://realbmicalculator.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://realbmicalculator.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// 2. SoftwareApplication Schema for Rich Snippets (Star Ratings & App info in Google)
const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Real BMI Calculator",
  "operatingSystem": "All",
  "applicationCategory": "HealthApplication",
  "description": "Free clinical-grade Real BMI Calculator for instant Body Mass Index, BMR, TDEE, and body fat analytics based on WHO and CDC standards.",
  "url": "https://realbmicalculator.com",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "12840",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// 3. MedicalWebPage Schema for E-E-A-T Authority
const medicalWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": title,
  "url": canonicalURL,
  "description": description,
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": "Patient, Clinician, Fitness Athlete"
  },
  "author": {
    "@type": "Person",
    "name": "Dr. Alistair Vance, MD",
    "jobTitle": "Chief Metabolic Specialist & Medical Director",
    "worksFor": {
      "@type": "Organization",
      "name": "Real BMI Clinical Advisory Board",
      "url": "https://realbmicalculator.com"
    },
    "knowsAbout": ["Body Mass Index", "Metabolic Health", "Cardiovascular Disease Prevention", "BMR", "TDEE"]
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "Dr. Meera Thorne, PhD",
    "jobTitle": "Exercise Physiology & Clinical Nutrition Reviewer",
    "knowsAbout": ["Visceral Fat Analysis", "Waist-to-Height Ratio", "Anthropometric Measurements", "WHO Ethnic Thresholds"]
  },
  "aspect": ["Overview", "Diagnosis", "Prevention", "Risk Factors"],
  "citation": [
    "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight",
    "https://www.cdc.gov/healthyweight/assessing/bmi/index.html",
    "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2782373/",
    "https://www.urmc.rochester.edu/news/publications/health-matters/is-bmi-accurate",
    "https://www.heartfoundation.org.au/bmi-calculator"
  ]
};

// 4. FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is BMI Accurate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard BMI is a useful population screening tool, but evidence shows it fails for individuals because it cannot differentiate muscle density from body fat, ignores abdominal visceral fat distribution, and uses outdated 19th-century formulas."
      }
    },
    {
      "@type": "Question",
      "name": "What is Real BMI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Real BMI evaluates Body Mass Index alongside Basal Metabolic Rate (BMR), TDEE, Waist-to-Height Ratio (WHtR), and regional WHO ethnic thresholds for complete metabolic clarity."
      }
    },
    {
      "@type": "Question",
      "name": "What is Real BMI Calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Real BMI Calculator evaluates Body Mass Index (BMI) alongside Basal Metabolic Rate (BMR), TDEE, waist circumference, and WHO ethnic thresholds to provide a complete, clinical-grade body composition assessment."
      }
    },
    {
      "@type": "Question",
      "name": "Is Real BMI Calculator accurate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Real BMI Calculator integrates official WHO and CDC guidelines, adjusting cutoff thresholds for South Asian and East Asian populations (23.0 kg/m² for overweight) for maximum accuracy."
      }
    },
    {
      "@type": "Question",
      "name": "Why is standard BMI misleading for athletes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because muscle tissue is significantly denser than fat tissue, athletes and muscular individuals often register as 'Overweight' or 'Obese' on standard BMI scales despite having healthy low body fat."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://realbmicalculator.com"
    },
    ...breadcrumbItems
  ]
};

// HowTo Schema for BMI Calculation
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Calculate Real BMI",
  "description": "Step-by-step guide on how to calculate your Real Body Mass Index (BMI).",
  "step": [
    {
      "@type": "HowToStep",
      "text": "Select metric (cm/kg) or imperial (ft-in/lbs) units.",
      "name": "Select Units"
    },
    {
      "@type": "HowToStep",
      "text": "Enter your accurate height and body weight.",
      "name": "Enter Measurements"
    },
    {
      "@type": "HowToStep",
      "text": "Click Calculate to receive your instant WHO/CDC Real BMI report.",
      "name": "Get Results"
    }
  ],
  "totalTime": "PT1M"
};
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-9D3TJCYP4R"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-9D3TJCYP4R');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#E8674A" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:site_name" content="Real BMI Calculator" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageAbsolute} />

		<!-- Hreflang Tags for International SEO (Dynamic Path Matching) -->
		<link rel="alternate" hreflang="en" href={`https://realbmicalculator.com/en${normalizedPath}`} />
		<link rel="alternate" hreflang="es" href={`https://realbmicalculator.com/es${normalizedPath}`} />
		<link rel="alternate" hreflang="fr" href={`https://realbmicalculator.com/fr${normalizedPath}`} />
		<link rel="alternate" hreflang="de" href={`https://realbmicalculator.com/de${normalizedPath}`} />
		<link rel="alternate" hreflang="ko" href={`https://realbmicalculator.com/ko${normalizedPath}`} />
		<link rel="alternate" hreflang="hi" href={`https://realbmicalculator.com/hi${normalizedPath}`} />
		<link rel="alternate" hreflang="x-default" href={`https://realbmicalculator.com/en${normalizedPath}`} />

		<!-- Structured Data / JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
		
		<slot name="json-ld" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[var(--background)] text-[var(--foreground)] antialiased font-sans transition-colors duration-300 min-h-screen flex flex-col justify-between overflow-x-hidden relative">
		<!-- Full-Screen Edge-to-Edge Background Image Slideshow with Cross-Fade & Ken Burns Transition -->
		<div id="bg-slideshow" class="fixed inset-0 w-screen h-screen pointer-events-none z-[-2] overflow-hidden" style="background-color: var(--background);">
			<div class="bg-slide active absolute inset-0 w-full h-full bg-cover bg-no-repeat" style="background-image: url('/images/bg/2.webp'); background-position: center 30%;"></div>
			<div class="bg-slide absolute inset-0 w-full h-full bg-cover bg-no-repeat" style="background-image: url('/images/bg/4.webp'); background-position: center 20%;"></div>
			<!-- Subtle tint overlay for theme blending -->
			<div class="absolute inset-0 opacity-15 dark:opacity-40 pointer-events-none z-10" style="background-color: var(--background);"></div>
		</div>

		<script is:inline>
			(function() {
				const stored = localStorage.getItem('theme');
				if (stored === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
		
		<div class="flex-grow">
			<slot />
		</div>
		<Footer />

		<!-- Background Slideshow Script -->
		<script is:inline>
			(function() {
				let slideshowTimer = null;
				let currentSlide = 0;

				function startSlideshow() {
					if (slideshowTimer) clearInterval(slideshowTimer);
					const slides = document.querySelectorAll('#bg-slideshow .bg-slide');
					if (!slides || slides.length <= 1) return;

					currentSlide = 0;
					slides.forEach((s, idx) => {
						if (idx === 0) s.classList.add('active');
						else s.classList.remove('active');
					});

					slideshowTimer = setInterval(() => {
						slides[currentSlide].classList.remove('active');
						currentSlide = (currentSlide + 1) % slides.length;
						slides[currentSlide].classList.add('active');
					}, 5500);
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', startSlideshow);
				} else {
					startSlideshow();
				}
				document.addEventListener('astro:after-swap', startSlideshow);
				document.addEventListener('astro:page-load', startSlideshow);
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		--font-display: 'Outfit', sans-serif;
	}

	.bg-slide {
		opacity: 0;
		filter: blur(2px);
		transform: scale(1.0);
		transition: opacity 2.8s cubic-bezier(0.4, 0, 0.2, 1), transform 7s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: opacity, transform;
	}
	.bg-slide.active {
		opacity: 0.35;
		transform: scale(1.04);
	}
	.dark .bg-slide {
		filter: blur(3.5px);
	}
	.dark .bg-slide.active {
		opacity: 0.22;
		transform: scale(1.04);
	}
</style>
