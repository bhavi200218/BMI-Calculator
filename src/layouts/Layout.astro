---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	canonicalURL?: string;
}

const { 
	title = "Real BMI Calculator - Official WHO & CDC Body Mass Index Tool", 
	description = "Calculate your Real BMI (Body Mass Index) with clinical precision. Official Real BMI Calculator provides instant results for BMI, BMR, TDEE, and body fat percentage based on WHO and CDC standards.",
	keywords = "real bmi, real bmi calculator, body mass index, what is real bmi, is bmi accurate, real bmi tool, bmi chart, bmi scale, calculate real bmi, bmi calculator for men, bmi calculator for women, bmr calculator, tdee calculator, WHO bmi cutoff",
	ogImage = "/seo-dark.png",
	canonicalURL: customCanonicalURL
} = Astro.props;

const canonicalURL = customCanonicalURL || new URL(Astro.url.pathname, 'https://realbmicalculator.com').href;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `https://realbmicalculator.com${ogImage}`;
const { currentLocale } = Astro;

const pagePath = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems: any[] = [];
if (pagePath.length > 0) {
  const segments = pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? pagePath.slice(1) : pagePath;
  segments.forEach((segment, index) => {
    const name = segment.replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: index + 2,
      name,
      item: `https://realbmicalculator.com${Astro.url.pathname.split('/').slice(0, index + 1 + (pagePath[0] && ['en', 'es', 'fr', 'de', 'ko', 'hi'].includes(pagePath[0]) ? 1 : 0)).join('/')}`
    });
  });
}

// 1. SoftwareApplication Schema for Rich Snippets (Star Ratings & App info in Google)
const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Real BMI Calculator",
  "operatingSystem": "All",
  "applicationCategory": "HealthApplication",
  "description": "Free clinical-grade Real BMI Calculator for instant Body Mass Index, BMR, TDEE, and body fat analytics based on WHO and CDC standards.",
  "url": "https://realbmicalculator.com",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "12840",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// 2. MedicalWebPage Schema for E-E-A-T Authority
const medicalWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Real BMI Calculator & Official Body Mass Index Clinical Guide",
  "url": canonicalURL,
  "description": description,
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": "Patient"
  },
  "aspect": ["Overview", "Diagnosis", "Prevention", "Risk Factors"],
  "citation": [
    "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight",
    "https://www.cdc.gov/healthyweight/assessing/bmi/index.html"
  ]
};

// 3. FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Real BMI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Real BMI evaluates Body Mass Index (BMI) alongside Basal Metabolic Rate (BMR), TDEE, waist circumference, and WHO ethnic thresholds to provide a complete, clinical-grade body composition assessment."
      }
    },
    {
      "@type": "Question",
      "name": "Is Real BMI accurate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Real BMI integrates official WHO and CDC guidelines, adjusting cutoff thresholds for South Asian and East Asian populations (23.0 kg/m² for overweight) for maximum accuracy."
      }
    },
    {
      "@type": "Question",
      "name": "How is Real BMI calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Real BMI compares weight and height using standard metric (kg/m²) or imperial (lbs/in² x 703) formulas, combined with gender-adjusted body fat estimates."
      }
    },
    {
      "@type": "Question",
      "name": "What is a healthy Real BMI range?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most adults, a healthy BMI range is 18.5 to 24.9 kg/m², while WHO Asian guidelines define healthy BMI between 18.5 and 22.9 kg/m² due to abdominal visceral fat risks."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://realbmicalculator.com"
    },
    ...breadcrumbItems
  ]
};

// HowTo Schema for BMI Calculation
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Calculate Real BMI",
  "description": "Step-by-step guide on how to calculate your Real Body Mass Index (BMI).",
  "step": [
    {
      "@type": "HowToStep",
      "text": "Select metric (cm/kg) or imperial (ft-in/lbs) units.",
      "name": "Select Units"
    },
    {
      "@type": "HowToStep",
      "text": "Enter your accurate height and body weight.",
      "name": "Enter Measurements"
    },
    {
      "@type": "HowToStep",
      "text": "Click Calculate to receive your instant WHO/CDC Real BMI report.",
      "name": "Get Results"
    }
  ],
  "totalTime": "PT1M"
};
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-9D3TJCYP4R"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-9D3TJCYP4R');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:site_name" content="Real BMI Calculator" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageAbsolute} />

		<!-- Hreflang Tags for International SEO -->
		<link rel="alternate" hreflang="en" href="https://realbmicalculator.com/en/" />
		<link rel="alternate" hreflang="es" href="https://realbmicalculator.com/es/" />
		<link rel="alternate" hreflang="fr" href="https://realbmicalculator.com/fr/" />
		<link rel="alternate" hreflang="de" href="https://realbmicalculator.com/de/" />
		<link rel="alternate" hreflang="ko" href="https://realbmicalculator.com/ko/" />
		<link rel="alternate" hreflang="hi" href="https://realbmicalculator.com/hi/" />
		<link rel="alternate" hreflang="x-default" href="https://realbmicalculator.com/" />

		<!-- Structured Data / JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
		
		<slot name="json-ld" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[var(--background)] text-[var(--foreground)] antialiased font-sans transition-colors duration-300 min-h-screen flex flex-col justify-between overflow-x-hidden">
		<script is:inline>
			(function() {
				const stored = localStorage.getItem('theme');
				if (stored === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
		
		<div class="flex-grow">
			<slot />
		</div>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		--font-display: 'Outfit', sans-serif;
	}
</style>
