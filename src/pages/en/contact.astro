---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Creator & Support | Real BMI Calculator",
  "url": "https://realbmicalculator.com/en/contact/",
  "description": "Contact Real BMI for technical support, mathematical formula feedback, editorial inquiries, or suggestions regarding our health and fitness calculators.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Software Engineer & Lead Developer",
      "url": "https://realbmicalculator.com/en/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Banswara",
      "addressRegion": "Rajasthan",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/en/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="Contact Creator & Support | Real BMI Calculator" 
    description="Contact Real BMI for technical support, mathematical formula feedback, editorial inquiries, or suggestions regarding our health and fitness calculators."
    canonicalURL="https://realbmicalculator.com/en/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-20 md:pt-24 pb-16 px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto space-y-8">
          <!-- Header block -->
          <div class="space-y-3">
            <a href="/en/" class="inline-flex items-center gap-2 min-h-[44px] px-3 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Home
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Get in Touch</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contact Creator & Support</h1>
            <p class="text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)] font-medium max-w-4xl">
              Have a question about our calculator formulas, a technical issue with 3D visualization, or feedback on our health guides? Reach out directly to Bhawanshi Dosi.
            </p>
          </div>

          <!-- Creator & Project Identity Card (Clean, Open, Modern) -->
          <div class="rounded-2xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-6 sm:p-7 space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Individual Website & Transparency
              </div>
              <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#464feb] hover:underline">
                <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                LinkedIn Profile ↗
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Founder & Lead Developer</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Bhawanshi Dosi</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Software Engineer & Solo Webmaster</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Operational Base</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Banswara, Rajasthan, India</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Global Availability (6 Locales)</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Platform Architecture</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Independent Health Project</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">23 Free Health Calculators</p>
              </div>
            </div>
          </div>

          <!-- Interactive Contact Form Component -->
          <div id="contact-desk">
            <ContactForm lang="en" />
          </div>

          <!-- Communication Guidelines (3 Clear Cards, No Line Dividers) -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                Communication Guidelines & Editorial Boundaries
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                Please review our scope of support before sending an inquiry to our developer inbox.
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  1. No Individual Medical Advice
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Real BMI provides population-level educational screening tools based on published equations. We cannot evaluate personal medical records, diagnose conditions, or prescribe individualized treatments. Please consult a licensed physician for personal care.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  2. Private Direct Email (No Public UGC)
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  To protect user privacy and prevent unverified health claims or spam, Real BMI does not operate public comment sections, message boards, or open forums. All incoming inquiries are private, one-on-one email communications reviewed directly by the creator.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  3. Zero Health Data Retention
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  All calculation logic runs exclusively in your web browser using client-side JavaScript. No biological measurements, heights, weights, or waist numbers are ever transmitted to our servers or stored in any database.
                </p>
              </div>
            </div>
          </div>

          <!-- Support FAQ Section -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                Frequently Asked Support Questions
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                Common inquiries regarding formula citations, 3D WebGL simulator performance, privacy guidelines, and calculator integrations.
              </p>
            </div>
            <div class="space-y-3.5">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  How can I report a mathematical error or suggest a formula update?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Send your inquiry directly to our support email (<!--email_off-->support@realbmicalculator.com<!--/email_off-->) with the specific calculator URL, the mathematical formula or variable in question, and academic citations (such as WHO, CDC, or PubMed articles). Bhawanshi Dosi reviews all formula feedback directly.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Can I embed Real BMI calculators on my blog, clinic, or gym website?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Yes. You may use our embed widget iframe freely on non-commercial and commercial websites. We ask that you maintain the attribution link back to realbmicalculator.com so your users can access complete formula documentation.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Are my health numbers, weight, or personal measurements stored on your servers?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  No. All calculations are processed locally inside your web browser using JavaScript. No biometric parameters, heights, weights, or body fat numbers are ever transmitted to our servers or stored in any database.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  How quickly does Real BMI respond to messages?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Messages are typically answered within 24 to 48 business hours. For bug reports regarding 3D WebGL rendering or calculator malfunction, please include your device model and browser version to expedite replication.
                </p>
              </div>
            </div>
          </div>

          <!-- Policy & Trust Links Strip (No Line Dividers) -->
          <div class="pt-2">
            <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--muted)]/20 p-5 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">
                Editorial & Governance Standards
              </span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-medium">
                <a href="/en/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Editorial Policy & Methodology</span>
                  <span>&rarr;</span>
                </a>
                <a href="/en/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>15 Scientific Citations</span>
                  <span>&rarr;</span>
                </a>
                <a href="/en/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Medical Disclaimer</span>
                  <span>&rarr;</span>
                </a>
                <a href="/en/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Privacy Policy</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
    </main>
</Layout>
