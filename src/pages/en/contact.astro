---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Contact Real BMI Calculator | Support & Feedback"
    description="Contact Real BMI Calculator for support, feedback, or questions about our reference health calculators. Get help with BMI, BMR, TDEE calculations."
>
    <Navbar />
    <PageShell
      title="Contact Us"
      eyebrow="Support for Real BMI"
      description="Reach out for help with calculators, accuracy questions, and health insight requests."
      returnUrl="/en"
      returnLabel="Home"
    >
      <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
        <div class="space-y-8">
          <div class="space-y-5 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg md:text-xl font-medium opacity-90">
            <p>Need help understanding your BMI, BMR, TDEE, body fat, or nutrition estimates? I maintain Real BMI and review calculator feedback, formula questions, and support requests directly.</p>
            <p>For questions about calculator methodology, reference formulas, or website usability, send a message with the tool name and your feedback.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-xs uppercase tracking-[0.28em] font-semibold text-[var(--accent)]">Response time</p>
              <p class="mt-3 text-base font-semibold text-[var(--foreground)]">Typically within 24 hours on business days</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-xs uppercase tracking-[0.28em] font-semibold text-[var(--accent)]">Message</p>
              <p class="mt-3 text-base text-[var(--muted-foreground)] leading-relaxed">For inquiries, support, or feedback, please email <a href="mailto:support@realbmicalculator.com" class="text-[var(--accent)] font-semibold hover:underline">support@realbmicalculator.com</a>.</p>
            </div>
          </div>

          <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
            <h2 class="text-2xl font-black text-[var(--foreground)]">What to include</h2>
            <p class="mt-3 text-base text-[var(--muted-foreground)] leading-relaxed">Please include the calculator name, your specific question or feedback, so I can respond with helpful information.</p>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-5 sm:p-8 shadow-[var(--shadow-soft)]">
          <a href="mailto:support@realbmicalculator.com" class="inline-flex w-full items-center justify-center rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-4 py-3 text-xs sm:text-sm font-semibold uppercase tracking-wider text-[var(--accent)] transition hover:bg-[var(--accent)]/15 text-center">support@realbmicalculator.com</a>
          <div class="mt-8 space-y-3 text-sm text-[var(--muted-foreground)] leading-relaxed">
            <p><strong>Note:</strong> Direct email is the best way to reach me for calculator feedback and site suggestions.</p>
            <p>I aim to respond within 24 hours on business days to improve clarity and usability across the website.</p>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
