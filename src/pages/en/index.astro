---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import HealthContent from '../../components/HealthContent.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Real BMI English — Evidence-Based Health Calculators"
	description="Access Real BMI's complete English health research platform and calculation suite with 23 free private health calculators and screening tools. Explore peer-reviewed metabolic guides, academic literature, and private browser screening tools."
	canonicalURL="https://realbmicalculator.com/en/"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  1. HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-20 md:pt-24 pb-6 px-4 md:px-6">
			<div class="max-w-7xl mx-auto space-y-6">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-3.5 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						GLOBAL HEALTH DIRECTORY • PEER-REVIEWED METABOLIC STANDARDS<span class="sr-only">. </span>
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Evidence-Based Health Calculators & Clinical Metric Suite<span class="sr-only">. </span>
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-base sm:text-xl text-[var(--accent)] font-semibold tracking-tight font-display">
						Comprehensive Physiological Reference Formulas & Private Screening<span class="sr-only">. </span>
					</p>
					<p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed">
						Check your body mass index, calories, and fitness stats in seconds. Our tools follow official WHO and CDC guidelines. All math runs on your device.
					</p>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-2.5 sm:gap-3 pt-1">
					{[
						'23 Peer-Reviewed Calculators',
						'Client-Side Browser Privacy',
						'Dual Metric & Imperial Support',
						'WHO, CDC & NIH References'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}<span class="sr-only">. </span>
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  2. 🔥 ALL HEALTH & FITNESS CALCULATORS  ═══════════════════ -->
		<section id="calculators" class="px-4 md:px-6 pt-0 pb-10 md:pb-14 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-6">
				<header class="space-y-3 pb-4 border-b border-[var(--border)]/40">
					<div class="flex items-center justify-between gap-4">
						<span class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">🔥 Global Tool Index<span class="sr-only">. </span></span>
						<span class="text-xs font-mono text-[var(--accent)] font-bold px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 shrink-0">
							23 Tools
						</span>
					</div>
					<h2 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						Complete Health & Fitness Calculator Directory<span class="sr-only">. </span>
					</h2>
					<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium max-w-3xl leading-relaxed">
						Explore all 23 health and fitness tools. Check your BMI, daily energy needs, body fat, and heart rate zones. Every calculation runs on your device with complete privacy.
					</p>
				</header>

				<HomepageHubWrapper lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  6. 📖 LATEST ARTICLES  ═══════════════════ -->
		<section id="latest-articles" class="px-4 md:px-6 py-10 md:py-14 border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<LatestArticles lang="en" limit={6} />
			</div>
		</section>

		<!-- ═══════════════════  3. ⭐ TRUST SIGNALS & STANDARDS  ═══════════════════ -->
		<!-- WHY PEOPLE CHOOSE REAL BMI -->
		<section class="px-4 md:px-6 py-12 md:py-16 border-t border-[var(--border)]/40 space-y-12">
			<div class="max-w-7xl mx-auto space-y-10">
				<div class="space-y-3 text-center sm:text-left max-w-3xl">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">Transparent Calculator Features<span class="sr-only">. </span></p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						Clarity for your health goals<span class="sr-only">. </span>
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
						Real BMI gives you fast, practical estimates. All tools follow published public health guidelines.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: 'Formula-based estimates', description: 'Get clear baselines for BMI, BMR, TDEE, and ideal weight using published mathematical equations.' },
						{ title: 'Browser privacy first', description: 'All calculations stay on your device — no accounts, sign-ups, or server storage required.' },
						{ title: 'Built on public standards', description: 'Results are presented alongside WHO and CDC public reference ranges for context.' },
						{ title: 'Useful for daily planning', description: 'Explore fitness metrics, nutrition estimates, and body composition references with clear calculation methods.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-3 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-sm hover:-translate-y-0.5">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}<span class="sr-only">. </span></h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand & Methodology Box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6 shadow-md">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-80">Transparent Methodology<span class="sr-only">. </span></p>
							<p class="text-2xl md:text-3xl font-display font-bold tracking-tight uppercase">HOW OUR CALCULATORS WORK<span class="sr-only">. </span></p>
							<p class="text-xs md:text-sm font-medium opacity-90 leading-relaxed pt-1">Explore our published formulas, reference standards, inputs, outputs, and limitations for all 23 tools.</p>
						</div>
						<a href="/en/methodology/" class="px-4 py-2.5 rounded-xl bg-white text-slate-900 font-display text-xs font-bold uppercase tracking-wider hover:bg-slate-100 transition-all shadow-xs">
							View Calculator Methodology →
						</a>
					</div>
				</div>

				<!-- Editorial & Research Verification Banner -->
				<div class="pt-4">
					<MedicalEEATBanner lang="en" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  7. ❓ REFERENCE STANDARDS & FAQ  ═══════════════════ -->
		<section id="faq-standards" class="px-4 md:px-6 py-10 md:py-14 border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-12">
				<HealthContent lang="en" />
				<EmbedWidgetBox lang="en" />
			</div>
		</section>

	</main>
</Layout>
