---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HeroBmiInstantCalculator from '../../components/HeroBmiInstantCalculator.astro';
import UpperEvidenceCenter from '../../components/UpperEvidenceCenter.astro';
import HeroQuickLaunch from '../../components/HeroQuickLaunch.astro';
import PopularHealthTopics from '../../components/PopularHealthTopics.astro';
import FeaturedResearchGuides from '../../components/FeaturedResearchGuides.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import UnderstandNumbersSection from '../../components/UnderstandNumbersSection.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import HealthContent from '../../components/HealthContent.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Real BMI — Health Research Hub, Evidence-Based Guides & Calculators"
	description="Access Real BMI's complete English health research platform and calculation suite. Explore peer-reviewed metabolic guides, academic literature, and private browser screening tools."
	canonicalURL="https://realbmicalculator.com/en/"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-24 md:pt-28 pb-8 md:pb-12 px-4 md:px-6">
			<div class="max-w-7xl mx-auto space-y-8">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-4 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						HEALTH RESEARCH HUB • EVIDENCE-BASED GUIDES & TOOLS
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Evidence-Based Health Research, Metabolic Guides & Screening Tools
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-lg sm:text-xl md:text-2xl text-[var(--accent)] font-semibold tracking-tight font-display">
						Peer-Reviewed Research Literature • Dual-Unit Parity Algorithms • Client-Side Privacy
					</p>
					<p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed pt-1">
						Explore authoritative health research, lifespan anthropometric guidelines, and private browser calculators built on published World Health Organization (WHO) and CDC epidemiological frameworks.
					</p>
				</div>

				<!-- Instant Quick BMI Calculator (First Screen Priority) -->
				<div class="max-w-4xl mx-auto">
					<HeroBmiInstantCalculator lang="en" />
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-3 sm:gap-4 pt-2">
					{[
						'18+ Health Calculators',
						'30+ Research Guides',
						'15 Indexed Primary Studies',
						'WHO & CDC Standards'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  SECTION 2: POPULAR CALCULATORS LAUNCHPAD  ═══════════════════ -->
		<section id="popular-calculators" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 bg-[var(--card)]/10 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<HeroQuickLaunch lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  SECTION 3: FEATURED RESEARCH GUIDES & ARTICLES  ═══════════════════ -->
		<div id="featured-guides" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 bg-[var(--card)]/20 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<FeaturedResearchGuides lang="en" />
			</div>
		</div>

		<div id="latest-articles" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<LatestArticles lang="en" limit={6} />
			</div>
		</div>

		<!-- ═══════════════════  SECTION 4: WHY PEOPLE CHOOSE REAL BMI & RESEARCH FOUNDATION  ═══════════════════ -->
		<section class="px-4 md:px-6 py-12 md:py-16 content-auto border-t border-[var(--border)]/40 space-y-12">
			<div class="max-w-7xl mx-auto">
				<div class="mb-10 sm:mb-12 space-y-3">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">Transparent Calculator Features</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						Clarity for your health goals
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium max-w-xl">
						Whether you are tracking progress, planning nutrition, or reviewing fitness baselines, Real BMI gives you fast, practical estimates grounded in published guidelines.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: 'Formula-based estimates', description: 'Get clear baselines for BMI, BMR, TDEE, and ideal weight using published mathematical equations.' },
						{ title: 'Browser privacy first', description: 'All calculations stay on your device — no accounts, sign-ups, or server storage required.' },
						{ title: 'Built on public standards', description: 'Results are presented alongside WHO and CDC public reference ranges for context.' },
						{ title: 'Useful for daily planning', description: 'Explore fitness metrics, nutrition estimates, and body composition references with clear calculation methods.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-4 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-[var(--shadow-accent)] hover:-translate-y-1">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand & Methodology Box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6 shadow-md">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-80">Transparent Methodology</p>
							<p class="text-2xl md:text-3xl font-display font-bold tracking-tight uppercase">HOW OUR CALCULATORS WORK</p>
							<p class="text-xs md:text-sm font-medium opacity-90 leading-relaxed pt-1">Explore our published formulas, reference standards, inputs, outputs, and limitations for all 18+ tools.</p>
						</div>
						<a href="/en/methodology/" class="px-4 py-2.5 rounded-xl bg-white text-slate-900 font-display text-xs font-bold uppercase tracking-wider hover:bg-slate-100 transition-all shadow-xs">
							View Calculator Methodology →
						</a>
					</div>
				</div>
			</div>

			<!-- Research Literature Matrix & Evidence Library -->
			<div class="max-w-7xl mx-auto pt-6">
				<UpperEvidenceCenter lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  SECTION 5: COMPLETE 18+ CALCULATOR SUITE  ═══════════════════ -->
		<section id="calculators" class="px-4 md:px-6 py-12 md:py-16 scroll-mt-24 border-t border-[var(--border)]/60 bg-[var(--card)]/30 content-auto">
			<div id="all-calculators" class="scroll-mt-24" aria-hidden="true"></div>
			<div class="max-w-7xl mx-auto space-y-8">
				<div class="text-center max-w-3xl mx-auto space-y-3">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
						Complete Interactive Directory
					</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						All 18+ Evidence-Based Health Calculators
					</h2>
					<p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
						Explore our complete suite of clinically referenced health and fitness tools — 100% browser-based with zero health data retention.
					</p>
				</div>
				<HomepageHubWrapper lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  SECTION 6: HEALTH TOPICS & FOUNDATIONS  ═══════════════════ -->
		<div id="popular-topics" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<PopularHealthTopics lang="en" />
			</div>
		</div>

		<div class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40">
			<div class="max-w-7xl mx-auto">
				<UnderstandNumbersSection lang="en" />
			</div>
		</div>

		<!-- ═══════════════════  SECTION 7: STANDARDS, METHODOLOGY & E-E-A-T  ═══════════════════ -->
		<div class="px-4 md:px-6 pt-8 pb-14 content-auto border-t border-[var(--border)]/40">
			<div class="max-w-7xl mx-auto space-y-12">
				<HealthContent lang="en" />
				<EmbedWidgetBox lang="en" />
				<MedicalEEATBanner lang="en" />
			</div>
		</div>

	</main>
</Layout>
