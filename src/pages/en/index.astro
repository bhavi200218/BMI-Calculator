---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
import DeepHealthSEO from '../../components/DeepHealthSEO.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import HealthContent from '../../components/HealthContent.astro';
---

<Layout 
	title="Free BMI, BMR, TDEE & Body Composition Calculators | Real BMI"
	description="Free BMI, BMR, TDEE & Body Composition Calculators. Educational calculators based on published formulas and reference ranges. Free & browser-based."
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-24 md:pt-28 pb-6 md:pb-8 px-4 md:px-6">
			<div class="max-w-7xl mx-auto">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-4 mb-8 max-w-4xl mx-auto animate-in" style="animation-delay:0ms">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						YOUR EVERYDAY HEALTH & FITNESS TOOLS
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Understand Your Numbers.<br class="hidden sm:inline" /> Plan With Confidence.
					</h1>

					<!-- Supporting H2 Subtitle -->
					<h2 class="text-lg sm:text-xl md:text-2xl text-[var(--accent)] font-semibold tracking-tight">
						Free BMI, BMR, TDEE & Body Composition Calculators
					</h2>

					<!-- Hero Description -->
					<p class="text-sm sm:text-base md:text-lg text-[var(--muted-foreground)] font-sans font-medium max-w-2xl mx-auto px-2 leading-relaxed">
						Explore simple calculators for BMI, metabolism, calorie planning, body composition, and everyday fitness reference. Get instant estimates using transparent formulas — directly in your browser, with no account required.
					</p>

					<!-- Action Buttons -->
					<div class="flex flex-wrap justify-center items-center gap-3 pt-2">
						<a href="#calculators" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-[var(--accent)] text-white text-xs font-display font-bold uppercase tracking-wider shadow-md hover:opacity-90 transition-all">
							Explore Calculators
						</a>
						<a href="/en/bmi-calculator/" class="inline-flex items-center justify-center px-6 py-3 rounded-xl border border-[var(--border)] bg-[var(--card)] text-[var(--foreground)] text-xs font-display font-bold uppercase tracking-wider hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all">
							View BMI Calculator
						</a>
					</div>

					<!-- Calculator Quick Links -->
					<div class="pt-3">
						<div class="flex flex-wrap justify-center items-center gap-1.5 text-xs font-semibold text-[var(--accent)]">
							{[
								{ name: 'BMI Calculator', href: '#calculators' },
								{ name: 'BMR Calculator', href: '#calculators' },
								{ name: 'TDEE Calculator', href: '#calculators' },
								{ name: 'Body Fat', href: '#calculators' },
								{ name: 'Ideal Weight', href: '#calculators' },
								{ name: 'Calories', href: '#calculators' },
								{ name: 'Macros', href: '#calculators' }
							].map((tag, idx, arr) => (
								<span>
									<a href={tag.href} class="hover:underline hover:text-[var(--foreground)] transition-colors">{tag.name}</a>
									{idx < arr.length - 1 && <span class="ml-1.5 text-[var(--muted-foreground)]/40">·</span>}
								</span>
							))}
						</div>
					</div>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-3 sm:gap-4 mb-4 animate-in" style="animation-delay:60ms">
					{[
						'15+ Calculators',
						'6 Languages',
						'Browser-Based',
						'Instant Results'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}
						</div>
					))}
				</div>

				<!-- Trust Badge below Stats -->
				<div class="flex items-center justify-center gap-2 mb-8 md:mb-10 text-xs font-medium text-[var(--muted-foreground)] animate-in" style="animation-delay:90ms">
					<svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
					</svg>
					<span>WHO & CDC Reference Standards</span>
				</div>

				<!-- Interactive Calculator Hub -->
				<div id="calculators" class="scroll-mt-28">
					<HomepageHubWrapper lang="en" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  WHY PEOPLE CHOOSE REAL BMI  ═══════════════════ -->
		<section class="px-4 md:px-6 py-12 md:py-16">
			<div class="max-w-7xl mx-auto">
				<div class="mb-10 sm:mb-12 space-y-3">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">Transparent Calculator Features</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						Clarity for your health goals
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium max-w-xl">
						Whether you are tracking progress, planning nutrition, or reviewing fitness baselines, Real BMI gives you fast, practical estimates grounded in published guidelines.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: 'Formula-based estimates', description: 'Get clear baselines for BMI, BMR, TDEE, and ideal weight using published mathematical equations.' },
						{ title: 'Browser privacy first', description: 'All calculations stay on your device — no accounts, sign-ups, or server storage required.' },
						{ title: 'Built on public standards', description: 'Results are presented alongside WHO and CDC public reference ranges for context.' },
						{ title: 'Useful for daily planning', description: 'Explore fitness targets, nutrition estimates, and body composition guidelines without guesswork.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-4 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-[var(--shadow-accent)] hover:-translate-y-1">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-70">Independent Tool</p>
							<p class="text-3xl md:text-4xl font-display font-bold tracking-tight uppercase">REAL BMI</p>
						</div>
						<p class="text-sm font-medium opacity-80 leading-relaxed">Reference tools grounded in published equations. Fast, private, and clear health metric calculators.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══════════════════  FEATURED GUIDES & TRUST CONTENT  ═══════════════════ -->
		<div class="px-4 md:px-6 pt-6 pb-12">
			<div class="max-w-7xl mx-auto space-y-12">
				<EmbedWidgetBox lang="en" />
				<LatestArticles lang="en" />
				<HealthContent lang="en" />
				<DeepHealthSEO lang="en" />
				<MedicalEEATBanner lang="en" />
			</div>
		</div>

	</main>
</Layout>
