---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
import DeepHealthSEO from '../../components/DeepHealthSEO.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import HealthContent from '../../components/HealthContent.astro';
---

<Layout 
	title="Free BMI, BMR, TDEE & Body Composition Calculators | Real BMI"
	description="Free BMI, BMR, TDEE & Body Composition Calculators. Educational calculators based on published formulas and reference ranges. Free & browser-based."
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-24 md:pt-28 pb-6 md:pb-8 px-4 md:px-6">
			<div class="max-w-7xl mx-auto">

				<!-- Main H1 headline -->
				<div class="text-center space-y-2.5 mb-6 max-w-4xl mx-auto animate-in" style="animation-delay:0ms">
					<h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight leading-[1.1] text-[var(--foreground)]">
						BMI, BMR & TDEE Calculators
						<span class="block text-sm sm:text-base md:text-lg mt-1.5 text-[var(--accent)] font-semibold tracking-normal normal-case">Browser-based reference tools powered by WHO & CDC guidelines.</span>
					</h1>
					<p class="text-xs sm:text-sm md:text-base text-[var(--muted-foreground)] font-sans font-semibold max-w-2xl mx-auto px-2">
						Fast, privacy-focused estimates for Body Mass Index, metabolic rates, and body composition metrics.
					</p>
				</div>

				<!-- Stats strip -->
				<div class="flex flex-wrap justify-center gap-6 md:gap-12 mb-8 md:mb-10 animate-in" style="animation-delay:60ms">
					{[
						{ value: 'WHO/CDC', label: 'Standards' },
						{ value: '6+', label: 'Languages' },
						{ value: 'Private', label: 'Local Inputs' },
						{ value: 'Instant', label: 'Results' },
					].map(s => (
						<div class="text-center space-y-0.5">
							<div class="text-2xl md:text-3xl font-display font-bold text-[var(--foreground)]">{s.value}</div>
							<div class="text-[10px] sm:text-xs font-display font-semibold tracking-[0.15em] uppercase text-[var(--muted-foreground)]">{s.label}</div>
						</div>
					))}
				</div>

				<!-- Interactive Calculator Hub -->
				<div id="calculators" class="scroll-mt-28">
					<HomepageHubWrapper lang="en" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  WHY PEOPLE CHOOSE REAL BMI  ═══════════════════ -->
		<section class="px-4 md:px-6 py-12 md:py-16">
			<div class="max-w-7xl mx-auto">
				<div class="mb-10 sm:mb-12 space-y-3">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">Transparent Calculator Features</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						Clarity for your health goals
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium max-w-xl">
						Whether you are tracking progress, planning nutrition, or reviewing fitness baselines, Real BMI gives you fast, practical estimates grounded in published guidelines.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: 'Formula-based estimates', description: 'Get clear baselines for BMI, BMR, TDEE, and ideal weight using published mathematical equations.' },
						{ title: 'Browser privacy first', description: 'All calculations stay on your device — no accounts, sign-ups, or server storage required.' },
						{ title: 'Built on public standards', description: 'Results are presented alongside WHO and CDC public reference ranges for context.' },
						{ title: 'Useful for daily planning', description: 'Explore fitness targets, nutrition estimates, and body composition guidelines without guesswork.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-4 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-[var(--shadow-accent)] hover:-translate-y-1">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-70">Independent Tool</p>
							<p class="text-3xl md:text-4xl font-display font-bold tracking-tight uppercase">REAL BMI</p>
						</div>
						<p class="text-sm font-medium opacity-80 leading-relaxed">Reference tools grounded in published equations. Fast, private, and clear health metric calculators.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══════════════════  FEATURED GUIDES & TRUST CONTENT  ═══════════════════ -->
		<div class="px-4 md:px-6 pt-6 pb-12">
			<div class="max-w-7xl mx-auto space-y-12">
				<EmbedWidgetBox lang="en" />
				<LatestArticles lang="en" />
				<HealthContent lang="en" />
				<DeepHealthSEO lang="en" />
				<MedicalEEATBanner lang="en" />
			</div>
		</div>

	</main>
</Layout>
