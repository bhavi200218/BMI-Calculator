---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import HealthContent from '../../components/HealthContent.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Real BMI Calculator – Free Online Body Mass Index & Health Suite"
	description="Calculate your Body Mass Index (BMI), healthy weight range, and calorie needs instantly with our free online tools. Compare against WHO & CDC standards. Private & browser-based."
	keywords="bmi calculator, calculate bmi, free bmi calculator online, body mass index calculator, real bmi calculator, bmi score, healthy weight chart, adult bmi calculator"
	canonicalURL="https://realbmicalculator.com/en/"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  1. HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-20 md:pt-24 pb-6 px-4 sm:px-6 lg:px-8 xl:px-12">
			<div class="w-full max-w-[1600px] mx-auto space-y-6">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-3.5 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						BMI & HEALTH CALCULATORS<span class="sr-only">. </span>
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Body Mass Index (BMI) Calculator<span class="sr-only">. </span>
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-base sm:text-xl text-[var(--accent)] font-semibold tracking-tight font-display">
						Know your BMI and understand your healthy weight range.<span class="sr-only">. </span>
					</p>
					<p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed">
						Find your BMI, ideal weight, and daily calories with our free tools. Every calculation uses WHO and CDC guidelines and runs directly in your browser.
					</p>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-2.5 sm:gap-3 pt-1">
					{[
						'Free to use',
						'kg & lbs',
						'Private calculations',
						'WHO & CDC guidelines'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}<span class="sr-only">. </span>
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  2. HEALTH & FITNESS CALCULATORS  ═══════════════════ -->
		<section id="calculators" class="px-4 sm:px-6 lg:px-8 xl:px-12 pt-0 pb-8 md:pb-10 scroll-mt-20">
			<div class="w-full max-w-[1600px] mx-auto space-y-6">
				<header class="flex items-center justify-between gap-4 pb-2">
					<h2 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						Health & Fitness Calculators<span class="sr-only">. </span>
					</h2>
					<span class="text-xs font-mono text-[var(--accent)] font-bold px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 shrink-0">
						23 Tools
					</span>
				</header>

				<HomepageHubWrapper lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  6. 📖 LATEST ARTICLES  ═══════════════════ -->
		<section id="latest-articles" class="px-4 sm:px-6 lg:px-8 xl:px-12 pt-8 md:pt-10 pb-10 md:pb-14 scroll-mt-20">
			<div class="w-full max-w-[1600px] mx-auto">
				<LatestArticles lang="en" limit={6} />
			</div>
		</section>

		<!-- ═══════════════════  3. ⭐ TRUST SIGNALS & STANDARDS  ═══════════════════ -->
		<!-- WHY PEOPLE CHOOSE REAL BMI -->
		<section class="px-4 sm:px-6 lg:px-8 xl:px-12 py-8 md:py-10">
			<div class="w-full max-w-[1600px] mx-auto space-y-6">
				<div class="space-y-2 text-center sm:text-left max-w-3xl">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.25em] text-[var(--accent)]">Transparent Calculator Features<span class="sr-only">. </span></p>
					<h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						Scientific Accuracy & Data Privacy<span class="sr-only">. </span>
					</h2>
					<p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-normal leading-relaxed">
						Real BMI delivers verified health formulas. Every tool runs in your browser to protect your personal privacy.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
					{[
						{ title: 'Clear Math Formulas', description: 'Every tool uses published formulas such as Mifflin-St Jeor, Devine, and Karvonen.' },
						{ title: 'Zero Data Collection', description: 'Your health numbers stay on your device. We do not store or track your private inputs.' },
						{ title: 'Multiple Body Checks', description: 'Compare your BMI with your body fat percentage and waist size for a better view.' },
						{ title: 'Official Health Cutoffs', description: 'All results are shown next to standard health ranges from the WHO and CDC.' },
					].map(item => (
						<div class="p-4 sm:p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] space-y-1.5 transition-all duration-200 hover:border-[var(--accent)]/50 hover:shadow-xs">
							<h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}<span class="sr-only">. </span></h3>
							<p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-normal leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
				</div>

				<!-- Transparent Methodology Strip -->
				<div class="p-4 sm:p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all duration-200 hover:border-[var(--accent)]/40">
					<div class="space-y-1">
						<div class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
							<span class="text-[11px] font-display font-bold uppercase tracking-wider text-[var(--accent)]">Transparent Methodology<span class="sr-only">. </span></span>
						</div>
						<h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">How Our 23 Calculators Work<span class="sr-only">. </span></h3>
						<p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-normal">Explore published formulas, reference standards, inputs, and limitations for all tools.</p>
					</div>
					<a href="/en/methodology/" class="px-4 py-2.5 rounded-xl bg-[var(--accent)] text-white font-display text-xs font-bold uppercase tracking-wider hover:opacity-95 transition-all shadow-xs inline-flex items-center gap-1.5 shrink-0 self-start sm:self-auto">
						<span>View Calculator Methodology →</span>
					</a>
				</div>

				<!-- Editorial & Research Verification Banner -->
				<MedicalEEATBanner lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  7. ❓ REFERENCE STANDARDS & FAQ  ═══════════════════ -->
		<section id="faq-standards" class="px-4 sm:px-6 lg:px-8 xl:px-12 py-10 md:py-14 scroll-mt-20">
			<div class="w-full max-w-[1600px] mx-auto space-y-12">
				<HealthContent lang="en" />
				<EmbedWidgetBox lang="en" />
			</div>
		</section>

	</main>
</Layout>
