---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="About Real BMI - Founder & Methodological Standards"
    description="Learn about Real BMI, an independent health calculator platform founded by Bhawanshi Dosi. Grounded in peer-reviewed WHO, CDC, and published health standards."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Real BMI",
      "description": "Organizational background, creator credentials, and evidence-based research methodology for Real BMI.",
      "url": "https://realbmicalculator.com/en/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Founder & Lead Developer",
          "description": "Software engineer and creator of Real BMI, specializing in client-side zero-retention health calculation engines.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Founder & Lead Developer",
          "url": "https://realbmicalculator.com/en/about/"
        },
        "knowsAbout": [
          "Body Mass Index (BMI)",
          "Basal Metabolic Rate (BMR)",
          "Total Daily Energy Expenditure (TDEE)",
          "Body Composition Assessment",
          "Anthropometric Reference Guidelines",
          "Automated Algorithmic Testing"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="About Real BMI"
      eyebrow="Mission & Evidence-Based Methodology"
      description="Founded, engineered, and maintained by Bhawanshi Dosi using peer-reviewed literature and published WHO & CDC standards."
      returnUrl="/en/"
      returnLabel="Home"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-8">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> is an independent health calculation website. It was built and is run by <strong>Bhawanshi Dosi</strong>, a software engineer living in Banswara, Rajasthan, India. Many online fitness tools are full of ads, confusing math, and privacy risks. Real BMI solves this problem. We provide clear, accurate calculators that run 100% in your browser. We never save or track your private numbers.</p>
            
            <!-- Creator Profile Card -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-2xl shadow-md shrink-0">
                BD
              </div>
              <div class="space-y-2 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl font-bold text-[var(--foreground)]">Bhawanshi Dosi</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">Founder &amp; Software Engineer</span>
                </div>
                <p class="text-xs font-medium text-[var(--accent)]">Banswara, Rajasthan, India &bull; Creator &amp; Lead Webmaster</p>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Software engineer specializing in client-side zero-retention health calculation engines. Bhawanshi personally researches, designs, codes, and maintains all 23 calculators on Real BMI, calibrating every algorithm directly to published public health literature (WHO, CDC, ICMR) and peer-reviewed clinical journals.
                </p>
              </div>
            </div>

            <!-- Non-Clinical Disclosure Banner -->
            <div class="p-5 rounded-xl border border-amber-500/30 bg-amber-500/5 text-amber-200/90 text-sm leading-relaxed space-y-2 not-prose">
              <div class="flex items-center gap-2 font-bold text-amber-400">
                <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Transparent Governance &amp; Non-Clinical Disclosure</span>
              </div>
              <p>
                Real BMI is an individual software engineering project created and operated solely by Bhawanshi Dosi. The platform does <strong>not</strong> operate a clinical medical review board, physician advisory committee, or multidisciplinary review panel. All calculators are algorithmic implementations of established public health literature intended strictly for educational awareness and lifestyle planning, not medical diagnosis or clinical care.
              </p>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Automated Mathematical Testing &amp; Verification Pipeline</h2>
            <p>Because Real BMI does not employ a subjective medical editorial board, accuracy and reliability are achieved through <strong>rigorous test-driven software engineering</strong>. Every formula, conversion constant, and reference boundary is validated by an automated testing suite comprising over 920 unit and regression tests executed on every code update before deployment:</p>
            
            <div class="grid gap-4 sm:grid-cols-2 not-prose pt-1">
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Peer-Reviewed Formula Fidelity
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Formulas (Mifflin-St Jeor 1990, Mosteller 1987, Devine 1974, WHO TRS 854) are validated against clinical benchmark data sets to verify exact numerical outputs.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Dual-Unit Parity &amp; Precision
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Metric (kg/cm) and imperial (lbs/inches) calculations are cross-verified using conversion factor 703.06957964 with floating-point tolerance of &plusmn;0.01.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Boundary &amp; Category Testing
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Unit tests validate standard WHO cutoffs (18.5, 25.0, 30.0) alongside Asian-specific risk thresholds (23.0, 27.5 kg/m&sup2;) across edge-case input values.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Zero-Retention Isolation Audit
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Automated architectural tests verify that no biometric inputs, calculations, or query parameters are ever transmitted over HTTP requests or stored in cookies.
                </p>
              </div>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">The Genesis of Real BMI: Why This Site Was Built</h2>
            <p>Real BMI began with a simple goal. Most online health tools are packed with pop-ups and slow scripts. Many tools collect your personal body numbers to sell to advertisers. Many do not explain how their math works.</p>
            <p>Bhawanshi Dosi built Real BMI to fix these issues. We use clean code and open math formulas from the WHO and CDC. You get fast, private health checks on any phone or laptop.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Core Engineering Principles: Speed &amp; Privacy</h2>
            <p>Every tool on Real BMI runs locally on your device. We use a zero-retention model:</p>
            <ul>
              <li><strong>Zero Data Kept:</strong> Your height, weight, and age never leave your device. We run no database of user numbers.</li>
              <li><strong>Fast Results:</strong> All math runs in under 16 milliseconds. You get instant updates as you type.</li>
              <li><strong>Works Offline:</strong> Once loaded, our tools work even if your internet connection drops.</li>
            </ul>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Evidence-Based Mathematical Standards</h2>
            <p>Every formula on Real BMI comes from trusted medical studies. These include the World Health Organization (WHO Technical Report 854), the CDC, the Mifflin-St Jeor equation, the Mosteller body surface formula, and the Devine ideal weight formula.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Zero-Retention Client-Side Architecture</h2>
            <p>Unlike commercial wellness apps that store your health numbers, Real BMI calculates everything inside your web browser. No measurements are ever sent over the network or saved to remote disks.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Educational Scope &amp; Medical Disclaimer</h2>
            <p>Real BMI is an educational resource, not a medical clinic or hospital. Our tools provide general awareness. They help you ask good questions when you visit your doctor or dietitian.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Open Equations &amp; Long-Term Commitment</h2>
            <p>We believe health math should be open to all. Each calculator includes step-by-step math and links to original medical papers. We maintain over 920 unit tests to ensure our tools stay accurate. Real BMI remains free for users worldwide.</p>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 shadow-[var(--shadow-soft)] space-y-6">
          <div class="space-y-2">
            <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Creator &amp; Verification</p>
            <h2 class="text-xl sm:text-2xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Independent Platform</h2>
            <p class="text-xs text-[var(--muted-foreground)] font-medium">Maintained personally by Bhawanshi Dosi</p>
          </div>

          <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
            <div>
              <span class="font-bold text-[var(--foreground)] block">Founder &amp; Developer:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi (Software Engineer)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Operational Base:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Banswara, Rajasthan, India</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Verification Method:</span>
              <span class="text-[var(--muted-foreground)] font-medium">920+ Automated Algorithmic Tests</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Clinical Board Claims:</span>
              <span class="text-[var(--muted-foreground)] font-medium">None (Non-Clinical Educational Tool)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Computing Architecture:</span>
              <span class="text-[var(--muted-foreground)] font-medium">100% Client-Side In-Browser Execution</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Data Privacy:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Zero Health Data Retention</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Scientific Baseline:</span>
              <span class="text-[var(--muted-foreground)] font-medium">WHO, CDC &amp; Peer-Reviewed Formulas</span>
            </div>
          </div>

          <div class="space-y-3 pt-4 border-t border-[var(--border)]">
            <a href="/en/sources/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] hover:bg-[var(--accent)]/15 transition text-center">
              Primary Citations (15 Studies) →
            </a>
            <a href="/en/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition text-center">
              Explore Formula Methodology →
            </a>
            <a href="/en/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15 text-center">
              Contact Creator &amp; Support →
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
