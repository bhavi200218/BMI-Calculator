---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="About Real BMI - Founder & Methodological Standards"
    description="Learn about Real BMI, an independent health calculator platform founded by Bhawanshi Dosi. Grounded in peer-reviewed WHO, CDC, and published health standards."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Real BMI",
      "description": "Organizational background, creator credentials, and evidence-based research methodology for Real BMI.",
      "url": "https://realbmicalculator.com/en/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Founder & Lead Developer",
          "description": "Software engineer and creator of Real BMI, specializing in client-side zero-retention health calculation engines.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Founder & Lead Developer",
          "url": "https://realbmicalculator.com/en/about/"
        },
        "knowsAbout": [
          "Body Mass Index (BMI)",
          "Basal Metabolic Rate (BMR)",
          "Total Daily Energy Expenditure (TDEE)",
          "Body Composition Assessment",
          "Anthropometric Reference Guidelines"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="About Real BMI"
      eyebrow="Mission & Evidence-Based Methodology"
      description="Founded and maintained by Bhawanshi Dosi using peer-reviewed literature and published WHO & CDC standards."
      returnUrl="/en/"
      returnLabel="Home"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-8">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> is an individual health calculation and educational platform founded, developed, and maintained by <strong>Bhawanshi Dosi</strong>, based in Banswara, Rajasthan, India. The platform was built to solve a widespread problem online: confusing, privacy-invasive health tools cluttered with ad tracking and opaque math. Real BMI provides transparent, mathematically verifiable calculators that run 100% locally on your device with zero health data retention.</p>
            
            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Evidence-Based Mathematical Standards</h2>
            <p>Every formula on Real BMI is derived directly from peer-reviewed scientific literature and established public health guidelines, including the World Health Organization (WHO Technical Report Series 854), the WHO Western Pacific Region Asian BMI consultation published in <em>The Lancet</em>, Mifflin-St Jeor indirect calorimetry standards, the Mosteller body surface area equation, and the Devine ideal body weight benchmark.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Zero-Retention Client-Side Architecture</h2>
            <p>Unlike commercial wellness applications that collect and store user biometrics, Real BMI executes all mathematical calculations locally in your web browser via client-side JavaScript. No heights, weights, ages, or body measurements are ever transmitted over the network or saved in any database.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Educational Scope &amp; Medical Disclaimer</h2>
            <p>Real BMI is an educational calculation reference, not a licensed medical clinic, hospital, or diagnostic healthcare provider. The calculations provided by our tools are intended to support personal wellness awareness and facilitate informed discussions with qualified physicians, registered dietitians, or certified health professionals.</p>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 shadow-[var(--shadow-soft)] space-y-6">
          <div class="space-y-2">
            <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Creator &amp; Standards</p>
            <h2 class="text-xl sm:text-2xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Independent Platform</h2>
            <p class="text-xs text-[var(--muted-foreground)] font-medium">Maintained personally by Bhawanshi Dosi</p>
          </div>

          <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
            <div>
              <span class="font-bold text-[var(--foreground)] block">Founder &amp; Developer:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi (Software Engineer)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Operational Base:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Banswara, Rajasthan, India</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Computing Architecture:</span>
              <span class="text-[var(--muted-foreground)] font-medium">100% Client-Side In-Browser Execution</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Data Privacy:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Zero Health Data Retention</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Scientific Baseline:</span>
              <span class="text-[var(--muted-foreground)] font-medium">WHO, CDC &amp; Peer-Reviewed Formulas</span>
            </div>
          </div>

          <div class="space-y-3 pt-4 border-t border-[var(--border)]">
            <a href="/en/sources/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] hover:bg-[var(--accent)]/15 transition text-center">
              Primary Citations (15 Studies) →
            </a>
            <a href="/en/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition text-center">
              Explore Formula Methodology →
            </a>
            <a href="/en/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15 text-center">
              Contact Creator &amp; Support →
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
