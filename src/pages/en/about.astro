---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="About Real BMI - Independent Health Calculator Project"
    description="Real BMI is an independent health-calculator website created and maintained by Bhawanshi Dosi, providing reference BMI, BMR, TDEE, and body composition estimates."
>
    <Navbar />
    <PageShell
      title="About Real BMI"
      eyebrow="Independent Calculator Project"
      description="Created and maintained by Bhawanshi Dosi using published formulas and public health reference standards."
      returnUrl="/en"
      returnLabel="Home"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg md:text-xl font-medium opacity-90">
            <p><strong>Real BMI</strong> is an independent health-calculator website created and maintained by <strong>Bhawanshi Dosi</strong>. The calculators use published mathematical equations and publicly available health reference ranges to provide educational estimates.</p>
            <p>Real BMI is not a medical practice, hospital, clinic, or physician-reviewed service. All tools are designed solely for educational, planning, and personal screening purposes.</p>
            <p>We build reference tools using published formulas (such as Mifflin-St Jeor, Harris-Benedict, Boer, Devine, and Mosteller) and public guidelines from organizations like the <strong>WHO</strong> and <strong>CDC</strong>.</p>
            <p>Calculator health inputs are processed locally in your browser and are not sent to our servers. The website may still use anonymous analytics or advertising services.</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Published Equations</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Calculations based on documented mathematical formulas and published population benchmarks.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Privacy-first</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Calculator inputs stay on your device, never stored on servers.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Independent Project</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Built and maintained independently by Bhawanshi Dosi.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Educational Estimates</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Practical references for planning and lifestyle awareness, not clinical diagnosis.</p>
            </div>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)]">
          <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Project Mission</p>
          <h2 class="mt-4 text-3xl font-black text-[var(--foreground)]">Transparent Reference Tools</h2>
          <p class="mt-4 text-base leading-relaxed text-[var(--muted-foreground)]">Real BMI is built to give people accessible mathematical estimates so they can compare their numbers against published reference guidelines.</p>

          <div class="mt-8 space-y-4 text-sm text-[var(--muted-foreground)] leading-relaxed">
            <p><strong>Published methodology:</strong> Calculations use peer-reviewed equations and public reference ranges; outputs are estimates for context.</p>
            <p><strong>Browser privacy:</strong> No personal health data stored or shared.</p>
            <p><strong>Clear boundaries:</strong> Real BMI is an independent website, not a medical clinic or advice service.</p>
          </div>

          <a href="/en/contact" class="mt-8 inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">Contact Bhawanshi</a>
        </aside>
      </div>
    </PageShell>
</Layout>
