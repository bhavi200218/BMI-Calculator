---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="About Real BMI - Founder & Methodological Standards"
    description="Learn about Real BMI, an independent health calculator platform founded by Bhawanshi Dosi. Grounded in peer-reviewed WHO, CDC, and published health standards."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Real BMI",
      "description": "Organizational background, creator credentials, editorial review process, and evidence-based research methodology for Real BMI.",
      "url": "https://realbmicalculator.com/en/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Founder & Lead Developer",
          "description": "Software engineer and creator of Real BMI, specializing in client-side zero-retention health calculation engines.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Founder & Lead Developer",
          "url": "https://realbmicalculator.com/en/about/"
        },
        "knowsAbout": [
          "Body Mass Index (BMI)",
          "Basal Metabolic Rate (BMR)",
          "Total Daily Energy Expenditure (TDEE)",
          "Body Composition Assessment",
          "Anthropometric Reference Guidelines"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="About Real BMI"
      eyebrow="Mission & Evidence-Based Methodology"
      description="Founded and maintained by Bhawanshi Dosi using peer-reviewed literature and published WHO & CDC standards."
      returnUrl="/en/"
      returnLabel="Home"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> is an individual health calculation and educational platform founded, developed, and maintained by <strong>Bhawanshi Dosi</strong>, based in Banswara, Rajasthan, India. The platform was built to solve a widespread problem online: confusing, privacy-invasive health tools cluttered with ad tracking and opaque math. Real BMI provides transparent, mathematically verifiable calculators that run 100% locally on your device with zero health data retention.</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/en/sources/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] hover:bg-[var(--accent)]/15 transition">
              Primary Research Citations Matrix (15 Studies) →
            </a>
            <a href="/en/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              Explore Formula Methodology →
            </a>
            <a href="/en/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              Contact Editorial Desk
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
