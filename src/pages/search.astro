---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageShell from '../components/PageShell.astro';

const query = Astro.url.searchParams.get('q') || '';
const sanitizedQuery = query.trim();
const pageTitle = sanitizedQuery ? `Search results for “${sanitizedQuery}” | Real BMI` : 'Search Real BMI | Health Calculator Search';
const pageDescription = 'Find BMI, BMR, TDEE, and body composition tools across Real BMI.';
---

<Layout title={pageTitle} description={pageDescription} robots="noindex, follow">
  <Navbar />
  <PageShell
    title="Search Real BMI"
    eyebrow="Calculator search"
    description="Locate the right BMI, BMR, TDEE, body fat, and wellness tools across our site."
    returnUrl="/en/"
    returnLabel="Home"
  >
    <div class="space-y-8">
      <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
        <p class="text-xs uppercase tracking-[0.28em] font-semibold text-[var(--accent)]">Search query</p>
        <p class="mt-3 text-lg font-semibold text-[var(--foreground)]">{sanitizedQuery || 'No query entered'}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/en/bmi-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">BMI Calculator</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Instant BMI results, health categories, and global screening.</p>
        </a>
        <a href="/en/tdee-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">TDEE Calculator</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Find your total daily energy needs for maintenance, loss, or gain.</p>
        </a>
        <a href="/en/body-fat-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Body Fat</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Assess body composition with a professional-style estimate.</p>
        </a>
        <a href="/en/bmr-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">BMR Calculator</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Calculate your Basal Metabolic Rate using the Mifflin-St Jeor formula for resting calorie burn.</p>
        </a>
        <a href="/en/ideal-weight-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Ideal Weight Calculator</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Compare healthy target body weights across Devine, Robinson, Miller, and Hamwi equations.</p>
        </a>
        <a href="/en/editorial-policy/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Editorial Policy</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Learn how Real BMI ensures transparent, evidence-based, and trustworthy health content.</p>
        </a>
        <a href="/en/water-intake-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Water Intake Calculator</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Determine recommended daily hydration volumes based on body weight, climate, and exercise duration.</p>
        </a>
        <a href="/en/macro-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Macro Calculator</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Calculate personalized daily macronutrient ratios (protein, carbohydrates, dietary fats) for body recomposition.</p>
        </a>
        <a href="/en/lean-body-mass-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Lean Body Mass</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Calculate muscle and fat-free mass using Boer, James, and Hume comparative anthropometric equations.</p>
        </a>
        <a href="/en/karvonen-heart-rate-calculator/" class="block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 text-[var(--foreground)] hover:border-[var(--accent)] transition-all">
          <p class="text-sm uppercase tracking-[0.2em] font-black">Heart Rate Zones</p>
          <p class="mt-3 text-base text-[var(--muted-foreground)]">Determine cardiovascular training intensity zones (Fat Burn, Aerobic, Threshold) using Heart Rate Reserve (HRR).</p>
        </a>
      </div>

      <!-- Search Tips & Guidance -->
      <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 space-y-4">
        <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">Search Tips & Navigation Guide</h2>
        <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed">
          Looking for a specific health metric? You can search for calculator names (e.g., "BMR", "TDEE", "Body Fat", "WHR", "BSA"), specific equations (such as "Mifflin-St Jeor", "Oxford 2.5", or "Epley 1RM"), or public health standards like "WHO BMI categories" or "Asian BMI Cutoffs".
        </p>
        <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed">
          All computations run directly in your browser with complete privacy. No personal health information is uploaded or stored.
        </p>
      </div>
    </div>
  </PageShell>
</Layout>
