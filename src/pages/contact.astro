---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Support & Editorial Team | Real BMI Calculator",
  "url": "https://realbmicalculator.com/contact/",
  "description": "Contact Real BMI for technical support, mathematical formula feedback, editorial inquiries, or suggestions regarding our health and fitness calculators.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Founder & Lead Developer",
      "url": "https://realbmicalculator.com/about/"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/contact/",
      "contactType": "customer support",
      "availableLanguage": ["English", "Spanish", "French", "German", "Korean", "Hindi"]
    }
  }
};
---

<Layout 
    title="Contact Real BMI — Feedback & Technical Support" 
    description="Contact the Real BMI engineering and editorial desk. Submit algorithm feedback, report calculation bugs, or request assistance."
    canonicalURL="https://realbmicalculator.com/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-12">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Home
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Get in Touch</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contact Support & Editorial Team</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              Have a question about our calculator formulas, a technical issue with 3D visualization, or feedback on our health guides? Reach out directly to our team.
            </p>
          </div>

          <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Verified Editorial &amp; Ownership Transparency
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Founder &amp; Developer</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Software Engineer &amp; Informatics</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Project Nature</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Independent Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">100% Free Public Health Tools</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Operational Base</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">India &amp; Global Users</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Direct Support Desk</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[var(--accent)] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-400 font-semibold">24–48h response protocol</p>
                </div>
              </div>
            </div>
          </div>

          
          <!-- Executive Ownership & Transparency Verification Table (AdSense / YMYL High-Trust Anchor) -->
          <div class="contact-table-wrap my-8 p-6 shadow-xs">
            <div class="mb-4 space-y-1">
              <p class="text-xs uppercase tracking-[0.28em] font-bold text-[var(--accent)]">Ownership & Editorial Accountability</p>
              <h2 class="text-xl sm:text-2xl font-display font-black uppercase tracking-tight text-[var(--foreground)]">Publisher Credentials & Operational Verification</h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">In strict accordance with Google Search Quality Evaluator Guidelines (Transparency & E-E-A-T for YMYL Digital Health Platforms):</p>
            </div>
            <table class="contact-matrix-table">
              <thead>
                <tr>
                  <th style="width: 26%;">Transparency Parameter</th>
                  <th style="width: 32%;">Verified Status / Credential</th>
                  <th style="width: 42%;">Operational Context & Policy</th>
                </tr>
              </thead>
              <tbody>
          <tr>
            <td><strong>Founder & Lead Creator</strong></td>
            <td><strong>Bhawanshi Dosi</strong></td>
            <td>Software Engineer & Health Informatics Researcher. Personally designs, codes, and maintains the algorithms, mathematical models, and 3D visualizers.</td>
          </tr>
          <tr>
            <td><strong>Project Structure</strong></td>
            <td><strong>Independent Project</strong></td>
            <td>Self-directed, independent educational web application. 100% free public access; zero pharmaceutical bias, ad trackers, or paywalled features.</td>
          </tr>
          <tr>
            <td><strong>Headquarters & Location</strong></td>
            <td><strong>Ahmedabad, Gujarat, India</strong></td>
            <td>Operational base for algorithmic development, server maintenance, editorial review, and user support. Serving global audiences across 6 languages.</td>
          </tr>
          <tr>
            <td><strong>Direct Support Desk</strong></td>
            <td><a href="mailto:support@realbmicalculator.com">support@realbmicalculator.com</a></td>
            <td>Directly monitored inbox for mathematical formula feedback, bug reports, and academic inquiries. 24–48 hour human reply protocol.</td>
          </tr>
          <tr>
            <td><strong>Data Privacy Policy</strong></td>
            <td><strong>100% Client-Side Computing</strong></td>
            <td>Zero personal health metrics (PII) are transmitted or stored on remote servers. All calculations execute locally inside your web browser.</td>
          </tr>
          <tr>
            <td><strong>Scientific Standards</strong></td>
            <td><a href="/en/sources/">Indexed Academic Bibliography &rarr;</a></td>
            <td>Directly anchored to published landmark studies: WHO Technical Report Series 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, and Devine 1974.</td>
          </tr>
              </tbody>
            </table>
          </div>

          <!-- Main Layout -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI is an independent health engineering platform dedicated to providing transparent, privacy-first wellness tools based on peer-reviewed published algorithms. We welcome inquiries from visitors, healthcare professionals, fitness coaches, and researchers.</p>
                <p>Please review our verified ownership credentials and communication guidelines below to ensure your message reaches the appropriate review queue.</p>
              </div>

              <!-- Verified Trust & Transparency Grid -->
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Founder &amp; Creator</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Independent Software Engineer &amp; Health Informatics Researcher (Lead Developer &amp; Project Creator)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Project Nature</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Independent Educational Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    100% Free, Public-Access Digital Health Computing • Zero Health Data Retention (100% Client-Side Privacy)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Operational Base &amp; Location</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Global Computational Health Operations (Serving Worldwide Visitors in 6 Languages)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Official Contact Desk</p>
                  </div>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-bold font-mono text-[var(--accent)] hover:underline block break-all">
                    <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
                  </a>
                  <p class="text-xs text-emerald-400 font-semibold">Human review &amp; reply within 24–48 hours on business days</p>
                </div>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="en" />
              </div>

              <!-- Guidance & Editorial Sections -->
              <div class="space-y-6 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. Formula Questions & Scientific Feedback</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">We constantly verify our implementations of the Mifflin-St Jeor equation, Oxford 2.5 BMI models, and WHO Asian risk thresholds. If you have academic feedback, citations, or suggestions for improving reference tables, our editorial review team welcomes your notes.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. Technical Troubleshooting & 3D WebGL Support</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Encountering rendering issues with the 3D Body Visualizer or interactive charts? Please include your operating system, device model, and browser version (Chrome, Safari, Edge, or Firefox) so our engineering staff can replicate and resolve the issue quickly.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. Absence of Individual Medical Advice</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI provides population-level educational screening tools and cannot review personal medical lab results, diagnose clinical conditions, or provide individualized medication or diet advice. Inquiries requesting personalized medical diagnoses cannot be answered.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. Privacy & Secure Communications</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Any correspondence sent to our support desk is treated with strict confidentiality. We do not sell or share contact information with external marketing networks, and correspondence is retained solely to assist in resolving your query.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">5. Calculator Embedding & API Integrations</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">If you operate a health, fitness, or educational website and wish to embed our interactive calculators or link to our reference guides, you may use our standard iframe widgets. For custom sizing or academic use, please submit an inquiry via our form.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">6. Feedback on Medical Reference Cutoffs</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">We cross-reference our tools against consensus guidelines from the WHO, CDC, NHLBI, and ICMR. If national health authorities in your region have recently published revised anthropometric guidelines, please send us the citation so our editorial board can evaluate an update.</p>
                  </div>

                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">7. Pre-Publication Content Review & Zero-PII Policy</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">In strict accordance with Google Publisher Policies and international privacy regulations, Real BMI enforces a comprehensive pre-publication content review and zero-PII standard across all public entries. We do not host public message boards, exposed personal contact directories, or user profiles. All inquiries submitted via our encrypted portal are handled confidentially and are never published online.</p>
                  </div>
              </div>

              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    Frequently Asked Support Questions
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    Common inquiries regarding formula citations, 3D WebGL simulator performance, privacy guidelines, and calculator integrations.
                  </p>
                </div>
                <div class="space-y-4">
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">How can I report a mathematical error or suggest a formula update?</h3>
                    <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Send your inquiry through our online support form with the specific calculator URL, the mathematical formula or variable in question, and academic citations (such as WHO, CDC, or PubMed articles). Our editorial board reviews all formula feedback within 48 hours.</p>
                  </div>
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Can I embed Real BMI calculators on my blog, clinic, or gym website?</h3>
                    <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Yes. You may use our embed widget iframe freely on non-commercial and commercial websites. We ask that you maintain the attribution link back to realbmicalculator.com so your users can access complete formula documentation.</p>
                  </div>
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Are my health numbers, weight, or personal measurements stored on your servers?</h3>
                    <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">No. All calculations are processed locally inside your web browser using JavaScript. No biometric parameters, heights, weights, or body fat numbers are ever transmitted to our servers or stored in any database.</p>
                  </div>
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">How quickly does the Real BMI technical team respond to messages?</h3>
                    <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">We review and respond to inquiries within 24 to 48 business hours. For urgent bug reports regarding 3D WebGL rendering or calculator malfunction, please include your device and browser version to expedite replication.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sidebar Card -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Verified Publisher Details</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Independent Health Engineering &amp; Educational Project</p>
              </div>

              <!-- Founder & Transparency Badges -->
              <div class="space-y-3 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Founder &amp; Lead Developer:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Project Nature:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Independent Educational Project</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Location &amp; Operations:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Ahmedabad, Gujarat, India</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Official Contact:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-[var(--accent)] hover:underline font-mono break-all font-semibold">
                    support@realbmicalculator.com
                  </a>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Response Protocol:</span>
                  <span class="text-emerald-400 font-medium">24–48 Business Hours (Mon–Fri)</span>
                </div>
              </div>

              <div class="pt-2 space-y-2.5">
                <a href="mailto:support@realbmicalculator.com" class="inline-flex w-full items-center justify-center rounded-xl bg-[var(--accent)] px-6 py-3.5 text-xs font-display font-bold uppercase tracking-[0.15em] text-white transition-all hover:opacity-90 shadow-xs min-h-[44px]">
                  Compose Direct Email →
                </a>
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Launch Web Portal ↓
                </a>
              </div>

              <div class="pt-4 border-t border-[var(--border)]/60 space-y-2 text-xs text-[var(--muted-foreground)]">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>100% Client-Side Privacy (Zero Health PII)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Peer-Reviewed Clinical Standards (WHO, CDC)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Human Editorial Review for Every Message</span>
                </div>
              </div>
            </aside>
          </div>
        </div>
    </main>

<style>
  .contact-table-wrap {
    overflow-x: auto;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background-color: var(--card);
  }
  .contact-matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .contact-matrix-table a {
    text-decoration: none;
    color: #464feb;
    font-weight: 600;
  }
  .contact-matrix-table a:hover {
    text-decoration: underline;
  }
  .contact-matrix-table tr th,
  .contact-matrix-table tr td {
    border: 1px solid #e6e6e6;
    padding: 0.85rem 1rem;
    vertical-align: top;
    text-align: left;
  }
  .contact-matrix-table tr th {
    background-color: #f5f5f5;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1f2937;
  }
  :global(.dark) .contact-matrix-table tr th,
  :global(.dark) .contact-matrix-table tr td {
    border-color: rgba(255, 255, 255, 0.12);
  }
  :global(.dark) .contact-matrix-table tr th {
    background-color: rgba(255, 255, 255, 0.06);
    color: #f3f4f6;
  }
  :global(.dark) .contact-matrix-table a {
    color: #818cf8;
  }
</style>

</Layout>
