---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto con la Creadora y Soporte | Real BMI Calculator",
  "url": "https://realbmicalculator.com/es/contact/",
  "description": "Póngase en contacto con Real BMI para soporte técnico, comentarios sobre fórmulas matemáticas, consultas editoriales o sugerencias sobre nuestras calculadoras.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Software Engineer & Lead Developer",
      "url": "https://realbmicalculator.com/es/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Banswara",
      "addressRegion": "Rajasthan",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/es/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="Contacto con la Creadora y Soporte | Real BMI Calculator" 
    description="Póngase en contacto con Real BMI para soporte técnico, comentarios sobre fórmulas matemáticas, consultas editoriales o sugerencias sobre nuestras calculadoras."
    canonicalURL="https://realbmicalculator.com/es/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-20 md:pt-24 pb-16 px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto space-y-8">
          <!-- Header block -->
          <div class="space-y-3">
            <a href="/es/" class="inline-flex items-center gap-2 min-h-[44px] px-3 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Inicio
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Atención y Consultas</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contacto con la Creadora y Soporte</h1>
            <p class="text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)] font-medium max-w-4xl">
              ¿Tiene preguntas sobre las fórmulas de las calculadoras, incidencias técnicas con la visualización 3D o sugerencias sobre nuestras guías de salud? Comuníquese directamente con Bhawanshi Dosi.
            </p>
          </div>

          <!-- Creator & Project Identity Card (Clean, Open, Modern) -->
          <div class="rounded-2xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-6 sm:p-7 space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Sitio Web Individual y Transparencia
              </div>
              <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#464feb] hover:underline">
                <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                Perfil de LinkedIn ↗
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Fundadora y Desarrolladora Principal</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Bhawanshi Dosi</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Ingeniera de Software y Administradora Web</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Sede y Operaciones</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Banswara, Rajastán, India</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Disponible a nivel global (6 idiomas)</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Arquitectura de la Plataforma</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Proyecto Educativo Independiente</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">23 Calculadoras de Salud Gratuitas</p>
              </div>
            </div>
          </div>

          <!-- Interactive Contact Form Component -->
          <div id="contact-desk">
            <ContactForm lang="es" />
          </div>

          <!-- Communication Guidelines (3 Clear Cards, No Line Dividers) -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                Directrices de Comunicación y Límites Editoriales
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                Revise el alcance de nuestro soporte antes de enviar una consulta a nuestro buzón.
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  1. Sin Asesoramiento Médico Individual
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Real BMI proporciona herramientas educativas de evaluación poblacional basadas en fórmulas publicadas. No evaluamos análisis clínicos, no diagnosticamos enfermedades ni prescribimos tratamientos. Consulte a un médico colegiado para atención médica personal.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  2. Correo Directo y Privado (Sin UGC Público)
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Para proteger la privacidad y evitar afirmaciones médicas no verificadas o spam, Real BMI no dispone de comentarios públicos, foros ni reseñas abiertas. Todos los mensajes son comunicaciones privadas revisadas directamente por la creadora.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  3. Cero Retención de Datos de Salud
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Toda la lógica de cálculo se ejecuta exclusivamente en su navegador mediante JavaScript del lado del cliente. Sus mediciones biológicas, peso o estatura nunca se transmiten a servidores ni se guardan en bases de datos.
                </p>
              </div>
            </div>
          </div>

          <!-- Support FAQ Section -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                Preguntas Frecuentes de Soporte
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                Consultas habituales sobre citas científicas, simulador 3D WebGL, directrices de privacidad e integraciones.
              </p>
            </div>
            <div class="space-y-3.5">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  ¿Cómo puedo reportar un error de cálculo o sugerir una fórmula?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Envíe su consulta directamente a nuestro correo de soporte (<!--email_off-->support@realbmicalculator.com<!--/email_off-->) con la URL de la calculadora, la variable en cuestión y las citas académicas (como artículos de PubMed, OMS o CDC). Bhawanshi Dosi revisa todos los comentarios directamente.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  ¿Puedo insertar calculadoras de Real BMI en mi sitio web o blog?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Sí. Puede utilizar nuestro widget iFrame libremente en páginas educativas o comerciales. Le solicitamos mantener el enlace de atribución hacia realbmicalculator.com para que sus lectores puedan consultar la metodología completa.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  ¿Se almacenan mis mediciones o peso en sus servidores?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  No. Todos los cálculos se procesan localmente en su navegador mediante JavaScript. Ningún parámetro biométrico o peso se transmite a nuestros servidores ni se almacena en bases de datos.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  ¿En cuánto tiempo responderá Real BMI?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Los mensajes son revisados por Bhawanshi Dosi y generalmente se responden en un plazo de 24 a 48 horas hábiles. Para reportes de errores en la visualización 3D, incluya su modelo de dispositivo y navegador.
                </p>
              </div>
            </div>
          </div>

          <!-- Policy & Trust Links Strip (No Line Dividers) -->
          <div class="pt-2">
            <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--muted)]/20 p-5 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">
                Estándares Editoriales y de Gobernanza
              </span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-medium">
                <a href="/es/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Política Editorial y Metodología</span>
                  <span>&rarr;</span>
                </a>
                <a href="/es/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>15 Referencias Científicas</span>
                  <span>&rarr;</span>
                </a>
                <a href="/es/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Aviso Médico Legal</span>
                  <span>&rarr;</span>
                </a>
                <a href="/es/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Política de Privacidad</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
    </main>
</Layout>
