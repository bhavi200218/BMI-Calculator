---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto y Equipo Editorial | Real BMI Calculator",
  "url": "https://realbmicalculator.com/es/contact/",
  "description": "Póngase en contacto con Real BMI para soporte técnico, comentarios sobre fórmulas matemáticas, consultas editoriales o sugerencias sobre nuestras calculadoras.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Ingeniero de Software y Desarrollador",
      "url": "https://realbmicalculator.com/es/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/es/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="Contacto | Real BMI Calculator" 
    description="Póngase en contacto con Real BMI para soporte técnico, comentarios sobre fórmulas matemáticas, consultas editoriales o sugerencias sobre nuestras calculadoras."
    canonicalURL="https://realbmicalculator.com/es/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-10">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/es/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Inicio
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Contacto</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contacto y Equipo Editorial</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              ¿Tiene preguntas sobre las fórmulas de las calculadoras, problemas técnicos con la visualización 3D o comentarios sobre nuestras guías de salud? Contáctenos directamente.
            </p>
          </div>

          <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Transparencia Editorial y del Proyecto
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Fundador y Creador</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Ingeniero de Software y Desarrollador</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Naturaleza del Proyecto</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Proyecto Independiente</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Proyecto Independiente de Calculadoras de Salud</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Sede y Operaciones</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">India y Acceso Global</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Correo de Soporte Oficial</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">Respuesta en 24–48 horas</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Red Profesional</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    Perfil de LinkedIn ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Identidad Verificada del Creador</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Layout (Clean 2-Column: Form & Guidance on Left, Support Desk on Right) -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start pt-2">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI es un proyecto independiente de calculadoras de salud dedicado a ofrecer herramientas gratuitas, centradas en la privacidad y basadas en fórmulas científicas de la OMS y los CDC.</p>
                <p>Consulte las siguientes pautas de comunicación o utilice el formulario a continuación para enviar su mensaje directamente a nuestro equipo.</p>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="es" />
              </div>

              <!-- Guidance & Editorial Sections (Consolidated, Non-Redundant) -->
              <div class="space-y-4 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. Preguntas sobre Fórmulas y Comentarios Académicos</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Verificamos continuamente nuestras implementaciones de modelos matemáticos publicados como la ecuación de Mifflin-St Jeor, los modelos de Oxford 2.5 y los umbrales de riesgo asiático de la OMS. Si tiene citas académicas o sugerencias para mejorar las tablas de referencia, nuestro equipo editorial agradece sus notas.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. Soporte Técnico y Visualizador 3D WebGL</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">¿Tiene problemas con el visualizador corporal 3D o los gráficos interactivos? Indique su sistema operativo, modelo de dispositivo y versión del navegador (Chrome, Safari, Edge o Firefox) para que nuestro equipo técnico pueda replicar y resolver la incidencia con rapidez.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. Ausencia de Asesoramiento Médico Individual</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI proporciona herramientas educativas de cribado poblacional y no puede interpretar análisis médicos personales, diagnosticar afecciones clínicas ni recomendar medicamentos o planes dietéticos individuales. Las solicitudes de diagnósticos personalizados no serán respondidas.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. Calidad del Contenido y Protección de la Privacidad (Sin Datos Personales Almacenados)</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Para proteger la privacidad y mantener la calidad del contenido, Real BMI aplica una rigurosa norma de revisión que garantiza que ninguna información médica personal se almacene jamás en registros públicos. No disponemos de foros públicos ni perfiles de usuario. Todas las consultas enviadas mediante nuestro formulario se tratan de manera confidencial.</p>
                  </div>
                
              </div>

              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    Preguntas Frecuentes de Soporte
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    Consultas habituales sobre fórmulas, rendimiento del simulador 3D WebGL, privacidad e integración de calculadoras.
                  </p>
                </div>
                <div class="space-y-4">
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Cómo puedo reportar un error de cálculo o sugerir una actualización?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Envíe su consulta mediante nuestro formulario indicando la URL de la calculadora, la fórmula matemática o variable en cuestión y las fuentes académicas (OMS, CDC o PubMed). Nuestro equipo editorial revisa las observaciones en 48 horas.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Puedo incrustar las calculadoras de Real BMI en mi sitio web o clínica?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Sí. Puede utilizar nuestro widget iframe libremente en sitios comerciales y no comerciales, manteniendo el enlace de atribución hacia realbmicalculator.com para que los usuarios consulten la documentación metodológica.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Se guardan mis medidas de peso o valores de salud en sus servidores?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">No. Todos los cálculos se procesan localmente en su navegador mediante JavaScript. Ningún dato biométrico, altura, peso o porcentaje de grasa se transmite a servidores ni se almacena en bases de datos.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Con qué rapidez responde el equipo técnico de Real BMI?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Revisamos y respondemos las consultas en un plazo de 24 a 48 horas hábiles. Para incidencias urgentes sobre WebGL 3D, incluya su dispositivo y navegador para acelerar la comprobación.</p>
                    </div>
                  
                </div>
              </div>
            </div>

            <!-- Sidebar Card (Streamlined, Non-Redundant Support Desk) -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Proyecto y Soporte</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Proyecto Independiente de Calculadoras de Salud</p>
              </div>

              <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Sede Operativa:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Ahmedabad, Gujarat, India</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Correo de Soporte:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-sm font-bold font-mono text-[#464feb] hover:underline block break-all mt-0.5">
                    support@realbmicalculator.com
                  </a>
                  <p class="text-[11px] text-emerald-500 font-semibold mt-0.5">Atención humana en 24–48 horas laborables</p>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Privacidad:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">100% Computación en el Navegador (Sin datos de salud almacenados)</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Alcance del Proyecto:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">25 Calculadoras Gratuitas y Estándares de Referencia</span>
                </div>
              </div>

              <div class="space-y-2 pt-4 border-t border-[var(--border)]">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">Políticas y Transparencia:</span>
                <div class="flex flex-col gap-2 text-xs font-medium">
                  <a href="/es/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>Política Editorial y Metodología</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/es/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>15 Citas Científicas Primarias</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/es/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>Aviso Médico</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/es/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>Política de Privacidad</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>

              <div class="pt-4 border-t border-[var(--border)]">
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Send Message
                </a>
              </div>
            </aside>
          </div>
        </div>
    </main>
</Layout>
