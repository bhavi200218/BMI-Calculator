---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contáctanos | Real BMI Calculator",
  "url": "https://realbmicalculator.com/es/contact/",
  "description": "Contáctenos para asistencia técnica, comentarios sobre fórmulas matemáticas, consultas editoriales o dudas sobre nuestras calculadoras de salud y bienestar.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Founder & Lead Developer",
      "url": "https://realbmicalculator.com/es/about/"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/es/contact/",
      "contactType": "customer support",
      "availableLanguage": ["English", "Spanish", "French", "German", "Korean", "Hindi"]
    }
  }
};
---

<Layout title="Contáctanos | Real BMI Calculator" description="Contáctenos para asistencia técnica, comentarios sobre fórmulas matemáticas, consultas editoriales o dudas sobre nuestras calculadoras de salud y bienestar.">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-12">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/es/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Home
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Ponte en Contacto</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contacto y Equipo Editorial</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              ¿Tiene preguntas sobre las fórmulas de nuestras calculadoras, incidencias técnicas con el visualizador 3D o sugerencias sobre nuestras guías de salud? Comuníquese con nuestro equipo.
            </p>
          </div>

          <!-- Main Layout -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI es un proyecto independiente de ingeniería y educación para la salud dedicado a ofrecer herramientas gratuitas centradas en la privacidad y basadas en fórmulas científicas de la OMS y los CDC.</p>
                <p>Consulte las credenciales de autoría y las siguientes pautas para dirigir su consulta con total transparencia.</p>
              </div>

              <!-- Verified Trust & Transparency Grid -->
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Fundador y Creador</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Ingeniero de Software Independiente e Investigador de Informática Biomédica (Lead Developer)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Naturaleza del Proyecto</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Independent Educational Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    100% gratuito y de libre acceso • Cero almacenamiento de datos (100% Client-Side Privacy)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Ubicación y Operaciones</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Operaciones globales de informática en salud (Disponible en 6 idiomas en todo el mundo)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Canal de Contacto Oficial</p>
                  </div>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-bold font-mono text-[var(--accent)] hover:underline block break-all">
                    <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
                  </a>
                  <p class="text-xs text-emerald-400 font-semibold">Respuesta humana personalizada en 24–48 horas laborables</p>
                </div>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="es" />
              </div>

              <!-- Guidance & Editorial Sections -->
              <div class="space-y-6 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. Consultas sobre Fórmulas y Metodología Científica</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Revisamos continuamente nuestras implementaciones de las fórmulas de Mifflin-St Jeor, el IMC exponencial de Oxford y los umbrales de la OMS para poblaciones asiáticas. Si tiene observaciones metodológicas o referencias clínicas que compartir, nuestro equipo editorial las recibirá con agrado.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. Soporte Técnico y Visualizador 3D WebGL</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">¿Ha detectado un problema de rendimiento en el Visualizador Corporal 3D o en las tablas dinámicas? Indíquenos su sistema operativo, modelo de dispositivo y navegador (Chrome, Safari, Edge o Firefox) para reproducir y corregir la incidencia con rapidez.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. Límite de Asesoramiento Médico Individual</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI es una herramienta exclusivamente educativa y de concienciación general. No podemos interpretar análisis clínicos de laboratorio, diagnosticar patologías individuales ni prescribir pautas farmacológicas o dietéticas personalizadas.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. Confidencialidad en las Comunicaciones</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Cualquier mensaje enviado a nuestro buzón de soporte se trata con estricta confidencialidad. No compartimos ni comercializamos direcciones de correo con terceros y los mensajes se conservan únicamente para atender su consulta.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">5. Integración de Widgets y Calculadoras Externas</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Si administra un portal de salud, nutrición o educación y desea integrar nuestras herramientas o enlazar nuestras tablas de referencia, puede utilizar nuestros widgets estándar vía iframe. Para formatos adaptados o uso académico, escríbanos detallando su proyecto.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">6. Sugerencias sobre Guías Epidemiológicas Nacionales</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Contrastamos nuestros algoritmos con los consensos de la OMS, CDC, NHLBI e ICMR. Si las autoridades de salud pública de su país han publicado directrices antropométricas actualizadas, remítanos la cita científica para que nuestro equipo editorial estudie su incorporación.</p>
                  </div>
                
              </div>
            </div>

            <!-- Sidebar Card -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Transparencia Editorial</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Proyecto independiente de informática en salud</p>
              </div>

              <!-- Founder & Transparency Badges -->
              <div class="space-y-3 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Fundador y Desarrollador:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Tipo de Proyecto:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Independent Educational Project</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Ubicación y Operaciones:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Ahmedabad, Gujarat, India</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Contacto Oficial:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-[var(--accent)] hover:underline font-mono break-all font-semibold">
                    support@realbmicalculator.com
                  </a>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Tiempo de Respuesta:</span>
                  <span class="text-emerald-400 font-medium">24–48 horas laborables</span>
                </div>
              </div>

              <div class="pt-2 space-y-2.5">
                <a href="mailto:support@realbmicalculator.com" class="inline-flex w-full items-center justify-center rounded-xl bg-[var(--accent)] px-6 py-3.5 text-xs font-display font-bold uppercase tracking-[0.15em] text-white transition-all hover:opacity-90 shadow-xs min-h-[44px]">
                  Enviar Correo Directo →
                </a>
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Abrir Formulario Web ↓
                </a>
              </div>

              <div class="pt-4 border-t border-[var(--border)]/60 space-y-2 text-xs text-[var(--muted-foreground)]">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>100% Privacidad en el Navegador (Sin Datos en Servidores)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Estándares Clínicos Validados (OMS, CDC)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Revisión Humana en Cada Comunicación</span>
                </div>
              </div>
            </aside>
          </div>
        </div>
    
              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    Preguntas Frecuentes de Soporte y Contacto
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    Respuestas a consultas frecuentes sobre fuentes científicas, rendimiento del simulador 3D WebGL, privacidad e integración de widgets.
                  </p>
                </div>
                <div class="space-y-4">
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Cómo puedo reportar un error de cálculo o sugerir una actualización de fórmula?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Envíe su consulta mediante el formulario de soporte indicando la URL de la calculadora afectada, el parámetro en cuestión y las referencias académicas pertinentes (como guías de la OMS o CDC). Nuestro comité editorial revisa las sugerencias científicas periódicamente.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Puedo insertar las calculadoras de Real BMI en mi propio sitio web o blog?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Sí. Puede utilizar nuestros widgets iframe de forma totalmente gratuita en páginas educativas, blogs de fitness y sitios de nutrición, manteniendo el enlace de atribución original para que sus usuarios puedan consultar la metodología científica completa.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Se guardan mis medidas corporales o resultados de salud en sus servidores?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">No. Toda la computación se ejecuta localmente en el motor JavaScript de su navegador. Ningún dato sobre su peso, estatura, edad o porcentaje de grasa corporal se almacena ni se transmite a servidores externos.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">¿Cuánto tarda el equipo técnico en responder a las consultas?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Normalmente respondemos en un plazo de 24 a 48 horas laborables. Si reporta un problema con el visor 3D o la interfaz interactiva, indique su sistema operativo y navegador para agilizar la asistencia.</p>
                    </div>
                  
                </div>
              </div>
  
    </main>
</Layout>
