---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Sobre Real BMI - Fundadora y Estándares Metodológicos"
    description="Conozca Real BMI, plataforma individual de calculadoras de salud fundada y mantenida por Bhawanshi Dosi. Fórmulas de la OMS y los CDC."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Sobre Real BMI",
      "description": "Antecedentes organizacionales, metodología de cálculo y protocolo de revisión editorial de Real BMI.",
      "url": "https://realbmicalculator.com/es/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Fundadora y Desarrolladora Principal",
          "description": "Ingeniera de software y creadora de Real BMI, especializada en motores de cálculo de salud en el navegador sin retención de datos.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
        "@type": "Person",
        "name": "Bhawanshi Dosi",
        "jobTitle": "Founder & Lead Developer",
        "url": "https://realbmicalculator.com/es/about/"
      },
        "knowsAbout": [
          "Índice de Masa Corporal (IMC)",
          "Tasa Metabólica Basal (TMB)",
          "Gasto Energético Total Diario (TDEE)",
          "Composición Corporal",
          "Pautas Antropométricas Oficiales"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Sobre Real BMI"
      eyebrow="Misión y Metodología Basada en Evidencia"
      description="Fundada y desarrollada por Bhawanshi Dosi utilizando literatura científica y estándares de la OMS y los CDC."
      returnUrl="/es/"
      returnLabel="Inicio"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> es una plataforma individual de cálculo de salud y referencia antropométrica fundada, desarrollada y administrada por <strong>Bhawanshi Dosi</strong> (Banswara, Rajastán, India). El proyecto nació para resolver un problema crítico en la web de la salud: herramientas saturadas de rastreo invasivo, publicidad engañosa y fórmulas opacas sin respaldo documental. Real BMI ofrece calculadoras transparentes y verificables que se ejecutan 100 % en el navegador local, con cero almacenamiento de datos de salud.</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/es/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              Consultar Metodología y Fórmulas →
            </a>
            <a href="/es/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              Contactar a la Desarrolladora
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
