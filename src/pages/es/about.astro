---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Sobre Real BMI - Fundadora y Normas Metodológicas"
    description="Conozca Real BMI, una plataforma independiente de calculadoras de salud fundada y programada por Bhawanshi Dosi, basada en los estándares revisados por pares de la OMS y los CDC."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Sobre Real BMI",
      "description": "Antecedentes organizativos, credenciales de la creadora y metodología de investigación basada en evidencia de Real BMI.",
      "url": "https://realbmicalculator.com/es/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Fundadora y Desarrolladora Principal",
          "description": "Ingeniera de software y creadora de Real BMI, especializada en motores de cálculo biométrico del lado del cliente sin retención de datos.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Fundadora y Desarrolladora Principal",
          "url": "https://realbmicalculator.com/es/about/"
        },
        "knowsAbout": [
          "Índice de Masa Corporal (IMC)",
          "Tasa Metabólica Basal (BMR)",
          "Gasto Energético Diario Total (TDEE)",
          "Composición Corporal",
          "Pautas de Referencia Antropométrica",
          "Pruebas Algorítmicas Automatizadas"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Sobre Real BMI"
      eyebrow="Misión y Metodología Basada en Evidencia"
      description="Fundada, desarrollada y administrada por Bhawanshi Dosi utilizando literatura científica y estándares de la OMS y los CDC."
      returnUrl="/es/"
      returnLabel="Inicio"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-8">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> es una plataforma individual de cálculo de salud y educación antropométrica fundada, desarrollada y administrada por <strong>Bhawanshi Dosi</strong>, una ingeniera de software establecida en Banswara, Rajastán, India. El proyecto nació para resolver un problema crítico en la web: herramientas de salud confusas, saturadas de rastreo invasivo, publicidad engañosa y fórmulas matemáticas opacas. Real BMI ofrece calculadoras transparentes y verificables que se ejecutan 100 % en el navegador local, con cero almacenamiento de datos de salud.</p>
            
            <!-- Creator Profile Card -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-2xl shadow-md shrink-0">
                BD
              </div>
              <div class="space-y-2 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl font-bold text-[var(--foreground)]">Bhawanshi Dosi</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">Fundadora e Ingeniera de Software</span>
                </div>
                <p class="text-xs font-medium text-[var(--accent)]">Banswara, Rajastán, India &bull; Creadora y Administradora Web</p>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Ingeniera de software especializada en motores computacionales del lado del cliente sin retención de datos. Bhawanshi investiga, diseña, programa y mantiene personalmente las 23 calculadoras de Real BMI, calibrando cada algoritmo según la literatura primaria de salud pública (OMS, CDC, ICMR) y revistas científicas revisadas por pares.
                </p>
              </div>
            </div>

            <!-- Non-Clinical Disclosure Banner -->
            <div class="p-5 rounded-xl border border-amber-500/30 bg-amber-500/5 text-amber-200/90 text-sm leading-relaxed space-y-2 not-prose">
              <div class="flex items-center gap-2 font-bold text-amber-400">
                <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Gobernanza Transparente y Divulgación No Clínica</span>
              </div>
              <p>
                Real BMI es un proyecto independiente de ingeniería de software desarrollado y operado exclusivamente por Bhawanshi Dosi. La plataforma <strong>no opera un comité de revisión médica clínica, panel multidisciplinario ni junta de asesoría médica</strong>. Todas las herramientas son aplicaciones algorítmicas de fórmulas publicadas para el conocimiento educativo personal, no diagnósticos clínicos.
              </p>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Canal de Pruebas Matemáticas y Verificación Automatizada</h2>
            <p>Dado que Real BMI no cuenta con un comité médico subjetivo, la precisión y solidez se garantizan mediante una <strong>ingeniería de software rigurosa guiada por pruebas (TDD)</strong>. Cada fórmula, constante de conversión y umbral de referencia se valida mediante una suite de más de 920 pruebas unitarias y de regresión automatizadas que se ejecutan antes de cualquier despliegue:</p>

            <div class="grid gap-4 sm:grid-cols-2 not-prose pt-1">
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Fidelidad a Fórmulas Científicas
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Las ecuaciones (Mifflin-St Jeor 1990, Mosteller 1987, Devine 1974, OMS Informe 854) se contrastan con conjuntos de datos clínicos de referencia.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Paridad Métrica e Imperial
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Los cálculos métricos (kg/cm) e imperiales (lbs/in) se verifican mediante el factor exacto 703.06957964 con tolerancia estricta de &plusmn;0.01.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Pruebas de Límites y Categorías
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Se validan los umbrales estándar de la OMS (18.5, 25.0, 30.0) junto con los criterios de riesgo asiáticos (23.0, 27.5 kg/m&sup2;) en casos límite.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Auditoría de Cero Almacenamiento
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Pruebas arquitectónicas aseguran que ninguna medición biométrica sea enviada a servidores externos ni retenida en cookies locales.
                </p>
              </div>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Estándares Matemáticos Basados en Evidencia</h2>
            <p>Cada ecuación implementada en Real BMI se deriva directamente de la literatura científica validada y las pautas internacionales de salud pública: la serie de informes técnicos 854 de la Organización Mundial de la Salud (OMS), la consulta de la región Asia-Pacífico de la OMS publicada en <em>The Lancet</em>, el modelo de calorimetría indirecta de Mifflin-St Jeor, la fórmula de área de superficie corporal de Mosteller y el estándar de peso corporal ideal de Devine.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Arquitectura de Privacidad sin Retención de Datos</h2>
            <p>A diferencia de las aplicaciones comerciales que recolectan biometría, Real BMI realiza todos los cálculos exclusivamente en la memoria del navegador del usuario mediante JavaScript del lado del cliente. Ningún peso, altura, edad o dato de salud se transmite a servidores remotos ni se guarda en bases de datos.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Propósito Educativo y Descargo de Responsabilidad</h2>
            <p>Real BMI es una herramienta de orientación y cálculo educativo, no un centro médico, hospital o servicio de diagnóstico clínico. Los resultados obtenidos son estimaciones matemáticas para fomentar la conciencia personal sobre la salud y respaldar el diálogo informado con médicos, nutricionistas o profesionales sanitarios cualificados.</p>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 shadow-[var(--shadow-soft)] space-y-6">
          <div class="space-y-2">
            <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Creadora y Verificación</p>
            <h2 class="text-xl sm:text-2xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Plataforma Independiente</h2>
            <p class="text-xs text-[var(--muted-foreground)] font-medium">Mantenida personalmente por Bhawanshi Dosi</p>
          </div>

          <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
            <div>
              <span class="font-bold text-[var(--foreground)] block">Fundadora y Desarrolladora:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi (Ingeniera de Software)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Sede Operativa:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Banswara, Rajastán, India</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Método de Verificación:</span>
              <span class="text-[var(--muted-foreground)] font-medium">920+ Pruebas Algorítmicas Automatizadas</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Junta Médica:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Ninguna (Herramienta Educativa No Clínica)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Modelo de Ejecución:</span>
              <span class="text-[var(--muted-foreground)] font-medium">100 % en el Navegador del Cliente</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Privacidad de Datos:</span>
              <span class="text-[var(--muted-foreground)] font-medium">Cero Almacenamiento de Datos de Salud</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Marco Científico:</span>
              <span class="text-[var(--muted-foreground)] font-medium">OMS, CDC y Estudios Científicos</span>
            </div>
          </div>

          <div class="space-y-3 pt-4 border-t border-[var(--border)]">
            <a href="/es/sources/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] hover:bg-[var(--accent)]/15 transition text-center">
              Citas Primarias (15 Estudios) →
            </a>
            <a href="/es/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition text-center">
              Consultar Metodología y Fórmulas (23) →
            </a>
            <a href="/es/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15 text-center">
              Contactar a la Desarrolladora →
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
