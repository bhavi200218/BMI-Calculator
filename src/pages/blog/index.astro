---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
import { blogArticles } from '../../utils/blogArticles';

const articles = Object.keys(blogArticles).map((slug) => {
  const item = blogArticles[slug];
  return {
    slug,
    title: item.title?.en || slug,
    category: item.category?.en || 'Health',
    description: item.description?.en || '',
  };
});
---

<Layout 
  title="Health & Fitness Articles | Real BMI Library (2026)"
  description="Explore expert clinical guides, BMI charts, weight loss formulas, and metabolic insights published by Real BMI."
  canonicalURL="https://realbmicalculator.com/blog/"
>
  <Navbar />
  <PageShell
    title="Clinical Health & BMI Articles"
    eyebrow="Knowledge Base"
    description="Evidence-based guides on Body Mass Index, body fat estimation, caloric maintenance, and metabolic health."
    returnUrl="/"
    returnLabel="Home"
  >
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-6">
      {articles.map((art) => (
        <a href={`/blog/${art.slug}`} class="group block h-full">
          <div class="h-full p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-4 hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-display font-semibold tracking-wider text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20 truncate max-w-full">
                {art.category}
              </span>
              <h2 class="text-lg md:text-xl font-display font-bold leading-snug text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
                {art.title}
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-3">
                {art.description}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] pt-4 border-t border-[var(--border)]/40">
              <span>Read Full Article</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </PageShell>
</Layout>
