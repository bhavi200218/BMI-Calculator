---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="संपादकीय नीति एवं संदर्भ मानक | Real BMI"
    description="साक्ष्य-आधारित स्वास्थ्य सामग्री, सहकर्मी-समीक्षित कार्यप्रणाली और पारदर्शी उपयोगकर्ता मार्गदर्शन के लिए Real BMI की संपादकीय नीति पढ़ें।"
    canonicalURL="https://realbmicalculator.com/hi/editorial-policy/"
>
    <Navbar />
    <PageShell
      title="संपादकीय नीति"
      eyebrow="कार्यप्रणाली एवं पारदर्शिता"
      description="जानें कि Bhawanshi Dosi साक्ष्य-आधारित स्वास्थ्य उपकरणों और शैक्षिक सामग्री का शोध, संदर्भ और रखरखाव कैसे करती हैं।"
      returnUrl="/hi/"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="max-w-5xl space-y-8 prose prose-zinc dark:prose-invert text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
        <p class="text-lg sm:text-xl font-normal text-[var(--foreground)] leading-relaxed">
          बांसवाड़ा, राजस्थान, भारत स्थित <strong>Bhawanshi Dosi</strong> द्वारा स्थापित, विकसित एवं संचालित एक स्वतंत्र डिजिटल स्वास्थ्य गणना और शैक्षिक मंच के रूप में <strong>Real BMI</strong> का उद्देश्य उपयोगकर्ताओं को उनके बॉडी मास इंडेक्स (BMI), बेसल मेटाबॉलिक रेट (BMR), कुल दैनिक ऊर्जा व्यय (TDEE) और संबंधित शारीरिक मापदंडों का पारदर्शी, सुरक्षित और वैज्ञानिक रूप से सत्यापित अनुमान निःशुल्क उपलब्ध कराना है।
        </p>

        <!-- 1. प्रमाण-आधारित संदर्भ दिशानिर्देश -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            1. प्रमाण-आधारित संदर्भ दिशानिर्देश
          </h2>
          <p>
            Real BMI पर प्रकाशित सभी गणना एल्गोरिदम और संदर्भ श्रेणियां स्थापित चिकित्सा साहित्य और आधिकारिक वैश्विक स्वास्थ्य संगठनों के दिशानिर्देशों पर आधारित हैं:
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-sm sm:text-base">
            <li><strong>विश्व स्वास्थ्य संगठन (WHO):</strong> अंतर्राष्ट्रीय वयस्क बीएमआई वर्गीकरण (TRS 854), पश्चिमी प्रशांत क्षेत्रीय एशियाई थ्रेसहोल्ड (23.0 kg/m² अधिक वजन, 27.5 kg/m² मोटापा), और कमर-से-हिप अनुपात मानक।</li>
            <li><strong>रोग नियंत्रण और रोकथाम केंद्र (CDC):</strong> जनसंख्या संदर्भ मानक, बाल विकास प्रतिशतक (ग्रोथ चार्ट) संदर्भ और वयस्क स्क्रीनिंग रूपरेखा।</li>
            <li><strong>भारतीय आयुर्विज्ञान अनुसंधान परिषद (ICMR):</strong> एशियाई भारतीयों के लिए विशिष्ट सर्वसम्मत सीमाएं, जो दक्षिण एशियाई 'पतले-मोटे' फेनोटाइप (कम बीएमआई पर भी अधिक आंतरिक चर्बी) को ध्यान में रखती हैं।</li>
            <li><strong>सहकर्मी-समीक्षित शोध सूत्र:</strong> वैज्ञानिकों द्वारा प्रकाशित ऐतिहासिक सूत्र, जिनमें Mifflin-St Jeor (बीएमआर), Devine (आदर्श वजन), Mosteller (शरीर सतह क्षेत्र), Boer (लीन बॉडी मास), और Hodgdon (अमेरिकी नौसेना वसा फॉर्मूला) शामिल हैं।</li>
          </ul>
        </div>

        <!-- 2. लेखक पहचान एवं कार्यपद्धति मानक -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            2. लेखक पहचान एवं कार्यपद्धति मानक
          </h2>
          <p>
            Real BMI पूर्ण व्यक्तिगत जवाबदेही और खुलेपन के साथ संचालित होता है:
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-sm sm:text-base">
            <li><strong>संस्थापक एवं सॉफ्टवेयर इंजीनियर:</strong> <strong>Bhawanshi Dosi</strong> संपूर्ण कोडिंग, गणितीय सूत्र कार्यान्वयन, स्वचालित परीक्षण और वेब डिज़ाइन की एकमात्र संचालक व लेखिका हैं।</li>
            <li><strong>क्लाइंट-साइड शून्य डेटा प्रतिधारण:</strong> सभी गणनाएं जावास्क्रिप्ट के माध्यम से सीधे आपके ब्राउज़र में 100% स्थानीय रूप से होती हैं। आपकी लंबाई, वजन, उम्र या अन्य आंकड़े कभी सर्वर पर नहीं भेजे जाते।</li>
            <li><strong>गैर-क्लिनिकल शैक्षिक संसाधन:</strong> Real BMI एक स्वतंत्र व्यक्तिगत वेबसाइट है; यह कोई अस्पताल, क्लिनिक या डॉक्टरों का समीक्षा बोर्ड नहीं है। हमारे कैलकुलेटर केवल शैक्षिक जागरूकता प्रदान करते हैं और चिकित्सीय निदान का विकल्प नहीं हैं।</li>
          </ul>
        </div>

        <!-- 3. पारदर्शिता और सतत अद्यतन -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            3. पारदर्शिता और सतत अद्यतन
          </h2>
          <p>
            हमारा मानना है कि स्वास्थ्य उपकरणों का गणित पूर्णतः पारदर्शी होना चाहिए। प्रत्येक कैलकुलेटर पेज पर सटीक गणितीय सूत्र, इकाई रूपांतरण, आवश्यक इनपुट, शारीरिक सीमाएं और प्राथमिक शोध अध्ययनों (PubMed / DOI) के सीधे लिंक प्रदर्शित किए जाते हैं। हम किसी भी अपारदर्शी ब्लैक-बॉक्स एल्गोरिदम का उपयोग नहीं करते हैं।
          </p>
          <p>
            वैश्विक उपयोगिता सुनिश्चित करने के लिए सभी 23 स्वास्थ्य उपकरण छह भाषाओं (अंग्रेजी, स्पेनिश, फ्रेंच, जर्मन, कोरियाई और हिंदी) में एक समान गणितीय तर्क के साथ संचालित होते हैं।
          </p>
        </div>

        <!-- 4. संपादकीय स्वतंत्रता एवं नैतिक विज्ञापन -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            4. संपादकीय स्वतंत्रता एवं नैतिक विज्ञापन
          </h2>
          <p>
            सभी स्वास्थ्य उपकरणों को बिना किसी सब्सक्रिप्शन या भुगतान के मुफ़्त रखने के लिए Real BMI Google AdSense के माध्यम से गैर-आक्रामक डिजिटल विज्ञापनों द्वारा समर्थित है।
          </p>
          <p>
            हम एक सख्त संपादकीय फ़ायरवॉल बनाए रखते हैं: किसी भी विज्ञापनदाता, दवा कंपनी या प्रायोजक का हमारे गणितीय एल्गोरिदम, लेखों या संदर्भ मानकों पर कोई प्रभाव नहीं होता है। हम कभी भी प्रायोजित परिणाम या सशुल्क रैंकिंग स्वीकार नहीं करते हैं।
          </p>
        </div>

        <!-- 5. शैक्षणिक अस्वीकरण एवं नैदानिक सीमाएं -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            5. शैक्षणिक अस्वीकरण एवं नैदानिक सीमाएं
          </h2>
          <p>
            Real BMI द्वारा प्रदान किए गए सभी आंकड़े और परिणाम सामान्य स्वास्थ्य जागरूकता और व्यक्तिगत स्क्रीनिंग के लिए शैक्षिक अनुमान मात्र हैं। ये किसी बीमारी का औपचारिक चिकित्सा निदान या व्यक्तिगत आहार योजना नहीं हैं।
          </p>
          <p>
            साधारण लंबाई और वजन इनपुट से मांसपेशियों, हड्डियों के घनत्व, जलयोजन या चिकित्सा इतिहास का सटीक आकलन नहीं किया जा सकता। किसी भी वजन प्रबंधन कार्यक्रम को शुरू करने से पहले हमेशा एक योग्य चिकित्सक या प्रमाणित आहार विशेषज्ञ से परामर्श लें।
          </p>
        </div>

        <!-- 6. अर्धवार्षिक ऑडिट चक्र एवं स्वचालित परीक्षण -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            6. अर्धवार्षिक ऑडिट चक्र एवं स्वचालित परीक्षण
          </h2>
          <p>
            हम सभी सूत्रों और संदर्भ तालिकाओं के लिए एक संरचित अर्धवार्षिक ऑडिट प्रोटोकॉल का पालन करते हैं। जब भी WHO, CDC या ICMR नए आंकड़े या दिशानिर्देश जारी करते हैं, तो हमारे गणना मॉडलों की आधिकारिक श्वेतपत्रों के साथ पुनः जांच की जाती है।
          </p>
          <p>
            सॉफ्टवेयर की गुणवत्ता बनाए रखने के लिए 500 से अधिक स्वचालित यूनिट परीक्षण मीट्रिक और इंपीरियल इकाइयों में गणितीय समानता (0.01 की सख्त सहनशीलता के साथ) और चरम सीमा इनपुट की स्थिरता की पुष्टि करते हैं।
          </p>
        </div>

        <!-- 7. मौलिकता एवं मानवीय लेखन प्रतिबद्धता -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            7. मौलिकता एवं मानवीय लेखन प्रतिबद्धता
          </h2>
          <p>
            सभी लिखित गाइड, चरण-दर-चरण गणितीय उदाहरण, एफएक्यू उत्तर और संदर्भ सामग्री मूल रूप से Bhawanshi Dosi द्वारा प्राथमिक शोध स्रोतों के संदर्भ में तैयार की जाती है।
          </p>
          <p>
            हम बिना मानवीय सत्यापन के कोई भी स्वचालित AI सामग्री प्रकाशित नहीं करते हैं। प्रत्येक पैराग्राफ की वैज्ञानिक सटीकता और साक्ष्य-आधारित सहमति के अनुसार सावधानीपूर्वक समीक्षा की जाती है।
          </p>
        </div>

        <!-- 8. त्रुटि सुधार नीति एवं उपयोगकर्ता प्रतिक्रिया -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            8. त्रुटि सुधार नीति एवं उपयोगकर्ता प्रतिक्रिया
          </h2>
          <p>
            वैज्ञानिक सटीकता हमारी सर्वोच्च प्राथमिकता है। यदि आप किसी कैलकुलेटर या लेख में कोई गणितीय विसंगति, अस्पष्ट परिभाषा या पुराना संदर्भ पाते हैं, तो हम आपको हमारे <a href="/hi/contact/" class="text-[var(--accent)] underline font-medium">संपर्क पेज</a> के माध्यम से सूचित करने के लिए प्रोत्साहित करते हैं।
          </p>
          <p>
            सत्यापित सुधारों की त्वरित जांच की जाती है और 24 से 48 घंटों के भीतर हमारे लाइव कोडबेस में पारदर्शी रूप से लागू किया जाता है।
          </p>
        </div>

        <!-- 9. पूर्व-प्रकाशन समीक्षा एवं गोपनीयता प्रोटोकॉल -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            9. पूर्व-प्रकाशन समीक्षा एवं गोपनीयता प्रोटोकॉल
          </h2>
          <p>
            उपयोगकर्ता सुरक्षा और Google AdSense नीतियों का पूर्ण अनुपालन सुनिश्चित करने के लिए सामग्री के सार्वजनिक होने से पहले 4-चरणीय गुणवत्ता आश्वासन प्रक्रिया लागू होती है:
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-sm sm:text-base">
            <li><strong>चरण 1: संदर्भ सत्यापन:</strong> सभी चिकित्सा सूत्रों की प्राथमिक सहकर्मी-समीक्षित पत्रिकाओं और आधिकारिक WHO/CDC मोनोग्राफ से पुष्टि की जाती है।</li>
            <li><strong>चरण 2: गणितीय समानता परीक्षण:</strong> दोहरी-इकाई परीक्षण मीट्रिक (किग्रा, सेमी) और इंपीरियल (पाउंड, इंच) दोनों प्रणालियों में समान गणना व्यवहार सुनिश्चित करते हैं।</li>
            <li><strong>चरण 3: डेटा गोपनीयता ऑडिट:</strong> अनिवार्य सत्यापन सुनिश्चित करता है कि कोई भी व्यक्तिगत डेटा कभी सर्वर पर न भेजा जाए और न ही संग्रहीत हो।</li>
            <li><strong>चरण 4: संपादकीय स्पष्टता समीक्षा:</strong> प्रकाशन से पहले सभी सामग्री की भाषा, फ़ॉर्मेटिंग और संदर्भों की पूर्ण जांच की जाती है।</li>
          </ul>
        </div>

      </div>
    </PageShell>
</Layout>
