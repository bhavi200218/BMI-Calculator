---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="गोपनीयता नीति | Real BMI"
    description="हमारी गोपनीयता नीति पढ़ें। Real BMI यह सुनिश्चित करता है कि आपका स्वास्थ्य डेटा निजी रहे और हमारे सर्वर पर कभी संग्रहीत न हो।"
>
    <Navbar />
    <PageShell
      title="गोपनीयता नीति"
      eyebrow="आपकी गोपनीयता, हमारी प्राथमिकता"
      description="जानें कि Real BMI आपके डेटा की सुरक्षा कैसे करता है।"
      returnUrl="/hi"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="space-y-8 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg md:text-xl font-medium opacity-90">
        <p><strong>Real BMI</strong> में, हम आपकी गोपनीयता को बहुत गंभीरता से लेते हैं। हमारे सभी बीएमआई, बीएमआर और टीडीईई कैलकुलेटर आपके ब्राउज़र में ही गणना करते हैं।</p>

        <h2>तीसरे पक्ष की सेवाएं और विज्ञापन</h2>
        <p>Google सहित तीसरे पक्ष के विक्रेता, इस वेबसाइट या अन्य वेबसाइटों पर उपयोगकर्ता की पिछली यात्राओं के आधार पर विज्ञापन देने के लिए कुकीज़ का उपयोग करते हैं। विज्ञापन कुकीज़ का Google द्वारा उपयोग, उसे और उसके भागीदारों को उपयोगकर्ताओं को इंटरनेट पर विज्ञापनों को दिखाने में सक्षम बनाता है।</p>
        <p>उपयोगकर्ता <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] underline">Google Ads Settings</a> या <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] underline">aboutads.info</a> पर जाकर व्यक्तिगत विज्ञापनों को निष्क्रिय कर सकते हैं।</p>
      </div>
    </PageShell>
</Layout>
