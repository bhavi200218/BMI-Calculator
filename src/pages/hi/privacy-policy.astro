---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="गोपनीयता नीति | Real BMI" 
    description="Real BMI की आधिकारिक गोपनीयता नीति: हमारी वेबसाइट पर सभी गणनाएं आपके ब्राउज़र में सुरक्षित रूप से होती हैं और हम कोई व्यक्तिगत स्वास्थ्य डेटा कभी स्टोर नहीं करते।"
    canonicalURL="https://realbmicalculator.com/hi/privacy-policy/"
>
    <Navbar />
    <PageShell
      title="गोपनीयता नीति"
      eyebrow="आपका डेटा, आपकी गोपनीयता"
      description="जानें कि Real BMI आपके इनपुट डेटा की सुरक्षा कैसे करता है और सभी स्वास्थ्य गणनाओं को पूर्णतः गोपनीय और सुरक्षित रखता है।"
      returnUrl="/hi/"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="space-y-8 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
        
        <!-- Privacy at a Glance (Quick Summary Card) -->
        <div class="not-prose p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-xs space-y-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-base sm:text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                गोपनीयता: एक नज़र में
              </h2>
              <p class="text-xs text-[var(--muted-foreground)]">
                Real BMI आपकी व्यक्तिगत गोपनीयता की सुरक्षा कैसे करता है, इसका त्वरित सारांश
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="flex items-start gap-2 text-xs sm:text-sm text-[var(--foreground)] font-medium">
              <span class="text-emerald-500 text-base leading-none">✓</span>
              <span>हम आपका बीएमआई या स्वास्थ्य संबंधी आंकड़े कभी स्टोर नहीं करते</span>
            </div>
            <div class="flex items-start gap-2 text-xs sm:text-sm text-[var(--foreground)] font-medium">
              <span class="text-emerald-500 text-base leading-none">✓</span>
              <span>सभी गणनाएं सीधे आपके वेब ब्राउज़र में स्थानीय रूप से होती हैं</span>
            </div>
            <div class="flex items-start gap-2 text-xs sm:text-sm text-[var(--foreground)] font-medium">
              <span class="text-emerald-500 text-base leading-none">✓</span>
              <span>किसी भी प्रकार के अकाउंट या रजिस्ट्रेशन की आवश्यकता नहीं है</span>
            </div>
            <div class="flex items-start gap-2 text-xs sm:text-sm text-[var(--foreground)] font-medium">
              <span class="text-emerald-500 text-base leading-none">✓</span>
              <span>आपका कोई भी स्वास्थ्य डेटा कभी बेचा या साझा नहीं किया जाता</span>
            </div>
            <div class="flex items-start gap-2 text-xs sm:text-sm text-[var(--foreground)] font-medium sm:col-span-2">
              <span class="text-emerald-500 text-base leading-none">✓</span>
              <span>एनालिटिक्स और विज्ञापन प्राथमिकताओं पर आपका 100% नियंत्रण है</span>
            </div>
          </div>
        </div>

        <!-- Core Trust Proposition Callout -->
        <div class="not-prose p-5 rounded-2xl bg-[var(--accent)]/5 border-l-4 border-[var(--accent)] text-[var(--foreground)] space-y-1">
          <p class="text-xs uppercase font-display font-bold tracking-wider text-[var(--accent)]">
            हमारा मुख्य गोपनीयता सिद्धांत
          </p>
          <p class="text-sm sm:text-base font-semibold leading-relaxed">
            सभी गणनाएं विशुद्ध रूप से आपके वेब ब्राउज़र के भीतर क्लाइंट-साइड पर प्रोसेस होती हैं।
          </p>
          <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
            आपकी लंबाई, वजन, उम्र और कमर का माप कभी भी आपके डिवाइस से बाहर नहीं जाता और न ही किसी सर्वर पर भेजा जाता है।
          </p>
        </div>

        <p class="text-lg sm:text-xl font-normal text-[var(--foreground)] leading-relaxed">
          <strong>Real BMI</strong> पर हम उपयोगकर्ता की व्यक्तिगत गोपनीयता और स्वास्थ्य डेटा की सुरक्षा को एक बुनियादी अधिकार मानते हैं। हमारे सभी कैलकुलेटर गोपनीयता-प्रथम दृष्टिकोण पर आधारित हैं।
        </p>

        <!-- 1. शून्य स्वास्थ्य डेटा संग्रह नीति -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            1. शून्य स्वास्थ्य डेटा संग्रह नीति
          </h2>
          <p>
            हम आपकी व्यक्तिगत लंबाई, वजन या अन्य शारीरिक मापों को कभी भी एकत्र, संचित या प्रेषित नहीं करते हैं।
          </p>
          <p>
            जब आप कैलकुलेटर में अपनी जानकारी दर्ज करते हैं, तो सभी गणितीय गणनाएं जावास्क्रिप्ट के माध्यम से सीधे आपके वेब ब्राउज़र में ही प्रोसेस होती हैं।
          </p>
          <p>
            ये आंकड़े कभी भी हमारे वेब सर्वर पर नहीं भेजे जाते और न ही किसी डेटाबेस में सहेजे जाते हैं।
          </p>
        </div>

        <!-- 2. स्थानीय ब्राउज़र प्रोसेसिंग और अस्थायी मेमोरी -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            2. स्थानीय ब्राउज़र प्रोसेसिंग और अस्थायी मेमोरी
          </h2>
          <p>
            क्योंकि गणना आपके डिवाइस पर स्थानीय रूप से होती है, इसलिए आपका डेटा केवल पेज खुले रहने तक ही रहता है।
          </p>
          <p>
            जैसे ही आप टैब बंद करते हैं या पेज को रीफ्रेश करते हैं, आपके द्वारा दर्ज किए गए सभी आंकड़े मेमोरी से तुरंत हट जाते हैं।
          </p>
          <p>
            Real BMI में किसी अकाउंट की जरूरत नहीं होती और न ही हम आपके आईपी पते से कोई स्वास्थ्य डेटा जोड़ते हैं।
          </p>
        </div>

        <!-- 3. तकनीकी निदान एवं आवश्यक सर्वर लॉग्स -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            3. तकनीकी निदान एवं आवश्यक सर्वर लॉग्स
          </h2>
          <p>
            अन्य मानक वेबसाइटों की तरह, हमारी होस्टिंग सेवा साइबर हमलों से बचाव और वेबसाइट की गति सुनिश्चित करने के लिए गैर-व्यक्तिगत तकनीकी लॉग (ब्राउज़र का प्रकार, ऑपरेटिंग सिस्टम) उत्पन्न करती है।
          </p>
          <p>
            ये लॉग कैलकुलेटर के उपयोग से पूरी तरह अलग होते हैं और इनमें कोई स्वास्थ्य डेटा नहीं होता।
          </p>
        </div>

        <!-- 4. वेब एनालिटिक्स और डिजिटल विज्ञापन -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            4. वेब एनालिटिक्स और डिजिटल विज्ञापन
          </h2>
          <p>
            Real BMI इन कैलकुलेटरों को मुफ़्त रखने के लिए गैर-आक्रामक ऑनलाइन विज्ञापनों का उपयोग करता है:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li><strong>Google AdSense:</strong> Google सहित तृतीय-पक्ष विक्रेता वेबसाइट पर विज़िट के आधार पर विज्ञापन प्रदर्शित करने के लिए कुकीज़ का उपयोग करते हैं।</li>
            <li><strong>व्यक्तिगत विज्ञापन बंद करना:</strong> आप <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] underline font-medium">Google Ads Settings</a> पर जाकर कभी भी व्यक्तिगत विज्ञापनों को बंद कर सकते हैं।</li>
            <li><strong>कुकी प्राथमिकताओं का नियंत्रण:</strong> Google Consent Mode v2 के माध्यम से आप हमारे कुकी बैनर में कभी भी अपनी प्राथमिकताओं को बदल सकते हैं।</li>
          </ul>
        </div>

        <!-- 5. आपके डेटा अधिकार -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            5. आपके डेटा अधिकार
          </h2>
          <p>
            अंतर्राष्ट्रीय गोपनीयता मानकों के अनुसार आपको अपने डेटा पर पूर्ण नियंत्रण प्राप्त है:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li><strong>डेटा बिक्री पर रोक:</strong> हम कभी भी किसी तीसरे पक्ष को आपका स्वास्थ्य डेटा नहीं बेचते।</li>
            <li><strong>स्वचालित डेटा निष्कासन:</strong> सर्वर पर डेटा न होने के कारण सत्र समाप्त होते ही आपकी जानकारी स्वतः नष्ट हो जाती है।</li>
            <li><strong>प्राथमिकताएं बदलना:</strong> आप हमारे <a href="/hi/cookie-policy/" class="text-[var(--accent)] underline font-medium">कुकी प्राथमिकता केंद्र</a> में जाकर किसी भी समय कुकीज़ प्रबंधित कर सकते हैं।</li>
          </ul>
        </div>

        <!-- 6. एन्क्रिप्शन और वेब सुरक्षा मानक -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            6. एन्क्रिप्शन और वेब सुरक्षा मानक
          </h2>
          <p>
            हम आधुनिक TLS एन्क्रिप्शन तकनीक का उपयोग करते हैं ताकि आपका ब्राउज़िंग अनुभव सुरक्षित रहे और कोई तीसरा पक्ष आपके डेटा को इंटरसेप्ट न कर सके।
          </p>
        </div>

        <!-- 7. संपादकीय समीक्षा एवं डेटा गोपनीयता नीति -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            7. संपादकीय समीक्षा एवं डेटा गोपनीयता नीति
          </h2>
          <p>
            सभी कैलकुलेटर और स्वास्थ्य लेख प्रकाशन से पहले कठोर समीक्षा से गुजरते हैं।
          </p>
          <p>
            हम किसी भी प्रकार के सार्वजनिक फ़ोरम या उपयोगकर्ता निर्देशिका का संचालन नहीं करते हैं, जिससे आपकी पहचान पूर्णतः सुरक्षित रहती है।
          </p>
        </div>

        <!-- 8. संपर्क एवं सहायता -->
        <div class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            8. संपर्क एवं सहायता
          </h2>
          <p>
            यदि आपके पास हमारी गोपनीयता नीति या ब्राउज़र गणना मॉडल के बारे में कोई प्रश्न है, तो कृपया हमारे <a href="/hi/contact/" class="text-[var(--accent)] underline font-medium">संपर्क और सहायता पेज</a> के माध्यम से हमसे संपर्क करें।
          </p>
        </div>

      </div>
    </PageShell>
</Layout>
