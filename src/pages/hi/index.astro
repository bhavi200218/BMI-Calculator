---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import BMICalculator from '../../components/BMICalculator.astro';
import ResultStudio from '../../components/ResultStudio.astro';
import HealthContent from '../../components/HealthContent.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import DeepHealthSEO from '../../components/DeepHealthSEO.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
import RealBMIIntentSection from '../../components/RealBMIIntentSection.astro';
import DiabetesRiskSEOSection from '../../components/DiabetesRiskSEOSection.astro';
import WaistHealthSEOSection from '../../components/WaistHealthSEOSection.astro';
import NewBMIFormulaSEOSection from '../../components/NewBMIFormulaSEOSection.astro';
---

<Layout 
	title="BMI (बॉडी मास इंडेक्स) कैलकुलेटर - मुफ़्त & सटीक | Real BMI"
	description="आधिकारिक Real BMI कैलकुलेटर। WHO एवं CDC नैदानिक मानकों के आधार पर अपने बीएमआई, बीएमआर और आदर्श वजन की तुरंत गणना करें। 100% मुफ़्त एवं गोपनीय।"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  HERO  ═══════════════════ -->
		<section class="pt-36 md:pt-44 pb-6 md:pb-8 px-4 md:px-6">
			<div class="max-w-7xl mx-auto">

				<!-- Main headline — elegant & balanced -->
				<div class="text-center space-y-2.5 mb-5 max-w-4xl mx-auto animate-in" style="animation-delay:0ms">
					<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold uppercase tracking-tight leading-[1.08] text-[var(--foreground)]">
						Real BMI कैलकुलेटर
						<span class="block text-base sm:text-lg md:text-xl lg:text-2xl mt-1 text-[var(--accent)] font-semibold tracking-normal normal-case">अपने शरीर को जानें। अपने स्वास्थ्य के मालिक बनें।</span>
					</h1>
					<p class="text-xs sm:text-sm md:text-base text-[var(--muted-foreground)] font-sans font-semibold max-w-none mx-auto px-2">
						<strong class="text-[var(--foreground)] font-bold">WHO एवं CDC मानकों</strong> पर आधारित सटीक बॉडी मास इंडेक्स कैलकुलेटर — 100% गोपनीय।
					</p>
				</div>

				<!-- Stats strip -->
				<div class="flex flex-wrap justify-center gap-6 md:gap-12 mb-6 animate-in" style="animation-delay:60ms">
					{[
						{ value: 'WHO', label: 'मानक' },
						{ value: '6+', label: 'भाषाएं' },
						{ value: '100%', label: 'गोपनीय' },
						{ value: 'तुरंत', label: 'परिणाम' },
					].map(s => (
						<div class="text-center space-y-0.5">
							<div class="text-2xl md:text-3xl font-display font-bold text-[var(--foreground)]">{s.value}</div>
							<div class="text-[10px] sm:text-xs font-display font-semibold tracking-[0.15em] uppercase text-[var(--muted-foreground)]">{s.label}</div>
						</div>
					))}
				</div>

				<!-- Eyebrow pill & Star Rating Badge in 1 Single Line (Placed Below Stats Strip) -->
				<div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 mb-8 md:mb-10 animate-in" style="animation-delay:120ms">
					<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[var(--accent)]/30 bg-[var(--accent)]/5 text-xs font-display font-semibold uppercase tracking-[0.18em] text-[var(--accent)] shadow-sm">
						<span class="tracking-widest text-[var(--accent)]">★★★★★</span>
						<span class="text-[var(--accent)]">4.9 / 5.0 रेटिंग</span>
						<span class="opacity-80 font-normal text-[11px] text-[var(--accent)] normal-case tracking-normal">(12,840+ समीक्षाएं)</span>
					</div>
					<span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[var(--accent)]/30 bg-[var(--accent)]/5 text-xs font-display font-semibold uppercase tracking-[0.18em] text-[var(--accent)] shadow-sm">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						सटीक स्वास्थ्य विश्लेषण
					</span>
				</div>

				<!-- Interactive Calculator Hub -->
				<HomepageHubWrapper lang="hi" />
			</div>
		</section>

		<!-- ═══════════════════  REAL BMI INTENT & ACCURACY SECTION  ═══════════════════ -->
		<RealBMIIntentSection lang="hi" />

		<!-- ═══════════════════  MAYO CLINIC & WHO ALIGNED BMI + WAIST SECTION  ═══════════════════ -->
		<WaistHealthSEOSection lang="hi" />

		<!-- ═══════════════════  NEW 3D HEIGHT-ADJUSTED BMI FORMULA SECTION  ═══════════════════ -->
		<NewBMIFormulaSEOSection lang="hi" />

		<!-- ═══════════════════  IDF & WHO ALIGNED RISK SECTION  ═══════════════════ -->
		<DiabetesRiskSEOSection lang="hi" />

		<!-- ═══════════════════  USER STORIES  ═══════════════════ -->
		<section class="px-4 md:px-6 py-12 md:py-16">
			<div class="max-w-7xl mx-auto">
				<div class="mb-10 sm:mb-12 space-y-3">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">यह क्यों मायने रखता है</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						आपका फिटनेस सफर,<br/>आपके नियम
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium max-w-xl">
						हमारा मानना है कि स्वास्थ्य उपकरण आपको सशक्त बनाने के लिए होने चाहिए, न कि आपको जज करने के लिए। प्रत्येक गणना WHO डेटा पर आधारित है।
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ num: '01', text: 'जब मैं आकार में आने का निर्णय लेता हूं,', highlight: 'मैं लक्ष्य तक पहुँचने का एक प्रभावी तरीका चाहता हूँ, ताकि मैं वास्तविक परिणाम देख सकूँ — केवल नंबर नहीं।' },
						{ num: '02', text: 'जब मेरा उत्साह कम हो जाता है,', highlight: 'मैं शुरुआत से शुरू किये बिना वहीं से वापस आना चाहता हूँ जहाँ से मैंने छोड़ा था, ताकि मेरी मेहनत बेकार न जाये।' },
						{ num: '03', text: 'जब मैं वर्कआउट शुरू करने की योजना बनाता हूँ,', highlight: 'मैं चाहता हूँ कि यह मुफ़्त हो और इसमें ज़ीरो साइन-अप की आवश्यकता हो, ताकि कोई रुकावट न हो।' },
						{ num: '04', text: 'जब मैं बिना कोच के ट्रेन करता हूँ,', highlight: 'मैं WHO क्लिनिकल डेटा द्वारा सही तकनीक सीखना चाहता हूँ, ताकि मैं कोई गलती न करूँ।' },
						{ num: '05', text: 'जब मैं घर पर अपनी सेहत की जांच करता हूँ,', highlight: 'मैं सटीक बीएमआर, टीडीईई और शरीर में वसा का अनुमान चाहता हूँ, ताकि मैं सक्रिय और सूचित रह सकूँ।' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-4 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-[var(--shadow-accent)] hover:-translate-y-1">
							<div class="text-3xl md:text-4xl font-display font-bold text-[var(--accent)] opacity-60 group-hover:opacity-100 transition-opacity">{item.num}</div>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.text}
								<span class="text-[var(--foreground)] font-semibold block mt-1">{item.highlight}</span>
							</p>
						</div>
					))}
					<!-- Brand box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-70">संचालित</p>
							<p class="text-3xl md:text-4xl font-display font-bold tracking-tight uppercase">REAL BMI</p>
						</div>
						<p class="text-sm font-medium opacity-80 leading-relaxed">सटीक नैदानिक गणना और प्रीमियम डिज़ाइन। कुछ ही सेकंड में अपने स्वास्थ्य मेट्रिक्स की गणना करें।</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══════════════════  ARTICLES & HEALTH CONTENT  ═══════════════════ -->
		<div class="px-4 md:px-6 pt-10 md:pt-14 pb-4">
			<div class="max-w-7xl mx-auto space-y-10 md:space-y-14">
				<LatestArticles />
				<HealthContent />
				<DeepHealthSEO />
				<MedicalEEATBanner lang="hi" />
			</div>
		</div>

	</main>
</Layout>
