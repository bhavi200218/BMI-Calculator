---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
import DeepHealthSEO from '../../components/DeepHealthSEO.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import HealthContent from '../../components/HealthContent.astro';
---

<Layout 
	title="मुफ़्त BMI, BMR, TDEE एवं शरीर संरचना कैलकुलेटर | Real BMI"
	description="डब्ल्यूएचओ एवं सीडीसी दिशानिर्देशों पर आधारित मुफ़्त शैक्षणिक बीएमआई, बीएमआर, टीडीईई और वजन कैलकुलेटर। 100% गोपनीय और त्वरित।"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-24 md:pt-28 pb-6 md:pb-8 px-4 md:px-6">
			<div class="max-w-7xl mx-auto">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-4 mb-8 max-w-4xl mx-auto animate-in" style="animation-delay:0ms">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						आपके दैनिक स्वास्थ्य और फिटनेस उपकरण
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						अपने नंबर समझें। विश्वास के साथ योजना बनाएं।
					</h1>

					<!-- Supporting H2 Subtitle -->
					<h2 class="text-lg sm:text-xl md:text-2xl text-[var(--accent)] font-semibold tracking-tight">
						मुफ़्त बीएमआई, बीएमआर, टीडीईई और शारीरिक संरचना कैलकुलेटर
					</h2>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-3 sm:gap-4 mb-4 animate-in" style="animation-delay:60ms">
					{["15+ कैलकुलेटर","6 भाषाएं","ब्राउज़र-आधारित","तत्काल परिणाम"].map(badge => (
						<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}
						</div>
					))}
				</div>

				<!-- Trust Badge below Stats -->
				<div class="flex items-center justify-center gap-2 mb-8 md:mb-10 text-xs font-medium text-[var(--muted-foreground)] animate-in" style="animation-delay:90ms">
					<svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
					</svg>
					<span>डब्ल्यूएचओ एवं सीडीसी संदर्भ मानक</span>
				</div>

				<!-- Interactive Calculator Hub -->
				<div id="calculators" class="scroll-mt-28">
					<HomepageHubWrapper lang="hi" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  WHY PEOPLE CHOOSE REAL BMI  ═══════════════════ -->
		<section class="px-4 md:px-6 py-12 md:py-16">
			<div class="max-w-7xl mx-auto">
				<div class="mb-10 sm:mb-12 space-y-3">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">पारदर्शी कैलकुलेटर विशेषताएं</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						आपके स्वास्थ्य लक्ष्यों के लिए स्पष्टता
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium max-w-xl">
						चाहे आप प्रगति को ट्रैक कर रहे हों, पोषण की योजना बना रहे हों, या फिटनेस बेसलाइन की समीक्षा कर रहे हों, Real BMI आपको प्रकाशित दिशानिर्देशों पर आधारित तेज़, व्यावहारिक अनुमान देता है।
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[{"title":"फॉर्मूला-आधारित अनुमान","desc":"प्रकाशित गणितीय समीकरणों का उपयोग करके बीएमआई, बीएमआर, टीडीईई और आदर्श वजन के लिए स्पष्ट बेसलाइन प्राप्त करें।"},{"title":"ब्राउज़र गोपनीयता पहले","desc":"सभी गणनाएं आपके डिवाइस पर रहती हैं - किसी खाते, साइन-अप या सर्वर स्टोरेज की आवश्यकता नहीं है।"},{"title":"सार्वजनिक मानकों पर आधारित","desc":"परिणाम संदर्भ के लिए डब्ल्यूएचओ और सीडीसी सार्वजनिक संदर्भ सीमाओं के साथ प्रस्तुत किए जाते हैं।"},{"title":"दैनिक योजना के लिए उपयोगी","desc":"स्पष्ट गणना पद्धतियों के साथ फिटनेस मेट्रिक्स, पोषण अनुमान और शरीर संरचना संदर्भों का अन्वेषण करें।"}].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-4 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-[var(--shadow-accent)] hover:-translate-y-1">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.desc}
							</p>
						</div>
					))}
					
					<!-- Brand & Methodology Box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6 shadow-md">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-80">पारदर्शी कार्यप्रणाली</p>
							<p class="text-2xl md:text-3xl font-display font-bold tracking-tight uppercase">हमारे कैलकुलेटर कैसे काम करते हैं</p>
							<p class="text-xs md:text-sm font-medium opacity-90 leading-relaxed pt-1">सभी 15+ टूल के लिए हमारे प्रकाशित सूत्रों, संदर्भ मानकों, इनपुट, आउटपुट और सीमाओं का अन्वेषण करें।</p>
						</div>
						<a href="/hi/methodology/" class="px-4 py-2.5 rounded-xl bg-white text-[var(--accent)] font-display text-xs font-bold uppercase tracking-wider hover:bg-opacity-90 transition-all shadow-xs">
							कैलकुलेटर कार्यप्रणाली देखें →
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══════════════════  FEATURED GUIDES & TRUST CONTENT  ═══════════════════ -->
		<div class="px-4 md:px-6 pt-6 pb-12">
			<div class="max-w-7xl mx-auto space-y-12">
				<EmbedWidgetBox lang="hi" />
				<LatestArticles lang="hi" />
				<HealthContent lang="hi" />
				<DeepHealthSEO lang="hi" />
				<MedicalEEATBanner lang="hi" />
			</div>
		</div>

	</main>
</Layout>
