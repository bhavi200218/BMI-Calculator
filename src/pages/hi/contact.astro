---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "सहायता एवं संपादकीय टीम से संपर्क करें | Real BMI Calculator",
  "url": "https://realbmicalculator.com/hi/contact/",
  "description": "तकनीकी सहायता, गणितीय सूत्रों पर फीडबैक, संपादकीय पूछताछ या हमारे स्वास्थ्य व फिटनेस कैलकुलेटर पर सुझावों के लिए Real BMI से संपर्क करें।",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "सॉफ्टवेयर इंजीनियर एवं मुख्य डेवलपर",
      "url": "https://realbmicalculator.com/hi/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/hi/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="संपर्क करें | Real BMI Calculator" 
    description="तकनीकी सहायता, गणितीय सूत्रों पर फीडबैक, संपादकीय पूछताछ या हमारे स्वास्थ्य व फिटनेस कैलकुलेटर पर सुझावों के लिए Real BMI से संपर्क करें।"
    canonicalURL="https://realbmicalculator.com/hi/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-10">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/hi/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              होम
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">संपर्क करें</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">सहायता एवं संपादकीय टीम से संपर्क करें</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              क्या आपके पास हमारे सूत्रों पर कोई प्रश्न है, 3D विज़ुअलाइज़ेशन में कोई तकनीकी समस्या है, या स्वास्थ्य गाइड पर सुझाव हैं? सीधे हमारी टीम से संपर्क करें।
            </p>
          </div>

          <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                संपादकीय एवं परियोजना पारदर्शिता
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">संस्थापक एवं निर्माता</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">सॉफ्टवेयर इंजीनियर एवं मुख्य डेवलपर</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">परियोजना की प्रकृति</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">स्वतंत्र परियोजना</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">स्वतंत्र स्वास्थ्य कैलकुलेटर परियोजना</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">संचालन केंद्र</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">अहमदाबाद, गुजरात, भारत</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">भारत एवं वैश्विक पहुंच</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">आधिकारिक सहायता डेस्क</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">24–48 घंटों में उत्तर</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">पेशेवर प्रोफाइल</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    LinkedIn प्रोफाइल ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">सत्यापित निर्माता पहचान</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Layout (Clean 2-Column: Form & Guidance on Left, Support Desk on Right) -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start pt-2">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI एक स्वतंत्र स्वास्थ्य कैलकुलेटर परियोजना है जो विश्व स्वास्थ्य संगठन (WHO) व CDC के प्रकाशित वैज्ञानिक एल्गोरिदम पर आधारित पारदर्शी और गोपनीयता-केंद्रित उपकरण प्रदान करती है।</p>
                <p>कृपया नीचे दिए गए संचार दिशानिर्देश देखें या सीधे हमारी टीम को संदेश भेजने के लिए फॉर्म का उपयोग करें।</p>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="hi" />
              </div>

              <!-- Guidance & Editorial Sections (Consolidated, Non-Redundant) -->
              <div class="space-y-4 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. सूत्र संबंधी प्रश्न एवं अकादमिक फीडबैक</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">हम मिफ्लिन-सेंट जेओर समीकरण, ऑक्सफोर्ड 2.5 बीएमआई मॉडल और WHO एशियाई जोखिम कट-ऑफ सहित स्थापित गणितीय मॉडलों के अपने कार्यान्वयन की लगातार पुष्टि करते हैं। अकादमिक शोध संदर्भों और सुझावों का स्वागत है।</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. तकनीकी समस्या निवारण एवं 3D WebGL सहायता</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">यदि 3D बॉडी विज़ुअलाइज़र या इंटरैक्टिव चार्ट में कोई समस्या आ रही है, तो कृपया अपना ऑपरेटिंग सिस्टम, डिवाइस मॉडल और ब्राउज़र संस्करण (Chrome, Safari, Edge आदि) लिखें ताकि हम समस्या का त्वरित समाधान कर सकें।</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. व्यक्तिगत चिकित्सीय परामर्श का अभाव</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI जनसंख्या-स्तर के शैक्षिक स्क्रीनिंग उपकरण प्रदान करता है। हम व्यक्तिगत लैब रिपोर्ट की समीक्षा नहीं करते, नैदानिक निदान नहीं देते और न ही व्यक्तिगत दवा या आहार सलाह देते हैं।</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. सामग्री की गुणवत्ता एवं गोपनीयता सुरक्षा (कोई व्यक्तिगत डेटा संग्रहीत नहीं)</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">गोपनीयता की सुरक्षा और सामग्री की गुणवत्ता बनाए रखने के लिए, Real BMI यह सुनिश्चित करता है कि सार्वजनिक प्रविष्टियों में कभी भी कोई व्यक्तिगत स्वास्थ्य डेटा संग्रहीत न हो। हमारे फॉर्म के माध्यम से भेजे गए सभी संदेश पूरी तरह गोपनीय रहते हैं।</p>
                  </div>
                
              </div>

              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    अक्सर पूछे जाने वाले सहायता प्रश्न (FAQs)
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    सूत्र उद्धरण, 3D WebGL सिम्युलेटर प्रदर्शन, गोपनीयता दिशानिर्देश और कैलकुलेटर एम्बेडिंग के संबंध में मुख्य प्रश्न।
                  </p>
                </div>
                <div class="space-y-4">
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">मैं गणितीय त्रुटि की रिपोर्ट कैसे कर सकता हूँ या सूत्र अद्यतन का सुझाव कैसे दे सकता हूँ?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">विशिष्ट कैलकुलेटर URL, गणितीय समीकरण और आधिकारिक वैज्ञानिक संदर्भों (जैसे WHO, CDC या PubMed) के साथ अपना संदेश फॉर्म के माध्यम से भेजें। हमारी टीम 48 घंटों में समीक्षा करती है।</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">क्या मैं अपने ब्लॉग, क्लिनिक या जिम वेबसाइट पर Real BMI कैलकुलेटर एम्बेड कर सकता हूँ?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">हाँ। आप गैर-व्यावसायिक और व्यावसायिक दोनों वेबसाइटों पर हमारे iframe विजेट का स्वतंत्र रूप से उपयोग कर सकते हैं। केवल realbmicalculator.com का एट्रिब्यूशन लिंक बनाए रखें।</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">क्या मेरी शारीरिक माप या वजन का डेटा आपके सर्वर पर संग्रहीत होता है?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">नहीं। सभी गणनाएं आपके वेब ब्राउज़र में स्थानीय रूप से जावास्क्रिप्ट के माध्यम से निष्पादित होती हैं। कोई भी व्यक्तिगत बायोमेट्रिक डेटा हमारे सर्वर पर नहीं भेजा जाता।</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Real BMI सहायता टीम संदेशों का उत्तर कितनी तेजी से देती है?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">हम व्यावसायिक दिनों में 24 से 48 घंटों के भीतर उत्तर देते हैं। 3D WebGL बग रिपोर्ट के लिए कृपया अपने डिवाइस और ब्राउज़र का विवरण साझा करें।</p>
                    </div>
                  
                </div>
              </div>
            </div>

            <!-- Sidebar Card (Streamlined, Non-Redundant Support Desk) -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">परियोजना एवं सहायता केंद्र</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">स्वतंत्र स्वास्थ्य कैलकुलेटर परियोजना</p>
              </div>

              <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">संचालन केंद्र:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">अहमदाबाद, गुजरात, भारत</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">सहायता ईमेल:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-sm font-bold font-mono text-[#464feb] hover:underline block break-all mt-0.5">
                    support@realbmicalculator.com
                  </a>
                  <p class="text-[11px] text-emerald-500 font-semibold mt-0.5">24–48 व्यावसायिक घंटों में उत्तर</p>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">गोपनीयता मानक:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">100% ब्राउज़र में स्थानीय गणना (कोई स्वास्थ्य डेटा संग्रहीत नहीं)</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">परियोजना का दायरा:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">25 निःशुल्क स्वास्थ्य कैलकुलेटर एवं संदर्भ मानक</span>
                </div>
              </div>

              <div class="space-y-2 pt-4 border-t border-[var(--border)]">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">नीति एवं पारदर्शिता मानक:</span>
                <div class="flex flex-col gap-2 text-xs font-medium">
                  <a href="/hi/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>संपादकीय नीति एवं कार्यप्रणाली</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/hi/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>15 प्राथमिक वैज्ञानिक शोध संदर्भ</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/hi/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>चिकित्सीय अस्वीकरण</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/hi/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>गोपनीयता नीति</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>

              <div class="pt-4 border-t border-[var(--border)]">
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Send Message
                </a>
              </div>
            </aside>
