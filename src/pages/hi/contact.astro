---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "संपर्क एवं संपादकीय टीम | Real BMI Calculator",
  "url": "https://realbmicalculator.com/hi/contact/",
  "description": "तकनीकी सहायता, गणितीय सूत्रों पर प्रतिक्रिया, संपादकीय पूछताछ या हमारे स्वास्थ्य एवं फिटनेस कैलकुलेटर पर सुझाव के लिए Real BMI से संपर्क करें।",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Founder & Lead Developer",
      "url": "https://realbmicalculator.com/hi/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/hi/contact/",
      "contactType": "customer support",
      "availableLanguage": ["English", "Spanish", "French", "German", "Korean", "Hindi"]
    }
  }
};
---

<Layout 
    title="संपर्क करें | Real BMI Calculator" 
    description="तकनीकी सहायता, गणितीय सूत्रों पर प्रतिक्रिया, संपादकीय पूछताछ या हमारे स्वास्थ्य एवं फिटनेस कैलकुलेटर पर सुझाव के लिए Real BMI से संपर्क करें।"
    canonicalURL="https://realbmicalculator.com/hi/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-10">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/hi/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              होम
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">हमसे संपर्क करें</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">सहायता एवं संपादकीय टीम</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              कैलकुलेटर सूत्रों, 3D विज़ुअलाइज़र की तकनीकी समस्याओं या हमारे स्वास्थ्य गाइडों पर सुझाव के लिए हमारी टीम से संपर्क करें।
            </p>
          </div>

          <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                सत्यापित संपादकीय एवं स्वामित्व पारदर्शिता (Verified Transparency)
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">संस्थापक एवं निर्माता</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Software Engineer &amp; Informatics</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">परियोजना प्रकार</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Independent Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Independent Health Informatics</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">संचालन केंद्र</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">अहमदाबाद, गुजरात, भारत</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">आधिकारिक सपोर्ट डेस्क</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">24–48 घंटे में मानवीय उत्तर</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">पेशेवर प्रोफ़ाइल</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    LinkedIn Profile ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">सत्यापित निर्माता पहचान</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Executive Ownership & Transparency Verification Table (AdSense / YMYL High-Trust Anchor) -->
          <div class="contact-table-wrap my-8 p-6 shadow-xs">
            <div class="mb-4 space-y-1">
              <p class="text-xs uppercase tracking-[0.28em] font-bold text-[var(--accent)]">स्वामित्व एवं संपादकीय जवाबदेही</p>
              <h2 class="text-xl sm:text-2xl font-display font-black uppercase tracking-tight text-[var(--foreground)]">प्रकाशक क्रेडेंशियल एवं परिचालन सत्यापन तालिका</h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">Google Search Quality Evaluator दिशानिर्देशों (YMYL डिजिटल स्वास्थ्य प्लेटफार्मों के लिए E-E-A-T एवं पारदर्शिता) के अनुसार:</p>
            </div>
            <table class="contact-matrix-table">
              <thead>
                <tr>
                  <th style="width: 26%;">पारदर्शिता पैरामीटर</th>
                  <th style="width: 32%;">सत्यापित स्थिति / क्रेडेंशियल</th>
                  <th style="width: 42%;">परिचालन संदर्भ एवं नीति</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>संस्थापक एवं मुख्य निर्माता</strong></td>
                  <td><strong>Bhawanshi Dosi</strong></td>
                  <td>सॉफ्टवेयर इंजीनियर एवं स्वास्थ्य सूचना विज्ञान शोधकर्ता। वे Real BMI के सभी एल्गोरिदम, गणितीय मॉडल और 3D विज़ुअलाइज़र को व्यक्तिगत रूप से कोड और प्रबंधित करते हैं।</td>
                </tr>
                <tr>
                  <td><strong>पेशेवर प्रोफ़ाइल</strong></td>
                  <td>
                    <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-bold text-[#464feb] hover:underline">
                      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                      linkedin.com/in/bhawanshi-dosi ↗
                    </a>
                  </td>
                  <td>सार्वजनिक पेशेवर प्रोफ़ाइल जो निर्माता की व्यक्तिगत पहचान, सॉफ्टवेयर इंजीनियरिंग पृष्ठभूमि और परियोजना के शासन को सत्यापित करती है।</td>
                </tr>
                <tr>
                  <td><strong>परियोजना का स्वरूप</strong></td>
                  <td><strong>Independent Health Informatics Project</strong></td>
                  <td>स्व-वित्तपोषित एवं स्वतंत्र शैक्षणिक डिजिटल स्वास्थ्य मंच। 100% मुफ़्त सार्वजनिक पहुंच; कोई कॉर्पोरेट या फ़ार्मास्युटिकल पूर्वाग्रह नहीं।</td>
                </tr>
                <tr>
                  <td><strong>मुख्यालय एवं परिचालन स्थान</strong></td>
                  <td><strong>Ahmedabad, Gujarat, India (अहमदाबाद, गुजरात, भारत)</strong></td>
                  <td>एल्गोरिदम विकास, तकनीकी रखरखाव, संपादकीय समीक्षा और उपयोगकर्ता सहायता का प्राथमिक भौतिक आधार।</td>
                </tr>
                <tr>
                  <td><strong>आधिकारिक संपर्क डेस्क</strong></td>
                  <td><a href="mailto:support@realbmicalculator.com" class="font-mono text-[#464feb] font-bold">support@realbmicalculator.com</a></td>
                  <td>गणितीय सूत्र प्रतिक्रिया, बग रिपोर्ट और शैक्षणिक पूछताछ के लिए सीधे मॉनिटर किया जाने वाला इनबॉक्स। 24–48 घंटे में मानवीय उत्तर प्रोटोकॉल।</td>
                </tr>
                <tr>
                  <td><strong>डेटा गोपनीयता एवं सुरक्षा</strong></td>
                  <td><strong>100% डिवाइस पर स्थानीय गणना</strong></td>
                  <td>कोई भी व्यक्तिगत स्वास्थ्य डेटा (वज़न, ऊंचाई आदि) बाहरी सर्वर पर प्रेषित या संग्रहीत नहीं किया जाता। सभी गणनाएं आपके ब्राउज़र में सुरक्षित रूप से होती हैं।</td>
                </tr>
                <tr>
                  <td><strong>वैज्ञानिक संदर्भ मानक</strong></td>
                  <td><a href="/hi/sources/" class="text-[#464feb] font-bold">सहकर्मी-समीक्षित शोध संदर्भ &rarr;</a></td>
                  <td>प्रत्येक उपकरण सीधे प्रकाशित वैज्ञानिक शोधपत्रों से प्रमाणित है: WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987 और Devine 1974।</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Main Layout -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI एक स्वतंत्र स्वास्थ्य इंजीनियरिंग और शिक्षा परियोजना है, जो विश्व स्वास्थ्य संगठन (WHO) और सीडीसी (CDC) के सहकर्मी-समीक्षित वैज्ञानिक सूत्रों पर आधारित मुफ़्त और गोपनीयता-केंद्रित उपकरण प्रदान करती है।</p>
                <p>अपनी पूछताछ को सही समीक्षा कतार तक पहुँचाने के लिए नीचे दिए गए स्वामित्व क्रेडेंशियल्स और संचार दिशानिर्देशों को देखें।</p>
              </div>

              <!-- Verified Trust & Transparency Grid -->
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">संस्थापक एवं निर्माता</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    सॉफ्टवेयर इंजीनियर एवं स्वास्थ्य सूचना विज्ञान शोधकर्ता (मुख्य डेवलपर व निर्माता)
                  </p>
                  <div class="pt-1">
                    <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#464feb] hover:underline inline-flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                      LinkedIn Profile ↗
                    </a>
                  </div>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">परियोजना प्रकार</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Independent Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Independent Health Informatics Project • 100% मुफ़्त एवं सुलभ • शून्य डेटा प्रतिधारण (Zero PII Retention)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">संचालन केंद्र एवं स्थान</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    वैश्विक डिजिटल स्वास्थ्य परिचालन (6 भाषाओं में दुनिया भर के उपयोगकर्ताओं की सेवा)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">आधिकारिक सहायता ईमेल</p>
                  </div>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-bold font-mono text-[#464feb] hover:underline block break-all">
                    <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
                  </a>
                  <p class="text-xs text-emerald-500 font-semibold">24–48 व्यावसायिक घंटों में उत्तर</p>
                </div>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="hi" />
              </div>

              <!-- Guidance & Editorial Sections -->
              <div class="space-y-6 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. वैज्ञानिक सूत्रों और कार्यप्रणाली से संबंधित पूछताछ</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">हम लगातार मिफ्लिन-सेंट जेओर, ऑक्सफोर्ड बीएमआई और एशियाई कटऑफ से संबंधित सूत्रों का सत्यापन करते हैं। यदि आपके पास कोई शैक्षणिक शोध संदर्भ या सुझाव हैं, तो हमारी संपादकीय टीम उनका स्वागत करती है।</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
