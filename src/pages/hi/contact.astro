---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "निर्माता एवं सहायता संपर्क | Real BMI Calculator",
  "url": "https://realbmicalculator.com/hi/contact/",
  "description": "तकनीकी सहायता, गणितीय सूत्रों पर फीडबैक, संपादकीय पूछताछ या हमारे स्वास्थ्य व फिटनेस कैलकुलेटर पर सुझावों के लिए Real BMI से संपर्क करें।",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "सॉफ्टवेयर इंजीनियर एवं मुख्य डेवलपर",
      "url": "https://realbmicalculator.com/hi/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Banswara",
      "addressRegion": "Rajasthan",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/hi/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="निर्माता एवं सहायता संपर्क | Real BMI Calculator" 
    description="तकनीकी सहायता, गणितीय सूत्रों पर फीडबैक, संपादकीय पूछताछ या हमारे स्वास्थ्य व फिटनेस कैलकुलेटर पर सुझावों के लिए Real BMI से संपर्क करें।"
    canonicalURL="https://realbmicalculator.com/hi/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-20 md:pt-24 pb-16 px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto space-y-8">
          <!-- Header block -->
          <div class="space-y-3">
            <a href="/hi/" class="inline-flex items-center gap-2 min-h-[44px] px-3 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              होम
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">संपर्क करें</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">निर्माता एवं सहायता संपर्क</h1>
            <p class="text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)] font-medium max-w-4xl">
              क्या आपके पास हमारे सूत्रों पर कोई प्रश्न है, 3D विज़ुअलाइज़ेशन में कोई तकनीकी समस्या है, या स्वास्थ्य गाइड पर सुझाव हैं? सीधे डेवलपर भवांशी दोसी से संपर्क करें।
            </p>
          </div>

          <!-- Creator & Project Identity Card (Clean, Open, Modern) -->
          <div class="rounded-2xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-6 sm:p-7 space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                व्यक्तिगत वेबसाइट एवं पारदर्शिता
              </div>
              <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#464feb] hover:underline">
                <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                लिंक्डइन प्रोफाइल ↗
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">संस्थापक एवं मुख्य डेवलपर</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Bhawanshi Dosi</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">सॉफ्टवेयर इंजीनियर एवं स्वतंत्र वेबमास्टर</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">संचालन केंद्र</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">बांसवाड़ा, राजस्थान, भारत</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">वैश्विक स्तर पर 6 भाषाओं में उपलब्ध</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">प्लेटफ़ॉर्म स्वरूप</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">स्वतंत्र शैक्षिक स्वास्थ्य पहल</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">23 निःशुल्क स्वास्थ्य कैलकुलेटर</p>
              </div>
            </div>
          </div>

          <!-- Interactive Contact Form Component -->
          <div id="contact-desk">
            <ContactForm lang="hi" />
          </div>

          <!-- Communication Guidelines (3 Clear Cards, No Line Dividers) -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                संचार दिशा-निर्देश एवं संपादकीय सीमाएँ
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                डेवलपर इनबॉक्स में संदेश भेजने से पहले कृपया हमारी सहायता सीमाओं की समीक्षा करें।
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  1. व्यक्तिगत चिकित्सा सलाह अनुपलब्ध
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Real BMI प्रकाशित सूत्रों पर आधारित जनसंख्या-स्तरीय शैक्षिक स्क्रीनिंग उपकरण प्रदान करता है। हम व्यक्तिगत लैब रिपोर्ट का विश्लेषण, रोगों का निदान या दवा/आहार संबंधी परामर्श नहीं दे सकते। व्यक्तिगत स्वास्थ्य निर्णयों के लिए योग्य चिकित्सक से परामर्श लें।
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  2. प्रत्यक्ष निजी ईमेल (सार्वजनिक UGC रहित)
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  उपयोगकर्ता गोपनीयता की रक्षा और अप्रमाणित स्वास्थ्य दावों को रोकने के लिए, Real BMI सार्वजनिक टिप्पणी अनुभाग, मंच या फोरम संचालित नहीं करता है। सभी संदेश सीधे डेवलपर द्वारा पढ़े जाने वाले निजी ईमेल पत्राचार हैं।
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  3. शून्य स्वास्थ्य डेटा संग्रहण
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  सभी गणनाएँ आपके वेब ब्राउज़र में स्थानीय रूप से जावास्क्रिप्ट के माध्यम से चलती हैं। आपकी ऊंचाई, वजन या स्वास्थ्य संबंधी आंकड़े हमारे सर्वर पर कभी नहीं भेजे जाते और न ही किसी डेटाबेस में सहेजे जाते हैं।
                </p>
              </div>
            </div>
          </div>

          <!-- Support FAQ Section -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                अक्सर पूछे जाने वाले प्रश्न (FAQ)
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                सूत्र संदर्भ, 3D WebGL सिम्युलेटर, गोपनीयता नीतियों और विजेट एकीकरण से संबंधित सामान्य प्रश्न।
              </p>
            </div>
            <div class="space-y-3.5">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  सूत्र में त्रुटि की सूचना या शोध संदर्भ कैसे भेजें?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  संबंधित कैलकुलेटर URL, सूत्र या चर और वैज्ञानिक उद्धरण (जैसे WHO, CDC या PubMed लिंक) के साथ support@realbmicalculator.com पर ईमेल भेजें। सभी सुझावों की सीधी समीक्षा की जाती है।
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  क्या मैं Real BMI कैलकुलेटर अपनी वेबसाइट पर जोड़ सकता हूँ?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  हाँ। आप शैक्षिक या व्यावसायिक वेबसाइटों पर हमारे कैलकुलेटर iframe विजेट के रूप में निःशुल्क लगा सकते हैं। हम केवल Real BMI का संदर्भ लिंक बनाए रखने का अनुरोध करते हैं।
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  क्या मेरा स्वास्थ्य डेटा सर्वर पर सुरक्षित रखा जाता है?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  नहीं। सभी गणनाएँ 100% आपके ब्राउज़र में होती हैं। कोई भी बायोमेट्रिक डेटा या वजन हमारे सर्वर पर न तो भेजा जाता है और न ही डेटाबेस में सहेजा जाता है।
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  संदेश का उत्तर कितनी जल्दी मिलता है?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  सभी संदेश भवांशी दोसी द्वारा जाँचे जाते हैं और सामान्यतः 24 से 48 व्यावसायिक घंटों में उत्तर दिया जाता है। बग रिपोर्ट में डिवाइस और ब्राउज़र का नाम लिखने से समाधान जल्दी होता है।
                </p>
              </div>
            </div>
          </div>

          <!-- Policy & Trust Links Strip (No Line Dividers) -->
          <div class="pt-2">
            <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--muted)]/20 p-5 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">
                संपादकीय एवं पारदर्शिता मानक
              </span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-medium">
                <a href="/hi/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>संपादकीय नीति एवं कार्यप्रणाली</span>
                  <span>&rarr;</span>
                </a>
                <a href="/hi/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>15 प्राथमिक वैज्ञानिक संदर्भ</span>
                  <span>&rarr;</span>
                </a>
                <a href="/hi/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>चिकित्सा अस्वीकरण</span>
                  <span>&rarr;</span>
                </a>
                <a href="/hi/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>गोपनीयता नीति</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
    </main>
</Layout>
