---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="नियम और शर्तें | Real BMI" 
    description="Real BMI के आधिकारिक नियम और शर्तें: हमारी मुफ़्त, ब्राउज़र-आधारित स्वास्थ्य व फिटनेस कैलकुलेटर सेवाओं और शैक्षिक संदर्भ उपकरणों के उपयोग की शर्तें पढ़ें।"
    canonicalURL="https://realbmicalculator.com/hi/terms-conditions/"
>
    <Navbar />
    <PageShell
        title="नियम और शर्तें"
        eyebrow="व्यावसायिक मानक"
        description="Real BMI के कैलकुलेटर, स्वास्थ्य संकेतक और गोपनीयता-केंद्रित सेवाओं के उपयोग के नियमों की समीक्षा करें।"
        returnUrl="/hi/"
        returnLabel="होम"
    >
        <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed space-y-8 text-base sm:text-lg font-medium opacity-90">
            <p class="text-lg sm:text-xl font-normal text-[var(--foreground)] leading-relaxed">
                ये नियम और शर्तें <strong class="text-[var(--foreground)]">Real BMI</strong> वेबसाइट और इसके अंतर्गत प्रदान किए जाने वाले सभी स्वास्थ्य कैलकुलेटरों, संदर्भ तालिकाओं और विश्लेषणात्मक उपकरणों के उपयोग को नियंत्रित करती हैं।
            </p>
            <p>
                हमारी सेवाओं का उपयोग करके, आप इन सभी शर्तों से कानूनी रूप से बंधे होने की सहमति देते हैं। यदि आप इन शर्तों से सहमत नहीं हैं, तो कृपया वेबसाइट का उपयोग न करें।
            </p>

            <!-- 1. शैक्षिक दायरा एवं गैर-नैदानिक उद्देश्य -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    1. शैक्षिक दायरा एवं गैर-नैदानिक उद्देश्य
                </h2>
                <p>
                    Real BMI पर उपलब्ध कराए गए सभी कैलकुलेटर सामान्य जनसंख्या-स्तरीय गणितीय सूत्रों और सांख्यिकीय स्वास्थ्य जागरूकता के लिए डिज़ाइन किए गए हैं।
                </p>
                <p>
                    यह सेवा किसी भी चिकित्सीय रोग का निदान, व्यक्तिगत उपचार योजना या औपचारिक चिकित्सकीय परामर्श का विकल्प नहीं है।
                </p>
                <p>
                    किसी भी स्वास्थ्य स्थिति, व्यायाम या आहार संबंधी बड़े बदलाव के लिए सदैव किसी योग्य स्वास्थ्य सेवा पेशेवर (Qualified Healthcare Professional) से परामर्श लें।
                </p>
            </div>

            <!-- 2. वैज्ञानिक सूत्रों की सटीकता और सीमाएं -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    2. वैज्ञानिक सूत्रों की सटीकता और सीमाएं
                </h2>
                <p>
                    हमारे एल्गोरिदम विश्व स्वास्थ्य संगठन (WHO) और रोग नियंत्रण एवं रोकथाम केंद्र (CDC) द्वारा प्रकाशित सांख्यिकीय फॉर्मूलों पर आधारित हैं।
                </p>
                <p>
                    मानव शरीर में हड्डियों के घनत्व, मांसपेशियों के अनुपात और उम्र के कारण व्यक्तिगत स्वास्थ्य स्थिति सांख्यिकीय अनुमानों से भिन्न हो सकती है।
                </p>
                <p>
                    Real BMI कोई पंजीकृत चिकित्सा उपकरण या टेलीमेडिसिन सॉफ्टवेयर नहीं है।
                </p>
            </div>

            <!-- 3. स्थानीय ब्राउज़र प्रोसेसिंग और पूर्ण डेटा गोपनीयता -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    3. स्थानीय ब्राउज़र प्रोसेसिंग और पूर्ण डेटा गोपनीयता
                </h2>
                <p>
                    हम उपयोगकर्ता की गोपनीयता को सर्वोच्च प्राथमिकता देते हैं। आपके द्वारा दर्ज किए जाने वाले सभी शारीरिक माप केवल आपके स्थानीय वेब ब्राउज़र में ही प्रोसेस होते हैं।
                </p>
                <p>
                    Real BMI आपकी स्वास्थ्य संबंधी किसी भी व्यक्तिगत जानकारी को किसी बाहरी सर्वर या डेटाबेस पर न तो भेजता है और न ही सहेजता है।
                </p>
            </div>

            <!-- 4. उपयोग की अनुमति और उपयोगकर्ता के दायित्व -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    4. उपयोग की अनुमति और उपयोगकर्ता के दायित्व
                </h2>
                <p>
                    आपको केवल व्यक्तिगत और गैर-व्यावसायिक शैक्षिक उपयोग के लिए Real BMI का उपयोग करने की अनुमति दी जाती है।
                </p>
                <p>
                    आप साइट पर किसी भी प्रकार की अनधिकृत ऑटोमेटेड स्क्रैपिंग, साइबर हमलों या बौद्धिक संपदा के दुरुपयोग में शामिल न होने के लिए सहमत हैं।
                </p>
            </div>

            <!-- 5. बौद्धिक संपदा अधिकार -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    5. बौद्धिक संपदा अधिकार
                </h2>
                <p>
                    इस वेबसाइट पर प्रदर्शित सभी लेख, यूआई डिजाइन, ग्राफिक एलिमेंट्स, 3D मॉडल्स और एल्गोरिदम अंतरराष्ट्रीय बौद्धिक संपदा कानूनों द्वारा सुरक्षित हैं।
                </p>
                <p>
                    पूर्व लिखित अनुमति के बिना किसी भी सामग्री का व्यावसायिक पुनरुत्पादन या प्रकाशन सख्त वर्जित है।
                </p>
            </div>

            <!-- 6. दायित्व की सीमा और वारंटी का अभाव -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    6. दायित्व की सीमा और वारंटी का अभाव
                </h2>
                <p>
                    Real BMI इस सेवा को "जैसा है" (as-is) आधार पर बिना किसी स्पष्ट या निहित वारंटी के उपलब्ध कराता है।
                </p>
                <p>
                    टूल्स के उपयोग या इसके आधार पर लिए गए व्यक्तिगत निर्णयों से उत्पन्न होने वाले किसी भी परिणाम के लिए Real BMI और इसके डेवलपर कानूनी रूप से उत्तरदायी नहीं होंगे।
                </p>
            </div>

            <!-- 7. नियमों में संशोधन -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    7. नियमों में संशोधन
                </h2>
                <p>
                    हम आवश्यकता पड़ने पर किसी भी समय इन नियमों और शर्तों को अद्यतन करने का अधिकार सुरक्षित रखते हैं।
                </p>
                <p>
                    संशोधनों के प्रकाशन के बाद भी साइट का निरंतर उपयोग आपकी अद्यतन शर्तों के प्रति सहमति माना जाएगा।
                </p>
            </div>

            <!-- 8. सामग्री की गुणवत्ता एवं गोपनीयता प्रोटोकॉल -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    8. सामग्री की गुणवत्ता एवं गोपनीयता प्रोटोकॉल
                </h2>
                <p>
                    Real BMI के सभी कैलकुलेटर और लेख प्रकाशन-पूर्व समीक्षा और सख्त गोपनीयता जांच से गुजरते हैं।
                </p>
                <p>
                    हम किसी भी प्रकार के सार्वजनिक संदेश बोर्ड या यूजर प्रोफाइल का संचालन नहीं करते, जिससे आपकी पहचान और स्वास्थ्य डेटा पूर्णतः सुरक्षित रहते हैं।
                </p>
            </div>
        </div>
    </PageShell>
</Layout>
