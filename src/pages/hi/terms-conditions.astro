---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="नियम एवं शर्तें | Real BMI"
    description="Real BMI, हमारे मुफ़्त स्वास्थ्य कैलकुलेटर और शैक्षिक उपकरणों के उपयोग के आधिकारिक नियम और शर्तें पढ़ें।"
    canonicalURL="https://realbmicalculator.com/hi/terms-conditions/"
>
    <Navbar />
    <PageShell
        title="नियम एवं शर्तें"
        eyebrow="व्यावसायिक मानक एवं कानूनी ढांचा"
        description="Real BMI के स्वास्थ्य कैलकुलेटर और गोपनीयता नीति के उपयोग के नियमों की समीक्षा करें।"
        returnUrl="/hi/"
        returnLabel="होम"
    >
        <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed space-y-8 text-base sm:text-lg font-medium opacity-90">
            <p class="text-lg sm:text-xl font-normal text-[var(--foreground)] leading-relaxed">
                ये नियम और शर्तें Real BMI वेबसाइट, इसके सभी 23 स्वास्थ्य कैलकुलेटर, संदर्भ चार्ट और शैक्षिक लेखों के आपके उपयोग को नियंत्रित करती हैं।
            </p>
            <p>
                हमारी वेबसाइट का उपयोग करके, आप स्वीकार करते हैं कि आपने इन शर्तों को पढ़, समझ और स्वीकार कर लिया है। यदि आप सहमत नहीं हैं, तो कृपया सेवा का उपयोग बंद कर दें।
            </p>

            <!-- 1. 1. शैक्षिक दायरा एवं गैर-चिकित्सीय उद्देश्य -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    1. शैक्षिक दायरा एवं गैर-चिकित्सीय उद्देश्य
                </h2>
                <p>Real BMI पर उपलब्ध सभी कैलकुलेटर, स्कोर और स्वास्थ्य मॉडल केवल सामान्य शैक्षिक जागरूकता और व्यक्तिगत संदर्भ के लिए बनाए गए हैं।</p>
        <p>हमारी गणनाओं को किसी भी स्थिति में चिकित्सकीय निदान, डॉक्टरी सलाह या उपचार योजना नहीं माना जाना चाहिए। Real BMI कोई क्लिनिक या अस्पताल नहीं है।</p>
        <p>किसी भी आहार परिवर्तन, वजन घटाने के कार्यक्रम या व्यायाम योजना को शुरू करने से पहले हमेशा एक योग्य चिकित्सक या पोषण विशेषज्ञ से परामर्श लें।</p>
            </div>

            <!-- 2. 2. वैज्ञानिक सूत्र, जनसंख्या मॉडल एवं सीमाएं -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    2. वैज्ञानिक सूत्र, जनसंख्या मॉडल एवं सीमाएं
                </h2>
                <p>Real BMI विश्व स्वास्थ्य संगठन (WHO TRS 854), यूएस सीडीसी तथा मिफलिन-सेंट जियोर (1990), मोस्टेलर (1987) और डिवाइन (1974) जैसे प्रख्यात वैज्ञानिकों के सहकर्मी-समीक्षित सूत्रों का उपयोग करता है।</p>
        <p>हालाँकि हमारे सूत्र वैज्ञानिक रूप से सटीक हैं, सांख्यिकीय जनसंख्या सूत्रों की अपनी सीमाएं होती हैं। वे सीधे मांसपेशियों, हड्डियों के घनत्व या आनुवंशिक चयापचय को नहीं माप सकते।</p>
        <p>उदाहरण के लिए, अधिक मांसपेशियों वाले एथलीटों का बीएमआई अधिक हो सकता है जबकि उनका शरीर वसा बहुत कम होता है। इसी प्रकार बुजुर्गों में मांसपेशियों की कमी सामान्य बीएमआई में भी छिप सकती है।</p>
            </div>

            <!-- 3. 3. स्थानीय ब्राउज़र निष्पादन एवं शून्य डेटा प्रतिधारण -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    3. स्थानीय ब्राउज़र निष्पादन एवं शून्य डेटा प्रतिधारण
                </h2>
                <p>हम उपयोगकर्ताओं की गोपनीयता को सर्वोपरि मानते हैं। सभी स्वास्थ्य गणनाएं (ऊंचाई, वजन, उम्र, कमर) आपके कंप्यूटर या फोन के ब्राउज़र में ही निष्पादित होती हैं।</p>
        <p>हम आपके स्वास्थ्य डेटा को अपने सर्वर पर कभी नहीं सहेजते, न ही किसी तीसरे पक्ष को बेचते हैं। पेज बंद करते ही सभी जानकारी मेमोरी से मिट जाती है।</p>
            </div>

            <!-- 4. 4. अनुमत व्यक्तिगत उपयोग एवं उपयोगकर्ता कर्तव्य -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    4. अनुमत व्यक्तिगत उपयोग एवं उपयोगकर्ता कर्तव्य
                </h2>
                <p>आपको केवल व्यक्तिगत और गैर-व्यावसायिक उपयोग के लिए Real BMI का उपयोग करने की अनुमति दी जाती है।</p>
        <p>वेबसाइट की सुरक्षा और अखंडता को नुकसान पहुंचाने वाले निम्न कार्य पूर्णतः प्रतिबंधित हैं:</p>
        <ul>
          <li>बिना अनुमति के डेटा स्क्रैपिंग या स्वचालित बॉट्स द्वारा सामग्री की नकल करना।</li>
          <li>वेबसाइट पर दुर्भावनापूर्ण हमले (DDoS) करने का प्रयास करना।</li>
          <li>हमारी वेबसाइट या कैलकुलेटर को बिना पूर्व अनुमति अन्य व्यावसायिक साइटों पर एम्बेड करना।</li>
        </ul>
            </div>

            <!-- 5. 5. बौद्धिक संपदा एवं कॉपीराइट अधिकार -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    5. बौद्धिक संपदा एवं कॉपीराइट अधिकार
                </h2>
                <p>वेबसाइट का कोड, डिज़ाइन, 3D WebGL विज़ुअलाइज़ेशन और सभी मूल स्वास्थ्य लेख संस्थापक और सॉफ्टवेयर इंजीनियर भावांशी दोशी की बौद्धिक संपदा हैं।</p>
        <p>लिखित अनुमति के बिना किसी भी सामग्री की व्यावसायिक नकल या वितरण कानूनी रूप से वर्जित है।</p>
            </div>

            <!-- 6. 6. वारंटी का अस्वीकरण -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    6. वारंटी का अस्वीकरण
                </h2>
                <p>हमारी सेवाएं 'जैसी हैं' और 'जैसी उपलब्ध हैं' के आधार पर प्रदान की जाती हैं। हम निरंतर निर्बाध सेवा या विशिष्ट लक्ष्यों की प्राप्ति की कोई वारंटी नहीं देते हैं।</p>
            </div>

            <!-- 7. 7. दायित्व की सीमा -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    7. दायित्व की सीमा
                </h2>
                <p>लागू कानून के अनुसार, Real BMI या इसके डेवलपर भावांशी दोशी किसी भी प्रत्यक्ष या अप्रत्यक्ष नुकसान के लिए उत्तरदायी नहीं होंगे जो कैलकुलेटर के उपयोग से उत्पन्न हो सकता है।</p>
            </div>

            <!-- 8. 8. बाहरी लिंक, उद्धरण एवं विज्ञापन -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    8. बाहरी लिंक, उद्धरण एवं विज्ञापन
                </h2>
                <p>हम डब्ल्यूएचओ और सीडीसी के विश्वसनीय अध्ययनों को उद्धृत करते हैं तथा मुफ़्त सेवा बनाए रखने के लिए Google AdSense के विनीत विज्ञापन प्रदर्शित करते हैं।</p>
        <p>हम किसी भी तृतीय-पक्ष साइट की सामग्री या नीतियों के लिए ज़िम्मेदार नहीं हैं।</p>
            </div>

            <!-- 9. 9. क्षतिपूर्ति -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    9. क्षतिपूर्ति
                </h2>
                <p>आप इन शर्तों के उल्लंघन से उत्पन्न किसी भी कानूनी दावे से Real BMI और इसके संचालकों को सुरक्षित रखने के लिए सहमत हैं।</p>
            </div>

            <!-- 10. 10. पृथक्करणीयता एवं पूर्ण समझौता -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    10. पृथक्करणीयता एवं पूर्ण समझौता
                </h2>
                <p>यदि कोई प्रावधान अवैध पाया जाता है, तो शेष प्रावधान पूरी तरह प्रभावी रहेंगे। यह समझौता गोपनीयता नीति और कुकी नीति के साथ पूर्ण समझौता बनाता है।</p>
            </div>

            <!-- 11. 11. लागू कानून एवं न्यायिक क्षेत्र -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    11. लागू कानून एवं न्यायिक क्षेत्र
                </h2>
                <p>ये शर्तें भारतीय कानूनों के अनुसार शासित होंगी। किसी भी विवाद का निपटारा बांसवाड़ा, राजस्थान, भारत की सक्षम अदालतों में किया जाएगा।</p>
            </div>

            <!-- 12. 12. शर्तों में संशोधन -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    12. शर्तों में संशोधन
                </h2>
                <p>हम किसी भी समय इन नियमों को संशोधित करने का अधिकार सुरक्षित रखते हैं। वेबसाइट का निरंतर उपयोग परिवर्तनों की स्वीकृति माना जाएगा।</p>
            </div>

            <!-- 13. 13. पूर्व-प्रकाशन गुणवत्ता एवं गोपनीयता प्रोटोकॉल -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    13. पूर्व-प्रकाशन गुणवत्ता एवं गोपनीयता प्रोटोकॉल
                </h2>
                <p>सभी 23 कैलकुलेटर और स्वास्थ्य लेखों को प्रकाशित करने से पहले चार चरणों की कड़ी जांच की जाती है:</p>
        <ul>
          <li><strong>स्रोत सत्यापन:</strong> डब्ल्यूएचओ और सीडीसी के मूल शोध पत्रों से सूत्रों का मिलान।</li>
          <li><strong>स्वचालित परीक्षण:</strong> 920 से अधिक यूनिट परीक्षणों द्वारा गणितीय सटीकता की पुष्टि।</li>
          <li><strong>गोपनीयता जांच:</strong> किसी भी व्यक्तिगत पहचान या डेटा का सार्वजनिक रूप से उजागर न होना सुनिश्चित करना।</li>
        </ul>
            </div>

            <!-- 14. 14. डेवलपर विवरण एवं संपर्क -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    14. डेवलपर विवरण एवं संपर्क
                </h2>
                <p>Real BMI एक स्वतंत्र परियोजना है जिसे <strong>भावांशी दोशी</strong>, सॉफ्टवेयर इंजीनियर (बांसवाड़ा, राजस्थान, भारत) द्वारा विकसित और संचालित किया जाता है।</p>
        <p>किसी भी प्रश्न या कानूनी सूचना के लिए कृपया <strong>support@realbmicalculator.com</strong> पर ईमेल करें या हमारे <a href="/hi/contact/" class="text-[var(--accent)] underline font-medium">संपर्क पृष्ठ</a> पर जाएं।</p>
            </div>

            <!-- 15. 15. डेटा सुरक्षा प्रतिबद्धता एवं जानकारी की बिक्री पर पूर्ण रोक -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    15. डेटा सुरक्षा प्रतिबद्धता एवं जानकारी की बिक्री पर पूर्ण रोक
                </h2>
                <p>Real BMI किसी भी स्थिति में उपयोगकर्ताओं के डेटा का व्यावसायीकरण न करने की नीति का कड़ाई से पालन करता है। हम कभी भी उपयोगकर्ताओं की जानकारी किसी डेटा ब्रोकर, मार्केटिंग एजेंसी या तीसरे पक्ष को बेचते या किराए पर नहीं देते हैं।</p>
        <p>चूँकि सभी गणनाएं आपके अपने फोन या कंप्यूटर में ही निष्पादित होती हैं, इसलिए आपका स्वास्थ्य डेटा 100% निजी और सुरक्षित रहता है।</p>
            </div>

            <!-- 16. 16. डिजिटल सुलभता एवं बहु-उपकरण संगतता -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    16. डिजिटल सुलभता एवं बहु-उपकरण संगतता
                </h2>
                <p>हमारी वेबसाइट आधुनिक वेब मानकों (HTML5, उत्तरदायी ग्रिड) का उपयोग करती है ताकि यह सभी प्रकार के स्मार्टफोन, टैबलेट और कंप्यूटर पर बिना किसी रुकावट के तेज़ी से काम करे।</p>
                <p>हम अंतरराष्ट्रीय वेब सुलभता मानकों (WCAG) का सम्मान करते हैं ताकि दृष्टिबाधित या अन्य दिव्यांग उपयोगकर्ता भी स्क्रीन रीडर की मदद से आसानी से स्वास्थ्य गणनाएं कर सकें।</p>
            </div>

            <!-- 17. निरंतर एल्गोरिदम रखरखाव, संशोधन इतिहास एवं उपयोगकर्ता प्रतिक्रिया -->
            <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    17. निरंतर एल्गोरिदम रखरखाव, संशोधन इतिहास एवं उपयोगकर्ता प्रतिक्रिया
                </h2>
                <p>Real BMI एक गतिशील और साक्ष्य-आधारित स्वास्थ्य संदर्भ पोर्टल है। हम सार्वजनिक स्वास्थ्य विज्ञान के नवीनतम अध्ययनों के आधार पर अपने गणितीय सूत्रों और संदर्भ कट-ऑफ की नियमित समीक्षा करते हैं।</p>
