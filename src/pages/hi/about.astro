---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Real BMI के बारे में - संस्थापक एवं कार्यपद्धति मानक"
    description="Real BMI, संस्थापक Bhawanshi Dosi, साक्ष्य-आधारित WHO व CDC संदर्भ मानकों और डेटा गोपनीयता सुरक्षा उपायों के बारे में जानें।"
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Real BMI के बारे में",
      "description": "Real BMI का संगठनात्मक परिचय, तकनीकी प्रशासन और साक्ष्य-आधारित संदर्भ कार्यप्रणाली।",
      "url": "https://realbmicalculator.com/hi/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "संस्थापक एवं मुख्य डेवलपर (Founder & Lead Developer)",
          "description": "सॉफ्टवेयर इंजीनियर एवं Real BMI की निर्माता, क्लाइंट-साइड शून्य-डेटा प्रतिधारण गणना इंजन की विशेषज्ञ।",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
        "@type": "Person",
        "name": "Bhawanshi Dosi",
        "jobTitle": "Founder & Lead Developer",
        "url": "https://realbmicalculator.com/hi/about/"
      },
        "knowsAbout": [
          "बॉडी मास इंडेक्स (BMI)",
          "बेसल मेटाबॉलिक रेट (BMR)",
          "कुल दैनिक ऊर्जा व्यय (TDEE)",
          "शरीर संरचना आकलन",
          "मानवशास्त्रीय संदर्भ दिशानिर्देश"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Real BMI के बारे में"
      eyebrow="मिशन एवं साक्ष्य-आधारित कार्यप्रणाली"
      description="संस्थापक Bhawanshi Dosi द्वारा आधिकारिक WHO एवं CDC मानकों के आधार पर संचालित।"
      returnUrl="/hi/"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> बांसवाड़ा, राजस्थान, भारत स्थित <strong>Bhawanshi Dosi</strong> द्वारा स्थापित, विकसित एवं संचालित एक व्यक्तिगत स्वास्थ्य गणना और शैक्षिक वेबसाइट है। इस परियोजना की शुरुआत आधुनिक ऑनलाइन स्वास्थ्य उपकरणों की गंभीर समस्याओं को हल करने के लिए की गई थी: अपारदर्शी गणितीय सूत्र, अत्यधिक विज्ञापन और व्यक्तिगत स्वास्थ्य डेटा की आक्रामक ट्रैकिंग। Real BMI वैज्ञानिक रूप से मान्य पारदर्शी मॉडल प्रदान करता है जो आपके डिवाइस पर 100% स्थानीय रूप से निष्पादित होते हैं।</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/hi/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              कार्यप्रणाली एवं सूत्र देखें →
            </a>
            <a href="/hi/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              निर्माता से संपर्क करें
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
