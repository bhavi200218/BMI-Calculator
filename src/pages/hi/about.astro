---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Real BMI के बारे में - क्लिनिकल मानक एवं संपादकीय टीम"
    description="Real BMI, हमारी स्वास्थ्य सूचना विज्ञान एवं संपादकीय टीम, साक्ष्य-आधारित WHO व CDC संदर्भ मानकों और डेटा गोपनीयता सुरक्षा उपायों के बारे में जानें।"
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Real BMI के बारे में",
      "description": "Real BMI का संगठनात्मक परिचय, संपादकीय समीक्षा प्रक्रिया और क्लिनिकल संदर्भ कार्यप्रणाली।",
      "url": "https://realbmicalculator.com/hi/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "संस्थापक एवं मुख्य डेवलपर (Founder & Lead Developer)",
          "description": "स्वतंत्र सॉफ्टवेयर इंजीनियर एवं स्वास्थ्य सूचना विज्ञान शोधकर्ता, क्लाइंट-साइड मेडिकल एल्गोरिदम और गोपनीयता-केंद्रित डेटा संरचना के विशेषज्ञ।"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ahmedabad",
          "addressRegion": "Gujarat",
          "addressCountry": "IN"
        },
        "knowsAbout": [
          "बॉडी मास इंडेक्स (BMI)",
          "बेसल मेटाबॉलिक रेट (BMR)",
          "कुल दैनिक ऊर्जा व्यय (TDEE)",
          "शरीर संरचना आकलन",
          "मानवशास्त्रीय संदर्भ दिशानिर्देश"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Real BMI के बारे में"
      eyebrow="मिशन एवं क्लिनिकल कार्यप्रणाली"
      description="पीयर-रिव्यूड साहित्य और आधिकारिक WHO एवं CDC मानकों के आधार पर Real BMI स्वास्थ्य सूचना विज्ञान एवं संपादकीय टीम द्वारा संचालित।"
      returnUrl="/hi/"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> डिजिटल स्वास्थ्य गणनाओं और शारीरिक मापदंडों के संदर्भ के लिए एक स्वतंत्र इंजीनियरिंग एवं शैक्षिक मंच है, जिसकी स्थापना <strong>Bhawanshi Dosi</strong> द्वारा की गई है और इसका संचालन <strong>Real BMI स्वास्थ्य सूचना विज्ञान एवं संपादकीय टीम</strong> (अहमदाबाद, गुजरात, भारत) द्वारा किया जाता है। इस परियोजना की शुरुआत आधुनिक ऑनलाइन स्वास्थ्य उपकरणों की गंभीर समस्याओं को हल करने के उद्देश्य से की गई थी: अपारदर्शी गणितीय अनुमान, अत्यधिक विज्ञापन और व्यक्तिगत स्वास्थ्य डेटा की आक्रामक ट्रैकिंग। Real BMI वैज्ञानिक रूप से मान्य, पारदर्शी रूप से सत्यापन योग्य गणना मॉडल प्रदान करता है जो आपके डिवाइस पर 100% स्थानीय रूप से निष्पादित होते हैं—बिना किसी व्यक्तिगत डेटा के संग्रह या ट्रांसमिशन के।</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">1. स्वास्थ्य सूचना विज्ञान एवं संपादकीय शोध नेतृत्व</h2>
            
            <!-- क्लिनिकल समीक्षा बोर्ड प्रोफाइल कार्ड -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start" id="editorial-board">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-xl shadow-md shrink-0">
                ERT
              </div>
              <div class="space-y-2 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold text-[var(--foreground)]">
                    Real BMI स्वास्थ्य सूचना विज्ञान एवं संपादकीय टीम
                  </h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">अनुसंधान एवं साक्ष्य समीक्षा टीम</span>
                </div>
                <p class="text-xs font-medium text-[var(--accent)]">स्वास्थ्य सूचना विज्ञान, बायोस्टैटिस्टिक्स एवं प्राथमिक अकादमिक शोध (WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, Devine 1974)</p>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  हमारी स्वास्थ्य सूचना विज्ञान एवं संपादकीय शोध टीम Real BMI पर उपलब्ध सभी कैलकुलेटरों, संदर्भ तालिकाओं और स्वास्थ्य गाइडों के गणितीय सूत्रों के सत्यापन, जनसंख्या-विशिष्ट संदर्भ सीमाओं और वैज्ञानिक मानकों की निरंतर निगरानी करती है।
                </p>
                <div class="pt-1">
                  <a href="/hi/editorial-policy/" class="text-xs font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
                    संपादकीय नीति एवं समीक्षा प्रोटोकॉल देखें →
                  </a>
                </div>
              </div>
            </div>

            <!-- तकनीकी एवं संपादकीय बोर्ड कार्ड -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--muted)] border border-[var(--border)] flex items-center justify-center text-[var(--accent)] font-display font-black text-xl shadow-md shrink-0">
                RB
              </div>
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold text-[var(--foreground)]">Real BMI विकास एवं संपादकीय समिति</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">सूचना विज्ञान टीम</span>
                </div>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  हमारी विकास टीम क्लाइंट-साइड हेल्थ इंफॉर्मेटिक्स, गणितीय अनुकूलन और पूर्ण डेटा गोपनीयता वाली वेब संरचना में विशेषज्ञ है। Real BMI सभी गणनाओं को सीधे उपयोगकर्ता के ब्राउज़र में निष्पादित करता है, जिससे किसी बाहरी सर्वर या डेटाबेस में जानकारी भेजने की आवश्यकता नहीं पड़ती।
                </p>
              </div>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2" id="medical-review">2. क्लिनिकल कार्यप्रणाली एवं वैज्ञानिक संदर्भ मानक</h2>
            <p>चूंकि शारीरिक स्वास्थ्य गणनाएं व्यक्तिगत जीवनशैली और स्वास्थ्य निर्णयों को प्रभावित करती हैं (YMYL — Your Money or Your Life), इसलिए हमारे सभी एल्गोरिदम अंतरराष्ट्रीय स्वास्थ्य संगठनों के सहकर्मी-समीक्षित शोधों पर आधारित हैं:</p>
            <ul>
              <li><strong>विश्व स्वास्थ्य संगठन (WHO):</strong> तकनीकी रिपोर्ट श्रृंखला 854 और पश्चिमी प्रशांत क्षेत्रीय कार्यालय द्वारा एशियाई आबादी के लिए निर्धारित विशेष बीएमआई कट-ऑफ (अधिक वजन: 23 kg/m² से, मोटापा: 25 kg/m² से)।</li>
              <li><strong>रोग नियंत्रण एवं रोकथाम केंद्र (CDC) व ICMR:</strong> राष्ट्रीय स्वास्थ्य सांख्यिकी केंद्र (NCHS) और भारतीय आयुर्विज्ञान अनुसंधान परिषद के वयस्क व किशोर विकास मानक।</li>
              <li><strong>मेटाबॉलिक सूत्र एवं ऊर्जा आवश्यकता:</strong> बेसल मेटाबॉलिक रेट (BMR) के लिए मिफलिन-सेंट जियोर समीकरण (1990), संशोधित हैरिस-बेनेडिक्ट सूत्र (1984), और दुबले शरीर द्रव्यमान पर आधारित कैच-मैकआर्डल मॉडल।</li>
              <li><strong>शरीर वसा एवं सतह क्षेत्रफल:</strong> अमेरिकी नौसेना परिधि विधि (हॉजडन एवं बेकेट 1984), मोस्टेलर शारीरिक सतह क्षेत्रफल सूत्र (BSA 1987), और 3D बॉडी वॉल्यूम अनुमान।</li>
            </ul>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">3. हमारा 5-चरणीय प्रकाशन-पूर्व एवं सत्यापन प्रोटोकॉल</h2>
            <p>सर्वोच्च संपादकीय और तकनीकी सटीकता सुनिश्चित करने के लिए प्रत्येक टूल और गाइड निम्नलिखित पांच कड़े चरणों से गुजरता है:</p>
            <ol>
              <li><strong>प्राथमिक स्रोतों से गणितीय व्युत्पत्ति:</strong> सभी गणना सूत्र सीधे आधिकारिक मेडिकल जर्नल्स और WHO/CDC प्रकाशनों से प्राप्त किए जाते हैं।</li>
              <li><strong>इकाई समता सत्यापन:</strong> स्वचालित दोहरी-स्ट्रीम परीक्षण सुनिश्चित करते हैं कि मीट्रिक (किग्रा/सेमी) और इंपीरियल (पाउंड/इंच) दोनों प्रणालियों में समान शारीरिक परिणाम प्राप्त हों।</li>
              <li><strong>शून्य-PII गोपनीयता ऑडिट:</strong> सख्त ऑडिट यह सुनिश्चित करता है कि उपयोगकर्ता का नाम, आईपी पता, फोन नंबर या ईमेल कभी भी इनपुट या यूआरएल में उजागर न हो।</li>
              <li><strong>क्लाइंट-साइड मेमोरी अलगाव:</strong> सभी बायोमेट्रिक इनपुट केवल डिवाइस की ब्राउज़र रैम में रहते हैं और टैब बंद करते ही पूरी तरह मिट जाते हैं।</li>
              <li><strong>क्लिनिकल सीमाएं एवं स्पष्ट प्रकटीकरण:</strong> प्रत्येक टूल अपनी सीमाओं (जैसे एथलीट, गर्भवती महिलाएं या बुजुर्ग) को पारदर्शी रूप से स्पष्ट करता है।</li>
            </ol>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">4. चिकित्सा अस्वीकरण एवं शैक्षिक उद्देश्य</h2>
            <p>Real BMI केवल एक गणितीय संदर्भ और शैक्षिक उपकरण है। यह पेशेवर चिकित्सा सलाह, निदान या उपचार का विकल्प नहीं है। अपनी व्यक्तिगत स्वास्थ्य आवश्यकताओं के लिए हमेशा किसी योग्य चिकित्सक या प्रमाणित पोषण विशेषज्ञ से परामर्श करें।</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">प्रकाशित सूत्र</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">दस्तावेजी गणितीय सूत्रों और सांख्यिकीय बेंचमार्क पर आधारित सटीक गणनाएं।</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">गोपनीयता प्रथम</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">समस्त गणना आपके डिवाइस पर होती है, कोई भी डेटा सर्वर पर स्टोर नहीं किया जाता।</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">WHO एवं CDC मानक</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">एशियाई और वैश्विक आबादी के लिए आधिकारिक संदर्भ श्रेणियां।</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">साक्ष्य-आधारित मार्गदर्शन</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">दैनिक जीवनशैली, फिटनेस और पोषण योजना के लिए भरोसेमंद संदर्भ मान।</p>
            </div>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
          <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">परियोजना का उद्देश्य</p>
          <h2 class="text-2xl font-black text-[var(--foreground)]">पारदर्शी संदर्भ उपकरण</h2>
          <p class="text-sm leading-relaxed text-[var(--muted-foreground)]">Real BMI को हर उपयोगकर्ता के लिए पारदर्शी, विज्ञापन-संतुलित और गोपनीयता-सुरक्षित स्वास्थ्य गणना उपकरण सुलभ कराने के उद्देश्य से बनाया गया है।</p>

          <div class="space-y-4 text-xs text-[var(--muted-foreground)] leading-relaxed border-t border-[var(--border)] pt-4">
            <p><strong>संपादकीय प्रबंधन:</strong> Real BMI स्वास्थ्य सूचना विज्ञान एवं संपादकीय टीम</p>
            <p><strong>क्लिनिकल संदर्भ:</strong> <a href="/hi/sources/" class="text-[var(--accent)] hover:underline font-semibold">15 प्राथमिक अध्ययन उद्धरण</a> (WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, Devine 1974)</p>
            <p><strong>वास्तुकला:</strong> 100% क्लाइंट-साइड ब्राउज़र गणना बिना किसी बाहरी डेटा ट्रांसमिशन के</p>
            <p><strong>गोपनीयता मानक:</strong> GDPR और Google प्रकाशक नीतियों के पूर्णतः अनुरूप</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/hi/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              कार्यप्रणाली एवं सूत्र देखें →
            </a>
            <a href="/hi/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              संपादकीय टीम से संपर्क करें
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
