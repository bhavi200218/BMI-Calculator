---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="चिकित्सा अस्वीकरण | Real BMI" 
    description="Real BMI का आधिकारिक चिकित्सा अस्वीकरण: हमारे स्वास्थ्य कैलकुलेटर केवल शैक्षिक संदर्भ के लिए हैं और पेशेवर डॉक्टर की चिकित्सकीय सलाह या निदान का विकल्प नहीं हैं।"
>
    <Navbar />
    <PageShell
      title="चिकित्सा अस्वीकरण"
      eyebrow="महत्वपूर्ण स्वास्थ्य सूचना"
      description="जानें कि Real BMI किस प्रकार शैक्षिक स्वास्थ्य अनुमान प्रदान करता है और चिकित्सकीय निर्णयों के लिए आपको डॉक्टर से परामर्श क्यों करना चाहिए।"
      returnUrl="/hi/"
      returnLabel="होम"
    >
      <div class="space-y-8 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg md:text-xl font-medium opacity-90">
        <p><strong>Real BMI</strong> द्वारा प्रदान की जाने वाली सभी जानकारी, गणना उपकरण और स्वास्थ्य मेट्रिक्स केवल शैक्षिक, सूचनात्मक और व्यक्तिगत जागरूकता उद्देश्यों के लिए हैं। यह सामग्री किसी भी स्थिति में पेशेवर चिकित्सा सलाह, औपचारिक नैदानिक जांच या व्यक्तिगत उपचार योजना का विकल्प नहीं है और न ही इसे इस रूप में समझा जाना चाहिए।</p>

        <h2>शैक्षिक उद्देश्य एवं गैर-नैदानिक सीमाएं</h2>
        <p>हमारे कैलकुलेटर विश्व स्वास्थ्य संगठन (WHO), भारतीय चिकित्सा अनुसंधान परिषद (ICMR) और अमेरिकी रोग नियंत्रण केंद्र (CDC) द्वारा प्रकाशित सांख्यिकीय सूत्रों और सार्वजनिक स्वास्थ्य दिशानिर्देशों पर आधारित हैं। ये गणितीय मॉडल सामान्य वयस्क जनसंख्या के संदर्भ के लिए तैयार किए गए हैं और ये आपकी व्यक्तिगत चिकित्सीय या जैविक स्थिति का मूल्यांकन नहीं कर सकते।</p>

        <h2>पेशेवर डॉक्टर के परामर्श का महत्व</h2>
        <p>Real BMI के परिणामों के आधार पर कभी भी स्वयं किसी बीमारी का निदान न करें, न ही डॉक्टर द्वारा निर्धारित दवाओं को बंद करें और न ही चिकित्सकीय देखरेख के बिना अत्यधिक कठोर आहार या व्यायाम कार्यक्रम शुरू करें। किसी भी स्वास्थ्य समस्या, पुरानी बीमारी या जीवनशैली में बदलाव के लिए हमेशा किसी योग्य चिकित्सक या पंजीकृत आहार विशेषज्ञ (Dietitian) से सलाह लें।</p>

        <h2>शारीरिक संरचना एवं बीएमआई की सीमाएं</h2>
        <p>मानक बीएमआई (BMI) पैमाने की वैज्ञानिक सीमाएं हैं। बीएमआई केवल ऊंचाई और वजन के अनुपात को मापता है, लेकिन यह मांसपेशियों के भार, हड्डियों के घनत्व और पेट के अंदर जमा विसरल फैट (आंतरिक चर्बी) में अंतर नहीं कर सकता। उच्च प्रदर्शन वाले एथलीट, मांसपेशियों के नुकसान से पीड़ित बुजुर्ग व्यक्ति, गर्भवती महिलाएं और एशियाई मूल के लोगों में बीएमआई का आंकड़ा उनके वास्तविक स्वास्थ्य जोखिम से भिन्न हो सकता है।</p>

        <h2>आपातकालीन चिकित्सा स्थितियां</h2>
        <p>Real BMI कोई आपातकालीन चिकित्सा सेवा नहीं है। यदि आप सीने में दर्द, सांस लेने में गंभीर कठिनाई, अचानक चक्कर आना या किसी अन्य जानलेवा लक्षण का अनुभव कर रहे हैं, तो तुरंत अपने स्थानीय आपातकालीन चिकित्सा सेवा से संपर्क करें या नजदीकी अस्पताल के आपातकालीन विभाग में जाएं।</p>

        <h2>दायित्व की सीमा और स्वैच्छिक उपयोग</h2>
        <p>Real BMI और इसके डेवलपर इस वेबसाइट के कैलकुलेटर या सामग्री के उपयोग से लिए गए किसी भी निर्णय या स्वास्थ्य परिणामों के लिए कोई कानूनी दायित्व स्वीकार नहीं करते हैं। इस वेबसाइट का उपयोग आपके अपने विवेक और व्यक्तिगत जिम्मेदारी पर निर्भर है।</p>
      </div>
    </PageShell>
</Layout>
