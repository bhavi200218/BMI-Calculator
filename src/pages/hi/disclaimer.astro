---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="चिकित्सा अस्वीकरण | Real BMI" 
    description="Real BMI का आधिकारिक चिकित्सा अस्वीकरण: हमारे स्वास्थ्य कैलकुलेटर केवल शैक्षिक संदर्भ के लिए हैं और पेशेवर डॉक्टर की चिकित्सकीय सलाह या निदान का विकल्प नहीं हैं।"
    canonicalURL="https://realbmicalculator.com/hi/disclaimer/"
>
    <Navbar />
    <PageShell
      title="चिकित्सा अस्वीकरण"
      eyebrow="महत्वपूर्ण स्वास्थ्य सूचना"
      description="समझें कि Real BMI किस प्रकार केवल शैक्षिक स्वास्थ्य अनुमान प्रदान करता है और चिकित्सकीय निर्णयों के लिए योग्य डॉक्टर से परामर्श क्यों अनिवार्य है।"
      returnUrl="/hi/"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="space-y-8 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
        
        <p class="text-lg sm:text-xl font-normal text-[var(--foreground)] leading-relaxed">
          <strong>Real BMI</strong> द्वारा प्रदान किए गए सभी गणना उपकरण, इंटरैक्टिव चार्ट और स्वास्थ्य संबंधी जानकारियां पूरी तरह से केवल शैक्षिक, सूचनात्मक और व्यक्तिगत जागरूकता के उद्देश्य से तैयार की गई हैं।
        </p>

        <!-- 1. What Real BMI Is -->
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            Real BMI क्या है
          </h2>
          <p>
            Real BMI साक्ष्य-आधारित स्वास्थ्य अनुमान प्रदान करने वाला एक निःशुल्क डिजिटल टूलसेट है:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>विश्व स्वास्थ्य संगठन (WHO), भारतीय चिकित्सा अनुसंधान परिषद (ICMR) और रोग नियंत्रण केंद्र (CDC) के स्थापित सूत्रों पर आधारित गणितीय अनुमान।</li>
            <li>शरीर के आकार और वजन के वितरण को आसानी से समझने के लिए 3D विज़ुअलाइज़र।</li>
            <li>सामान्य जनसंख्या के स्वास्थ्य मानकों को समझने के लिए मानक सांख्यिकीय संदर्भ सीमाएं।</li>
          </ul>
        </div>

        <!-- 2. What Real BMI Is Not -->
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            Real BMI क्या नहीं है
          </h2>
          <p>
            Real BMI कोई अस्पताल या प्रमाणित स्वास्थ्य सेवा प्रदाता नहीं है:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li><strong>चिकित्सीय सलाह नहीं:</strong> हमारे परिणाम किसी भी रूप में डॉक्टर की पेशेवर सलाह, औपचारिक रोग-निदान या व्यक्तिगत उपचार योजना नहीं हैं।</li>
            <li><strong>नैदानिक परीक्षण नहीं:</strong> केवल कैलकुलेटर के स्कोर से हृदय रोग, मधुमेह, हार्मोनल असंतुलन या पोषण की कमी का पता नहीं लगाया जा सकता।</li>
            <li><strong>दवा या उपचार का आधार नहीं:</strong> केवल कैलकुलेटर के परिणामों के आधार पर कभी भी दवाएं बंद न करें और न ही बिना चिकित्सकीय सलाह के अत्यधिक सख्त डाइट शुरू करें।</li>
          </ul>
        </div>

        <!-- 3. Who Should Consult a Doctor -->
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            डॉक्टर से परामर्श कब लेना आवश्यक है
          </h2>
          <p>
            हम दृढ़ता से अनुशंसा करते हैं कि आप किसी प्रमाणित डॉक्टर या योग्य आहार विशेषज्ञ (Dietitian) से सलाह लें, विशेष रूप से यदि:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li>आप वजन में बड़ा बदलाव (अत्यधिक घटाना या बढ़ाना) या खानपान में भारी बदलाव करने की योजना बना रहे हैं।</li>
            <li>आपको पहले से मधुमेह (डायबिटीज), उच्च रक्तचाप (हाई बीपी), हृदय रोग या थायरॉयड जैसी पुरानी बीमारियां हैं।</li>
            <li>आप गर्भवती हैं, स्तनपान करा रही हैं या किसी सर्जरी से उबर रही हैं।</li>
            <li>आपको खानपान से जुड़े विकार (ईटिंग डिसऑर्डर) का इतिहास रहा है।</li>
            <li>आपके शरीर के वजन में अचानक और बिना कारण बदलाव आ रहा है।</li>
          </ul>
        </div>

        <!-- 4. Emergency Situations (Callout Box) -->
        <div class="p-5 sm:p-6 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-[var(--foreground)] space-y-2 not-prose">
          <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-display font-bold uppercase tracking-wider text-xs sm:text-sm">
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            आपातकालीन स्थितियां
          </div>
          <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">
            तत्काल आपातकालीन चिकित्सा सहायता
          </h3>
          <p class="text-sm leading-relaxed text-[var(--muted-foreground)] font-medium">
            Real BMI कोई आपातकालीन चिकित्सा सेवा नहीं है। यदि आप सीने में दर्द, सांस लेने में गंभीर कठिनाई, अचानक चक्कर आना, अत्यधिक कमजोरी या किसी जानलेवा लक्षण का अनुभव कर रहे हैं, तो तुरंत 112 (भारत) या स्थानीय आपातकालीन नंबर पर कॉल करें अथवा निकटतम अस्पताल के इमरजेंसी विभाग में जाएं।
          </p>
        </div>

        <!-- 5. BMI Limitations -->
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            बीएमआई (BMI) की सीमाएं
          </h2>
          <p>
            मानक बॉडी मास इंडेक्स (BMI) पैमाने की कुछ महत्वपूर्ण वैज्ञानिक सीमाएं हैं:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li><strong>शरीर की संरचना:</strong> बीएमआई केवल ऊंचाई और वजन का अनुपात (kg/m²) बताता है। यह मांसपेशियों के भार, हड्डियों के घनत्व और आंतरिक चर्बी (विसेरल फैट) में अंतर नहीं कर सकता। अधिक मांसपेशियों वाले एथलीट अक्सर 'ओवरवेट' श्रेणी में आ जाते हैं जबकि उनका फैट बहुत कम होता है।</li>
            <li><strong>उम्र और सार्कोपेनिया:</strong> 60 वर्ष से अधिक उम्र के बुजुर्गों में मांसपेशियों की प्राकृतिक कमी (सार्कोपेनिया) के कारण आंतरिक चर्बी अधिक होने पर भी बीएमआई 'सामान्य' दिख सकता है।</li>
            <li><strong>जातीय विविधता:</strong> दक्षिण एशियाई और भारतीय मूल के लोगों में कम वजन पर भी आंतरिक चर्बी अधिक जमा होती है, जिसके कारण डब्ल्यूएचओ ने एशियाई वयस्कों के लिए स्वस्थ सीमा 18.5 से 22.9 kg/m² निर्धारित की है।</li>
          </ul>
        </div>

        <!-- 6. Privacy: No Personal Health Information Stored -->
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            गोपनीयता: कोई व्यक्तिगत स्वास्थ्य डेटा संग्रहीत नहीं किया जाता
          </h2>
          <p>
            आपके स्वास्थ्य आंकड़े पूरी तरह से आपके अपने हैं:
          </p>
          <ul class="list-disc pl-6 space-y-1.5">
            <li><strong>ब्राउज़र में स्थानीय गणना:</strong> सभी गणनाएं सीधे आपके वेब ब्राउज़र में जावास्क्रिप्ट द्वारा सुरक्षित रूप से प्रोसेस होती हैं।</li>
            <li><strong>कोई डेटाबेस स्टोरेज नहीं:</strong> हम आपकी ऊंचाई, वजन, उम्र या कमर के माप को कभी भी अपने सर्वर पर स्टोर, ट्रैक या शेयर नहीं करते।</li>
            <li><strong>शून्य सार्वजनिक रिकॉर्ड:</strong> हमारी वेबसाइट पर कोई सार्वजनिक यूजर प्रोफाइल या फ़ोरम नहीं है जहां आपका निजी डेटा कभी उजागर हो सके।</li>
          </ul>
        </div>

        <!-- 7. Legal Disclaimer -->
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            कानूनी अस्वीकरण एवं दायित्व की सीमा
          </h2>
          <p>
            Real BMI और इसके निर्माता इस वेबसाइट की सामग्री या कैलकुलेटर के उपयोग से लिए गए किसी भी व्यक्तिगत निर्णय या स्वास्थ्य परिणाम के लिए कोई कानूनी दायित्व स्वीकार नहीं करते हैं। इस वेबसाइट का उपयोग पूर्णतः आपकी अपनी इच्छा और विवेक पर निर्भर है।
          </p>
        </div>

      </div>
    </PageShell>
</Layout>
