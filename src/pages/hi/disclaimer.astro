---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="चिकित्सा अस्वीकरण | Real BMI" 
    description="Real BMI का आधिकारिक चिकित्सा अस्वीकरण: हमारे कैलकुलेटर केवल शैक्षिक स्वास्थ्य संदर्भ के लिए हैं और योग्य डॉक्टर की चिकित्सकीय सलाह या निदान का विकल्प नहीं हैं।"
    canonicalURL="https://realbmicalculator.com/hi/disclaimer/"
>
    <Navbar />
    <PageShell
      title="चिकित्सा अस्वीकरण"
      eyebrow="महत्वपूर्ण स्वास्थ्य सूचना"
      description="समझें कि Real BMI किस प्रकार केवल शैक्षिक स्वास्थ्य संदर्भ प्रदान करता है और चिकित्सकीय निर्णयों के लिए योग्य डॉक्टर से परामर्श क्यों अनिवार्य है।"
      returnUrl="/hi/"
      returnLabel="मुख्य पृष्ठ"
    >
      <div class="max-w-5xl space-y-8 text-[var(--muted-foreground)] leading-relaxed text-base font-normal">
        
        <!-- Summary Callout -->
        <div class="p-5 rounded-2xl bg-[var(--card)]/60 border border-[var(--border)]/60">
          <p class="text-base sm:text-lg text-[var(--foreground)] leading-relaxed font-medium">
            <strong>Real BMI</strong> द्वारा प्रदान किए गए सभी कैलकुलेटर, संदर्भ चार्ट और स्वास्थ्य लेख केवल सामान्य जानकारी और व्यक्तिगत जागरूकता के लिए हैं। ये सार्वजनिक स्वास्थ्य मानकों को समझने में सहायता करते हैं, लेकिन किसी भी रूप में पेशेवर चिकित्सीय सलाह या रोग निदान का विकल्प नहीं हैं।
          </p>
        </div>

        <!-- 1. Educational Scope & Non-Diagnostic Notice -->
        <section class="space-y-3">
          <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            1. शैक्षिक दायरा एवं गैर-नैदानिक प्रकृति
          </h2>
          <p>
            Real BMI विश्व स्वास्थ्य संगठन (WHO), रोग नियंत्रण केंद्र (CDC) और आईसीएमआर (ICMR) के स्थापित शोध सूत्रों पर आधारित गणितीय अनुमान प्रदान करता है:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>गणितीय अनुमान:</strong> स्थापित वैज्ञानिक सूत्रों से प्राप्त प्राथमिक बॉडी मेट्रिक्स (जैसे BMI, BMR, TDEE और बॉडी फैट %)।</li>
            <li><strong>जनसंख्या संदर्भ सीमाएं:</strong> सामान्य जनसंख्या के स्वास्थ्य दिशानिर्देशों के साथ अपने आंकड़ों की तुलना करने के लिए मानक संदर्भ स्तर।</li>
            <li><strong>व्यक्तिगत स्वास्थ्य जागरूकता:</strong> अपने डॉक्टर या आहार विशेषज्ञ से सटीक चर्चा करने के लिए ज्ञानवर्धक संदर्भ।</li>
          </ul>
          <p class="pt-1">
            <strong>Real BMI क्या नहीं प्रदान करता:</strong> हम कोई अस्पताल, क्लिनिक या मेडिकल प्रैक्टिस नहीं चलाते हैं। हमारे परिणाम व्यक्तिगत नैदानिक मूल्यांकन, चिकित्सीय निदान या उपचार योजना नहीं हैं। केवल स्वचालित कैलकुलेटर के आधार पर कभी भी दवाएं न बदलें और न ही अत्यधिक सख्त आहार शुरू करें।
          </p>
        </section>

        <!-- 2. Emergency Situations (Callout Box) -->
        <div class="p-5 sm:p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 text-[var(--foreground)] space-y-2">
          <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-display font-bold uppercase tracking-wider text-xs sm:text-sm">
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            2. आपातकालीन चिकित्सा सहायता
          </div>
          <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">
            गंभीर लक्षणों में तत्काल सहायता
          </h3>
          <p class="text-sm leading-relaxed text-[var(--muted-foreground)]">
            Real BMI कोई आपातकालीन सेवा नहीं है। यदि आपको या आपके आसपास किसी को सीने में भारी दबाव, सांस लेने में गंभीर कठिनाई, अचानक चक्कर आना, अत्यधिक कमजोरी या जानलेवा लक्षण महसूस हों, तो तुरंत 112 (भारत/यूरोप), 911 (अमेरिका), या स्थानीय आपातकालीन नंबर पर कॉल करें अथवा निकटतम अस्पताल के आपातकालीन विभाग में जाएं।
          </p>
        </div>

        <!-- 3. When to Consult a Qualified Doctor or Dietitian -->
        <section class="space-y-3">
          <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            3. डॉक्टर या आहार विशेषज्ञ से परामर्श कब अनिवार्य है
          </h2>
          <p>
            हम दृढ़ता से सलाह देते हैं कि आप किसी प्रमाणित डॉक्टर या योग्य क्लिनिकल डायटीशियन से अवश्य परामर्श लें, विशेष रूप से यदि:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>आप वजन में बड़ा बदलाव (अत्यधिक घटाना या बढ़ाना) या अत्यधिक कैलोरी प्रतिबंध की योजना बना रहे हैं।</li>
            <li>आपको पहले से मधुमेह (डायबिटीज), उच्च रक्तचाप (हाई बीपी), हृदय रोग या थायरॉयड जैसी पुरानी स्वास्थ्य समस्याएं हैं।</li>
            <li>आप ऐसी दवाएं ले रहे हैं जिनकी खुराक शरीर के वजन पर निर्भर करती है (जैसे इंसुलिन या रक्तचाप की दवाएं)।</li>
            <li>आप गर्भवती हैं, स्तनपान करा रही हैं या किसी शल्य चिकित्सा (सर्जरी) से उबर रही हैं।</li>
            <li>खानपान से जुड़े विकार (ईटिंग डिसऑर्डर) का कोई इतिहास रहा है।</li>
            <li>शरीर के वजन में बिना किसी ज्ञात कारण के अचानक और तीव्र बदलाव आ रहा हो।</li>
          </ul>
        </section>

        <!-- 4. Scientific & Physiological Limitations of Screening Tools -->
        <section class="space-y-3">
          <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            4. वैज्ञानिक एवं शारीरिक सीमाएं
          </h2>
          <p>
            मानक स्वास्थ्य स्क्रीनिंग पैमानों की कुछ वैज्ञानिक सीमाएं हैं जिन्हें ध्यान में रखना आवश्यक है:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>शरीर की संरचना बनाम कुल वजन:</strong> बीएमआई केवल ऊंचाई और वजन का अनुपात (kg/m²) बताता है। यह मांसपेशियों के भार, हड्डियों के घनत्व और आंतरिक चर्बी में अंतर नहीं कर सकता। एथलीटों का बीएमआई अधिक मांसपेशी द्रव्यमान के कारण 'ओवरवेट' दिख सकता है भले ही उनकी चर्बी बहुत कम हो।</li>
            <li><strong>उम्र और मांसपेशियों की कमी (सार्कोपेनिया):</strong> 65 वर्ष से अधिक उम्र के वरिष्ठ नागरिकों में मांसपेशियों की प्राकृतिक कमी के कारण चर्बी अधिक होने पर भी बीएमआई सामान्य दिख सकता है। बुजुर्गों के लिए हल्का सा अधिक बीएमआई (23.0 से 27.9 kg/m²) हड्डियों की सुरक्षा हेतु बेहतर माना जाता है।</li>
            <li><strong>जातीय विविधता एवं कार्डियोमेटाबॉलिक जोखिम:</strong> भारतीय और एशियाई मूल के लोगों में कम बीएमआई पर भी आंतरिक पेट की चर्बी (विसेरल फैट) अधिक जमा होती है। इसलिए डब्ल्यूएचओ ने एशियाई वयस्कों के लिए स्वस्थ सीमा 18.5 से 22.9 kg/m² तथा ओवरवेट 23.0 kg/m² निर्धारित की है।</li>
            <li><strong>बच्चों एवं किशोरों का विकास:</strong> वयस्क बीएमआई सूत्र 18 वर्ष से कम आयु के बच्चों पर कभी लागू नहीं होने चाहिए। बच्चों के विकास का मूल्यांकन केवल बाल रोग विशेषज्ञ (पीडियाट्रिशियन) द्वारा उम्र और लिंग आधारित सीडीसी/डब्ल्यूएचओ ग्रोथ चार्ट से किया जाना चाहिए।</li>
          </ul>
        </section>

        <!-- 5. Risks of Severe Caloric Restriction & Medication Adjustments -->
        <section class="space-y-3">
          <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            5. अनियंत्रित कैलोरी कटौती व दवा जोखिम
          </h2>
          <p>
            ऑनलाइन कैलकुलेटर के परिणामों के आधार पर अपनी नियमित दवाओं (विशेषकर इंसुलिन, थायरॉयड या बीपी की गोलियां) की खुराक कभी भी स्वयं न बदलें। वजन में बदलाव से दवाओं के अवशोषण की दर बदलती है; खुराक का समायोजन केवल आपके डॉक्टर द्वारा किया जाना चाहिए।
          </p>
          <p>
            इसके अतिरिक्त, चिकित्सकीय देखरेख के बिना अत्यधिक कम कैलोरी डाइट (जैसे महिलाओं के लिए 1,200 और पुरुषों के लिए 1,500 कैलोरी प्रतिदिन से कम) लेने से चयापचय में मंदी, पित्ताशय की पथरी (गॉलस्टोन), पोषक तत्वों की कमी और मांसपेशियों की हानि का गंभीर जोखिम रहता है। बड़े आहार परिवर्तनों से पहले हमेशा पेशेवर सलाह लें।
          </p>
        </section>

        <!-- 6. Directional Proxies vs. Diagnostic Laboratory Biomarkers -->
        <section class="space-y-3">
          <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            6. स्क्रीनिंग अनुमान बनाम नैदानिक लैब परीक्षण
          </h2>
          <p>
            बीएमआई, कमर-से-कूल्हा अनुपात और बॉडी फैट जैसे गणितीय आंकड़े प्रारंभिक स्क्रीनिंग टूल्स हैं। ये सामान्य दिशा दर्शाते हैं, लेकिन संपूर्ण स्वास्थ्य मूल्यांकन का स्थान नहीं ले सकते।
          </p>
          <p>
            वास्तविक चयापचय और हृदय स्वास्थ्य का सटीक आकलन केवल क्लिनिकल लैब परीक्षणों द्वारा ही संभव है: फास्टिंग ब्लड ग्लूकोज, HbA1c, संपूर्ण लिपिड प्रोफाइल (कोलेस्ट्रॉल और ट्राइग्लिसराइड्स), और आराम की स्थिति में रक्तचाप माप। हमारे टूल्स का उपयोग अपने नियमित हेल्थ चेकअप में डॉक्टर से सार्थक प्रश्न पूछने के लिए करें।
          </p>
        </section>

        <!-- 7. Limitation of Liability & Independent Governance -->
        <section class="space-y-3">
          <h2 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
            7. दायित्व की सीमा एवं स्वतंत्र प्रबंधन
          </h2>
          <p>
            Real BMI बांसवाड़ा, राजस्थान, भारत स्थित सॉफ्टवेयर इंजीनियर <strong>भवांशी दोसी</strong> द्वारा स्वतंत्र रूप से विकसित और प्रबंधित एक सॉफ्टवेयर प्रोजेक्ट है। सभी सूत्र डब्ल्यूएचओ, सीडीसी और आईसीएमआर के सार्वजनिक दिशानिर्देशों पर आधारित हैं। यह प्लेटफॉर्म किसी अस्पताल या क्लिनिकल रिव्यू बोर्ड से संबद्ध नहीं है।
          </p>
          <p>
            लागू कानून द्वारा अनुमत अधिकतम सीमा तक, Real BMI और इसके निर्माता इस वेबसाइट के उपयोग से लिए गए किसी भी व्यक्तिगत स्वास्थ्य निर्णय, आहार परिवर्तन या परिणाम के लिए कोई कानूनी दायित्व स्वीकार नहीं करते हैं। आप इन टूल्स का उपयोग पूरी तरह से अपने विवेक और जोखिम पर करते हैं। सूत्रों के सत्यापन या पूछताछ के लिए हमारे <a href="/hi/contact/" class="text-[var(--accent)] underline font-medium hover:text-[var(--foreground)] transition-colors">संपर्क पृष्ठ</a> पर जाएं।
          </p>
        </section>

      </div>
    </PageShell>
</Layout>
