---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageShell from '../components/PageShell.astro';
---

<Layout 
    title="About Real BMI — Clinical Informatics & Editorial Team"
    description="Learn about Real BMI, our clinical informatics team, computational methodology, and evidence-based standards derived from WHO, CDC, and peer-reviewed literature."
    canonicalURL="https://realbmicalculator.com/about/"
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Real BMI",
      "description": "Organizational background, creator credentials, editorial review process, and clinical reference methodology for Real BMI.",
      "url": "https://realbmicalculator.com/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Organization",
          "name": "Real BMI Health Informatics Team",
          "description": "Health informatics development team specializing in client-side medical formulas and zero-retention health data architecture."
        },
        "knowsAbout": [
          "Body Mass Index (BMI)",
          "Basal Metabolic Rate (BMR)",
          "Total Daily Energy Expenditure (TDEE)",
          "Body Composition Assessment",
          "Anthropometric Reference Guidelines"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="About Real BMI"
      eyebrow="Mission & Clinical Methodology"
      description="Maintained by the Real BMI health computation and editorial team using peer-reviewed literature and published WHO & CDC standards."
      returnUrl="/"
      returnLabel="Home"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> is an independent digital health reference platform created and maintained by the <strong>Real BMI Health Informatics & Editorial Team</strong>. The platform was built to solve a widespread problem online: confusing, privacy-invasive health tools cluttered with ad tracking and opaque math. Real BMI provides clear, mathematically verifiable calculators that run 100% locally on your device with zero health data retention.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">1. Health Informatics & Editorial Leadership</h2>
            
            <!-- Clinical Review Board Profile -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start" id="editorial-board">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-xl shadow-md shrink-0">
                CRB
              </div>
              <div class="space-y-2 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold text-[var(--foreground)]">
                    Real BMI Clinical Review Board
                  </h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Clinical Reference Panel</span>
                </div>
                <p class="text-xs font-medium text-[var(--accent)]">Health Informatics, Biostatistics &amp; Evidence-Based Public Health Guidelines (WHO, CDC, ACSM)</p>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Our multidisciplinary review panel oversees mathematical formula derivation, population-level health benchmarks, clinical reference thresholds, and peer-reviewed verification protocols across all Real BMI calculators and educational guides.
                </p>
                <div class="pt-2 flex flex-wrap gap-4">
                  <a href="/en/editorial-policy/" class="text-xs font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
                    Explore Editorial Policy &amp; Review Protocol →
                  </a>
                </div>
              </div>
            </div>

            <!-- Engineering & Editorial Board -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--muted)] border border-[var(--border)] flex items-center justify-center text-[var(--accent)] font-display font-black text-xl shadow-md shrink-0">
                RB
              </div>
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold text-[var(--foreground)]">Real BMI Engineering &amp; Editorial Board</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">Health Informatics Team</span>
                </div>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Our team specializes in client-side health informatics, numerical computing, and browser privacy architecture. Real BMI was created to deliver clinical-grade formulas directly to users without intermediary servers, accounts, or persistent identifiers.
                </p>
              </div>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2" id="medical-review">2. Clinical Methodology &amp; Reference Standards</h2>
            <p>Because anthropometric and metabolic calculations touch sensitive health decisions (YMYL — Your Money or Your Life), our computational models are strictly cross-referenced against established clinical consensus documents and peer-reviewed literature:</p>
            <ul>
              <li><strong>World Health Organization (WHO):</strong> Technical Report Series 854 (Physical Status: The Use and Interpretation of Anthropometry) and WHO Western Pacific Region adult Asian risk categories (BMI ≥23 kg/m² overweight, ≥25 kg/m² obese).</li>
              <li><strong>Centers for Disease Control and Prevention (CDC):</strong> National Center for Health Statistics (NCHS) BMI classification benchmarks and adult population percentile tables.</li>
              <li><strong>Metabolic &amp; Caloric Formulas:</strong> Mifflin-St Jeor (1990) peer-reviewed as the most reliable predictive equation for resting metabolic rate; Harris-Benedict (1984 Roza &amp; Shizgal revision); Katch-McArdle lean mass formulas.</li>
              <li><strong>Body Composition Equations:</strong> U.S. Navy circumference method (Hodgdon &amp; Beckett, 1984), Mosteller Body Surface Area (1987), and Jackson-Pollock 3-site / 7-site density models.</li>
            </ul>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">3. Our 5-Stage Pre-Publication &amp; Content Review Protocol</h2>
            <p>To uphold uncompromising quality, data security, and full compliance with Google Publisher Policies, every tool, calculator algorithm, and reference guide undergoes a mandatory 5-step pre-publication review prior to public deployment:</p>
            <ol>
              <li><strong>Formula Derivation &amp; Primary Literature:</strong> Mathematical models are directly derived from published journal papers and international health guideline documents (WHO Technical Report 854, CDC NCHS, Mifflin-St Jeor 1990).</li>
              <li><strong>Unit Parity Validation:</strong> Algorithms are subjected to dual-stream automated unit testing across Metric (cm/kg) and Imperial (ft-in/lbs) systems to guarantee zero rounding divergence.</li>
              <li><strong>Pre-Publication Privacy &amp; Zero-PII Audit:</strong> A mandatory privacy audit ensures that no personally identifiable information (PII)—including personal names, private emails, phone numbers, or confidential user records—appears in public entries, calculator inputs, or URL parameters.</li>
              <li><strong>Client-Side Isolation Audit:</strong> Verification that biometric inputs remain strictly quarantined inside local device browser memory and are never transmitted over HTTP requests or stored in databases.</li>
              <li><strong>Clinical Boundary &amp; Health Disclaimer Check:</strong> Calculators clearly display physiological edge cases, formula limitations (e.g., muscular athletes, elderly sarcopenia, pregnancy), and explicit educational disclaimers.</li>
            </ol>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">4. Medical Disclaimer & Educational Purpose</h2>
            <p>Real BMI is an educational calculation and screening website, not a licensed medical clinic, hospital, or diagnostic healthcare provider. The scores and ranges provided by our calculators are intended to guide personal fitness awareness and facilitate informed discussions with qualified healthcare providers. Always consult a physician, registered dietitian, or certified health professional before undertaking significant dietary, caloric, or physical training changes.</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Published Equations</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Calculations based on documented mathematical formulas and published population benchmarks.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Zero Health Data Retention</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Biometric inputs never leave your browser memory and are purged on page reload.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">WHO & CDC Reference</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">International public health classification standards with Asian risk action thresholds.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Educational Estimates</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Practical reference baselines for daily fitness and nutritional lifestyle planning.</p>
            </div>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
          <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Editorial Board & Mission</p>
          <h2 class="text-2xl font-black text-[var(--foreground)]">Transparent Reference Standards</h2>
          <p class="text-sm leading-relaxed text-[var(--muted-foreground)]">Real BMI is dedicated to transparent, formula-accurate health estimates. We do not use proprietary "black-box" scores — every calculation shows the exact mathematical formula and peer-reviewed citations.</p>

          <div class="space-y-4 text-xs text-[var(--muted-foreground)] leading-relaxed border-t border-[var(--border)] pt-4">
            <p><strong>Editorial Lead:</strong> Real BMI Health Informatics & Editorial Engineering Team</p>
            <p><strong>Clinical Reference:</strong> WHO Technical Report Series, CDC NCHS, ACSM Guidelines</p>
            <p><strong>Execution Model:</strong> 100% Client-Side Browser Computing</p>
            <p><strong>Editorial Integrity:</strong> Independent, evidence-based, zero user data tracking</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/en/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              Explore Formula Methodology →
            </a>
            <a href="/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              Contact Editorial Desk
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
