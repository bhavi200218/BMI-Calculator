  <link rel="canonical" href="https://realbmicalculator.com/en/terms-conditions/" />
  <!-- Open Graph & Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://realbmicalculator.com/en/terms-conditions/" />
  <meta property="og:title" content="Terms and Conditions | Real BMI" />
  <meta property="og:description" content="Official Terms and Conditions for Real BMI. Review acceptable use policies, intellectual property rights, and educational screening limitations." />
  <meta property="og:image" content="https://realbmicalculator.com/seo-dark.png" />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content="Terms and Conditions | Real BMI" />
  <meta property="twitter:description" content="Official Terms and Conditions for Real BMI. Review acceptable use policies, intellectual property rights, and educational screening limitations." />
  <meta property="twitter:image" content="https://realbmicalculator.com/seo-dark.png" />
  <link rel="alternate" hreflang="en" href="https://realbmicalculator.com/en/terms-conditions/" />
  <link rel="alternate" hreflang="es" href="https://realbmicalculator.com/es/terms-conditions/" />
  <link rel="alternate" hreflang="fr" href="https://realbmicalculator.com/fr/terms-conditions/" />
  <link rel="alternate" hreflang="de" href="https://realbmicalculator.com/de/terms-conditions/" />
  <link rel="alternate" hreflang="ko" href="https://realbmicalculator.com/ko/terms-conditions/" />
  <link rel="alternate" hreflang="hi" href="https://realbmicalculator.com/hi/terms-conditions/" />
  <link rel="alternate" hreflang="x-default" href="https://realbmicalculator.com/en/terms-conditions/" />
  <style>
    :root {
      --background: #091212;
      --foreground: #FCFAF7;
      --accent: #E8674A;
      --card: #11201D;
      --border: #182B27;
      --muted: #162925;
      --muted-foreground: #8FA7A7;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      background-color: var(--background);
      color: var(--foreground);
      line-height: 1.6;
      padding: 2rem 1rem;
    }
    .container {
      max-width: 48rem;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      padding: 2.5rem 2rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    h1 {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 0.75rem;
    }
    h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
      color: var(--foreground);
    }
    p {
      color: var(--muted-foreground);
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }
    .terms-box {
      background: rgba(232, 103, 74, 0.08);
      border: 1px solid rgba(232, 103, 74, 0.25);
      border-radius: 1rem;
      padding: 1.5rem;
      margin: 1.5rem 0;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0.75rem 1.75rem;
      border-radius: 0.75rem;
      background-color: var(--accent);
      color: #ffffff;
      font-weight: 700;
      text-decoration: none;
      margin-top: 1rem;
    }
    .lang-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
      margin-bottom: 1.5rem;
    }
    .lang-link {
      display: inline-block;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
      background: var(--muted);
      border: 1px solid var(--border);
      color: var(--foreground);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      text-align: center;
    }
    .lang-link:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    ul {
      margin-left: 1.25rem;
      color: var(--muted-foreground);
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }
    li {
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>
  <main id="main-content" class="container">
    <header role="banner" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid var(--border);">
      <a href="/en/" class="logo site-logo" rel="home" aria-label="Real BMI Homepage" style="display:inline-flex;align-items:center;gap:0.75rem;text-decoration:none;">
        <img src="/favicon.svg" alt="Real BMI Logo" width="32" height="32" style="border-radius:0.5rem;background:var(--accent);padding:0.25rem;object-fit:contain;" />
        <span class="site-title" style="font-size:1.15rem;font-weight:800;text-transform:uppercase;color:var(--foreground);">Real BMI</span>
      </a>
      <a href="/en/" style="font-size:0.85rem;font-weight:700;color:var(--accent);text-decoration:none;">← Return to Home</a>
    </header>
    <article>
      <h1>Terms and Conditions of Use</h1>
      <p>
        These Terms and Conditions constitute a legally binding agreement between you and <strong>Real BMI</strong> (an independent health calculator platform maintained by the Real BMI Editorial & Health Engineering Team). By accessing our website, interacting with our WebGL 3D visualizers, or using any of our metabolic calculators, you agree to abide by these terms. If you do not agree with any provision herein, you must refrain from using the service.
      </p>

      <div class="terms-box">
        <p style="margin-bottom: 0.5rem; font-weight: 700; color: var(--accent);">Core Legal Principles & Permitted Use:</p>
        <ul style="margin: 0; padding-left: 1.2rem; color: #cbd5e1; font-size: 0.95rem;">
          <li>All calculators are provided free of charge for non-commercial, personal educational screening only.</li>
          <li>Calculations execute locally in your client browser environment with zero server-side metric logging.</li>
          <li>Mathematical formulas do not constitute medical diagnoses, clinical advice, or individualized treatment plans.</li>
        </ul>
      </div>

