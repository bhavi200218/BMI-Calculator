---

<Layout 
  title={pageTitle}
  description={metaDesc}
  keywords={calcKeywords}
  canonicalURL={canonicalUrl}
>
  <!-- Inject WebApplication and MedicalWebPage JSON-LD dynamically inside Layout context -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="json-ld"></script>
  <script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)} slot="json-ld"></script>
  
  <Navbar />
  
  <main class="pt-16 sm:pt-20 md:pt-22 pb-16 px-4 md:px-6 relative overflow-x-hidden">
    <div class="max-w-7xl mx-auto space-y-8 sm:space-y-10">
      
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-medium text-[var(--muted-foreground)]">
        <a href={`/${lang}/`} class="hover:text-[var(--accent)] transition-colors">{bHome}</a><span class="sr-only">. </span>
        <span>/</span>
        <a href={`/${lang}/#calculators`} class="hover:text-[var(--accent)] transition-colors">{bCalc}</a><span class="sr-only">. </span>
        <span>/</span>
        <span class="text-[var(--foreground)]">{calc.name[lang] || calc.name['en']}</span><span class="sr-only">. </span>
      </nav>

      <!-- Top Header text -->
      <div class="text-center space-y-4 max-w-3xl mx-auto">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {calc.name[lang] || calc.name['en']}
        </h1>
        <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium max-w-2xl mx-auto">
          {pageDesc}
        </p>

        <!-- Hero Trust & Privacy Feature Badges (Equal Parity across all Locales) -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-semibold text-[var(--muted-foreground)] pt-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            {{ en: '100% Free & Instant', es: '100% Gratis e Instantáneo', fr: '100% Gratuit et Instantané', de: '100% Kostenlos & Sofort', ko: '100% 무료 및 즉시 계산', hi: '100% मुफ़्त और त्वरित' }[lang]}<span class="sr-only">. </span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            {{ en: 'Browser-Based Privacy', es: 'Privacidad en Navegador', fr: 'Confidentialité sur Navigateur', de: 'Datenschutz im Browser', ko: '브라우저 기반 개인정보 보호', hi: 'सुरक्षित एवं निजी (ब्राउज़र में)' }[lang]}<span class="sr-only">. </span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ en: 'WHO & Reference Standards', es: 'Estándares de Referencia OMS', fr: 'Normes OMS et Références', de: 'WHO & Referenzstandards', ko: 'WHO 및 공중보건 참고 기준', hi: 'डब्ल्यूएचओ एवं संदर्भ मानक' }[lang]}<span class="sr-only">. </span>
          </span>
        </div>
      </div>

      <!-- Population & Regional Standards Notice (Disambiguation for Indian vs Asian WHO Standards) -->
      {calc.slug === 'bmi-calculator-for-indians' && (
        <aside class="p-3.5 sm:p-4 rounded-xl border border-amber-500/25 bg-amber-500/5 text-xs text-[var(--foreground)] max-w-3xl mx-auto flex items-start gap-3 text-left shadow-xs">
          <div class="w-6 h-6 rounded-full bg-amber-500/15 text-amber-500 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="space-y-1">
            <p class="font-bold text-amber-600 dark:text-amber-400">
              {{
                en: 'Official Indian Consensus Standards (ICMR & MoHFW)',
                es: 'Estándares de Consenso para India (ICMR y MoHFW)',
                fr: 'Normes Officielles de Consensus pour l\'Inde (ICMR & MoHFW)',
                de: 'Offizielle indische Konsensusstandards (ICMR & MoHFW)',
                ko: '인도 공식 합의 표준 (ICMR 및 인도 보건부)',
                hi: 'आधिकारिक भारतीय सहमति मानक (ICMR एवं स्वास्थ्य मंत्रालय)'
              }[lang]}
            </p>
            <p class="text-[var(--muted-foreground)] leading-relaxed">
              {{
                en: 'This tool applies the Indian Council of Medical Research (ICMR) South Asian guidelines (Overweight ≥ 23.0 kg/m², Obesity ≥ 25.0 kg/m², and waist risk thresholds: 90 cm men / 80 cm women). Looking for East or Southeast Asian standards where obesity begins at 27.5 kg/m²?',
                es: 'Esta herramienta aplica las directrices del ICMR para el sur de Asia (Sobrepeso ≥ 23.0 kg/m², Obesidad ≥ 25.0 kg/m² y cintura de riesgo: 90 cm hombres / 80 cm mujeres). ¿Buscas las pautas para el Este y Sudeste Asiático donde la obesidad inicia en 27.5 kg/m²?',
                fr: 'Cet outil applique les directives du Conseil indien de la recherche médicale (ICMR) pour l\'Asie du Sud (Surpoids ≥ 23,0 kg/m², Obésité ≥ 25,0 kg/m² et seuil de tour de taille : 90 cm hommes / 80 cm femmes). Vous cherchez les normes pour l\'Asie de l\'Est où l\'obésité débute à 27,5 kg/m² ?',
