---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import UniversalCalculator from '../../components/UniversalCalculator.astro';
import CalculatorResult from '../../components/CalculatorResult.astro';
import HealthContent from '../../components/HealthContent.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import DeepHealthSEO from '../../components/DeepHealthSEO.astro';
import ToolSEOContent from '../../components/ToolSEOContent.astro';
import ThreeDBodyVisualizer from '../../components/ThreeDBodyVisualizer.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import { calculators, locales, type Locale, type CalculatorConfig } from '../../utils/calculators';

// Define static paths for all 15 calculators across 6 languages
export function getStaticPaths() {
  const paths: any[] = [];
  for (const lang of locales) {
    for (const calc of calculators) {
      paths.push({
        params: { lang, calculator: calc.slug },
        props: { calc, lang }
      });
    }
  }
  return paths;
}

interface Props {
  calc: CalculatorConfig;
  lang: Locale;
}

const { calc, lang } = Astro.props;

const pageTitle = calc.title[lang] || calc.title['en'];
const pageDesc = calc.description[lang] || calc.description['en'];
const canonicalUrl = `https://realbmicalculator.com/${lang}/${calc.slug}/`;

const localizedIntro = {
  en: 'Built for quick health analytics and compliance. Real-time computations.',
  es: 'Diseñado para análisis rápidos de salud y cumplimiento. Cálculos en tiempo real.',
  fr: 'Conçu pour des analyses de santé rapides et conformes. Calculs en temps réel.',
  de: 'Entwickelt für schnelle Gesundheitsanalysen und Compliance. Echtzeitberechnungen.',
  ko: '빠른 건강 분석과 규정 준수를 위해 설계되었습니다. 실시간 계산 제공.',
  hi: 'तेज़ स्वास्थ्य विश्लेषण और अनुपालन के लिए बनाया गया। वास्तविक समय में गणना।'
};

// WebApplication Schema for SEO
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": calc.name[lang] || calc.name['en'],
  "url": canonicalUrl,
  "description": pageDesc,
  "applicationCategory": "HealthApplication",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "operatingSystem": "All"
};
---

<Layout 
  title={pageTitle}
  description={pageDesc}
  canonicalURL={canonicalUrl}
>
  <!-- Inject WebApplication JSON-LD dynamically inside Layout context -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="json-ld"></script>
  
  <Navbar />
  
  <main class="pt-26 md:pt-30 pb-20 px-4 md:px-6 relative overflow-x-hidden">
    <div class="max-w-7xl mx-auto space-y-16">
      
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-medium text-[var(--muted-foreground)]">
        <a href={`/${lang}/`} class="hover:text-[var(--accent)] transition-colors">Home</a>
        <span>/</span>
        <a href={`/${lang}/#calculator`} class="hover:text-[var(--accent)] transition-colors">Calculators</a>
        <span>/</span>
        <span class="text-[var(--foreground)]">{calc.name[lang] || calc.name['en']}</span>
      </nav>

      <!-- Top Header text -->
      <div class="text-center space-y-4 max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] animate-in" style="animation-delay:0ms">
          {calc.slug === 'new-bmi-calculator' ? (lang === 'hi' ? '3D व्यू के साथ अपना BMI कैलकुलेट करें' : 'Calculate Your BMI with 3D View') : (calc.name[lang] || calc.name['en'])}
        </h1>
        <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium animate-in max-w-2xl mx-auto" style="animation-delay:50ms">
          {pageDesc} {localizedIntro[lang] || localizedIntro.en}
        </p>

        {calc.slug === 'new-bmi-calculator' && (
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 my-4 p-4 rounded-2xl bg-[var(--card)] border border-[var(--border)] text-left text-xs font-semibold text-[var(--foreground)] max-w-2xl mx-auto shadow-xs animate-in" style="animation-delay:80ms">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Calculate your BMI with 360° interactive 3D view
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Enter your height and weight in cm, inches, kg or lbs
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Choose between Solid 3D Mesh, Wireframe, and Heatmap views
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Oxford 2.5 Power Formula (1.3 × weight / height²·⁵)
            </li>
          </ul>
        )}
      </div>

      <!-- Main Calculator Layout -->
      {calc.slug === 'new-bmi-calculator' ? (
        <div class="w-full animate-in" style="animation-delay:100ms">
          <ThreeDBodyVisualizer lang={lang} />
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch animate-in" style="animation-delay:100ms">
          <UniversalCalculator calculator={calc} lang={lang} />
          <CalculatorResult lang={lang} />
        </div>
      )}

      <!-- Extended Content & Clinical Knowledge Base for Search Indexing -->
      <div class="pt-12 space-y-20">
        <ToolSEOContent slug={calc.slug} lang={lang} />
        <EmbedWidgetBox lang={lang} />
        <LatestArticles />
        <HealthContent />
        <DeepHealthSEO />
      </div>

    </div>
  </main>
</Layout>
