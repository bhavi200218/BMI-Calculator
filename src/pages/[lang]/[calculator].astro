// Define static paths for active unique calculators across 6 languages (aliases handled via _redirects)
export function getStaticPaths() {
  const paths: any[] = [];
  const aliasSlugs = new Set(['one-rep-max-calculator', '3d-body-visualizer']);
  for (const lang of locales) {
    for (const calc of calculators) {
      if (aliasSlugs.has(calc.slug)) continue;
      paths.push({
        params: { lang, calculator: calc.slug },
        props: { calc, lang }
      });
    }
  }
  return paths;
}

