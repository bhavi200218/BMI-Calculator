---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import UniversalCalculator from '../../components/UniversalCalculator.astro';
import CalculatorResult from '../../components/CalculatorResult.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import ToolSEOContent from '../../components/ToolSEOContent.astro';
import ThreeDBodyVisualizer from '../../components/ThreeDBodyVisualizer.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import { seoDatabase } from '../../data/seoDatabase';
import { calculators, locales, type Locale, type CalculatorConfig } from '../../utils/calculators';

// Define static paths for all 25 calculators across 6 languages
export function getStaticPaths() {
  const paths: any[] = [];
  for (const lang of locales) {
    for (const calc of calculators) {
      paths.push({
        params: { lang, calculator: calc.slug },
        props: { calc, lang }
      });
    }
  }
  return paths;
}

interface Props {
  calc: CalculatorConfig;
  lang: Locale;
}

const { calc, lang } = Astro.props;

if (calc.slug === 'one-rep-max-calculator') {
  return Astro.redirect(`/${lang}/1rm-calculator/`, 301);
}

const dbData = seoDatabase[calc.slug]?.[lang] || seoDatabase[calc.slug]?.['en'];
const pageTitle = dbData?.title || calc.title[lang] || calc.title['en'];
const pageDesc = dbData?.intro || calc.description[lang] || calc.description['en'];
const canonicalUrl = `https://realbmicalculator.com/${lang}/${calc.slug}/`;

const localizedIntro = {
  en: 'Built for instant reference calculations and educational metrics. Real-time computations.',
  es: 'Diseñado para cálculos de referencia instantáneos y métricas educativas. Cálculos en tiempo real.',
  fr: 'Conçu pour des calculs de référence instantanés et des métriques éducatives. Calculs en temps réel.',
  de: 'Entwickelt für schnelle Referenzberechnungen und lehrreiche Werte. Echtzeitberechnungen.',
  ko: '실시간 참고 계산 및 교육용 지표를 제공합니다.',
  hi: 'तत्काल संदर्भ गणना और शैक्षिक मेट्रिक्स के लिए निर्मित। वास्तविक समय गणना।'
};

const bHome = { en: 'Home', es: 'Inicio', fr: 'Accueil', de: 'Startseite', ko: '홈', hi: 'मुख्य पृष्ठ' }[lang];
const bCalc = { en: 'Calculators', es: 'Calculadoras', fr: 'Calculateurs', de: 'Rechner', ko: '계산기', hi: 'कैलकुलेटर' }[lang];

const checklist3DBmi: Record<string, string[]> = {
  en: [
    'Height-adjusted Oxford 2.5 Power Formula (1.3 × weight / height²·⁵)',
    'Corrects tall and short stature distortions in standard 2D BMI',
    'Compare 3D score directly against WHO healthy weight thresholds',
    'Interactive 360° avatar scaling directly inside your browser'
  ],
  es: [
    'Fórmula Oxford 2.5 Exponencial ajustada por altura (1.3 × peso / altura²·⁵)',
    'Corrige la distorsión de estaturas altas y bajas del IMC 2D estándar',
    'Compara la puntuación 3D frente a los umbrales de peso saludable de la OMS',
    'Escalado interactivo del avatar 3D en 360° en tu navegador'
  ],
  fr: [
    'Formule Oxford 2.5 ajustée à la stature (1.3 × poids / taille²·⁵)',
    'Corrige les biais de taille des personnes très grandes ou très petites',
    'Comparez le score 3D aux seuils de poids santé de l\'OMS',
    'Ajustement d\'avatar 3D interactif à 360° directement dans le navigateur'
  ],
  de: [
    'Höhenkorrigierte Oxford 2.5 Potenzformel (1.3 × Gewicht / Größe²·⁵)',
    'Korrigiert Verzerrungen bei sehr großen oder kleinen Personen',
    'Direkter Vergleich mit WHO-Grenzwerten für Normalgewicht',
    'Interaktives 360°-Avatar-Modell direkt im Webbrowser'
  ],
  ko: [
    '신장 보정 옥스포드 2.5 체질량 공식 (1.3 × 체중 / 신장²·⁵)',
    '표준 2D BMI의 키가 크거나 작은 사람에 대한 왜곡 보정',
    'WHO 정상 체중 기준점과 3D 점수 실시간 비교',
    '브라우저 내 360° 대화형 3D 아바타 체형 반영'
  ],
  hi: [
    'ऊंचाई-समायोजित ऑक्सफोर्ड 2.5 फॉर्मूला (1.3 × वजन / ऊंचाई²·⁵)',
    'लंबे और छोटे कद के व्यक्तियों के लिए मानक बीएमआई विसंगति में सुधार',
    'डब्ल्यूएचओ (WHO) स्वस्थ वजन सीमा के साथ 3D स्कोर की तुलना',
    'ब्राउज़र में 360° इंटरएक्टिव 3D अवतार स्केलिंग'
  ]
};

const checklist3DVisualizer: Record<string, string[]> = {
  en: [
    'Full 360° interactive avatar camera rotation with mouse & touch drag',
    'Real-time anatomical silhouette morphing based on body proportions',
    'Toggle between Solid 3D Mesh, Wireframe, and Heatmap views',
    'Inspect front, profile, and back body shape contours privately'
  ],
  es: [
    'Rotación interactiva de cámara en 360° mediante ratón y controles táctiles',
    'Modelado anatómico en tiempo real según proporciones corporales',
    'Alterna entre vistas de Malla Sólida, Estructura de Alambre y Mapa de Calor',
    'Inspecciona contornos frontales, de perfil y posteriores en total privacidad'
  ],
  fr: [
    'Rotation de caméra 360° interactive à la souris et au toucher',
    'Modélisation anatomique en temps réel selon les proportions corporelles',
    'Basculez entre Maillage Solide, Fil de Fer et Carte Thermique',
    'Analysez la silhouette de face, de profil et de dos en toute confidentialité'
  ],
  de: [
    'Interaktive 360°-Kameradrehung per Maus- und Touch-Steuerung',
    'Anatomische Echtzeit-Modellierung basierend auf Körperproportionen',
    'Umschalten zwischen Solidem Netz, Drahtmodell und Heatmap-Ansicht',
    'Betrachten Sie Vorder-, Seiten- und Rückansicht mit voller Privatsphäre'
  ],
  ko: [
    '마우스 드래그 및 터치 조작을 통한 360° 자유 회전 3D 카메라 뷰',
    '신체 비율 데이터에 기반한 실시간 해부학적 체형 모핑',
    '솔리드 메쉬, 와이어프레임 구조, 비만도 히트맵 모드 전환',
    '전면, 측면, 후면 체형 실루엣을 비공개로 안전하게 확인'
  ],
  hi: [
    'माउस और टच ड्रैग के साथ 360° इंटरएक्टिव कैमरा रोटेशन',
    'शारीरिक अनुपातों के आधार पर वास्तविक समय में शारीरिक रूप-परिवर्तन',
    'सॉलिड 3D मेश, वायरफ्रेम और हीटमैप व्यू के बीच टॉगल करें',
    'सामने, बगल और पीछे के शारीरिक आकार को पूर्ण गोपनीयता में देखें'
  ]
};

const items3D = (calc.slug === '3d-bmi-calculator' ? checklist3DBmi[lang] : checklist3DVisualizer[lang]) || checklist3DBmi.en;

// WebApplication Schema for SEO
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": calc.name[lang] || calc.name['en'],
  "url": canonicalUrl,
  "description": pageDesc,
  "applicationCategory": "HealthApplication",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "operatingSystem": "All"
};
// Curated domain-relevant articles to eliminate generic repetitive article dumping
const relevantArticlesBySlug: Record<string, string[]> = {
  'bmi-calculator': ['what-is-bmi', 'bmi-chart-for-men-women', 'bmi-calculator-teens'],
  '3d-bmi-calculator': ['what-is-bmi', 'bmi-vs-body-fat', 'bmi-chart'],
  '3d-body-visualizer': ['what-is-bmi', 'bmi-vs-body-fat', 'bmi-chart-for-men-women'],
  'bmi-chart': ['bmi-chart-for-men-women', 'bmi-chart', 'bmi-by-age'],
  'healthy-weight-by-height': ['healthy-weight-chart', 'bmi-by-age', 'bmi-calculator-teens'],
  'bmi-calculator-for-indians': ['healthy-bmi-range-indians', 'bmi-calculator-india'],
  'asian-bmi-calculator': ['healthy-bmi-range-indians', 'bmi-calculator-india'],
  'bmr-calculator': ['bmr-vs-tdee-calculator', 'what-is-bmi'],
  'tdee-calculator': ['bmr-vs-tdee-calculator', 'what-is-bmi'],
  'maintenance-calorie-calculator': ['bmr-vs-tdee-calculator', 'what-is-bmi'],
  'calorie-calculator': ['bmr-vs-tdee-calculator', 'healthy-weight-chart'],
  'macro-calculator': ['bmr-vs-tdee-calculator', 'bmi-vs-body-fat'],
  'body-fat-calculator': ['bmi-vs-body-fat', 'is-bmi-accurate'],
  'lean-body-mass-calculator': ['bmi-vs-body-fat', 'is-bmi-accurate'],
  'ideal-weight-calculator': ['healthy-weight-chart', 'what-is-bmi'],
  'waist-to-hip-ratio-calculator': ['bmi-vs-body-fat', 'is-bmi-accurate'],
  'body-surface-area-calculator': ['what-is-bmi', 'is-bmi-accurate'],
  'heart-rate-zone-calculator': ['is-bmi-accurate', 'bmr-vs-tdee-calculator'],
  'karvonen-heart-rate-calculator': ['is-bmi-accurate', 'bmr-vs-tdee-calculator'],
  '1rm-calculator': ['bmi-vs-body-fat', 'is-bmi-accurate'],
  'one-rep-max-calculator': ['bmi-vs-body-fat', 'is-bmi-accurate'],
  'protein-intake-calculator': ['bmr-vs-tdee-calculator', 'bmi-vs-body-fat'],
  'water-intake-calculator': ['bmr-vs-tdee-calculator', 'healthy-weight-chart', 'bmi-calculator-teens'],
  'pregnancy-weight-gain-calculator': ['what-is-bmi', 'healthy-weight-chart', 'bmi-by-age'],
  'diabetes-risk-calculator': ['healthy-bmi-range-indians', 'bmi-by-age', 'what-is-bmi']
};

const relatedGuidesTitle: Record<string, string> = {
  en: 'Related Evidence-Based Guides',
  es: 'Guías Basadas en Evidencia Relacionadas',
  fr: 'Guides Basés sur des Preuves Associés',
  de: 'Verwandte Evidenzbasierte Leitfäden',
  ko: '관련 증거 기반 건강 가이드',
  hi: 'संबंधित साक्ष्य-आधारित गाइड'
};

const relatedGuidesSubtitle: Record<string, string> = {
  en: 'Curated clinical reference articles and educational explanations tailored to this calculator.',
  es: 'Artículos de referencia clínica y explicaciones educativas seleccionadas para esta calculadora.',
  fr: 'Articles de référence clinique et explications pédagogiques adaptés à ce calculateur.',
  de: 'Ausgewählte klinische Referenzartikel und Erläuterungen passend zu diesem Rechner.',
  ko: '이 계산기에 특화된 임상 참고 문헌 및 교육용 설명 자료입니다.',
  hi: 'इस कैलकुलेटर के लिए विशेष रूप से तैयार किए गए नैदानिक संदर्भ लेख और शैक्षिक विवरण।'
};
---

<Layout 
  title={pageTitle}
  description={pageDesc}
  canonicalURL={canonicalUrl}
>
  <!-- Inject WebApplication JSON-LD dynamically inside Layout context -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="json-ld"></script>
  
  <Navbar />
  
  <main class="pt-20 md:pt-24 pb-16 px-4 md:px-6 relative overflow-x-hidden">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-medium text-[var(--muted-foreground)]">
        <a href={`/${lang}/`} class="hover:text-[var(--accent)] transition-colors">{bHome}</a>
        <span>/</span>
        <a href={`/${lang}/#calculators`} class="hover:text-[var(--accent)] transition-colors">{bCalc}</a>
        <span>/</span>
        <span class="text-[var(--foreground)]">{calc.name[lang] || calc.name['en']}</span>
      </nav>

      <!-- Top Header text -->
      <div class="text-center space-y-4 max-w-3xl mx-auto">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {calc.name[lang] || calc.name['en']}
        </h1>
        <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium max-w-2xl mx-auto">
          {pageDesc}
        </p>

        <!-- Hero Trust & Privacy Feature Badges (Equal Parity across all Locales) -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-semibold text-[var(--muted-foreground)] pt-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            {{ en: '100% Free & Instant', es: '100% Gratis e Instantáneo', fr: '100% Gratuit et Instantané', de: '100% Kostenlos & Sofort', ko: '100% 무료 및 즉시 계산', hi: '100% मुफ़्त और त्वरित' }[lang]}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            {{ en: 'Browser-Based Privacy', es: 'Privacidad en Navegador', fr: 'Confidentialité sur Navigateur', de: 'Datenschutz im Browser', ko: '브라우저 기반 개인정보 보호', hi: 'सुरक्षित एवं निजी (ब्राउज़र में)' }[lang]}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ en: 'WHO & Reference Standards', es: 'Estándares de Referencia OMS', fr: 'Normes OMS et Références', de: 'WHO & Referenzstandards', ko: 'WHO 및 공중보건 참고 기준', hi: 'डब्ल्यूएचओ एवं संदर्भ मानक' }[lang]}
          </span>
        </div>
      </div>

      <!-- Main Calculator Layout -->
      {['3d-bmi-calculator', '3d-body-visualizer'].includes(calc.slug) ? (
        <div class="space-y-10 animate-in" style="animation-delay:100ms">
          <!-- Primary Highlight: 3D Body Visualizer Canvas Studio -->
          <div class="w-full">
            <ThreeDBodyVisualizer lang={lang} />
          </div>

          <!-- Featured Snippet SEO Checklist Box (Shifted below 3D studio for Google indexing) -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-5 rounded-2xl bg-[var(--card)] border border-[var(--border)] text-left text-xs font-semibold text-[var(--foreground)] max-w-3xl mx-auto shadow-xs">
            {items3D.map(item => (
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch animate-in" style="animation-delay:100ms">
          <UniversalCalculator calculator={calc} lang={lang} />
          <CalculatorResult lang={lang} />
        </div>
      )}

      <!-- Extended Content & Educational Reference Knowledge Base for Search Indexing -->
      <div class="pt-4 space-y-12">
        <ToolSEOContent slug={calc.slug} lang={lang} calculator={calc} />
        {calc.slug === 'bmi-calculator' && <EmbedWidgetBox lang={lang} />}
        <LatestArticles 
          lang={lang} 
          slugs={relevantArticlesBySlug[calc.slug] || ['what-is-bmi', 'is-bmi-accurate']}
          title={relatedGuidesTitle[lang] || relatedGuidesTitle.en}
          subtitle={relatedGuidesSubtitle[lang] || relatedGuidesSubtitle.en}
        />
      </div>

    </div>
  </main>
</Layout>
