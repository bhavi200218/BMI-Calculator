    hi: 'ऊंचाई के अनुसार स्वस्थ वजन, कद और वजन का चार्ट, ऊंचाई के हिसाब से सही वजन'
  },
  'bmi-calculator-for-indians': {
    en: 'bmi calculator for indians, indian bmi calculator, icmr bmi chart, asian indian bmi cutoffs, healthy weight for indians',
    es: 'calculadora de imc para indios, tabla de imc icmr, valores de imc asiatica, peso saludable indios',
    fr: 'calculateur imc pour indiens, grille imc icmr, seuils imc asiatique, poids sante indiens',
    de: 'bmi rechner fuer inder, icmr bmi tabelle, asiatische bmi grenzwerte, normalgewicht fuer inder',
    ko: '인도인 전용 bmi 계산기, icmr 체질량지수 표, 인도 성인 비만 기준, 아시아인 bmi',
    hi: 'भारतीयों के लिए बीएमआई कैलकुलेटर, आईसीएमआर बीएमआई चार्ट, भारतीय वजन सीमा, एशियाई बीएमआई'
  }
};

const calcKeywords = calcKeywordsMap[calc.slug]?.[lang] 
  || `${calc.name[lang] || calc.name['en']}, ${calc.slug.replace(/-/g, ' ')}, health calculator, reference standards, real bmi`;
---

<Layout 
  title={pageTitle}
  description={metaDesc}
  keywords={calcKeywords}
  canonicalURL={canonicalUrl}
>
  <!-- Inject WebApplication and MedicalWebPage JSON-LD dynamically inside Layout context -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="json-ld"></script>
  <script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)} slot="json-ld"></script>
  
  <Navbar />
  
  <main class="pt-20 md:pt-24 pb-16 px-4 md:px-6 relative overflow-x-hidden">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-medium text-[var(--muted-foreground)]">
        <a href={`/${lang}/`} class="hover:text-[var(--accent)] transition-colors">{bHome}</a><span class="sr-only">. </span>
        <span>/</span>
        <a href={`/${lang}/#calculators`} class="hover:text-[var(--accent)] transition-colors">{bCalc}</a><span class="sr-only">. </span>
        <span>/</span>
        <span class="text-[var(--foreground)]">{calc.name[lang] || calc.name['en']}</span><span class="sr-only">. </span>
      </nav>

      <!-- Top Header text -->
      <div class="text-center space-y-4 max-w-3xl mx-auto">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {calc.name[lang] || calc.name['en']}
        </h1>
        <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium max-w-2xl mx-auto">
          {pageDesc}
        </p>

        <!-- Hero Trust & Privacy Feature Badges (Equal Parity across all Locales) -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-semibold text-[var(--muted-foreground)] pt-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            {{ en: '100% Free & Instant', es: '100% Gratis e Instantáneo', fr: '100% Gratuit et Instantané', de: '100% Kostenlos & Sofort', ko: '100% 무료 및 즉시 계산', hi: '100% मुफ़्त और त्वरित' }[lang]}<span class="sr-only">. </span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            {{ en: 'Browser-Based Privacy', es: 'Privacidad en Navegador', fr: 'Confidentialité sur Navigateur', de: 'Datenschutz im Browser', ko: '브라우저 기반 개인정보 보호', hi: 'सुरक्षित एवं निजी (ब्राउज़र में)' }[lang]}<span class="sr-only">. </span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--muted)]/50 border border-[var(--border)]">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ en: 'WHO & Reference Standards', es: 'Estándares de Referencia OMS', fr: 'Normes OMS et Références', de: 'WHO & Referenzstandards', ko: 'WHO 및 공중보건 참고 기준', hi: 'डब्ल्यूएचओ एवं संदर्भ मानक' }[lang]}<span class="sr-only">. </span>
          </span>
        </div>
      </div>

      <!-- Population & Regional Standards Notice (Disambiguation for Indian vs Asian WHO Standards) -->
      {calc.slug === 'bmi-calculator-for-indians' && (
        <aside class="p-4 rounded-xl border border-amber-500/25 bg-amber-500/5 text-xs text-[var(--foreground)] max-w-3xl mx-auto flex items-start gap-3 text-left shadow-xs">
          <div class="w-6 h-6 rounded-full bg-amber-500/15 text-amber-500 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">ℹ</div>
          <div class="space-y-1">
            <p class="font-bold text-amber-600 dark:text-amber-400">
              {{
                en: 'Official Indian Consensus Standards (ICMR & MoHFW)',
                es: 'Estándares de Consenso para India (ICMR y MoHFW)',
                fr: 'Normes Officielles de Consensus pour l\'Inde (ICMR & MoHFW)',
                de: 'Offizielle indische Konsensusstandards (ICMR & MoHFW)',
                ko: '인도 공식 합의 표준 (ICMR 및 인도 보건부)',
                hi: 'आधिकारिक भारतीय सहमति मानक (ICMR एवं स्वास्थ्य मंत्रालय)'
              }[lang]}
            </p>
            <p class="text-[var(--muted-foreground)] leading-relaxed">
              {{
                en: 'This tool applies the Indian Council of Medical Research (ICMR) South Asian guidelines (Overweight ≥ 23.0 kg/m², Obesity ≥ 25.0 kg/m², and waist risk thresholds: 90 cm men / 80 cm women). Looking for East or Southeast Asian standards where obesity begins at 27.5 kg/m²?',
                es: 'Esta herramienta aplica las directrices del ICMR para el sur de Asia (Sobrepeso ≥ 23.0 kg/m², Obesidad ≥ 25.0 kg/m² y cintura de riesgo: 90 cm hombres / 80 cm mujeres). ¿Buscas las pautas para el Este y Sudeste Asiático donde la obesidad inicia en 27.5 kg/m²?',
                fr: 'Cet outil applique les directives du Conseil indien de la recherche médicale (ICMR) pour l\'Asie du Sud (Surpoids ≥ 23,0 kg/m², Obésité ≥ 25,0 kg/m² et seuil de tour de taille : 90 cm hommes / 80 cm femmes). Vous cherchez les normes pour l\'Asie de l\'Est où l\'obésité débute à 27,5 kg/m² ?',
                de: 'Dieser Rechner wendet die Richtlinien des Indian Council of Medical Research (ICMR) für Südasien an (Übergewicht ≥ 23,0 kg/m², Adipositas ≥ 25,0 kg/m² und Taillenrisiko: 90 cm Männer / 80 cm Frauen). Suchen Sie nach ostasiatischen Standards mit einer Adipositasschwelle von 27,5 kg/m²?',
                ko: '본 계산기는 인도 의학연구위원회(ICMR)의 남아시아 기준을 적용합니다(과체중 ≥ 23.0 kg/m², 비만 ≥ 25.0 kg/m², 복부비만 허리둘레 기준: 남 90cm / 여 80cm). 비만 기준이 27.5 kg/m²인 동아시아/동남아시아 판정 기준을 찾으시나요?',
                hi: 'यह टूल भारतीय चिकित्सा अनुसंधान परिषद (ICMR) के दक्षिण एशियाई दिशानिर्देश लागू करता है (अधिक वजन ≥ 23.0 kg/m², मोटापा ≥ 25.0 kg/m², एवं कमर जोखिम सीमा: 90 सेमी पुरुष / 80 सेमी महिला)। क्या आप पूर्वी या दक्षिण-पूर्वी एशियाई मानक (मोटापा कटऑफ ≥ 27.5 kg/m²) की तलाश कर रहे हैं?'
              }[lang]}
              {' '}
              <a href={`/${lang}/asian-bmi-calculator/`} class="text-[var(--accent)] font-semibold underline hover:text-[var(--accent)]/80 inline-flex items-center gap-1">
                {{
                  en: 'Open Asian BMI Calculator (WHO WPRO) →',
                  es: 'Ver Calculadora de IMC Asiático (OMS WPRO) →',
                  fr: 'Ouvrir le Calculateur d\'IMC Asiatique (OMS WPRO) →',
                  de: 'Asiatischen BMI-Rechner öffnen (WHO WPRO) →',
                  ko: '아시아인 BMI 계산기 (WHO WPRO) 열기 →',
                  hi: 'एशियाई बीएमआई कैलकुलेटर (WHO WPRO) देखें →'
                }[lang]}
              </a>
            </p>
          </div>
        </aside>
      )}

      {calc.slug === 'asian-bmi-calculator' && (
        <aside class="p-4 rounded-xl border border-blue-500/25 bg-blue-500/5 text-xs text-[var(--foreground)] max-w-3xl mx-auto flex items-start gap-3 text-left shadow-xs">
          <div class="w-6 h-6 rounded-full bg-blue-500/15 text-blue-500 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">ℹ</div>
          <div class="space-y-1">
            <p class="font-bold text-blue-600 dark:text-blue-400">
              {{
                en: 'WHO Western Pacific Region (WPRO 2004 Standards)',
                es: 'Norma de la OMS para el Pacífico Occidental (WPRO 2004)',
                fr: 'Norme OMS pour la Région Pacifique Occidental (WPRO 2004)',
                de: 'WHO-Region Westlicher Pazifik (WPRO 2004 Standards)',
                ko: 'WHO 서태평양 지역 지침 (WPRO 2004 판정 기준)',
                hi: 'WHO पश्चिमी प्रशांत क्षेत्रीय मानक (WPRO 2004)'
              }[lang]}
            </p>
            <p class="text-[var(--muted-foreground)] leading-relaxed">
              {{
                en: 'This tool applies the WHO Expert Consultation criteria for East and Southeast Asian adults (Chinese, Japanese, Korean, etc.), where increased risk begins at 23.0 kg/m² and obesity begins at 27.5 kg/m². If you are of South Asian or Indian descent, the ICMR recommends a stricter obesity threshold (≥ 25.0 kg/m²).',
                es: 'Esta herramienta aplica los criterios de la OMS para adultos del Este y Sudeste Asiático (China, Japón, Corea, etc.), donde el riesgo aumentado inicia en 23.0 kg/m² y la obesidad en 27.5 kg/m². Para ascendencia del sur de Asia o India, el ICMR recomienda un umbral de obesidad más estricto (≥ 25.0 kg/m²).',
                fr: 'Cet outil applique les critères de l\'OMS pour les adultes d\'Asie de l\'Est et du Sud-Est (Chine, Japon, Corée, etc.), où le risque accru débute à 23,0 kg/m² et l\'obésité à 27,5 kg/m². Pour les personnes d\'origine sud-asiatique ou indienne, l\'ICMR recommande un seuil d\'obésité plus strict (≥ 25,0 kg/m²).',
                de: 'Dieser Rechner wendet die Kriterien der WHO-Expertenkonsultation für Ost- und Südostasien (China, Japan, Korea usw.) an, wo das erhöhte Risiko bei 23,0 kg/m² und Adipositas bei 27,5 kg/m² beginnt. Für südasiatische oder indische Herkunft empfiehlt das ICMR einen strengeren Grenzwert (≥ 25,0 kg/m²).',
                ko: '본 도구는 동아시아 및 동남아시아 성인(한국인, 일본인, 중국인 등)을 위한 WHO 서태평양 기준을 적용합니다(주의 기준 23.0 kg/m², 비만 기준 27.5 kg/m²). 남아시아 또는 인도인 혈통인 경우 ICMR 권고에 따라 더 엄격한 비만 기준(≥ 25.0 kg/m²)이 적용됩니다.',
                hi: 'यह टूल पूर्वी और दक्षिण-पूर्वी एशियाई वयस्कों (चीनी, जापानी, कोरियाई आदि) के लिए डब्ल्यूएचओ विशेषज्ञ मानदंड लागू करता है, जहां अधिक जोखिम 23.0 kg/m² और मोटापा 27.5 kg/m² से शुरू होता है। यदि आप दक्षिण एशियाई या भारतीय मूल के हैं, तो ICMR अधिक सख्त मोटापा सीमा (≥ 25.0 kg/m²) की सिफारिश करता है।'
              }[lang]}
              {' '}
              <a href={`/${lang}/bmi-calculator-for-indians/`} class="text-[var(--accent)] font-semibold underline hover:text-[var(--accent)]/80 inline-flex items-center gap-1">
                {{
                  en: 'Open BMI Calculator for Indians (ICMR) →',
                  es: 'Ver Calculadora de IMC para Indios (ICMR) →',
                  fr: 'Ouvrir le Calculateur d\'IMC pour Indiens (ICMR) →',
                  de: 'Indischen BMI-Rechner öffnen (ICMR) →',
                  ko: '인도인 전용 BMI 계산기 (ICMR) 열기 →',
                  hi: 'भारतीयों के लिए बीएमआई कैलकुलेटर (ICMR) देखें →'
                }[lang]}
              </a>
            </p>
          </div>
        </aside>
      )}

      {calc.slug === 'bmi-calculator' && (
        <aside class="p-4 sm:p-5 rounded-2xl border border-[var(--border)] bg-[var(--card)] text-xs text-[var(--foreground)] max-w-4xl mx-auto shadow-xs">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-[var(--accent)]/10 text-[var(--accent)] font-bold shrink-0 text-base">🎯</span>
              <div class="space-y-0.5">
                <span class="font-bold text-[var(--foreground)] text-sm block">
                  {{
                    en: 'Looking for a specialized BMI calculator?',
                    es: '¿Buscas una calculadora de IMC especializada?',
                    fr: 'Vous recherchez un calculateur d\'IMC spécialisé ?',
                    de: 'Suchen Sie nach einem spezialisierten BMI-Rechner?',
                    ko: '맞춤형 특수 BMI 계산기를 찾으시나요?',
                    hi: 'क्या आप किसी विशिष्ट बीएमआई कैलकुलेटर की तलाश कर रहे हैं?'
                  }[lang]}
                </span>
                <span class="text-[var(--muted-foreground)] text-xs">
                  {{
                    en: 'Standard WHO cutoffs may not reflect ethnic differences or 3D body composition:',
                    es: 'Los cortes estándar de la OMS pueden no reflejar diferencias étnicas o composición 3D:',
                    fr: 'Les seuils de l\'OMS peuvent ne pas refléter les variations ethniques ou la silhouette 3D :',
                    de: 'Standard-WHO-Grenzwerte berücksichtigen ethnische Unterschiede oder 3D-Körperbau oft nicht:',
                    ko: '표준 WHO 기준은 인종별 체지방 특성이나 3D 체형을 모두 반영하지 못할 수 있습니다:',
                    hi: 'मानक डब्ल्यूएचओ कटऑफ जातीय भिन्नताओं या 3D शारीरिक संरचना को पूरी तरह नहीं दर्शाते:'
                  }[lang]}
                </span>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 pt-1 md:pt-0 shrink-0">
              <a href={`/${lang}/bmi-calculator-for-indians/`} class="px-3 py-1.5 rounded-lg bg-[var(--muted)]/70 hover:bg-[var(--accent)]/15 border border-[var(--border)] text-[var(--foreground)] hover:text-[var(--accent)] font-semibold text-xs transition-colors inline-flex items-center gap-1.5">
                <span>🇮🇳</span>
                {{
                  en: 'BMI for Indians (ICMR)',
                  es: 'IMC para Indios (ICMR)',
                  fr: 'IMC pour Indiens (ICMR)',
                  de: 'BMI für Inder (ICMR)',
                  ko: '인도인 전용 BMI (ICMR)',
                  hi: 'भारतीयों के लिए BMI (ICMR)'
                }[lang]}
              </a>
              <a href={`/${lang}/asian-bmi-calculator/`} class="px-3 py-1.5 rounded-lg bg-[var(--muted)]/70 hover:bg-[var(--accent)]/15 border border-[var(--border)] text-[var(--foreground)] hover:text-[var(--accent)] font-semibold text-xs transition-colors inline-flex items-center gap-1.5">
                <span>🌏</span>
                {{
                  en: 'Asian BMI (WHO WPRO)',
                  es: 'IMC Asiático (OMS)',
                  fr: 'IMC Asiatique (OMS)',
                  de: 'Asiatischer BMI (WHO)',
                  ko: '아시아인 BMI (WHO)',
                  hi: 'एशियाई बीएमआई (WHO)'
                }[lang]}
              </a>
              <a href={`/${lang}/3d-bmi-calculator/`} class="px-3 py-1.5 rounded-lg bg-[var(--muted)]/70 hover:bg-[var(--accent)]/15 border border-[var(--border)] text-[var(--foreground)] hover:text-[var(--accent)] font-semibold text-xs transition-colors inline-flex items-center gap-1.5">
                <span>🧍</span>
                {{
                  en: '3D BMI Visualizer',
                  es: 'Visualizador IMC 3D',
                  fr: 'Visualiseur IMC 3D',
                  de: '3D BMI Visualisierer',
                  ko: '3D 체형 시각화 도구',
                  hi: '3D बीएमआई विजुअलाइज़र'
                }[lang]}
              </a>
            </div>
          </div>
        </aside>
      )}

      <!-- Main Calculator Layout -->
      {calc.slug === '3d-bmi-calculator' ? (
        <div class="space-y-10 animate-in" style="animation-delay:100ms">
          <!-- Primary Highlight: 3D Body Visualizer Canvas Studio -->
          <div class="w-full">
            <ThreeDBodyVisualizer lang={lang} />
          </div>

          <!-- Featured Snippet SEO Checklist Box (Shifted below 3D studio for Google indexing) -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-5 rounded-2xl bg-[var(--card)] border border-[var(--border)] text-left text-xs font-semibold text-[var(--foreground)] max-w-3xl mx-auto shadow-xs">
            {items3D.map(item => (
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}<span class="sr-only">. </span>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch animate-in" style="animation-delay:100ms">
          <UniversalCalculator calculator={calc} lang={lang} />
          <CalculatorResult lang={lang} calculatorName={calc.name[lang] || calc.name.en} />
        </div>
      )}

      <!-- Extended Content & Educational Reference Knowledge Base for Search Indexing -->
      <div class="pt-4 space-y-10">
        <ToolSEOContent slug={calc.slug} lang={lang} calculator={calc} />
        {calc.slug === 'bmi-calculator-for-indians' && <IndianBmiClinicalGuide lang={lang} />}
        {calc.slug === 'bmi-calculator' && <EmbedWidgetBox lang={lang} />}
        <MedicalEEATBanner lang={lang} />
        <LatestArticles 
          lang={lang} 
          slugs={relevantArticlesBySlug[calc.slug] || ['what-is-bmi', 'is-bmi-accurate']}
          title={relatedGuidesTitle[lang] || relatedGuidesTitle.en}
          subtitle={relatedGuidesSubtitle[lang] || relatedGuidesSubtitle.en}
        />
      </div>

    </div>
  </main>
</Layout>
