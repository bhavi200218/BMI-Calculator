      "ko": "임신 전 체중, 신장, 현재 임신 주수(1~40주), 임신 유형(단태아 vs 쌍둥이)"
    },
    "output": {
      "en": "Target Weight Gain Range for Current Gestational Week and Total Recommended Term Goal (kg/lbs)",
      "hi": "वर्तमान सप्ताह हेतु अनुशंसित वजन वृद्धि सीमा एवं कुल गर्भावस्था लक्ष्य (किग्रा/पाउंड)",
      "es": "Rango Recomendado de Aumento de Peso para la Semana Gestacional Actual y Meta Total al Término",
      "fr": "Fourchette de Prise de Poids Recommandée pour la Semaine Actuelle et Objectif Total à Terme",
      "de": "Empfohlener Gewichtszunahmebereich für die aktuelle Schwangerschaftswoche & Gesamtziel bis zur Geburt",
      "ko": "현재 임신 주수에 따른 권장 적정 체중 증가 범위 및 만삭 시점의 총 권장 증량 목표치"
    },
    "limitations": {
      "en": "General guide for healthy singleton pregnancies. Gestational diabetes or health risks require direct medical care.",
      "hi": "सामान्य एकल व जुड़वां गर्भावस्था हेतु जनसंख्या दिशानिर्देश; गर्भावधि मधुमेह या उच्च रक्तचाप में व्यक्तिगत ओब्स्टेट्रिशियन सलाह अनिवार्य है।",
      "es": "Pautas poblacionales para embarazos sin complicaciones; diabetes gestacional o preeclampsia requieren seguimiento obstétrico individualizado.",
      "fr": "Recommandations valables pour les grossesses sans complication ; le diabète gestationnel ou la prééclampsie exigent un suivi médical personnalisé.",
      "de": "Populationsrichtlinien für unkomplizierte Schwangerschaften; Gestationsdiabetes oder Präeklampsie erfordern individuelle fachärztliche Betreuung.",
      "ko": "합병증이 없는 일반 임신 기준이며, 임신성 당뇨, 전자간증(임신중독증), 다태아 고위험 임신은 담당 산부인과 전문의의 개별 관리를 받아야 합니다."
    }
  }
];

const searchPlaceholders: Record<string, string> = {
  en: "Search calculator formulas (e.g. BMI, BMR, TDEE, Body Fat)...",
  es: "Buscar fórmulas de calculadoras (ej. IMC, BMR, TDEE, Grasa)...",
  fr: "Rechercher des formules (ex. IMC, BMR, TDEE, Masse Grasse)...",
  de: "Rechnerformeln suchen (z. B. BMI, BMR, TDEE, Körperfett)...",
  ko: "계산기 공식 검색 (예: BMI, BMR, TDEE, 체지방률)...",
  hi: "कैलकुलेटर सूत्र खोजें (जैसे बीएमआई, BMR, TDEE, शरीर की चर्बी)..."
};

const aliasSlugs = new Set(['one-rep-max-calculator', '3d-body-visualizer']);
const activeMethodology = methodologyMatrix.filter(item => !aliasSlugs.has(item.slug));
---

<Layout 
  title={currentI18n.title}
  description={currentI18n.description}
>
  <Navbar />
  
  <PageShell
    title={currentI18n.pageTitle}
    eyebrow={currentI18n.eyebrow}
    description={currentI18n.pageDesc}
    returnUrl={`/${lang}/`}
    returnLabel={currentI18n.returnLabel}
  >
    <div class="space-y-12">
      
      <!-- Intro & Product Statement Box -->
      <div class="p-6 md:p-8 rounded-2xl border border-[var(--accent)]/20 bg-[var(--card)] space-y-4 shadow-sm">
        <h2 class="text-2xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
          {lang === 'en' ? 'How We Calculate Your Health Numbers' : currentI18n.statementTitle}
        </h2>
        {lang === 'en' ? (
          <div class="space-y-3 text-sm text-[var(--muted-foreground)] leading-relaxed">
            <p>We use simple, open math. Good tools help you learn. They give you clear facts about your body.</p>
            <p>Our tools use tested formulas from trusted health groups. These include the World Health Organization and the CDC. Each math rule is well known and widely used.</p>
            <p>You can check the numbers yourself. You can test each step on paper. We show you the exact math on every page.</p>
            <p>Your privacy comes first. All math runs inside your web browser. No data goes to an outside server. We do not keep your age. We do not keep your height. We do not keep your weight. When you close the tab, your numbers are gone.</p>
            <p>Each tool has clear limits. A BMI score tells you about total weight. It does not measure body fat directly. A muscular athlete may have a high BMI. An older adult may have more fat with a normal BMI. That is why we offer 23 different tools. You can check body fat. You can check waist size. You can check daily calories. This gives you a clear picture of your health.</p>
            <p>We test our code each day. Automated tests check every formula. They verify metric math with kilograms and meters. They verify imperial math with pounds and inches. Both units give matching results. You can trust the numbers.</p>
            <p>Our tools are for learning only. They do not replace a visit to a doctor. If you have questions about your health, talk to a qualified medical provider.</p>
          </div>
        ) : (
          <p class="text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
            {currentI18n.statementDesc}
          </p>
        )}
      </div>

      <!-- Core Pillars Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {currentI18n.pillars.map(pillar => (
          <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2.5">
            <h3 class="text-lg font-display font-bold text-[var(--foreground)] uppercase tracking-wide">{pillar.title}</h3>
            <p class="text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{pillar.desc}</p>
          </div>
        ))}
      </div>

      <!-- Executive Algorithm & Formula Reference Table (Formula & Source Verification Table) -->
      <div class="space-y-4">
        <div class="space-y-1">
          <p class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">{currentI18n.matrixEyebrow}</p>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-[var(--foreground)] uppercase tracking-tight">
            {currentI18n.tableViewTitle}
          </h2>
          <p class="text-sm text-[var(--muted-foreground)] font-medium">
            {currentI18n.tableViewDesc}
          </p>
        </div>

        <div class="methodology-table-wrap p-4 sm:p-6 shadow-xs">
          <table class="methodology-matrix-table">
            <thead>
              <tr>
                <th style="width: 18%;">{currentI18n.tableColTool}</th>
                <th style="width: 20%;">{currentI18n.tableColFormula}</th>
                <th style="width: 18%;">{currentI18n.tableColSource}</th>
                <th style="width: 14%;">{currentI18n.tableColInputs}</th>
                <th style="width: 15%;">{currentI18n.tableColOutputs}</th>
                <th style="width: 15%;">{currentI18n.tableColLimitations}</th>
              </tr>
            </thead>
            <tbody>
              {activeMethodology.map((item) => {
                const foundCalc = calculators.find(c => c.slug === item.slug);
                const localizedName = foundCalc ? (foundCalc.name[lang] || foundCalc.name.en) : item.name;
                const locFormula = item.formula[lang] || item.formula.en;
                const locSource = item.source[lang] || item.source.en;
                const locInputs = item.inputs[lang] || item.inputs.en;
                const locOutput = item.output[lang] || item.output.en;
                const locLimitations = item.limitations[lang] || item.limitations.en;

                return (
                  <tr>
                    <td>
                      <a href={`/${lang}/${item.slug}/`} class="font-bold">
                        {localizedName}</a><span class="sr-only">. </span>
                      
                    </td>
                    <td class="font-mono text-xs">{locFormula}<span class="sr-only">. </span></td>
                    <td class="text-xs">{locSource}<span class="sr-only">. </span></td>
                    <td>{locInputs}<span class="sr-only">. </span></td>
                    <td>{locOutput}<span class="sr-only">. </span></td>
                    <td class="text-xs leading-relaxed">{locLimitations}<span class="sr-only">. </span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Interactive Detailed Methodology Accordion (23 Tools with Search) -->
      <div class="space-y-6 pt-4 border-t border-[var(--border)]">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div class="space-y-1">
            <p class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">{currentI18n.matrixEyebrow}</p>
            <h2 class="text-2xl md:text-3xl font-display font-bold text-[var(--foreground)] uppercase tracking-tight">
              {currentI18n.matrixTitle}
            </h2>
            <p class="text-sm text-[var(--muted-foreground)] font-medium">
              {currentI18n.matrixDesc}
            </p>
          </div>

          <!-- Interactive Search Input -->
          <div class="relative w-full sm:max-w-xs shrink-0">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--muted-foreground)]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input 
              type="search" 
              id="methodologySearchInput" 
              placeholder={searchPlaceholders[lang] || searchPlaceholders.en} 
              autocomplete="off"
              class="w-full pl-10 pr-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--card)] text-xs text-[var(--foreground)] placeholder-[var(--muted-foreground)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50 focus:border-[var(--accent)] shadow-xs transition-all"
            />
          </div>
        </div>

        <!-- Accordion List -->
        <div class="space-y-3" id="methodologyAccordionList">
          {activeMethodology.map((item) => {
            const foundCalc = calculators.find(c => c.slug === item.slug);
            const localizedName = foundCalc ? (foundCalc.name[lang] || foundCalc.name.en) : item.name;

            const locFormula = item.formula[lang] || item.formula.en;
            const locSource = item.source[lang] || item.source.en;
            const locInputs = item.inputs[lang] || item.inputs.en;
            const locOutput = item.output[lang] || item.output.en;
            const locLimitations = item.limitations[lang] || item.limitations.en;

            return (
              <details 
                class="methodology-accordion group rounded-xl border border-[var(--border)] bg-[var(--card)] overflow-hidden transition-all duration-200 hover:border-[var(--accent)]/50 shadow-xs"
                data-search={`${localizedName} ${locFormula} ${locSource} ${item.slug}`.toLowerCase()}
              >
                <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer select-none list-none gap-4">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)] shrink-0"></span>
                    <h3 class="text-base sm:text-lg font-display font-bold text-[var(--foreground)] truncate">
                      {localizedName}
                    </h3>
                    <span class="hidden sm:inline-block px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-[var(--muted)] border border-[var(--border)] text-[var(--muted-foreground)] truncate max-w-[220px]">
                      {locOutput}
                    </span>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <a 
                      href={`/${lang}/${item.slug}/`} 
                      class="hidden md:inline-flex items-center gap-1 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] hover:underline"
                    >
                      {currentI18n.openTool}
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                    <span class="w-6 h-6 rounded-lg bg-[var(--muted)]/50 flex items-center justify-center text-[var(--muted-foreground)] group-open:rotate-180 transition-transform duration-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </span>
                  </div>
                </summary>

                <div class="p-5 sm:p-6 pt-2 border-t border-[var(--border)]/60 bg-[var(--muted)]/10 space-y-4">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                    <div class="space-y-1.5 p-3 rounded-lg bg-[var(--card)] border border-[var(--border)]">
                      <span class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-[10px]">{currentI18n.equationLabel}</span>
                      <p class="font-mono text-[var(--foreground)] font-semibold break-words">{locFormula}<span class="sr-only">. </span></p>
                    </div>
                    <div class="space-y-1.5 p-3 rounded-lg bg-[var(--card)] border border-[var(--border)]">
                      <span class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-[10px]">{currentI18n.sourceLabel}</span>
                      <p class="text-[var(--foreground)] font-medium leading-relaxed">{locSource}<span class="sr-only">. </span></p>
                    </div>
                  </div>

                  <div class="p-3.5 rounded-lg bg-[var(--card)] border border-[var(--border)] space-y-1.5 text-xs">
                    <p><strong class="text-[var(--foreground)]">{currentI18n.inputsLabel}:</strong> <span class="text-[var(--muted-foreground)] font-medium">{locInputs}</span></p>
                    <p><strong class="text-[var(--foreground)]">{currentI18n.outputLabel}:</strong> <span class="text-[var(--muted-foreground)] font-medium">{locOutput}</span></p>
                    <p><strong class="text-[var(--foreground)]">{currentI18n.limitationsLabel}:</strong> <span class="text-[var(--muted-foreground)] font-medium leading-relaxed">{locLimitations}</span></p>
                  </div>

                  <div class="pt-2 flex justify-end md:hidden">
                    <a 
                      href={`/${lang}/${item.slug}/`} 
                      class="inline-flex items-center gap-1.5 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] hover:underline"
                    >
                      {currentI18n.openTool} →
                    </a>
                  </div>
                </div>
              </details>
            );
          })}
        </div>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('methodologySearchInput');
            const accordions = document.querySelectorAll('.methodology-accordion');
            if (!searchInput || !accordions.length) return;

            searchInput.addEventListener('input', (e) => {
              const q = e.target.value.trim().toLowerCase();
              accordions.forEach(item => {
                const searchData = item.getAttribute('data-search') || '';
                if (!q || searchData.includes(q)) {
                  item.style.display = '';
                  if (q.length >= 2) {
                    item.open = true;
                  }
                } else {
                  item.style.display = 'none';
                }
              });
            });
          });
        </script>
      </div>

      <!-- Direct Academic Citations & Sources Cross-Link Banner -->
        <div class="p-6 md:p-8 rounded-2xl border-2 border-indigo-500/30 bg-indigo-500/5 space-y-4 not-prose shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="text-xs font-bold font-display uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
              {lang === 'hi' ? 'प्राथमिक अकादमिक शोध उद्धरण एवं संदर्भ' : (lang === 'es' ? 'Citas Académicas Primarias y Bibliografía' : (lang === 'fr' ? 'Citations Académiques Primaires & Bibliographie' : (lang === 'de' ? 'Primäre wissenschaftliche Zitate & Bibliographie' : (lang === 'ko' ? '직접 학술 연구 논문 인용 및 참고문헌' : 'Primary Academic Research Citations & Sources'))))}
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
              {currentI18n.studiesBadge}
            </span>
          </div>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
            {lang === 'hi' 
              ? 'केवल सामान्य संदर्भों के बजाय, Real BMI प्रत्येक कैलकुलेटर को सटीक अध्ययनों से जोड़ता है: WHO Technical Report Series 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, और Devine 1974।'
              : (lang === 'es'
                ? 'En lugar de menciones genéricas, Real BMI vincula cada calculadora con estudios fundamentales exactos: OMS TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987 y Devine 1974.'
                : (lang === 'fr'
                  ? 'Plutôt que de simples mentions institutionnelles, Real BMI adosse chaque outil à des études fondamentales précises : OMS TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987 et Devine 1974.'
                  : (lang === 'de'
                    ? 'Statt pauschaler Angaben verknüpft Real BMI jeden Rechner mit exakten Studien: WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987 und Devine 1974.'
                    : (lang === 'ko'
                      ? '모호한 기관명 약어 대신, Real BMI는 모든 계산기를 정밀한 논문(WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, Devine 1974)과 직접 연결합니다.'
                      : 'Rather than relying on vague acronym claims (WHO, CDC, NIH, ACSM), Real BMI links every calculator to exact landmark studies: WHO Technical Report Series 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, and Devine 1974.'))))}
          </p>
          <div class="pt-2">
            <a 
              href={`/${lang}/sources/`} 
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--accent)] text-white text-xs font-bold uppercase tracking-wider hover:opacity-95 transition-opacity"
            >
              <span>{lang === 'hi' ? 'प्राथमिक शोध उद्धरण मैट्रिक्स देखें (15 अध्ययन) →' : (lang === 'es' ? 'Explorar Matriz de Citas de Investigación (15 Estudios) →' : (lang === 'fr' ? 'Consulter la Matrice des Citations de Recherche (15 Études) →' : (lang === 'de' ? 'Forschungszitate-Matrix erkunden (15 Studien) →' : (lang === 'ko' ? '학술 연구 인용 매트릭스 탐색 (15편 연구) →' : 'Explore Primary Research Citations & Matrix (15 Studies) →'))))}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </PageShell>
</Layout>

<style>
  .methodology-table-wrap {
    overflow-x: auto;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background-color: var(--card);
  }
  .methodology-matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .methodology-matrix-table a {
    text-decoration: none;
    color: #464feb;
    font-weight: 600;
  }
  .methodology-matrix-table a:hover {
    text-decoration: underline;
  }
  .methodology-matrix-table tr th,
  .methodology-matrix-table tr td {
    border: 1px solid #e6e6e6;
    padding: 0.85rem 1rem;
    vertical-align: top;
    text-align: left;
  }
  .methodology-matrix-table tr th {
    background-color: #f5f5f5;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1f2937;
    white-space: nowrap;
  }
  :global(.dark) .methodology-matrix-table tr th,
  :global(.dark) .methodology-matrix-table tr td {
    border-color: rgba(255, 255, 255, 0.12);
  }
  :global(.dark) .methodology-matrix-table tr th {
    background-color: rgba(255, 255, 255, 0.06);
    color: #f3f4f6;
  }
  :global(.dark) .methodology-matrix-table a {
    color: #818cf8;
  }
</style>
