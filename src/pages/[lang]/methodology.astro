                  <div>
                    <span class="font-display font-bold uppercase text-[var(--muted-foreground)]">{currentI18n.limitationsLabel}</span>
                    <p class="text-[var(--muted-foreground)] font-medium mt-0.5 leading-relaxed">{locLimitations}</p>
                  </div>
                </div>
              </div>
            );
          })}
