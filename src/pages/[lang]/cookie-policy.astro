---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
import { locales, type Locale } from '../../utils/calculators';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Locale };

const content = {
  "en": {
    "pageTitle": "Cookie Policy | Real BMI",
    "pageDescription": "Read the official Cookie Policy for Real BMI. Learn about the essential local storage and privacy-focused cookies we use.",
    "title": "Cookie Policy",
    "eyebrow": "Transparency & Data Control",
    "description": "Detailed disclosure of the browser storage and cookie technologies utilized across Real BMI calculators.",
    "homeLabel": "Home",
    "sections": [
      {
        "heading": "1. Overview of Technologies Used & Zero-Retention Architecture",
        "body": "Real BMI is built upon a strict privacy-first web architecture. When you calculate your Body Mass Index (BMI), Basal Metabolic Rate (BMR), or Total Daily Energy Expenditure (TDEE), all computations execute completely within your personal web browser's local JavaScript engine. We never transmit your health measurements, height, weight, age, or physical metrics to remote web servers or third-party databases. To deliver a smooth, high-performance experience and support free public access, we utilize minimal browser local storage and third-party cookies as detailed below. You maintain complete control over which non-essential cookies you permit."
      },
      {
        "heading": "2. Strictly Necessary Functional Storage & UI Persistence",
        "body": "These items are technically required for the website and calculators to operate smoothly. They do not store personal identifiers, IP addresses, or medical data and cannot be disabled in our preference center. For example, we remember whether you prefer light mode or dark mode to avoid visual jarring when moving between pages. We also save your preference between metric units (centimeters and kilograms) and imperial units (feet, inches, and pounds). These preferences reside purely inside your local browser storage and are never uploaded to any remote server or shared across domains."
      },
      {
        "heading": "3. Anonymous Analytics & Telemetry (Optional, Consent-Gated)",
        "body": "Only with your explicit, prior permission do we use Google Analytics 4 to understand aggregate website usage patterns and optimize calculator performance. Google Analytics sets cookies such as _ga and _ga_* with a retention period of up to two years. These cookies collect anonymized telemetry such as page views, visitor referral channels, screen resolutions, and general device categories. We never collect or link names, email addresses, IP addresses, or medical calculations through analytics tools."
      },
      {
        "heading": "4. Digital Advertising Cookies & Free Service Sustainability",
        "body": "With your consent, Google AdSense uses advertising cookies such as __gads and __gpi (retained for up to 13 months) to display non-intrusive advertisements. These advertisements fund the ongoing hosting, development, and free public availability of all 23 computational health tools. If you decline advertising cookies, only non-personalized, contextual advertisements are served. We never permit pop-ups, autoplay audio, deceptive redirects, or intrusive full-screen interstitials."
      },
      {
        "heading": "5. How to Manage, Modify, or Withdraw Your Consent",
        "body": "You have complete control over your cookie choices at all times. You can open our interactive Cookie Preferences panel at any moment by clicking the 'Cookie Preferences' link located in the footer of every page on this website. From this panel, you can turn optional analytics and advertising cookies on or off with a single click. Your updated preferences apply immediately across all calculators and are stored locally for up to 12 months."
      },
      {
        "heading": "6. Browser Settings, Clearing Storage & Cross-Device Privacy",
        "body": "You can permanently delete or block cookies and local site data directly within your web browser settings (Chrome, Safari, Firefox, Edge). Clearing your browser cookies or cache will immediately remove your saved theme preferences, measurement units, and consent choices without affecting the mathematical functionality of our tools. Real BMI remains fully functional and mathematically precise even if you block all cookies or browse in strict private mode."
      },
      {
        "heading": "7. Cloudflare Edge Security & Network Integrity Storage",
        "body": "Real BMI is served globally through Cloudflare Pages edge network. Cloudflare may set essential security tokens (such as __cf_bm or cf_clearance) to detect malicious bot traffic, prevent automated content scraping, and protect our platform from distributed denial-of-service (DDoS) attacks. These security cookies do not track individual users across unrelated sites, do not build personal profiles, and contain zero personal health information."
      },
      {
        "heading": "8. Global Privacy Rights & Regulatory Compliance",
        "body": "We comply with major international privacy laws. This includes the European Union General Data Protection Regulation (GDPR), the ePrivacy Directive, the California Consumer Privacy Act (CCPA/CPRA), the UK Data Protection Act, and India's Digital Personal Data Protection (DPDP) Act. We honor Global Privacy Control (GPC) signals sent by modern web browsers. Under no circumstances do we sell, rent, or trade user data to data brokers or commercial marketing firms."
      },
      {
        "heading": "9. Global Privacy Control (GPC) & Do-Not-Track (DNT) Handling",
        "body": "Our website actively listens for Global Privacy Control (GPC) and Do-Not-Track (DNT) signals broadcast by your browser. When our platform detects an active GPC or DNT signal, all non-essential analytics and digital advertising cookies are automatically deactivated by default. In this scenario, only strictly necessary functional local storage elements required to render the user interface are enabled."
      },
      {
        "heading": "10. Step-by-Step Instructions: Managing Cookies in Popular Browsers",
        "body": "You can manage or delete cookies directly in your browser settings at any time: In Google Chrome, navigate to Settings > Privacy and Security > Third-Party Cookies. In Apple Safari, go to Settings > Privacy and choose 'Block All Cookies'. In Mozilla Firefox, select Settings > Privacy & Security > Cookies and Site Data. In Microsoft Edge, open Settings > Cookies and Site Permissions > Manage and Delete Cookies. Mobile users on iOS and Android can similarly manage cookies within their respective browser app preferences."
      },
      {
        "heading": "11. Third-Party Vendor Technical Disclosures",
        "body": "We maintain full transparency regarding all third-party vendors utilized on Real BMI. Our primary infrastructure partner is Cloudflare, Inc. (101 Townsend St, San Francisco, CA 94107, USA), providing edge CDN hosting and DDoS protection. Our advertising and analytics partner is Google LLC (1600 Amphitheatre Parkway, Mountain View, CA 94043, USA), operating Google AdSense and Google Analytics 4 under strict data processing agreements and standard contractual clauses."
      },
      {
        "heading": "12. Continuous Audit Cycle, Policy Updates & Contact",
        "body": "We perform a formal review of all scripts, cookies, and local storage items every six months to guarantee ongoing compliance with evolving privacy regulations. Any updates to our cookie practices will be published directly on this page with an updated revision date. If you have questions regarding our cookie practices, please contact founder and developer Bhawanshi Dosi in Banswara, Rajasthan, India, by emailing privacy@realbmicalculator.com."
      }
    ],
    "storageTableTitle": "Active Storage & Cookie Registry",
    "tableHeaders": [
      "Name / Key",
      "Type & Provider",
      "Purpose",
      "Duration"
    ],
    "storageRows": [
      [
        "theme",
        "Local Storage (Real BMI)",
        "Remembers your light or dark mode visual preference to prevent screen flickering.",
        "Persistent"
      ],
      [
        "bmiUnit",
        "Local Storage (Real BMI)",
        "Remembers your preferred units (metric cm/kg vs imperial ft/lbs) across calculators.",
        "Persistent"
      ],
      [
        "cookie_consent_preferences",
        "Local Storage (Real BMI)",
        "Records your cookie consent choices so we do not repeatedly show consent prompts.",
        "12 Months"
      ],
      [
        "_ga, _ga_*",
        "Cookie (Google Analytics)",
        "Measures anonymous aggregate traffic to improve tool performance and usability.",
        "Up to 2 Years"
      ],
      [
        "__gads, __gpi",
        "Cookie (Google AdSense)",
        "Serves non-intrusive ads to maintain free, open access to all health calculators.",
        "Up to 13 Months"
      ],
      [
        "__cf_bm, cf_clearance",
        "Cookie (Cloudflare Security)",
        "Essential edge security token to identify trusted web traffic and mitigate bot attacks.",
        "Up to 1 Year"
      ]
    ]
