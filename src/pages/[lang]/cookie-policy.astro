      {
        heading: "4. डिजिटल विज्ञापन कुकीज़ (वैकल्पिक)",
        body: "आपकी सहमति से, Google AdSense विज्ञापन कुकीज़ (__gads, 13 महीने तक) का उपयोग मुफ़्त सेवा बनाए रखने के लिए करता है। अस्वीकार करने पर गैर-वैयक्तिकृत विज्ञापन सेटिंग्स लागू होती हैं।"
      },
      {
        heading: "5. सहमति का प्रबंधन या वापस लेना",
        body: "आप किसी भी समय वेबसाइट के फुटर में 'कुकी प्राथमिकताएं' लिंक पर क्लिक करके अपनी पसंद बदल सकते हैं या सहमति वापस ले सकते हैं।"
      },
      {
        heading: "6. ब्राउज़र सेटिंग्स, मेमोरी साफ़ करना और गोपनीयता नियंत्रण",
        body: "आप अपने वेब ब्राउज़र (Chrome, Safari, Firefox, Edge) की सेटिंग्स के माध्यम से किसी भी समय सहेजी गई कुकीज़ और स्थानीय मेमोरी को हटा या ब्लॉक कर सकते हैं। ब्राउज़र डेटा साफ़ करने से आपकी थीम प्राथमिकताएं, माप इकाइयां और सहमति विकल्प रीसेट हो जाते हैं, लेकिन इससे कैलकुलेटर की गणितीय सटीकता पर कोई प्रभाव नहीं पड़ता। तृतीय-पक्ष कुकीज़ पूरी तरह से अवरुद्ध होने या गुप्त (Incognito) मोड में भी Real BMI के सभी स्वास्थ्य उपकरण पूरी तरह कार्यात्मक रहते हैं।"
      }
    ],
    storageTableTitle: "कुकी एवं स्टोरेज तालिका",
    tableHeaders: ["नाम / कुंजी", "प्रकार एवं प्रदाता", "उद्देश्य", "अवधि"],
    storageRows: [
      ["theme", "स्थानीय मेमोरी (Real BMI)", "डार्क/लाइट मोड प्राथमिकता को याद रखता है।", "स्थायी"],
      ["bmiUnit", "स्थानीय मेमोरी (Real BMI)", "मीट्रिक/इंपीरियल इकाइयों को याद रखता है।", "स्थायी"],
      ["cookie_consent_preferences", "स्थानीय मेमोरी (Real BMI)", "कुकी सहमति निर्णयों को सहेजता है।", "12 महीने"],
      ["_ga, _ga_*", "कुकी (Google Analytics)", "उपयोगिता सुधार हेतु अनाम ट्रैफ़िक मापन।", "2 वर्ष तक"],
      ["__gads, __gpi", "कुकी (Google AdSense)", "मुफ़्त स्वास्थ्य उपकरण बनाए रखने हेतु विज्ञापन।", "13 महीने तक"]
    ]
  }
};

const c = content[lang] || content.en;
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <Navbar />
  <PageShell
    title={c.title}
    eyebrow={c.eyebrow}
    description={c.description}
    returnUrl={`/${lang}/`}
    returnLabel={c.homeLabel}
  >
    <div class="space-y-8 text-[var(--muted-foreground)] leading-relaxed text-base md:text-lg font-medium">
      
      <div class="prose prose-zinc dark:prose-invert max-w-none space-y-6">
        {c.sections.map((section) => (
          <div>
            <h2 class="text-xl sm:text-2xl font-bold font-display uppercase tracking-tight text-[var(--foreground)] mb-3">
              {section.heading}
            </h2>
            <p>{section.body}</p>
          </div>
        ))}
      </div>

      <!-- Storage & Cookie Table -->
      <div class="pt-6 space-y-4">
        <h3 class="text-lg sm:text-xl font-bold font-display uppercase tracking-tight text-[var(--foreground)]">
          {c.storageTableTitle}
        </h3>
        <div class="overflow-x-auto rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead class="bg-[var(--muted)]/60 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs">
              <tr>
                {c.tableHeaders.map((header) => (
                  <th class="p-3 sm:p-4 font-bold">{header}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)]/60 text-[var(--foreground)]">
              {c.storageRows.map((row) => (
                <tr class="hover:bg-[var(--muted)]/20 transition-colors">
                  <td class="p-3 sm:p-4 font-mono font-semibold text-[var(--accent)]">{row[0]}</td>
                  <td class="p-3 sm:p-4">{row[1]}</td>
                  <td class="p-3 sm:p-4 text-[var(--muted-foreground)]">{row[2]}</td>
                  <td class="p-3 sm:p-4 font-medium whitespace-nowrap">{row[3]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Live Preferences Action Box -->
      <div class="p-6 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border border-[var(--border)] shadow-md flex flex-col sm:flex-row items-center justify-between gap-4 mt-8">
        <div>
          <h4 class="text-base font-bold font-display uppercase tracking-tight text-[var(--foreground)]">
            {lang === 'es' ? '¿Desea cambiar sus opciones?' :
             lang === 'fr' ? 'Souhaitez-vous modifier vos choix ?' :
             lang === 'de' ? 'Möchten Sie Ihre Einstellungen ändern?' :
             lang === 'ko' ? '설정을 변경하시겠습니까?' :
             lang === 'hi' ? 'क्या आप अपनी प्राथमिकताएं बदलना चाहते हैं?' :
             'Want to update your choices?'}
          </h4>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] mt-1">
            {lang === 'es' ? 'Abra el panel interactivo para actualizar o revocar su consentimiento en cualquier momento.' :
             lang === 'fr' ? 'Ouvrez le panneau interactif pour modifier ou retirer votre consentement.' :
             lang === 'de' ? 'Öffnen Sie das Einstellungsmenü, um Ihre Einwilligung jederzeit anzupassen.' :
             lang === 'ko' ? '언제든지 인터랙티브 패널을 열어 동의를 변경하거나 철회할 수 있습니다.' :
             lang === 'hi' ? 'अपनी सहमति को किसी भी समय अपडेट या वापस लेने के लिए पैनल खोलें।' :
             'Open the preference panel to adjust or withdraw your consent at any time.'}
          </p>
        </div>
        <button
          type="button"
          onclick="if(window.openCookiePreferences) window.openCookiePreferences();"
          class="shrink-0 min-h-[48px] px-5 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)] text-white shadow hover:scale-105 active:scale-95 transition-all cursor-pointer"
        >
          {lang === 'es' ? 'Gestionar Preferencias' :
           lang === 'fr' ? 'Gérer les Préférences' :
           lang === 'de' ? 'Präferenzen Anpassen' :
           lang === 'ko' ? '기본 설정 관리' :
           lang === 'hi' ? 'प्राथमिकताएं प्रबंधित करें' :
           'Manage Preferences'}
        </button>
      </div>

    </div>
  </PageShell>
</Layout>
