---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PageShell from '../../../components/PageShell.astro';
import LatestArticles from '../../../components/LatestArticles.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { calculators, type Locale } from '../../../utils/calculators';
import { getBlogCta, getBlogRelatedSlugs, getBlogRelatedArticles } from '../../../utils/blogRelatedTools';
import { enhanceArticleReferences } from '../../../utils/articleReferences';

export function getStaticPaths() {
  const supportedLocales = ['es', 'fr', 'de', 'ko', 'hi'];

  return supportedLocales.flatMap((locale) =>
    Object.keys(blogArticles).map((slug) => ({
      params: { lang: locale, slug }
    }))
  );
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;
const { slug } = params;
const article = blogArticles[slug as string] || blogArticles['what-is-bmi'];
const articleTitle = article.title[lang] || article.title.en;
const articleCategory = article.category ? (article.category[lang] || article.category.en) : 'Health';
const articleDescription = article.description[lang] || article.description.en;
const rawContentHtml = article.contentHtml ? (article.contentHtml[lang] || '') : '';
const clinicalBadge: Record<string, string> = {
  en: 'Evidence-Based Reference Standards',
  es: 'Estándares de Referencia Basados en Evidencia',
  fr: 'Normes de Référence Fondées sur des Preuves',
  de: 'Evidenzbasierte Referenzstandards',
  ko: '근거 기반 건강 참조 표준',
  hi: 'प्रमाण-आधारित स्वास्थ्य संदर्भ मानक'
};
const badgeLabel = clinicalBadge[lang] || clinicalBadge.en;

// Elimination of thin multilingual content & English fallback stitching:
// Non-English blog stubs are 301 redirected to the authoritative English articles.
// To guarantee zero Google AdSense "Low Value Content" penalties, all non-English blog pages are:
// 1) Canonicalized to the primary English article (/blog/${slug}/)
// 2) Permanently set to robots: 'noindex, follow' (0 indexable non-English blog pages)
// 3) Free from Frankenstein English fallback text block dumps
const articleContentHtml = rawContentHtml ? enhanceArticleReferences(slug as string, rawContentHtml, lang) : '';
const articleBody: string[] = (article.body ? (article.body[lang] || []) : []) || [];

const canonicalUrl = `https://realbmicalculator.com/en/blog/${slug}/`;
const cta = getBlogCta(slug as string, lang);
const robotsDirective = 'noindex, follow';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": articleTitle,
  "description": articleDescription,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Person",
    "name": "Bhawanshi Dosi",
    "jobTitle": "Software Engineer & Creator",
    "url": `https://realbmicalculator.com/${lang}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Real BMI",
    "logo": {
      "@type": "ImageObject",
      "url": "https://realbmicalculator.com/favicon.svg"
    }
  },
  "datePublished": article.datePublished || "2026-01-15",
  "dateModified": article.dateModified || "2026-10-21"
};

const datePublished = article.datePublished || "2026-01-15";
const dateModified = article.dateModified || "2026-10-21";

const blogLabels = {
  en: 'Back to Articles',
  es: 'Volver a los Artículos',
  fr: 'Retour aux Articles',
  de: 'Zurück zu den Artikeln',
  ko: '아티클 목록으로 돌아가기',
  hi: 'लेखों की सूची पर वापस जाएं'
};

const bylineLabels: Record<string, { writtenBy: string; author: string; role: string; published: string; updated: string }> = {
  en: { writtenBy: "Written by", author: "Bhawanshi Dosi", role: "Software Engineer & Creator • Banswara, Rajasthan, India", published: "Published", updated: "Last Updated" },
  es: { writtenBy: "Escrito por", author: "Bhawanshi Dosi", role: "Creadora y Desarrolladora • Banswara, Rajastán, India", published: "Publicado", updated: "Última Actualización" },
  fr: { writtenBy: "Rédigé par", author: "Bhawanshi Dosi", role: "Créatrice & Développeuse • Banswara, Rajasthan, Inde", published: "Publié le", updated: "Dernière Mise à Jour" },
  de: { writtenBy: "Verfasst von", author: "Bhawanshi Dosi", role: "Schöpferin & Entwicklerin • Banswara, Rajasthan, Indien", published: "Veröffentlicht", updated: "Zuletzt Aktualisiert" },
  ko: { writtenBy: "작성자", author: "Bhawanshi Dosi", role: "제작자 겸 소프트웨어 개발자 • 인도 라자스탄주 반스와라", published: "게시일", updated: "최종 업데이트" },
  hi: { writtenBy: "लेखक", author: "Bhawanshi Dosi", role: "निर्माता एवं सॉफ्टवेयर इंजीनियर • बांसवाड़ा, राजस्थान, भारत", published: "प्रकाशित", updated: "अंतिम अद्यतन" }
};
const byline = bylineLabels[lang] || bylineLabels.en;

const verificationBadges: Record<string, { algo: string; edu: string }> = {
  en: { algo: "Algorithmic Verification (WHO & CDC Equations)", edu: "Educational Resource • Non-Physician Authored" },
  es: { algo: "Verificación Algorítmica (Ecuaciones de la OMS y CDC)", edu: "Recurso Educativo • Sin Autoría Médica" },
  fr: { algo: "Vérification Algorithmique (Équations OMS & CDC)", edu: "Ressource Éducative • Non Rédigée par un Médecin" },
  de: { algo: "Algorithmische Verifizierung (WHO- & CDC-Gleichungen)", edu: "Pädagogische Ressource • Nicht von Ärzten verfasst" },
  ko: { algo: "알고리즘 수식 검증 (WHO 및 CDC 표준 공식)", edu: "교육용 건강 정보 • 의사 미작성 리소스" },
  hi: { algo: "एल्गोरिदम सत्यापन (WHO एवं CDC मानक सूत्र)", edu: "शैक्षणिक संसाधन • चिकित्सक द्वारा अप्रमाणित" }
};
const badges = verificationBadges[lang] || verificationBadges.en;

const authorBoxContent: Record<string, {
  aboutTitle: string;
  badge: string;
  bio: string;
  aboutLink: string;
  methodologyLink: string;
  sourcesLink: string;
  policyLink: string;
  verificationTitle: string;
  verificationDesc: string;
  disclaimerTitle: string;
  disclaimerDesc: string;
}> = {
  en: {
    aboutTitle: "About the Author",
    badge: "Software Engineer & Creator",
    bio: "Bhawanshi Dosi is a software engineer based in Banswara, Rajasthan, India, and the sole creator of Real BMI. She builds privacy-first, evidence-based health screening tools and educational reference resources built strictly on standardized formulas published by the World Health Organization (WHO), Centers for Disease Control and Prevention (CDC), and National Institutes of Health (NIH).",
    aboutLink: "About Bhawanshi",
    methodologyLink: "Calculation Methodology",
    sourcesLink: "Clinical Reference Sources",
    policyLink: "Editorial & Review Policy",
    verificationTitle: "Automated Algorithmic Verification",
    verificationDesc: "Every equation, imperial conversion constant (703), and metabolic formula (Mifflin-St Jeor, WHO cut-offs) cited in this guide is verified against published academic literature using automated test suites.",
    disclaimerTitle: "Non-Physician Educational Disclaimer",
    disclaimerDesc: "Real BMI is an independent educational tool, not a physician-reviewed or clinical healthcare service. This content is for educational screening only and is not medical advice. Always consult a licensed medical professional for clinical diagnosis or treatment."
  },
  es: {
    aboutTitle: "Sobre la Autora",
    badge: "Ingeniera de Software y Creadora",
    bio: "Bhawanshi Dosi es una ingeniera de software residente en Banswara, Rajastán, India, y la creadora exclusiva de Real BMI. Diseña calculadoras de cribado de salud con privacidad garantizada basadas estrictamente en fórmulas de la Organización Mundial de la Salud (OMS), CDC y NIH.",
    aboutLink: "Sobre Bhawanshi",
    methodologyLink: "Metodología de Cálculo",
    sourcesLink: "Fuentes Clínicas",
    policyLink: "Política Editorial",
    verificationTitle: "Verificación Algorítmica Automatizada",
    verificationDesc: "Cada ecuación, constante de conversión imperial (703) y fórmula metabólica (Mifflin-St Jeor, umbrales de la OMS) se verifica mediante pruebas matemáticas automatizadas.",
    disclaimerTitle: "Aviso Educativo sin Autoría Médica",
    disclaimerDesc: "Real BMI es una herramienta educativa independiente, no un servicio médico revisado por facultativos. No ofrece diagnóstico clínico ni prescripción médica. Consulte siempre con un profesional de la salud colegiado."
  },
  fr: {
    aboutTitle: "À propos de l'Auteure",
    badge: "Ingénieure Logicielle & Créatrice",
    bio: "Bhawanshi Dosi est une ingénieure logicielle basée à Banswara, Rajasthan, Inde, et l'unique créatrice de Real BMI. Elle conçoit des outils d'évaluation de santé confidentiels et rigoureusement conformes aux formules publiées par l'OMS, les CDC et les NIH.",
    aboutLink: "À propos de Bhawanshi",
    methodologyLink: "Méthodologie de Calcul",
    sourcesLink: "Sources de Référence",
    policyLink: "Politique Éditoriale",
    verificationTitle: "Vérification Algorithmique Automatisée",
    verificationDesc: "Chaque équation, constante de conversion impériale (703) et formule métabolique (Mifflin-St Jeor, seuils OMS) est rigoureusement validée par des suites de tests automatisées.",
    disclaimerTitle: "Avertissement Médical et Pédagogique",
    disclaimerDesc: "Real BMI est une ressource pédagogique indépendante, non affiliée à un cabinet médical et non validée par un médecin praticien. Consultez systématiquement un médecin qualifié pour tout diagnostic personnel."
  },
  de: {
    aboutTitle: "Über die Autorin",
    badge: "Software-Ingenieurin & Schöpferin",
    bio: "Bhawanshi Dosi ist eine Software-Ingenieurin aus Banswara, Rajasthan, Indien, und die alleinige Schöpferin von Real BMI. Sie entwickelt datenschutzfreundliche Gesundheitsrechner basierend auf standardisierten Formeln von WHO, CDC und NIH.",
    aboutLink: "Über Bhawanshi",
    methodologyLink: "Berechnungsmethodik",
    sourcesLink: "Klinische Quellen",
    policyLink: "Redaktionsrichtlinie",
    verificationTitle: "Automatisierte algorithmische Verifizierung",
    verificationDesc: "Jede Gleichung, Umrechnungskonstante (703) und Stoffwechselformal (Mifflin-St Jeor, WHO-Grenzwerte) wird durch automatisierte Testsuiten gegen die wissenschaftliche Literatur abgeglichen.",
    disclaimerTitle: "Pädagogischer medizinischer Hinweis",
    disclaimerDesc: "Real BMI ist ein unabhängiges Bildungswerkzeug und kein ärztlich geprüfter medizinischer Dienst. Die Inhalte dienen ausschließlich der allgemeinen Orientierung und ersetzen keine professionelle Diagnose."
  },
  ko: {
    aboutTitle: "저자 소개",
    badge: "소프트웨어 엔지니어 겸 단독 제작자",
    bio: "Bhawanshi Dosi는 인도 라자스탄주 반스와라에 거주하는 소프트웨어 엔지니어이자 Real BMI의 단독 제작자입니다. 세계보건기구(WHO), 미국 질병통제예방센터(CDC), 국립보건원(NIH) 공식 표준 지침을 준수하는 건강 계산 도구를 개발합니다.",
    aboutLink: "Bhawanshi 소개",
    methodologyLink: "계산 산출 방법론",
    sourcesLink: "임상 참고 문헌",
    policyLink: "편집 및 검토 원칙",
    verificationTitle: "자동화된 알고리즘 수식 검증",
    verificationDesc: "본 가이드의 모든 수식과 상수(703 임페리얼 계수, Mifflin-St Jeor 공식 등)는 공식 의학 논문 기준 자동화 테스트 스위트를 통해 수학적으로 검증되었습니다.",
    disclaimerTitle: "교육용 건강 안내 및 법적 고지",
    disclaimerDesc: "Real BMI는 소프트웨어 엔지니어가 개발한 독립 교육 도구이며, 의사가 직접 진단하는 의료 서비스가 아닙니다. 질병 진단이나 치료 결정은 반드시 공인 의료진과 상담하십시오."
  },
  hi: {
    aboutTitle: "लेखक के बारे में",
    badge: "सॉफ्टवेयर इंजीनियर एवं निर्माता",
    bio: "भवंशी दोसी बांसवाड़ा, राजस्थान, भारत की एक सॉफ्टवेयर इंजीनियर हैं और Real BMI की एकमात्र निर्माता हैं। वे विश्व स्वास्थ्य संगठन (WHO), CDC और NIH के मानकीकृत सूत्रों पर आधारित गोपनीयता-अनुकूल और साक्ष्य-समर्थित स्वास्थ्य गणना टूल्स विकसित करती हैं।",
    aboutLink: "भवंशी के बारे में",
    methodologyLink: "गणना पद्धति",
    sourcesLink: "वैज्ञानिक संदर्भ",
    policyLink: "संपादकीय नीति",
    verificationTitle: "स्वचालित एल्गोरिदम सत्यापन",
    verificationDesc: "इस लेख में प्रयुक्त प्रत्येक फॉर्मूला, इकाई रूपांतरण गुणांक (703) एवं उपापचयी समीकरण स्वचालित टेस्ट सूट द्वारा चिकित्सा साहित्य के अनुसार सत्यापित हैं।",
    disclaimerTitle: "शैक्षणिक चिकित्सा अस्वीकरण",
    disclaimerDesc: "Real BMI एक स्वतंत्र शैक्षणिक टूल है, यह किसी चिकित्सक द्वारा संचालित स्वास्थ्य सेवा नहीं है। यह सामग्री केवल सामान्य जानकारी के लिए है और चिकित्सा सलाह नहीं है। व्यक्तिगत स्वास्थ्य परामर्श के लिए सदैव योग्य चिकित्सक से संपर्क करें।"
  }
};
const authorBox = authorBoxContent[lang] || authorBoxContent.en;

const relatedArticleSlugs = getBlogRelatedArticles(slug as string);
const relatedToolSlugs = getBlogRelatedSlugs(slug as string);
const relatedCalcs = relatedToolSlugs
  .map(s => calculators.find(c => c.slug === s))
  .filter(Boolean);

const relatedGuidesTitle: Record<string, string> = {
  en: 'Related Evidence-Based Guides',
  es: 'Guías Basadas en Evidencia Relacionadas',
  fr: 'Guides Basés sur des Preuves Associés',
  de: 'Verwandte Evidenzbasierte Leitfäden',
  ko: '관련 증거 기반 건강 가이드',
  hi: 'संबंधित साक्ष्य-आधारित गाइड'
};

const relatedGuidesSubtitle: Record<string, string> = {
  en: 'Explore complementary health guides, clinical classifications, and physiological reference standards.',
  es: 'Explora guías de salud complementarias, clasificaciones clínicas y estándares de referencia.',
  fr: 'Découvrez des guides santé complémentaires, classifications cliniques et repères physiologiques.',
  de: 'Erkunden Sie ergänzende Gesundheitsleitfäden, klinische Klassifikationen und Referenzstandards.',
  ko: '보완적인 건강 가이드, 임상 분류 및 생리학적 표준 참조 지침을 확인하세요.',
  hi: 'पूरक स्वास्थ्य गाइड, नैदानिक वर्गीकरण और शारीरिक संदर्भ मानकों का अन्वेषण करें।'
};

const relatedToolsLabel: Record<string, string> = {
  en: 'Explore related tools:',
  es: 'Explora herramientas relacionadas:',
  fr: 'Découvrir les outils associés :',
  de: 'Verwandte Rechner entdecken:',
  ko: '관련 건강 계산기 바로가기:',
  hi: 'संबंधित टूल्स देखें:'
};
---

<Layout 
    title={`${articleTitle} | Real BMI`}
    description={articleDescription}
    canonicalURL={canonicalUrl}
    robots={robotsDirective}
>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="json-ld"></script>
    <Navbar />
    <PageShell
      title={articleTitle}
      eyebrow={articleCategory}
      description={articleDescription}
      returnUrl="/en/blog/"
      returnLabel={blogLabels[lang] || blogLabels.en}
    >
      <!-- Visible Editorial Byline & Verification Card -->
      <div class="not-prose mb-8 p-5 sm:p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-bold text-sm shadow">
              BD
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-wider font-semibold text-[var(--muted-foreground)]">{byline.writtenBy}</span>
                <a href={`/${lang}/about/`} class="text-sm font-bold text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">{byline.author}</a>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">{authorBox.badge}</span>
              </div>
              <p class="text-xs text-[var(--muted-foreground)]">{byline.role}</p>
            </div>
          </div>
          <div class="text-xs text-[var(--muted-foreground)] sm:text-right space-y-0.5 border-t sm:border-t-0 pt-2 sm:pt-0 border-[var(--border)]">
            <p><span class="font-medium text-[var(--foreground)]">{byline.published}:</span> {datePublished}</p>
            <p><span class="font-medium text-[var(--foreground)]">{byline.updated}:</span> {dateModified}</p>
          </div>
        </div>

        <!-- Verification & Review Transparency Badges -->
        <div class="pt-3 border-t border-[var(--border)] flex flex-wrap items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-medium border border-emerald-500/20">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            {badges.algo}
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-200 font-medium border border-amber-500/20">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
            {badges.edu}
          </span>
        </div>
      </div>

      <!-- Editorial Edition Notice -->
      <div class="not-prose mb-6 p-4 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)] text-xs text-[var(--muted-foreground)] flex items-center justify-between gap-3">
        <span>{{
          en: "Complete reference guide available in the primary English edition.",
          es: "Guía completa de referencia disponible en la edición principal en inglés.",
          fr: "Guide complet de référence disponible dans l'édition principale en anglais.",
          de: "Umfassender Referenzleitfaden in der offiziellen englischen Ausgabe verfügbar.",
          ko: "공식 영문 에디션에서 전체 심층 참조 가이드를 확인하실 수 있습니다.",
          hi: "संपूर्ण संदर्भ गाइड मुख्य अंग्रेजी संस्करण में उपलब्ध है।"
        }[lang]}</span>
        <a href={`/en/blog/${slug}/`} class="text-[var(--accent)] font-semibold underline shrink-0 hover:text-[var(--foreground)]">
          {{
            en: "Read full English guide →",
            es: "Leer en inglés →",
            fr: "Lire en anglais →",
            de: "Auf Englisch lesen →",
            ko: "영문 원본 읽기 →",
            hi: "अंग्रेजी में पढ़ें →"
          }[lang]}
        </a>
      </div>

      <article class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium article-container">
        {articleContentHtml ? (
          <div set:html={articleContentHtml} />
        ) : (
          <div class="space-y-6">
            {articleBody.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        <!-- Author Profile & Clinical Transparency Section -->
        <div class="mt-12 not-prose p-6 sm:p-8 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-sm space-y-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pb-6 border-b border-[var(--border)]">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-xl shadow-md shrink-0">
              BD
            </div>
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs uppercase tracking-wider font-semibold text-[var(--muted-foreground)]">{authorBox.aboutTitle}</span>
                <h4 class="text-lg font-bold text-[var(--foreground)]">Bhawanshi Dosi</h4>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">{authorBox.badge}</span>
              </div>
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                {authorBox.bio}
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-semibold text-[var(--accent)]">
                <a href={`/${lang}/about/`} class="hover:underline">{authorBox.aboutLink} &rarr;</a>
                <a href={`/${lang}/methodology/`} class="hover:underline">{authorBox.methodologyLink} &rarr;</a>
                <a href={`/${lang}/sources/`} class="hover:underline">{authorBox.sourcesLink} &rarr;</a>
                <a href={`/${lang}/editorial-policy/`} class="hover:underline">{authorBox.policyLink} &rarr;</a>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)] space-y-1.5">
              <div class="flex items-center gap-2 font-bold text-[var(--foreground)]">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                <span>{authorBox.verificationTitle}</span>
              </div>
              <p class="text-[var(--muted-foreground)] leading-normal">
                {authorBox.verificationDesc}
              </p>
            </div>

            <div class="p-4 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)] space-y-1.5">
              <div class="flex items-center gap-2 font-bold text-[var(--foreground)]">
                <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
                <span>{authorBox.disclaimerTitle}</span>
              </div>
              <p class="text-[var(--muted-foreground)] leading-normal">
                {authorBox.disclaimerDesc}
              </p>
            </div>
          </div>
        </div>

        <!-- 1. Related Evidence-Based Guides -->
        <div class="mt-14 not-prose">
          <LatestArticles 
            lang={lang}
            slugs={relatedArticleSlugs}
            limit={3}
            title={relatedGuidesTitle[lang] || relatedGuidesTitle.en}
            subtitle={relatedGuidesSubtitle[lang] || relatedGuidesSubtitle.en}
          />
        </div>

        <!-- 2. Calculator CTA (Contextual Interactive Tool) -->
        <div class="mt-8 not-prose space-y-4">
          <div class="p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border-2 border-[var(--accent)]/30 shadow-xl text-center space-y-5">
            <h3 class="text-2xl font-bold font-display uppercase tracking-tight text-[var(--foreground)]">{cta.title}</h3>
            <p class="text-base text-[var(--muted-foreground)] max-w-xl mx-auto font-sans">
              {cta.descPrefix} <a href={`/${lang}/${cta.targetSlug}/`} class="text-[var(--accent)] underline font-bold hover:text-[var(--foreground)] transition-colors">{cta.linkText}</a> {cta.descSuffix}
            </p>
            <a href={`/${lang}/${cta.targetSlug}/`} class="calc-btn-gradient px-8 py-4 rounded-xl font-black uppercase text-xs tracking-widest inline-block transition-all hover:scale-105 active:scale-95 shadow-lg text-white">
              {cta.btnText}
            </a>

            <!-- Compact Related Tool Badges -->
            {relatedCalcs.length > 0 && (
              <div class="pt-4 border-t border-[var(--border)]/50 flex flex-wrap items-center justify-center gap-2 text-xs">
                <span class="text-[var(--muted-foreground)] font-medium">{relatedToolsLabel[lang] || relatedToolsLabel.en}</span>
                {relatedCalcs.map((c) => (
                  <a 
                    href={`/${lang}/${c!.slug}/`} 
                    class="px-3 py-1 rounded-full bg-[var(--muted)]/50 hover:bg-[var(--accent)]/10 text-[var(--foreground)] hover:text-[var(--accent)] border border-[var(--border)] transition-colors font-semibold"
                  >
                    {c!.name[lang] || c!.name.en || c!.title[lang] || c!.title.en} →
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </article>
    </PageShell>
</Layout>

<style is:global>
