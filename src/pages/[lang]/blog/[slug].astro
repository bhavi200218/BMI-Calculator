---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PageShell from '../../../components/PageShell.astro';
import HubGrid from '../../../components/HubGrid.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { type Locale } from '../../../utils/calculators';

export function getStaticPaths() {
  const supportedLocales = ['en', 'es', 'fr', 'de', 'ko', 'hi'];

  return supportedLocales.flatMap((locale) =>
    Object.keys(blogArticles).map((slug) => ({
      params: { lang: locale, slug }
    }))
  );
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;
const { slug } = params;
const article = blogArticles[slug as string] || blogArticles['what-is-bmi'];
const articleTitle = article.title[lang] || article.title.en;
const articleCategory = article.category ? (article.category[lang] || article.category.en) : 'Health';
const articleDescription = article.description[lang] || article.description.en;
const articleContentHtml = article.contentHtml ? (article.contentHtml[lang] || article.contentHtml.en) : null;
const articleBody = article.body ? (article.body[lang] || article.body.en) : [];

const canonicalUrl = `https://realbmicalculator.com/${lang}/blog/${slug}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": articleTitle,
  "description": articleDescription,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": "Real BMI Health Editorial Team",
    "url": `https://realbmicalculator.com/${lang}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Real BMI",
    "logo": {
      "@type": "ImageObject",
      "url": "https://realbmicalculator.com/favicon.svg"
    }
  },
  "datePublished": "2026-01-01",
  "dateModified": new Date().toISOString().split('T')[0]
};

const blogLabels = {
  en: 'Back to Articles',
  es: 'Volver a los Artículos',
  fr: 'Retour aux Articles',
  de: 'Zurück zu den Artikeln',
  ko: '아티클 목록으로 돌아가기',
  hi: 'लेखों की सूची पर वापस जाएं'
};

const ctaLabels: Record<string, any> = {
  en: {
    title: "Want to know your BMI?",
    descPrefix: "Use our free",
    linkText: "BMI Calculator",
    descSuffix: "to get your result in seconds.",
    btnText: "Calculate My BMI Now →"
  },
  hi: {
    title: "क्या आप अपना BMI जानना चाहते हैं?",
    descPrefix: "कुछ ही सेकंड में सटीक परिणाम पाने के लिए हमारे मुफ़्त",
    linkText: "BMI कैलकुलेटर",
    descSuffix: "का उपयोग करें।",
    btnText: "अभी बीएमआई कैलकुलेट करें →"
  },
  es: {
    title: "¿Quieres saber tu IMC?",
    descPrefix: "Utiliza nuestra",
    linkText: "Calculadora de IMC",
    descSuffix: "gratuita para obtener tu resultado en segundos.",
    btnText: "Calcular Mi IMC Ahora →"
  },
  fr: {
    title: "Voulez-vous connaître votre IMC ?",
    descPrefix: "Utilisez notre",
    linkText: "Calculateur d'IMC",
    descSuffix: "gratuit pour obtenir votre résultat en quelques secondes.",
    btnText: "Calculer Mon IMC Maintenant →"
  },
  de: {
    title: "Möchten Sie Ihren BMI wissen?",
    descPrefix: "Nutzen Sie unseren kostenlosen",
    linkText: "BMI-Rechner",
    descSuffix: ", um Ihr Ergebnis in Sekunden zu erhalten.",
    btnText: "Jetzt Meinen BMI Berechnen →"
  },
  ko: {
    title: "당신의 BMI를 알고 싶으신가요?",
    descPrefix: "무료",
    linkText: "BMI 계산기",
    descSuffix: "를 사용하여 몇 초 만에 결과를 확인하세요.",
    btnText: "지금 내 BMI 계산하기 →"
  }
};

const cta = ctaLabels[lang] || ctaLabels.en;
---

<Layout 
    title={`${articleTitle} | Real BMI`}
    description={articleDescription}
    canonicalURL={canonicalUrl}
>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="json-ld"></script>
    <Navbar />
    <PageShell
      title={articleTitle}
      eyebrow={articleCategory}
      description={articleDescription}
      returnUrl={`/${lang}/blog`}
      returnLabel={blogLabels[lang] || blogLabels.en}
    >
      <article class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium">
        {articleContentHtml ? (
          <div set:html={articleContentHtml} />
        ) : (
          <div class="space-y-6">
            {articleBody.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        <!-- Natural In-Article Call to Action (CTA) Box -->
        <div class="my-12 p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border-2 border-[var(--accent)]/30 shadow-xl text-center space-y-4 not-prose">
          <h3 class="text-2xl font-bold font-display uppercase tracking-tight text-[var(--foreground)]">{cta.title}</h3>
          <p class="text-base text-[var(--muted-foreground)] max-w-xl mx-auto font-sans">
            {cta.descPrefix} <a href="/calculator" class="text-[var(--accent)] underline font-bold hover:text-[var(--foreground)] transition-colors">{cta.linkText}</a> {cta.descSuffix}
          </p>
          <a href="/calculator" class="calc-btn-gradient px-8 py-4 rounded-xl font-black uppercase text-xs tracking-widest inline-block transition-all hover:scale-105 active:scale-95 shadow-lg text-white">
            {cta.btnText}
          </a>
        </div>

        <div class="pt-12 border-t border-[var(--border)] not-prose">
          <HubGrid lang={lang} />
        </div>
      </article>
    </PageShell>
</Layout>
