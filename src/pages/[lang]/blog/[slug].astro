---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PageShell from '../../../components/PageShell.astro';
import BlogRelatedCalculators from '../../../components/BlogRelatedCalculators.astro';
import MedicalEEATBanner from '../../../components/MedicalEEATBanner.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { type Locale } from '../../../utils/calculators';
import { getBlogCta } from '../../../utils/blogRelatedTools';

export function getStaticPaths() {
  const supportedLocales = ['es', 'fr', 'de', 'ko', 'hi'];

  return supportedLocales.flatMap((locale) =>
    Object.keys(blogArticles).map((slug) => ({
      params: { lang: locale, slug }
    }))
  );
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;
const { slug } = params;
const article = blogArticles[slug as string] || blogArticles['what-is-bmi'];
const articleTitle = article.title[lang] || article.title.en;
const articleCategory = article.category ? (article.category[lang] || article.category.en) : 'Health';
const articleDescription = article.description[lang] || article.description.en;
const rawContentHtml = article.contentHtml ? (article.contentHtml[lang] || '') : '';
const cleanPlainText = rawContentHtml.replace(/<[^>]+>/g, '').trim();
const plainTextLen = cleanPlainText.length;
const wordCount = cleanPlainText ? cleanPlainText.split(/\s+/).filter(Boolean).length : 0;
const clinicalBadge: Record<string, string> = {
  en: 'Evidence-Based Reference Standards',
  es: 'Estándares de Referencia Basados en Evidencia',
  fr: 'Normes de Référence Fondées sur des Preuves',
  de: 'Evidenzbasierte Referenzstandards',
  ko: '근거 기반 건강 참조 표준',
  hi: 'प्रमाण-आधारित स्वास्थ्य संदर्भ मानक'
};
const badgeLabel = clinicalBadge[lang] || clinicalBadge.en;

// Elimination of thin multilingual content & English fallback stitching:
// Non-English blog stubs are 301 redirected to the authoritative English articles.
// To guarantee zero Google AdSense "Low Value Content" penalties, all non-English blog pages are:
// 1) Canonicalized to the primary English article (/blog/${slug}/)
// 2) Permanently set to robots: 'noindex, follow' (0 indexable non-English blog pages)
// 3) Free from Frankenstein English fallback text block dumps
const articleContentHtml = rawContentHtml || '';
const articleBody: string[] = (article.body ? (article.body[lang] || []) : []) || [];

const canonicalUrl = `https://realbmicalculator.com/blog/${slug}/`;
const cta = getBlogCta(slug as string, lang);
const robotsDirective = 'noindex, follow';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": articleTitle,
  "description": articleDescription,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": "Real BMI Editorial Team",
    "url": `https://realbmicalculator.com/${lang}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Real BMI",
    "logo": {
      "@type": "ImageObject",
      "url": "https://realbmicalculator.com/favicon.svg"
    }
  },
  "datePublished": article.datePublished || "2026-01-15",
  "dateModified": article.dateModified || "2026-10-21"
};

const datePublished = article.datePublished || "2026-01-15";
const dateModified = article.dateModified || "2026-10-21";

const blogLabels = {
  en: 'Back to Articles',
  es: 'Volver a los Artículos',
  fr: 'Retour aux Articles',
  de: 'Zurück zu den Artikeln',
  ko: '아티클 목록으로 돌아가기',
  hi: 'लेखों की सूची पर वापस जाएं'
};

const bylineLabels: Record<string, { writtenBy: string; author: string; role: string; published: string; updated: string }> = {
  en: { writtenBy: "Written by", author: "Real BMI Editorial Team", role: "Health Informatics & Research Review Staff", published: "Published", updated: "Updated" },
  es: { writtenBy: "Escrito por", author: "Equipo Editorial Real BMI", role: "Equipo de Informática de Salud e Investigación", published: "Publicado", updated: "Actualizado" },
  fr: { writtenBy: "Rédigé par", author: "Équipe Éditoriale Real BMI", role: "Équipe d'Informatique de Santé et de Recherche", published: "Publié le", updated: "Mis à jour" },
  de: { writtenBy: "Verfasst von", author: "Real BMI Redaktionsteam", role: "Gesundheitsinformatik- & Forschungsteam", published: "Veröffentlicht", updated: "Aktualisiert" },
  ko: { writtenBy: "작성자", author: "Real BMI 편집팀", role: "건강정보학 및 연구 리뷰팀", published: "게시일", updated: "업데이트" },
  hi: { writtenBy: "लेखक", author: "Real BMI संपादकीय टीम", role: "स्वास्थ्य सूचना विज्ञान एवं अनुसंधान समीक्षा टीम", published: "प्रकाशित", updated: "अद्यतित" }
};
const byline = bylineLabels[lang] || bylineLabels.en;
---

<Layout 
    title={`${articleTitle} | Real BMI`}
    description={articleDescription}
    canonicalURL={canonicalUrl}
    robots={robotsDirective}
>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="json-ld"></script>
    <Navbar />
    <PageShell
      title={articleTitle}
      eyebrow={articleCategory}
      description={articleDescription}
      returnUrl={`/${lang}/blog/`}
      returnLabel={blogLabels[lang] || blogLabels.en}
    >
      <!-- Visible Editorial Byline & Verification Card -->
      <div class="not-prose mb-8 p-4 sm:p-5 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-bold text-sm shadow">
            RB
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase tracking-wider font-semibold text-[var(--muted-foreground)]">{byline.writtenBy}</span>
              <a href={`/${lang}/about/`} class="text-sm font-bold text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">{byline.author}</a>
            </div>
            <p class="text-xs text-[var(--muted-foreground)]">{byline.role}</p>
          </div>
        </div>
        <div class="text-xs text-[var(--muted-foreground)] sm:text-right space-y-0.5 border-t sm:border-t-0 pt-2 sm:pt-0 border-[var(--border)]">
          <p><span class="font-medium text-[var(--foreground)]">{byline.published}:</span> {datePublished}</p>
          <p><span class="font-medium text-[var(--foreground)]">{byline.updated}:</span> {dateModified}</p>
        </div>
      <!-- Editorial Edition Notice -->
      <div class="not-prose mb-6 p-4 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)] text-xs text-[var(--muted-foreground)] flex items-center justify-between gap-3">
        <span>{{
          en: "Complete clinical guide available in the authoritative English edition.",
          es: "Guía clínica completa disponible en la edición oficial en inglés.",
          fr: "Guide clinique complet disponible dans l'édition officielle en anglais.",
          de: "Umfassender klinischer Leitfaden in der offiziellen englischen Ausgabe verfügbar.",
          ko: "공식 영문 에디션에서 전체 심층 임상 가이드를 확인하실 수 있습니다.",
          hi: "संपूर्ण नैदानिक गाइड आधिकारिक अंग्रेजी संस्करण में उपलब्ध है।"
        }[lang]}</span>
        <a href={`/blog/${slug}/`} class="text-[var(--accent)] font-semibold underline shrink-0 hover:text-[var(--foreground)]">
          {{
            en: "Read full English guide →",
            es: "Leer en inglés →",
            fr: "Lire en anglais →",
            de: "Auf Englisch lesen →",
            ko: "영문 원본 읽기 →",
            hi: "अंग्रेजी में पढ़ें →"
          }[lang]}
        </a>
      </div>

      <article class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium article-container">
        {articleContentHtml ? (
          <div set:html={articleContentHtml} />
        ) : (
          <div class="space-y-6">
            {articleBody.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        <!-- Editorial Transparency & Quality Standards -->
        <div class="mt-14 not-prose">
          <MedicalEEATBanner lang={lang} />
        </div>

        <!-- Complementary Calculation Tools & Interactive Next Steps (Shifted to End of Article) -->
        <div class="mt-14 pt-8 border-t border-[var(--border)] not-prose space-y-8">
          <div class="p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border-2 border-[var(--accent)]/30 shadow-xl text-center space-y-4">
            <h3 class="text-2xl font-bold font-display uppercase tracking-tight text-[var(--foreground)]">{cta.title}</h3>
            <p class="text-base text-[var(--muted-foreground)] max-w-xl mx-auto font-sans">
              {cta.descPrefix} <a href={`/${lang}/${cta.targetSlug}/`} class="text-[var(--accent)] underline font-bold hover:text-[var(--foreground)] transition-colors">{cta.linkText}</a> {cta.descSuffix}
            </p>
            <a href={`/${lang}/${cta.targetSlug}/`} class="calc-btn-gradient px-8 py-4 rounded-xl font-black uppercase text-xs tracking-widest inline-block transition-all hover:scale-105 active:scale-95 shadow-lg text-white">
              {cta.btnText}
            </a>
          </div>

          <BlogRelatedCalculators articleSlug={slug as string} lang={lang} />
        </div>
      </article>
    </PageShell>
</Layout>

<style is:global>
  /* Academic Reference & Table Standards */
  article.article-container a:not(.calc-btn-gradient) {
    text-decoration: none;
    color: #464feb;
  }
  article.article-container a:not(.calc-btn-gradient):hover {
    text-decoration: underline;
  }
  article.article-container tr th,
  article.article-container tr td {
    border: 1px solid #e6e6e6;
  }
  article.article-container tr th {
    background-color: #f5f5f5;
    color: #1e293b;
  }
  :global(.dark) article.article-container tr th,
  :global(.dark) article.article-container tr td {
    border-color: rgba(255, 255, 255, 0.12);
  }
  :global(.dark) article.article-container tr th {
    background-color: rgba(255, 255, 255, 0.05);
    color: #f1f5f9;
  }
</style>
