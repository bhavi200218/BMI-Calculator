---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PageShell from '../../../components/PageShell.astro';
import BlogRelatedCalculators from '../../../components/BlogRelatedCalculators.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { type Locale } from '../../../utils/calculators';
import { getBlogCta } from '../../../utils/blogRelatedTools';

export function getStaticPaths() {
  const supportedLocales = ['es', 'fr', 'de', 'ko', 'hi'];

  return supportedLocales.flatMap((locale) =>
    Object.keys(blogArticles).map((slug) => ({
      params: { lang: locale, slug }
    }))
  );
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;
const { slug } = params;
const article = blogArticles[slug as string] || blogArticles['what-is-bmi'];
const articleTitle = article.title[lang] || article.title.en;
const articleCategory = article.category ? (article.category[lang] || article.category.en) : 'Health';
const articleDescription = article.description[lang] || article.description.en;
const articleContentHtml = article.contentHtml ? (article.contentHtml[lang] || article.contentHtml.en) : null;
const articleBody = article.body ? (article.body[lang] || article.body.en) : [];

const canonicalUrl = `https://realbmicalculator.com/${lang}/blog/${slug}/`;
const cta = getBlogCta(slug as string, lang);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": articleTitle,
  "description": articleDescription,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Person",
    "name": "Bhawanshi Dosi",
    "url": `https://realbmicalculator.com/${lang}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Real BMI",
    "logo": {
      "@type": "ImageObject",
      "url": "https://realbmicalculator.com/favicon.svg"
    }
  },
  "datePublished": "2026-01-01",
  "dateModified": new Date().toISOString().split('T')[0]
};

const blogLabels = {
  en: 'Back to Articles',
  es: 'Volver a los Artículos',
  fr: 'Retour aux Articles',
  de: 'Zurück zu den Artikeln',
  ko: '아티클 목록으로 돌아가기',
  hi: 'लेखों की सूची पर वापस जाएं'
};

const bylineLabels: Record<string, { writtenBy: string; role: string; published: string; updated: string }> = {
  en: { writtenBy: "Written by", role: "Founder & Health Tools Developer, Real BMI", published: "Published", updated: "Updated" },
  es: { writtenBy: "Escrito por", role: "Fundador y Desarrollador, Real BMI", published: "Publicado", updated: "Actualizado" },
  fr: { writtenBy: "Rédigé par", role: "Fondateur et Développeur, Real BMI", published: "Publié le", updated: "Mis à jour" },
  de: { writtenBy: "Verfasst von", role: "Gründer & Entwickler, Real BMI", published: "Veröffentlicht", updated: "Aktualisiert" },
  ko: { writtenBy: "작성자", role: "Real BMI 설립자 및 개발자", published: "게시일", updated: "업데이트" },
  hi: { writtenBy: "लेखक", role: "संस्थापक एवं डेवलपर, Real BMI", published: "प्रकाशित", updated: "अद्यतित" }
};
const byline = bylineLabels[lang] || bylineLabels.en;
---

<Layout 
    title={`${articleTitle} | Real BMI`}
    description={articleDescription}
    canonicalURL={canonicalUrl}
>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="json-ld"></script>
    <Navbar />
    <PageShell
      title={articleTitle}
      eyebrow={articleCategory}
      description={articleDescription}
      returnUrl={`/${lang}/blog/`}
      returnLabel={blogLabels[lang] || blogLabels.en}
    >
      <!-- Visible Editorial Byline & Verification Card -->
      <div class="not-prose mb-8 p-4 sm:p-5 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-bold text-sm shadow">
            BD
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase tracking-wider font-semibold text-[var(--muted-foreground)]">{byline.writtenBy}</span>
              <a href={`/${lang}/about/`} class="text-sm font-bold text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">Bhawanshi Dosi</a>
            </div>
            <p class="text-xs text-[var(--muted-foreground)]">{byline.role}</p>
          </div>
        </div>
        <div class="text-xs text-[var(--muted-foreground)] sm:text-right space-y-0.5 border-t sm:border-t-0 pt-2 sm:pt-0 border-[var(--border)]">
          <p><span class="font-medium text-[var(--foreground)]">{byline.published}:</span> 2026-01-01</p>
          <p><span class="font-medium text-[var(--foreground)]">{byline.updated}:</span> 2026-10-21</p>
        </div>
      </div>

      <article class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium">
        {articleContentHtml ? (
          <div set:html={articleContentHtml} />
        ) : (
          <div class="space-y-6">
            {articleBody.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        <!-- Natural In-Article Contextual Call to Action (CTA) Box -->
        <div class="my-12 p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border-2 border-[var(--accent)]/30 shadow-xl text-center space-y-4 not-prose">
          <h3 class="text-2xl font-bold font-display uppercase tracking-tight text-[var(--foreground)]">{cta.title}</h3>
          <p class="text-base text-[var(--muted-foreground)] max-w-xl mx-auto font-sans">
            {cta.descPrefix} <a href={`/${lang}/${cta.targetSlug}/`} class="text-[var(--accent)] underline font-bold hover:text-[var(--foreground)] transition-colors">{cta.linkText}</a> {cta.descSuffix}
          </p>
          <a href={`/${lang}/${cta.targetSlug}/`} class="calc-btn-gradient px-8 py-4 rounded-xl font-black uppercase text-xs tracking-widest inline-block transition-all hover:scale-105 active:scale-95 shadow-lg text-white">
            {cta.btnText}
          </a>
        </div>

        <BlogRelatedCalculators articleSlug={slug as string} lang={lang} />
      </article>
    </PageShell>
</Layout>
