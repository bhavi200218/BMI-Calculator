---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { locales, type Locale } from '../../../utils/calculators';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang }
  }));
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;

const headers = {
  en: { 
    title: "Evidence-Based Health Articles", 
    desc: "Read clear guides on BMI, daily calories, and body health. All articles use trusted WHO and CDC standards to help you track your health." 
  },
  es: { 
    title: "Artículos de Salud Basados en Evidencia", 
    desc: "Explore artículos educativos sobre interpretación del IMC, gasto metabólico, composición corporal y condición cardiovascular basados en estándares de la OMS y los CDC." 
  },
  fr: { 
    title: "Articles de Santé Fondés sur des Preuves", 
    desc: "Découvrez des articles éducatifs sur l'interprétation de l'IMC, les dépenses métaboliques, la composition corporelle et le cardio selon les normes de l'OMS et des CDC." 
  },
  de: { 
    title: "Wissenschaftliche Gesundheitsartikel", 
    desc: "Wissenschaftlich fundierte Bildungsartikel zu BMI-Werten, Grundumsatz, Körperzusammensetzung und Herz-Kreislauf-Fitness auf Basis von WHO- und CDC-Standards." 
  },
  ko: { 
    title: "근거 중심 건강 아티클", 
    desc: "WHO 및 질병관리청(CDC) 표준에 기반한 BMI 분석, 기초대사량, 체성분 및 심혈관 건강 관련 신뢰할 수 있는 교육용 건강 아티클입니다." 
  },
  hi: { 
    title: "साक्ष्य-आधारित स्वास्थ्य लेख", 
    desc: "डब्ल्यूएचओ और सीडीसी के वैज्ञानिक मानकों पर आधारित बीएमआई, बेसल मेटाबॉलिज्म, शारीरिक संरचना और हृदय स्वास्थ्य से जुड़े साक्ष्य-आधारित शैक्षिक लेख।" 
  }
};

const articleBreadcrumbs: Record<string, string> = {
  en: 'Articles',
  es: 'Artículos',
  fr: 'Articles',
  de: 'Artikel',
  ko: '아티클',
  hi: 'लेख'
};

const homeLabels = {
  en: 'Home',
  es: 'Inicio',
  fr: 'Accueil',
  de: 'Startseite',
  ko: '홈',
  hi: 'होम'
};

const coreTopics = [
  { id: 'all', label: { en: 'All', es: 'Todos', fr: 'Tous', de: 'Alle', ko: '전체', hi: 'सभी' } },
  { id: 'bmi', label: { en: 'BMI', es: 'IMC', fr: 'IMC', de: 'BMI', ko: 'BMI', hi: 'बीएमआई' } },
  { id: 'weight', label: { en: 'Weight', es: 'Peso', fr: 'Poids', de: 'Gewicht', ko: '체중', hi: 'वजन' } },
  { id: 'metabolism', label: { en: 'Metabolism', es: 'Metabolismo', fr: 'Métabolisme', de: 'Stoffwechsel', ko: '대사', hi: 'मेटाबॉलिज्म' } },
  { id: 'nutrition', label: { en: 'Nutrition', es: 'Nutrición', fr: 'Nutrition', de: 'Ernährung', ko: '영양', hi: 'पोषण' } },
  { id: 'fitness', label: { en: 'Fitness', es: 'Fitness', fr: 'Fitness', de: 'Fitness', ko: '피트니스', hi: 'फिटनेस' } },
  { id: 'heart', label: { en: 'Heart Health', es: 'Salud Cardíaca', fr: 'Santé Cardiaque', de: 'Herzgesundheit', ko: '심혈관 건강', hi: 'हृदय स्वास्थ्य' } },
];

function getArticleTopic(slug: string, cat: string): string {
  const s = slug.toLowerCase();
  const c = cat.toLowerCase();

  // Specific high-intent topics mapped directly
  if (s.includes('nutrition') || s.includes('protein') || s.includes('macro') || s.includes('water') || s.includes('deficit')) return 'nutrition';
  if (s.includes('heart') || s.includes('blood-pressure') || s.includes('vo2') || s.includes('cardio') || s.includes('waist-to-hip')) return 'heart';
  if (s.includes('strength') || s.includes('resistance') || s.includes('neat') || s.includes('sarcopenia')) return 'fitness';
  if (s.includes('bmr') || s.includes('tdee') || s.includes('metabol') || s.includes('sleep')) return 'metabolism';
  if (s.includes('body-fat') || s.includes('lean-body-mass') || s.includes('ideal-body-weight') || s.includes('body-surface') || s.includes('visceral') || s.includes('healthy-weight')) return 'weight';
  if (s.includes('bmi')) return 'bmi';

  // Fallback category matching
  if (c.includes('nutrition') || c.includes('protein') || c.includes('fluid')) return 'nutrition';
  if (c.includes('cardio') || c.includes('heart') || c.includes('pressure')) return 'heart';
  if (c.includes('fitness') || c.includes('exercise') || c.includes('strength')) return 'fitness';
  if (c.includes('metabol') || c.includes('energy')) return 'metabolism';
  if (c.includes('weight') || c.includes('composition')) return 'weight';
  return 'bmi';
}

const h = headers[lang] || headers.en;

const articleSlugs = Object.keys(blogArticles);
const visibleSlugs = articleSlugs;

const articlesList = visibleSlugs.map(slug => {
  const item = blogArticles[slug];
  const cat = item.category ? (item.category[lang] || item.category.en) : 'Health';
  return {
    slug,
    title: item.title[lang] || item.title.en,
    category: cat,
    topicGroup: getArticleTopic(slug, item.category?.en || cat),
    description: item.description ? (item.description[lang] || item.description.en) : '',
    datePublished: item.datePublished || '2026-10-15',
    dateModified: item.dateModified || '2026-11-25',
  };
});

const libraryEyebrows: Record<string, string> = {
  en: "Evidence-Based Health Library",
  es: "Biblioteca de Salud Basada en Evidencia",
  fr: "Bibliothèque de Santé Fondée sur des Preuves",
  de: "Evidenzbasierte Gesundheitsbibliothek",
  ko: "근거 중심 건강 정보 라이브러리",
  hi: "साक्ष्य-आधारित स्वास्थ्य लाइब्रेरी"
};

const trustBadges: Record<string, string[]> = {
  en: ["WHO & CDC Standards", "Educational Reference", "Zero Data Stored"],
  es: ["Estándares OMS y CDC", "Referencia Educativa", "Sin Retención de Datos"],
  fr: ["Normes OMS et CDC", "Référence Éducative", "Zéro Donnée Enregistrée"],
  de: ["WHO- & CDC-Standards", "Bildungsreferenz", "Keine Datenspeicherung"],
  ko: ["WHO 및 CDC 표준", "교육용 건강 참고 자료", "데이터 미저장"],
  hi: ["डब्ल्यूएचओ और सीडीसी मानक", "शैक्षिक संदर्भ सामग्री", "शून्य डेटा संग्रह"]
};

const emptyStates: Record<string, { title: string; desc: string; reset: string }> = {
  en: {
    title: "No health guides found",
    desc: "Try searching with a different term or clear the filter.",
    reset: "Reset Search & Filters"
  },
  es: {
    title: "No se encontraron guías de salud",
    desc: "Prueba buscando con otro término o restablece los filtros.",
    reset: "Restablecer Búsqueda y Filtros"
  },
  fr: {
    title: "Aucun guide de santé trouvé",
    desc: "Essayez avec un autre mot-clé ou réinitialisez les filtres.",
    reset: "Réinitialiser la Recherche"
  },
  de: {
    title: "Keine Gesundheitsleitfäden gefunden",
    desc: "Versuchen Sie es mit einem anderen Begriff oder setzen Sie die Filter zurück.",
    reset: "Suche & Filter zurücksetzen"
  },
  ko: {
    title: "일치하는 건강 가이드가 없습니다",
    desc: "다른 검색어를 입력하시거나 필터를 초기화해 보세요.",
    reset: "검색 및 필터 초기화"
  },
  hi: {
    title: "कोई स्वास्थ्य गाइड नहीं मिली",
    desc: "कृपया दूसरा शब्द खोजें या फ़िल्टर रीसेट करें।",
    reset: "सर्च और फ़िल्टर रीसेट करें"
  }
};

const cardLabels: Record<string, { updated: string; readMore: string }> = {
  en: { updated: "Updated", readMore: "Read Full Article" },
  es: { updated: "Actualizado", readMore: "Leer Artículo Completo" },
  fr: { updated: "Mis à jour", readMore: "Lire l'Article Complet" },
  de: { updated: "Aktualisiert", readMore: "Vollständigen Artikel lesen" },
  ko: { updated: "업데이트", readMore: "전체 아티클 읽기" },
  hi: { updated: "अद्यतित", readMore: "पूरा लेख पढ़ें" }
};
---

<Layout 
  title={`${h.title} | Real BMI`}
  description={h.desc}
  canonicalURL={`https://realbmicalculator.com/${lang}/blog/`}
  robots="index, follow"
>
  <Navbar />

  <main id="main-content" class="pt-20 md:pt-24 pb-16 px-4 sm:px-6 lg:px-8 xl:px-12 relative overflow-x-hidden">
    <div class="w-full max-w-[1600px] mx-auto space-y-6">

      <!-- Breadcrumb & Top Hero Header -->
      <header class="space-y-3.5 text-center sm:text-left max-w-4xl">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex items-center justify-center sm:justify-start gap-1.5 text-xs font-display font-medium text-[var(--muted-foreground)]">
          <a href={`/${lang}/`} class="hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1 py-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            <span>{homeLabels[lang] || homeLabels.en}</span>
          </a>
          <span class="opacity-40" aria-hidden="true">/</span>
          <span class="text-[var(--foreground)] font-semibold">{articleBreadcrumbs[lang] || articleBreadcrumbs.en}</span>
        </nav>

        <!-- Eyebrow Tag / Pill -->
        <div class="pt-0.5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
            <span>{libraryEyebrows[lang] || libraryEyebrows.en}</span>
          </div>
        </div>

        <!-- Main H1 Headline -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
          {h.title}
        </h1>

        <!-- Balanced SEO & AdSense Description -->
        <p class="text-xs sm:text-sm md:text-base text-[var(--muted-foreground)] font-normal leading-relaxed max-w-3xl">
          {h.desc}
        </p>

        <!-- Micro Trust Badges Strip -->
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 pt-1 text-xs">
          {(trustBadges[lang] || trustBadges.en).map(badge => (
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border)] bg-[var(--card)] text-[11px] font-display font-semibold uppercase tracking-wider text-[var(--muted-foreground)] shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>{badge}</span>
            </div>
          ))}
        </div>
      </header>

      <!-- Category Hub Navigation: Core Topic Pills -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pt-1 pb-2" id="topicPillsContainer">
        {coreTopics.map((topic, idx) => (
          <button 
            type="button" 
            class={`topic-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all cursor-pointer ${idx === 0 ? 'bg-[var(--accent)] text-white shadow-xs' : 'bg-[var(--card)] text-[var(--muted-foreground)] border border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--foreground)]'}`}
            data-topic={topic.id}
          >
            {topic.label[lang] || topic.label.en}
            {idx === 0 ? ` (${articlesList.length})` : ''}
          </button><span class="sr-only">. </span>
        ))}
      </div>

      <!-- Empty Results Container (Populated dynamically via JavaScript only on zero-match filter) -->
      <div 
        id="noResultsMsg" 
        class="hidden text-center py-12 space-y-2" 
        style="display: none;" 
        hidden
        data-empty-title={(emptyStates[lang] || emptyStates.en).title}
        data-empty-desc={(emptyStates[lang] || emptyStates.en).desc}
        data-empty-reset={(emptyStates[lang] || emptyStates.en).reset}
      ></div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" id="articlesGrid">
      {articlesList.map(article => (
        <a 
          href={`/${lang}/blog/${article.slug}/`} 
          class="group block h-full article-item" 
          data-category={article.category}
          data-topic={article.topicGroup}
        >
          <div class="h-full p-6 sm:p-7 rounded-2xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-4 hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-block px-2.5 py-1 rounded-md text-xs font-display font-semibold tracking-wider text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20">
                  {article.category}<span class="sr-only">. </span>
                </span>
                <span class="text-xs font-mono text-[var(--muted-foreground)]">{(cardLabels[lang] || cardLabels.en).updated} {article.dateModified}<span class="sr-only">. </span></span>
              </div>
              <h2 class="text-xl font-display font-bold leading-snug text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors duration-200">
                {article.title}<span class="sr-only">. </span>
              </h2>
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-3">
                {article.description}<span class="sr-only">. </span>
              </p>
            </div>
            <div class="flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] pt-4 border-t border-[var(--border)]/40">
              <span>{(cardLabels[lang] || cardLabels.en).readMore}<span class="sr-only">. </span></span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <script is:inline>
      function initBlogFilters() {
        const pills = document.querySelectorAll('.topic-pill');
        const cards = document.querySelectorAll('.article-item');
        const noResults = document.getElementById('noResultsMsg');

        if (!cards.length) return;

        let activeTopic = 'all';

        function renderEmptyState() {
          if (!noResults) return;
          if (noResults.children.length === 0) {
            const title = noResults.getAttribute('data-empty-title') || 'No health guides found';
            const desc = noResults.getAttribute('data-empty-desc') || 'Try searching with a different term or clear the filter.';
            const reset = noResults.getAttribute('data-empty-reset') || 'Reset Search & Filters';
            noResults.innerHTML = `
              <p class="text-base font-display font-bold text-[var(--foreground)]">${title}</p>
              <p class="text-xs text-[var(--muted-foreground)]">${desc}</p>
              <button type="button" id="resetFilterBtn" class="mt-3 px-4 py-2 rounded-xl bg-[var(--accent)] text-white text-xs font-bold uppercase tracking-wider hover:opacity-90 transition-opacity cursor-pointer">
                ${reset}
              </button>
            `;
            const newResetBtn = noResults.querySelector('#resetFilterBtn');
            if (newResetBtn) {
              newResetBtn.addEventListener('click', handleReset);
            }
          }
        }

        function applyFilters() {
          let visibleCount = 0;
          cards.forEach(card => {
            const cardTopic = card.getAttribute('data-topic');
            const matchesTopic = activeTopic === 'all' || cardTopic === activeTopic;

            if (matchesTopic) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (noResults) {
            if (visibleCount === 0) {
              renderEmptyState();
              noResults.style.display = 'block';
              noResults.removeAttribute('hidden');
              noResults.classList.remove('hidden');
            } else {
              noResults.style.display = 'none';
              noResults.setAttribute('hidden', '');
              noResults.classList.add('hidden');
            }
          }
        }

        function handleReset() {
          activeTopic = 'all';
          pills.forEach((p, idx) => {
            if (idx === 0) {
              p.classList.remove('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
              p.classList.add('bg-[var(--accent)]', 'text-white', 'shadow-xs');
            } else {
              p.classList.remove('bg-[var(--accent)]', 'text-white', 'shadow-xs');
              p.classList.add('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
            }
          });
          applyFilters();
        }

        // Topic Pills click
        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            pills.forEach(p => {
              p.classList.remove('bg-[var(--accent)]', 'text-white', 'shadow-xs');
              p.classList.add('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
            });
            pill.classList.remove('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
            pill.classList.add('bg-[var(--accent)]', 'text-white', 'shadow-xs');

            activeTopic = pill.getAttribute('data-topic') || 'all';
            applyFilters();
          });
        });

        // Ensure filters and empty-state are correctly evaluated on initial page load
        applyFilters();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBlogFilters);
      } else {
        initBlogFilters();
      }
      document.addEventListener('astro:page-load', initBlogFilters);
    </script>
    </div>
  </main>
</Layout>
