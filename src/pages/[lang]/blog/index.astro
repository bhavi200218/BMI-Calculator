---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PageShell from '../../../components/PageShell.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { locales, type Locale } from '../../../utils/calculators';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang }
  }));
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;

const headers = {
  en: { title: "BMI & Health Articles (2026 Guide)", desc: "Explore evidence-based health guides on Body Mass Index (BMI), BMR, TDEE, protein intake, and official WHO & CDC healthy reference standards and charts." },
  es: { title: "Artículos sobre IMC y Salud (Guía 2026)", desc: "Explora guías de salud basadas en evidencia sobre el Índice de Masa Corporal (IMC), BMR, TDEE, requerimiento de proteínas y estándares de salud de la OMS y CDC." },
  fr: { title: "Articles sur l'IMC et la Santé (Guide 2026)", desc: "Explorez nos guides de santé fondés sur des preuves concernant l'IMC, le BMR, le TDEE, l'apport protéique et les normes de référence de l'OMS et du CDC." },
  de: { title: "BMI & Gesundheitsartikel (Leitfaden 2026)", desc: "Entdecken Sie evidenzbasierte Gesundheitsleitfäden zu Body-Mass-Index (BMI), BMR, TDEE, Proteinbedarf sowie offiziellen WHO- und CDC-Referenztabellen." },
  ko: { title: "BMI 및 건강 아티클 (2026 가이드)", desc: "세계보건기구(WHO) 및 질병관리청(CDC) 표준 지침에 따른 체질량지수(BMI), 기초대사량(BMR), 일일 총 에너지 소비량(TDEE), 단백질 섭취량 및 건강 체중 관리 종합 아티클 가이드를 확인하세요. 개인정보 수집 없는 안전한 브라우저 연산 제공." },
  hi: { title: "बीएमआई और स्वास्थ्य लेख (2026 गाइड)", desc: "विश्व स्वास्थ्य संगठन (WHO) व सीडीसी मानकों पर आधारित बॉडी मास इंडेक्स (BMI), BMR, TDEE, प्रोटीन सेवन और स्वस्थ वजन श्रेणियों पर प्रमाणित लेख पढ़ें।" }
};

const homeLabels = {
  en: 'Home',
  es: 'Inicio',
  fr: 'Accueil',
  de: 'Startseite',
  ko: '홈',
  hi: 'होम'
};

const h = headers[lang] || headers.en;

const articleSlugs = Object.keys(blogArticles);
const articlesList = articleSlugs.map(slug => {
  const item = blogArticles[slug];
  return {
    slug,
    title: item.title[lang] || item.title.en,
    category: item.category ? (item.category[lang] || item.category.en) : 'Health',
    description: item.description ? (item.description[lang] || item.description.en) : '',
  };
});
---

<Layout 
  title={`${h.title} | Real BMI`}
  description={h.desc}
  canonicalURL={`https://realbmicalculator.com/${lang}/blog/`}
>
  <Navbar />

  <PageShell
    title={h.title}
    eyebrow="Health Articles & Guides"
    description={h.desc}
    returnUrl={`/${lang}`}
    returnLabel={homeLabels[lang] || homeLabels.en}
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articlesList.map(article => (
        <a href={`/${lang}/blog/${article.slug}/`} class="group block h-full">
          <div class="h-full p-6 sm:p-7 rounded-2xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-4 hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-display font-semibold tracking-wider text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20">
                  {article.category}
                </span>
                <span class="text-[11px] font-mono text-[var(--muted-foreground)]">2026 Guide</span>
              </div>
              <h2 class="text-xl font-display font-bold leading-snug text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors duration-200">
                {article.title}
              </h2>
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-3">
                {article.description}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] pt-4 border-t border-[var(--border)]/40">
              <span>Read Full Article</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </PageShell>
</Layout>
