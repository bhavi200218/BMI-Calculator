---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import PageShell from '../../../components/PageShell.astro';
import { blogArticles } from '../../../utils/blogArticles';
import { locales, type Locale } from '../../../utils/calculators';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang }
  }));
}

const { params } = Astro;
const lang = (params.lang || 'en') as Locale;

const headers = {
  en: { 
    title: "Health Articles & Guides", 
    desc: "Explore evidence-based research guides on Body Mass Index, metabolism, nutrition, and cardiovascular wellness based on WHO & CDC standards." 
  },
  es: { 
    title: "Artículos y Guías de Salud", 
    desc: "Explore guías de investigación basadas en evidencia sobre IMC, metabolismo, nutrición y salud cardiovascular según estándares de la OMS y CDC." 
  },
  fr: { 
    title: "Articles & Guides de Santé", 
    desc: "Explorez des guides de recherche fondés sur des preuves sur l'IMC, le métabolisme, la nutrition et le bien-être cardiovasculaire selon les normes OMS et CDC." 
  },
  de: { 
    title: "Gesundheitsartikel & Leitfäden", 
    desc: "Entdecken Sie evidenzbasierte Leitfäden zu BMI, Stoffwechsel, Ernährung und Herz-Kreislauf-Fitness auf Grundlage von WHO- und CDC-Standards." 
  },
  ko: { 
    title: "건강 정보 및 의학 가이드", 
    desc: "WHO 및 CDC 기준에 따른 체질량지수(BMI), 기초대사량, 영양 섭취 및 심혈관 건강에 대한 근거 중심의 신뢰할 수 있는 가이드를 확인하세요." 
  },
  hi: { 
    title: "स्वास्थ्य लेख एवं शोध गाइड", 
    desc: "विश्व स्वास्थ्य संगठन (WHO) एवं सीडीसी मानकों पर आधारित बॉडी मास इंडेक्स (BMI), मेटाबॉलिज्म, पोषण और हृदय स्वास्थ्य पर साक्ष्य-आधारित गाइड।" 
  }
};

const searchPlaceholders = {
  en: "Search Health Guides...",
  es: "Buscar Guías de Salud...",
  fr: "Rechercher des Guides de Santé...",
  de: "Gesundheitsleitfäden durchsuchen...",
  ko: "건강 가이드 검색...",
  hi: "स्वास्थ्य गाइड खोजें..."
};

const homeLabels = {
  en: 'Home',
  es: 'Inicio',
  fr: 'Accueil',
  de: 'Startseite',
  ko: '홈',
  hi: 'होम'
};

const coreTopics = [
  { id: 'all', label: { en: 'All', es: 'Todos', fr: 'Tous', de: 'Alle', ko: '전체', hi: 'सभी' } },
  { id: 'bmi', label: { en: 'BMI', es: 'IMC', fr: 'IMC', de: 'BMI', ko: 'BMI', hi: 'बीएमआई' } },
  { id: 'weight', label: { en: 'Weight', es: 'Peso', fr: 'Poids', de: 'Gewicht', ko: '체중', hi: 'वजन' } },
  { id: 'metabolism', label: { en: 'Metabolism', es: 'Metabolismo', fr: 'Métabolisme', de: 'Stoffwechsel', ko: '대사', hi: 'मेटाबॉलिज्म' } },
  { id: 'nutrition', label: { en: 'Nutrition', es: 'Nutrición', fr: 'Nutrition', de: 'Ernährung', ko: '영양', hi: 'पोषण' } },
  { id: 'fitness', label: { en: 'Fitness', es: 'Fitness', fr: 'Fitness', de: 'Fitness', ko: '피트니스', hi: 'फिटनेस' } },
  { id: 'heart', label: { en: 'Heart Health', es: 'Salud Cardíaca', fr: 'Santé Cardiaque', de: 'Herzgesundheit', ko: '심혈관 건강', hi: 'हृदय स्वास्थ्य' } },
];

function getArticleTopic(cat: string): string {
  const c = cat.toLowerCase();
  if (c.includes('bmi') || c.includes('pediatric') || c.includes('ethnic') || c.includes('biological') || c.includes('practical') || c.includes('population')) return 'bmi';
  if (c.includes('weight') || c.includes('composition') || c.includes('measurement') || c.includes('pharmacokinetics') || c.includes('body')) return 'weight';
  if (c.includes('metabol') || c.includes('energy') || c.includes('evidence')) return 'metabolism';
  if (c.includes('nutrition') || c.includes('macronutrient') || c.includes('protein') || c.includes('water') || c.includes('fluid') || c.includes('hydration') || c.includes('dietary')) return 'nutrition';
  if (c.includes('strength') || c.includes('exercise') || c.includes('fitness') || c.includes('age') || c.includes('senior') || c.includes('demographics')) return 'fitness';
  if (c.includes('cardio') || c.includes('heart') || c.includes('preventive') || c.includes('pressure') || c.includes('pulse')) return 'heart';
  return 'bmi';
}

const h = headers[lang] || headers.en;

const articleSlugs = Object.keys(blogArticles);
const articlesList = articleSlugs.map(slug => {
  const item = blogArticles[slug];
  const cat = item.category ? (item.category[lang] || item.category.en) : 'Health';
  return {
    slug,
    title: item.title[lang] || item.title.en,
    category: cat,
    topicGroup: getArticleTopic(item.category?.en || cat),
    description: item.description ? (item.description[lang] || item.description.en) : '',
    datePublished: item.datePublished || '2026-01-15',
    dateModified: item.dateModified || '2026-10-21',
  };
});

const detailedCategories = [...new Set(articlesList.map(a => a.category))].sort();
---

<Layout 
  title={`${h.title} | Real BMI`}
  description={h.desc}
  canonicalURL={lang === 'en' ? 'https://realbmicalculator.com/en/blog/' : 'https://realbmicalculator.com/en/blog/'}
  robots={lang === 'en' ? 'index, follow' : 'noindex, follow'}
>
  <Navbar />

  <PageShell
    title={h.title}
    eyebrow="Evidence-Based Health Library"
    description={h.desc}
    returnUrl={`/${lang}/`}
    returnLabel={homeLabels[lang] || homeLabels.en}
  >
    <!-- Interactive Search Bar -->
    <div class="relative w-full max-w-xl mx-auto mb-6">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[var(--muted-foreground)]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input 
        type="search" 
        id="blogSearchInput" 
        placeholder={searchPlaceholders[lang] || "Search Health Guides..."} 
        autocomplete="off"
        class="w-full pl-11 pr-4 py-3 rounded-xl border border-[var(--border)] bg-[var(--card)] text-sm text-[var(--foreground)] placeholder-[var(--muted-foreground)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50 focus:border-[var(--accent)] shadow-xs transition-all"
      />
    </div>

    <!-- Multilingual Library Notice for non-English -->
    {lang !== 'en' && (
      <div class="not-prose mb-6 p-3.5 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)] text-xs text-[var(--muted-foreground)] flex items-center justify-between gap-3">
        <span>{{
          es: "Biblioteca completa de investigación en salud basada en evidencia en la edición oficial en inglés.",
          fr: "Bibliothèque complète de recherche sur la santé fondée sur des preuves dans l'édition officielle en anglais.",
          de: "Vollständige evidenzbasierte Gesundheitsforschungsbibliothek in der offiziellen englischen Ausgabe.",
          ko: "공식 영문 에디션에서 전체 증거 기반 건강 연구 라이브러리를 확인하실 수 있습니다.",
          hi: "संपूर्ण प्रमाण-आधारित स्वास्थ्य अनुसंधान लेख लाइब्रेरी आधिकारिक अंग्रेजी संस्करण में उपलब्ध है।"
        }[lang]}</span>
        <a href="/en/blog/" class="text-[var(--accent)] font-semibold underline shrink-0 hover:text-[var(--foreground)]">
          {{
            es: "Ver biblioteca en inglés →",
            fr: "Voir la bibliothèque en anglais →",
            de: "Englische Bibliothek ansehen →",
            ko: "영문 라이브러리 보기 →",
            hi: "अंग्रेजी लाइब्रेरी देखें →"
          }[lang]}
        </a>
      </div>
    )}

    <!-- Category Hub Navigation: 7 Core Pills + More Dropdown -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8 pb-4 border-b border-[var(--border)]" id="categoryHubNav">
      <!-- Visible Core Pills -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="topicPillsContainer">
        {coreTopics.map((topic, idx) => (
          <button 
            type="button" 
            class={`topic-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all cursor-pointer ${idx === 0 ? 'bg-[var(--accent)] text-white shadow-xs' : 'bg-[var(--card)] text-[var(--muted-foreground)] border border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--foreground)]'}`}
            data-topic={topic.id}
          >
            {topic.label[lang] || topic.label.en}
            {idx === 0 ? ` (${articlesList.length})` : ''}
          </button>
        ))}
      </div>

      <!-- More Categories Dropdown -->
      <div class="shrink-0">
        <select 
          id="moreCategoriesDropdown" 
          aria-label="Filter by specific category"
          class="w-full sm:w-auto px-3 py-1.5 sm:py-2 rounded-xl text-xs font-semibold uppercase tracking-wider bg-[var(--card)] text-[var(--foreground)] border border-[var(--border)] hover:border-[var(--accent)] cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/40"
        >
          <option value="all">More Categories ▾</option>
          {detailedCategories.map(cat => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Empty Results Message -->
    <div id="noResultsMsg" class="hidden text-center py-12 space-y-2">
      <p class="text-base font-display font-bold text-[var(--foreground)]">No health guides found</p>
      <p class="text-xs text-[var(--muted-foreground)]">Try searching with a different term or clear the filter.</p>
      <button type="button" id="resetFilterBtn" class="mt-3 px-4 py-2 rounded-xl bg-[var(--accent)] text-white text-xs font-bold uppercase tracking-wider hover:opacity-90 transition-opacity">
        Reset Search & Filters
      </button>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="articlesGrid">
      {articlesList.map(article => (
        <a 
          href={`/${lang}/blog/${article.slug}/`} 
          class="group block h-full article-item" 
          data-category={article.category}
          data-topic={article.topicGroup}
          data-search={`${article.title} ${article.description} ${article.category}`.toLowerCase()}
        >
          <div class="h-full p-6 sm:p-7 rounded-2xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-4 hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-block px-2.5 py-1 rounded-md text-xs font-display font-semibold tracking-wider text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20">
                  {article.category}
                </span>
                <span class="text-xs font-mono text-[var(--muted-foreground)]">Updated {article.dateModified}</span>
              </div>
              <h2 class="text-xl font-display font-bold leading-snug text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors duration-200">
                {article.title}
              </h2>
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-3">
                {article.description}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] pt-4 border-t border-[var(--border)]/40">
              <span>Read Full Article</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('blogSearchInput');
        const pills = document.querySelectorAll('.topic-pill');
        const dropdown = document.getElementById('moreCategoriesDropdown');
        const cards = document.querySelectorAll('.article-item');
        const noResults = document.getElementById('noResultsMsg');
        const resetBtn = document.getElementById('resetFilterBtn');

        let activeTopic = 'all';
        let activeCategory = 'all';
        let searchQuery = '';

        function applyFilters() {
          let visibleCount = 0;
          cards.forEach(card => {
            const cardTopic = card.getAttribute('data-topic');
            const cardCategory = card.getAttribute('data-category');
            const cardSearchText = card.getAttribute('data-search') || '';

            const matchesTopic = activeTopic === 'all' || cardTopic === activeTopic;
            const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
            const matchesSearch = !searchQuery || cardSearchText.includes(searchQuery);

            if (matchesTopic && matchesCategory && matchesSearch) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }

        // Search Input event
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.trim().toLowerCase();
            applyFilters();
          });
        }

        // Topic Pills click
        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            pills.forEach(p => {
              p.classList.remove('bg-[var(--accent)]', 'text-white', 'shadow-xs');
              p.classList.add('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
            });
            pill.classList.remove('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
            pill.classList.add('bg-[var(--accent)]', 'text-white', 'shadow-xs');

            activeTopic = pill.getAttribute('data-topic') || 'all';
            activeCategory = 'all';
            if (dropdown) dropdown.value = 'all';
            applyFilters();
          });
        });

        // More Categories Dropdown change
        if (dropdown) {
          dropdown.addEventListener('change', (e) => {
            activeCategory = e.target.value;
            if (activeCategory !== 'all') {
              activeTopic = 'all';
              pills.forEach(p => {
                p.classList.remove('bg-[var(--accent)]', 'text-white', 'shadow-xs');
                p.classList.add('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
              });
            } else {
              const allPill = document.querySelector('.topic-pill[data-topic="all"]');
              if (allPill) {
                allPill.classList.remove('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
                allPill.classList.add('bg-[var(--accent)]', 'text-white', 'shadow-xs');
              }
            }
            applyFilters();
          });
        }

        // Reset button click
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            searchQuery = '';
            activeTopic = 'all';
            activeCategory = 'all';
            if (dropdown) dropdown.value = 'all';
            pills.forEach((p, idx) => {
              if (idx === 0) {
                p.classList.remove('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
                p.classList.add('bg-[var(--accent)]', 'text-white', 'shadow-xs');
              } else {
                p.classList.remove('bg-[var(--accent)]', 'text-white', 'shadow-xs');
                p.classList.add('bg-[var(--card)]', 'text-[var(--muted-foreground)]', 'border', 'border-[var(--border)]');
              }
            });
            applyFilters();
          });
        }
      });
    </script>
  </PageShell>
</Layout>
