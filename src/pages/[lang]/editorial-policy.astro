---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
const { lang } = Astro.params;

const pageData = {
  en: {
    pageTitle: 'Editorial Policy | Real BMI',
    pageDescription: 'Read Real BMI’s editorial policy for evidence-based health content, peer-reviewed methodology, clinical screening definitions, and transparent user guidance.',
    title: 'Editorial Policy',
    eyebrow: 'Evidence-based health content',
    description: 'Learn how Real BMI writes and reviews trusted health content across languages and regions.',
    homeLabel: 'Home',
    sections: [
      {
        heading: 'Accuracy and review',
        body: 'We align our calculator formulas and educational text with resources from WHO, CDC, NIH, and public health guidelines. Content is reviewed to ensure it reflects recognized health definitions, measurement methods, and limitations.'
      },
      {
        heading: 'Independence',
        body: 'Editorial decisions are made without influence from advertising or product sponsorship. Real BMI’s mission is to provide factual wellness tools, not to promote specific brands or treatments.'
      },
      {
        heading: 'Expertise',
        body: 'Our site combines technical accuracy in BMI, BMR, TDEE, and body composition with clear user guidance. We describe when a metric is for screening only and when further medical evaluation is recommended.'
      },
      {
        heading: 'Trust and transparency',
        body: 'Real BMI publishes medical disclaimers, sources, privacy details, and editorial policies openly so users can trust the health advice they read and the tools they use.'
      },
      {
        heading: 'Pre-Publication Review & Privacy Sanitization',
        body: 'Every article, calculator tool, and reference table undergoes a mandatory multi-step editorial review before publication. This process verifies mathematical formula precision, cites authoritative public health sources (WHO, CDC), and conducts a strict PII (Personally Identifiable Information) audit to guarantee that no personal names, email addresses, phone numbers, or private user data are ever published or exposed in public entries or URLs.'
      }
    ]
  },
  es: {
    pageTitle: 'Política Editorial | Real BMI',
    pageDescription: 'Lea la política editorial de Real BMI: metodología basada en evidencia médica, fórmulas revisadas por pares, transparencia científica y orientación educativa.',
    title: 'Política Editorial',
    eyebrow: 'Contenido de salud basado en evidencia',
    description: 'Descubra cómo Real BMI redacta y revisa contenido de salud confiable en varios idiomas y regiones.',
    homeLabel: 'Inicio',
    sections: [
      {
        heading: 'Precisión y revisión',
        body: 'Alineamos nuestras fórmulas de calculadora y el texto educativo con recursos de la OMS, CDC, NIH y guías de referencia de salud. El contenido se revisa para garantizar que refleje definiciones de salud reconocidas, métodos de medición y limitaciones.'
      },
      {
        heading: 'Independencia',
        body: 'Las decisiones editoriales se toman sin influencia de publicidad o patrocinios. La misión de Real BMI es ofrecer herramientas de bienestar basadas en hechos, no promocionar marcas o tratamientos específicos.'
      },
      {
        heading: 'Experiencia',
        body: 'Nuestro sitio combina precisión técnica en BMI, BMR, TDEE y composición corporal con orientación clara para el usuario. Describimos cuándo una métrica es solo para detección y cuándo se recomienda una evaluación profesional adicional.'
      },
      {
        heading: 'Confianza y transparencia',
        body: 'Real BMI publica declaraciones médicas, fuentes, detalles de privacidad y políticas editoriales abiertamente para que los usuarios confíen en la información de salud que leen y en las herramientas que utilizan.'
      },
      {
        heading: 'Revisión Previa a la Publicación y Privacidad (PII)',
        body: 'Cada artículo, herramienta y tabla de referencia pasa por un riguroso proceso de revisión editorial antes de publicarse. Verificamos la precisión de las fórmulas matemáticas, contrastamos fuentes con la OMS y los CDC, y realizamos una auditoría de privacidad estricta para garantizar que ninguna información de identificación personal (nombres, correos, teléfonos o datos de usuario) se exponga públicamente.'
      }
    ]
  },
  fr: {
    pageTitle: 'Politique éditoriale | Real BMI',
    pageDescription: 'Découvrez la politique éditoriale de Real BMI : contenus fondés sur les preuves, méthodologies issues de la littérature scientifique et transparence totale.',
    title: 'Politique éditoriale',
    eyebrow: 'Contenu de santé fondé sur des preuves',
    description: 'Découvrez comment Real BMI rédige et révise un contenu santé fiable dans différentes langues et régions.',
    homeLabel: 'Accueil',
    sections: [
      {
        heading: 'Précision et relecture',
        body: 'Nous alignons nos formules de calcul et les textes éducatifs avec les ressources de l’OMS, du CDC, des NIH et des guides de référence de santé. Le contenu est relu pour garantir qu’il reflète des définitions de santé reconnues, des méthodes de mesure et des limites.'
      },
      {
        heading: 'Indépendance',
        body: 'Les décisions éditoriales sont prises sans influence publicitaire ou sponsorisation. La mission de Real BMI est de fournir des outils de bien-être factuels, et non de promouvoir des marques ou traitements spécifiques.'
      },
      {
        heading: 'Expertise',
        body: 'Notre site combine précision technique en BMI, BMR, TDEE et composition corporelle avec des conseils clairs. Nous expliquons quand une métrique est uniquement de dépistage et quand une évaluation professionnelle supplémentaire est recommandée.'
      },
      {
        heading: 'Confiance et transparence',
        body: 'Real BMI publie ouvertement des avertissements de santé, des sources, des détails de confidentialité et des politiques éditoriales afin que les utilisateurs puissent faire confiance aux informations qu’ils lisent et aux outils qu’ils utilisent.'
      },
      {
        heading: 'Relecture Pré-Publication et Protection de la Vie Privée (PII)',
        body: 'Chaque article, outil de calcul et tableau de référence fait l’objet d’une validation éditoriale rigoureuse avant sa mise en ligne. Nous vérifions la précision des formules, citons les directives officielles (OMS, CDC) et effectuons un audit de confidentialité strict pour garantir qu’aucune donnée personnelle identifiable (noms, e-mails, numéros de téléphone) ne soit exposée publiquement.'
      }
    ]
  },
  de: {
    pageTitle: 'Redaktionsrichtlinie | Real BMI',
    pageDescription: 'Erfahren Sie mehr über unsere redaktionellen Leitlinien: evidenzbasierte Methoden, wissenschaftlich geprüfte Formeln und transparente Rechner-Tools.',
    title: 'Redaktionsrichtlinie',
    eyebrow: 'Evidenzbasierte Gesundheitsinhalte',
    description: 'Erfahren Sie, wie unsere Redaktion vertrauenswürdige Gesundheitsinhalte in mehreren Sprachen und Regionen erstellt und überprüft.',
    homeLabel: 'Startseite',
    sections: [
      {
        heading: 'Genauigkeit und Prüfung',
        body: 'Wir stimmen unsere Rechenformeln und erklärenden Texte mit Ressourcen der WHO, CDC, NIH und gesundheitlichen Referenzleitlinien ab. Inhalte werden überprüft, um sicherzustellen, dass sie anerkannte Gesundheitsdefinitionen, Messmethoden und Einschränkungen widerspiegeln.'
      },
      {
        heading: 'Unabhängigkeit',
        body: 'Redaktionelle Entscheidungen werden ohne Einfluss von Werbung oder Produktsponsoring getroffen. Unsere Mission ist es, sachliche Wellness-Tools bereitzustellen, nicht bestimmte Marken oder Behandlungen zu fördern.'
      },
      {
        heading: 'Fachwissen',
        body: 'Unsere Seite kombiniert technische Genauigkeit bei BMI, BMR, TDEE und Körperzusammensetzung mit klaren Benutzeranleitungen. Wir erläutern, wann eine Kennzahl nur zur Vorsorge dient und wann eine professionelle Bewertung empfohlen wird.'
      },
      {
        heading: 'Vertrauen und Transparenz',
        body: 'Unsere Plattform veröffentlicht Hinweise, Quellen, Datenschutzdetails und redaktionelle Richtlinien offen, damit Benutzer den bereitgestellten Gesundheitsinformationen und Rechner-Tools uneingeschränkt vertrauen können.'
      },
      {
        heading: 'Vorveröffentlichungsprüfung & Datenschutz-Audit (PII)',
        body: 'Jeder Artikel, Rechner und jede Referenztabelle durchläuft vor der Veröffentlichung ein mehrstufiges redaktionelles Prüfverfahren. Dies gewährleistet mathematische Präzision, Übereinstimmung mit WHO/CDC-Leitlinien sowie eine strenge Datenschutz- und PII-Prüfung, damit keinerlei personenbezogene Daten öffentlich exponiert werden.'
      }
    ]
  },
  ko: {
    pageTitle: '편집 방침 | Real BMI',
    pageDescription: 'Real BMI의 편집 정책 안내입니다. 근거 기반 보건 지침, 공표된 의학 공식, 투명한 검토 기준 및 윤리적 정보 제공 원칙을 준수하여 작성됩니다.',
    title: '편집 방침',
    eyebrow: '증거 기반 건강 콘텐츠',
    description: 'Real BMI가 다양한 언어와 지역에서 신뢰할 수 있는 건강 콘텐츠를 어떻게 작성하고 검토하는지 알아보세요.',
    homeLabel: '홈',
    sections: [
      {
        heading: '정확성 및 검토',
        body: '우리는 계산기 공식과 교육 텍스트를 WHO, CDC, NIH 및 임상 지침의 자료와 일치시킵니다. 콘텐츠는 인정된 건강 정의, 측정 방법 및 제한 사항을 반영하는지 검토됩니다.'
      },
      {
        heading: '독립성',
        body: '편집 결정은 광고나 제품 후원의 영향을 받지 않고 이루어집니다. Real BMI의 목표는 특정 브랜드나 치료법을 홍보하는 것이 아니라 사실 기반 웰빙 도구를 제공하는 것입니다.'
      },
      {
        heading: '전문성',
        body: '우리 사이트는 BMI, BMR, TDEE 및 체성분에 대한 기술적 정확성과 명확한 사용자 지침을 결합합니다. 우리는 언제 지표가 스크리닝용인지, 추가 임상 평가가 권장되는지 설명합니다.'
      },
      {
        heading: '신뢰와 투명성',
        body: 'Real BMI는 의료 고지, 출처, 개인정보 세부 사항 및 편집 정책을 공개하여 사용자가 읽는 건강 조언과 사용하는 도구를 신뢰할 수 있도록 합니다.'
      },
      {
        heading: '사전 발행 검토 및 개인정보 보호 (PII) 프로세스',
        body: '모든 건강 가이드, 계산기 도구 및 참조 테이블은 정식 발행 전 다단계 편집 및 규정 준수 검토를 거칩니다. 수학적 공식의 정확도 검증, 공공 보건 기관(WHO, CDC) 지침 대조뿐만 아니라, 공개 페이지나 URL에 개인 식별 정보(성명, 이메일, 전화번호 등)가 노출되지 않도록 엄격한 개인정보(PII) 스크리닝을 시행합니다.'
      }
    ]
  },
  hi: {
    pageTitle: 'संपादकीय नीति | Real BMI',
    pageDescription: 'Real BMI की संपादकीय नीति पढ़ें: साक्ष्य-आधारित स्वास्थ्य सामग्री, सहकर्मी-समीक्षित गणना विधियां, डब्ल्यूएचओ मानक और पारदर्शी शैक्षिक उपयोगकर्ता मार्गदर्शन।',
    title: 'संपादकीय नीति',
    eyebrow: 'प्रमाण-आधारित स्वास्थ्य सामग्री',
    description: 'जानें कि Real BMI कैसे विभिन्न भाषाओं और क्षेत्रों में विश्वसनीय स्वास्थ्य सामग्री लिखता और समीक्षा करता है।',
    homeLabel: 'होम',
    sections: [
      {
        heading: 'सटीकता और समीक्षा',
        body: 'हम अपने कैलकुलेटर सूत्र और शैक्षिक पाठ को WHO, CDC, NIH और क्लिनिकल मार्गदर्शिकाओं के संसाधनों के साथ संरेखित करते हैं। सामग्री की समीक्षा यह सुनिश्चित करने के लिए की जाती है कि यह मान्यता प्राप्त स्वास्थ्य परिभाषाओं, माप विधियों और सीमाओं को दर्शाती है।'
      },
      {
        heading: 'स्वतंत्रता',
        body: 'संपादकीय निर्णय विज्ञापन या उत्पाद प्रायोजन के प्रभाव के बिना लिए जाते हैं। Real BMI का मिशन तथ्य-आधारित वेलनेस टूल प्रदान करना है, न कि विशिष्ट ब्रांड या उपचारों को बढ़ावा देना।'
      },
      {
        heading: 'विशेषज्ञता',
        body: 'हमारी साइट BMI, BMR, TDEE और शरीर संरचना में तकनीकी सटीकता को स्पष्ट उपयोगकर्ता मार्गदर्शन के साथ जोड़ती है। हम बताते हैं कि कब कोई मीट्रिक केवल स्क्रीनिंग के लिए है और कब आगे की क्लिनिकल जांच की सिफारिश की जाती है।'
      },
      {
        heading: 'विश्वास और पारदर्शिता',
        body: 'Real BMI चिकित्सा अस्वीकरण, स्रोत, गोपनीयता विवरण और संपादकीय नीतियों को खुले रूप से प्रकाशित करता है ताकि उपयोगकर्ता उस स्वास्थ्य सलाह और उपकरणों पर भरोसा कर सकें जिन्हें वे पढ़ते हैं।'
      },
      {
        heading: 'प्रकाशन-पूर्व समीक्षा एवं व्यक्तिगत गोपनीयता (PII) सुरक्षा',
        body: 'प्रत्येक स्वास्थ्य लेख, कैलकुलेटर और संदर्भ तालिका का प्रकाशन से पूर्व बहु-स्तरीय संपादकीय सत्यापन किया जाता है। इसमें गणितीय सूत्रों की सटीकता, WHO और CDC संदर्भों का सत्यापन, तथा एक सख्त गोपनीयता (PII) ऑडिट शामिल है ताकि यह सुनिश्चित हो सके कि किसी भी सार्वजनिक प्रविष्टि में नाम, ईमेल, फोन नंबर या व्यक्तिगत पहचान डेटा कभी उजागर न हो।'
      }
    ]
  }
};

const copy = (pageData as Record<string, any>)[lang || 'en'] || pageData.en;

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'hi' } }
  ];
}
---

<Layout title={copy.pageTitle} description={copy.pageDescription}>
  <Navbar />
  <PageShell
    title={copy.title}
    eyebrow={copy.eyebrow}
    description={copy.description}
    returnUrl={`/${lang}/`}
    returnLabel={copy.homeLabel}
  >
    <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg md:text-xl font-medium opacity-90 space-y-8">
      {copy.sections.map((section: { heading: string; body: string }) => (
        <>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </>
      ))}
    </div>
  </PageShell>
</Layout>
