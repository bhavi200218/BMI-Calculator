---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HomepageHubWrapper from '../components/HomepageHubWrapper.astro';
import HealthContent from '../components/HealthContent.astro';
import LatestArticles from '../components/LatestArticles.astro';
import DeepHealthSEO from '../components/DeepHealthSEO.astro';
import HubGrid from '../components/HubGrid.astro';

const lang = 'en';
const pageTitle = 'All Clinical Health Calculators | Real BMI Hub';
const pageDesc = 'Calculate BMI, BMR, TDEE, Body Fat %, Lean Mass, Ideal Weight, Calorie & Protein targets with our interactive health tools.';
const canonicalUrl = 'https://realbmicalculator.com/calculator';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Real BMI All Calculators Hub",
  "url": canonicalUrl,
  "description": pageDesc,
  "applicationCategory": "HealthApplication",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "operatingSystem": "All"
};
---

<Layout 
  title={pageTitle}
  description={pageDesc}
  canonicalURL={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="json-ld"></script>
  
  <Navbar />
  
  <main class="pt-26 md:pt-30 pb-20 px-4 md:px-6 relative overflow-x-hidden">
    <div class="max-w-7xl mx-auto space-y-16">
      
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-medium text-[var(--muted-foreground)]">
        <a href="/" class="hover:text-[var(--accent)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--foreground)]">All Health Calculators</span>
      </nav>

      <!-- Top Header text -->
      <div class="text-center space-y-4 max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] animate-in">
          All Health Calculators
        </h1>
        <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium animate-in max-w-2xl mx-auto">
          Switch seamlessly between all 15 clinical health calculators. Real-time WHO & CDC computations.
        </p>
      </div>

      <!-- Interactive Multi-Calculator Hub Studio -->
      <HomepageHubWrapper lang={lang} />

      <!-- Extended Content & Clinical Knowledge Base -->
      <div class="pt-12 space-y-20">
        <LatestArticles />
        <HealthContent />
        <DeepHealthSEO />
        <HubGrid lang={lang} />
      </div>

    </div>
  </main>
</Layout>
