---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import FeaturedResearchGuides from '../../components/FeaturedResearchGuides.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import HealthContent from '../../components/HealthContent.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Real BMI — 건강 연구 허브, 근거 중심 가이드 및 건강 계산기"
	description="세계보건기구(WHO) 및 질병관리청(CDC) 표준에 기반한 근거 중심 건강 연구 플랫폼. 동료 검토 연구 가이드 및 100% 안전한 브라우저 건강 평가 도구."
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  1. HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-24 md:pt-28 pb-8 md:pb-12 px-4 md:px-6">
			<div class="max-w-7xl mx-auto space-y-8">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-4 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						건강 연구 허브 • 동료 검토 건강 가이드 및 스크리닝 도구
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						근거 중심 건강 연구, 대사 분석 가이드 및 건강 평가 도구
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-lg sm:text-xl md:text-2xl text-[var(--accent)] font-semibold tracking-tight font-display">
						동료 검토 학술 문헌 • 공인 대사 알고리즘 • 사용자 데이터 무보관
					</p>
					<p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed pt-1">
						세계보건기구(WHO)와 미국 질병통제예방센터(CDC)의 공중보건 역학 지침에 기반한 신뢰할 수 있는 건강 의학 연구, 생애주기별 신체 지표 가이드 및 안전한 브라우저 연산 도구를 확인하세요.
					</p>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-3 sm:gap-4 pt-1">
					{[
						'18+ 건강 계산기',
						'30+ 연구 가이드',
						'15개 원저 논문 색인',
						'WHO 및 CDC 근거 기준'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  2. COMPLETE INTERACTIVE DIRECTORY (TOP POSITION)  ═══════════════════ -->
		<section id="calculators" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 bg-[var(--card)]/10 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-8">
				<div class="text-center max-w-3xl mx-auto space-y-3">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
						전체 인터랙티브 디렉터리
					</div>
					<h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						18+ 근거 중심 건강 및 피트니스 계산기
					</h2>
					<p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
						학술적 문헌에 근거한 건강 도구 전체 컬렉션을 확인하세요 — 100% 브라우저 기반으로 개인정보를 일절 저장하지 않습니다.
					</p>
				</div>

				<HomepageHubWrapper lang="ko" />
			</div>
		</section>

		<!-- ═══════════════════  3. 📚 RESEARCH GUIDES  ═══════════════════ -->
		<section id="featured-guides" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 bg-[var(--card)]/20 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<FeaturedResearchGuides lang="ko" />
			</div>
		</section>

		<!-- ═══════════════════  4. ⭐ TRUST SIGNALS & STANDARDS  ═══════════════════ -->
		<!-- WHY PEOPLE CHOOSE REAL BMI -->
		<section class="px-4 md:px-6 py-12 md:py-16 content-auto border-t border-[var(--border)]/40 space-y-12">
			<div class="max-w-7xl mx-auto space-y-10">
				<div class="space-y-3 text-center sm:text-left max-w-3xl">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">투명한 계산기 기술 기준</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						당신의 건강 목표를 위한 명확한 지표
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
						운동 진행 상황을 추적하든 일일 영양 목표를 세우든, Real BMI는 공인된 지침에 기반한 신속하고 실용적인 예측치를 제공합니다.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: '공식 기반 정밀 추정치', description: '발표된 수학적 방정식을 활용하여 BMI, BMR, TDEE 및 이상 체중에 대한 명확한 기준치를 산출합니다.' },
						{ title: '브라우저 단독 보안 처리', description: '모든 연산은 기기 내부 브라우저에서 수행되며, 회원가입이나 서버 데이터 저장을 일절 요구하지 않습니다.' },
						{ title: '공공 표준 지침 준수', description: '결과값은 WHO 및 CDC의 역학적 참고 범주와 함께 제시되어 보다 객관적인 해석이 가능합니다.' },
						{ title: '일상 건강 계획을 위한 실용성', description: '투명하게 공개된 산출 방식을 통해 피트니스 지표, 영양 필요량, 체성분 데이터를 체계적으로 관리하세요.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-3 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-sm hover:-translate-y-0.5">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand & Methodology Box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6 shadow-md">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-80">투명한 방법론 가이드</p>
							<p class="text-2xl md:text-3xl font-display font-bold tracking-tight uppercase">도구 작동 원리</p>
							<p class="text-xs md:text-sm font-medium opacity-90 leading-relaxed pt-1">18개 이상의 모든 도구에 대한 수식, 참조 표준, 입력값, 결과값 산출 방식 및 한계점을 확인하세요.</p>
						</div>
						<a href="/ko/methodology/" class="px-4 py-2.5 rounded-xl bg-white text-slate-900 font-display text-xs font-bold uppercase tracking-wider hover:bg-slate-100 transition-all shadow-xs">
							방법론 전문 확인하기 →
						</a>
					</div>
				</div>

				<!-- Editorial & Research Verification Banner -->
				<div class="pt-4">
					<MedicalEEATBanner lang="ko" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  5. 📖 LATEST ARTICLES  ═══════════════════ -->
		<section id="latest-articles" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<LatestArticles lang="ko" limit={6} />
			</div>
		</section>

		<!-- ═══════════════════  6. ❓ REFERENCE STANDARDS & FAQ  ═══════════════════ -->
		<section id="faq-standards" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-12">
				<HealthContent lang="ko" />
				<EmbedWidgetBox lang="ko" />
			</div>
		</section>

	</main>
</Layout>