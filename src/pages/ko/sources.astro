---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';

const sources = [
  {
    "title": "WHO 신체 상태: 인체측정학의 활용과 해석",
    "org": "세계보건기구 (WHO / NLM PubMed)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/8594834/",
    "desc": "성인 체질량지수(BMI) 분류 기준 및 글로벌 벤치마크를 정립한 공식 보고서.",
    "actionLabel": "WHO 보고서 원문 열람"
  },
  {
    "title": "WHO 전문가 자문회의: 아시아 인구를 위한 적정 BMI와 보건 정책",
    "org": "The Lancet (WHO 전문가 자문회의)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/14726171/",
    "desc": "아시아 성인 공중보건 실행 분별점(23.0 kg/m² 위험 증가, 27.5 kg/m² 고위험)을 정의한 2004 란셋 논문.",
    "actionLabel": "Lancet 원문 연구 보기"
  },
  {
    "title": "인도 및 아시아 성인 비만과 대사증후군 진단 합의 성명",
    "org": "ICMR & JAPI (Misra A, et al.)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/19702033/",
    "desc": "인도 성인 기준(18.5–22.9 정상, 23.0–24.9 과체중, ≥ 25.0 비만)을 수립한 국가 공인 가이드라인.",
    "actionLabel": "ICMR 국가 가이드라인 확인"
  },
  {
    "title": "CDC 성인 체질량지수 스크리닝 표준",
    "org": "미국 질병통제예방센터 (CDC)",
    "url": "https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html",
    "desc": "성인 미터법 및 야드파운드법 공식 체질량지수 산출 표준 공식.",
    "actionLabel": "CDC 스크리닝 기준 살펴보기"
  },
  {
    "title": "건강한 개인의 휴식기 에너지 소비량 예측 공식",
    "org": "American Journal of Clinical Nutrition (Mifflin MD, St Jeor ST)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/2305711/",
    "desc": "기초대사량(BMR) 추정을 위해 가장 신뢰받는 미플린-세인트 지어 공식.",
    "actionLabel": "AJCN 학술 논문 검토"
  },
  {
    "title": "미 해군 인체 측정 기반 체지방률 공식",
    "org": "Naval Health Research Center (Hodgdon JA, Beckett WS)",
    "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2872290/",
    "desc": "신체 둘레 측정치를 통해 체지방률을 정밀하게 추정하는 로그 공식.",
    "actionLabel": "미 해군 연구 보고서 열람"
  },
  {
    "title": "복부 비만과 대사증후군에 관한 IDF 국제 합의 성명",
    "org": "세계당뇨병연맹 (IDF)",
    "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2782373/",
    "desc": "아시아 성인 복부 비만 위험 기준선(남성 >90cm, 여성 >80cm) 정의.",
    "actionLabel": "IDF 국제 합의 성명서 확인"
  },
  {
    "title": "옥스퍼드 2.5 거듭제곱 신장 보정 BMI 공식",
    "org": "옥스퍼드 대학교 (Prof. Nick Trefethen)",
    "url": "https://people.maths.ox.ac.uk/trefethen/bmi.html",
    "desc": "신장에 따른 3차원 인체 부피 왜곡을 정밀하게 보정한 수학적 공식.",
    "actionLabel": "옥스퍼드 수학 분석 자료 안내"
  }
];
---

<Layout 
    title="학술 연구 출처 및 의학 참고 문헌 | Real BMI"
    description="Real BMI의 모든 건강 계산식과 기준 범주의 근거가 되는 WHO, CDC, ICMR 등의 공인 의학 연구와 표준 공식을 확인하세요."
>
    <Navbar />
    <PageShell
      title="학술 연구 출처 및 의학 참고 문헌"
      eyebrow="과학적 근거 중심 표준"
      description="본 사이트의 모든 계산 공식과 기준선은 세계보건기구, 질병관리청 및 동료 평가를 거친 학술 연구 논문을 바탕으로 합니다."
      returnUrl="/ko/"
      returnLabel="Home"
    >
      <div class="space-y-8">
        <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] font-medium leading-relaxed space-y-4">
          <p class="text-lg">
            Real BMI는 과학적 투명성을 최우선 가치로 삼고 있습니다. 모든 신체 지수 산출식, 대사량 계산 모델 및 건강 위험 기준선은 세계보건기구(WHO), 미국 질병통제예방센터(CDC) 및 동료 평가를 통과한 국제 학술지의 공인 논문을 직접 인용하여 구축되었습니다.
          </p>
          <p class="text-sm md:text-base">
            사용자가 계산 알고리즘의 과학적 배경을 직접 검증할 수 있도록 공인 원문 논문 및 보건 기구 공식 지침에 대한 직접 링크를 안내합니다:
          </p>
        </div>

        <div class="grid gap-6">
          {sources.map((src) => (
            <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3 shadow-xs hover:border-[var(--accent)]/40 transition-all">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <span class="px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-wider border border-[var(--accent)]/20">
                  {src.org}
                </span>
                <a 
                  href={src.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--accent)] hover:underline"
                  aria-label={`${src.actionLabel}: ${src.title}`}
                >
                  {src.actionLabel}
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
              <h2 class="text-xl font-display font-bold text-[var(--foreground)]">{src.title}</h2>
              <p class="text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{src.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </PageShell>
</Layout>
