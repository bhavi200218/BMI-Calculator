---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="의학적 면책 조항 | Real BMI" description="Real BMI 의학적 면책 고지: 당사의 건강 계산기는 순수 교육 및 참고 목적으로 제공되며, 전문 의료진의 진단, 처방 및 치료 상담을 대체할 수 없습니다. 개인정보 수집 없는 안전한 브라우저 무료 연산 도구 제공. 모든 측정 공식과 지표는 공인된 연구 문헌을 참조합니다.">
    <Navbar />
    <main class="pt-40 pb-20 px-6 max-w-4xl mx-auto space-y-12 text-center">
        <a href="/ko" class="text-[10px] font-black uppercase tracking-widest text-[var(--foreground)] flex items-center gap-2 hover:translate-x-[-4px] transition-transform w-fit mx-auto">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            홈으로 돌아가기
        </a>
        <h1 class="text-5xl font-black tracking-tighter uppercase">의학적 면책 조항</h1>
        <div class="glass-card bg-[var(--muted)] border-[var(--border)] p-12 space-y-8">
            <p class="text-2xl font-black text-[var(--foreground)] uppercase tracking-widest">법적 건강 고지</p>
            <p class="text-[var(--muted-foreground)] leading-relaxed max-w-2xl mx-auto text-lg font-bold opacity-80">
                Real BMI의 콘텐츠는 정보 제공 목적으로만 사용됩니다.
            </p>
        </div>
    </main>
</Layout>
