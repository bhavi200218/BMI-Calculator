---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "고객 지원 및 문의 | Real BMI Calculator",
  "url": "https://realbmicalculator.com/ko/contact/",
  "description": "Real BMI 공식 문의 페이지입니다. 건강 계산기 수식 검증, 3D 시각화 기술 지원, 학술 제휴 및 이용 관련 피드백을 전달하세요.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Founder & Lead Developer",
      "url": "https://realbmicalculator.com/ko/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/ko/contact/",
      "contactType": "customer support",
      "availableLanguage": ["English", "Spanish", "French", "German", "Korean", "Hindi"]
    }
  }
};
---

<Layout title="고객 지원 및 문의 | Real BMI Calculator" description="Real BMI 공식 문의 페이지입니다. 건강 계산기 수식 검증, 3D 시각화 기술 지원, 학술 제휴 및 이용 관련 피드백을 전달하세요.">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-12">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/ko/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Home
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">고객 지원 및 문의</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">고객 지원 및 편집팀 문의</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              계산 공식의 의학적 출처, 3D 신체 시각화 도구의 기술적 오류 제보, 사이트 이용 의견이 있으신가요? 담당 팀에 직접 문의하세요.
            </p>
          </div>

                    <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                검증된 편집 투명성 및 개발자 신원 확인
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">설립자 겸 수석 개발자</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">소프트웨어 엔지니어 & 의료정보학</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">프로젝트 성격</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">독립 비영리 프로젝트</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Independent Health Informatics</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">운영 본부 및 위치</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">글로벌 건강 정보학 운영</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">공식 고객 지원</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">24–48시간 이내 직접 회신</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">전문 프로필 (LinkedIn)</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    링크드인 프로필 ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">검증된 개발자 신원</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Executive Ownership & Transparency Verification Table (AdSense / YMYL High-Trust Anchor) -->
          <div class="contact-table-wrap my-8 p-6 shadow-xs">
            <div class="mb-4 space-y-1">
              <p class="text-xs uppercase tracking-[0.28em] font-bold text-[var(--accent)]">소유권 및 편집 책임성</p>
              <h2 class="text-xl sm:text-2xl font-display font-black uppercase tracking-tight text-[var(--foreground)]">발행인 자격 및 운영 투명성 검증 표</h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">Google 검색 품질 평가자 가이드라인(YMYL 디지털 헬스케어 플랫폼을 위한 E-E-A-T 및 투명성 기준) 준수:</p>
            </div>
            <table class="contact-matrix-table">
              <thead>
                <tr>
                  <th style="width: 26%;">투명성 항목</th>
                  <th style="width: 32%;">검증된 상태 / 자격</th>
                  <th style="width: 42%;">운영 맥락 및 정책</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>설립자 및 총괄 개발자</strong></td>
                  <td><strong>Bhawanshi Dosi</strong></td>
                  <td>소프트웨어 엔지니어 및 의료 정보학 연구원. 계산 알고리즘, 수학적 모델 및 3D 시각화 시뮬레이터를 직접 설계 및 프로그래밍합니다.</td>
                </tr>
                <tr>
                  <td><strong>전문 프로필</strong></td>
                  <td><a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-bold text-[#464feb] hover:underline"><svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>linkedin.com/in/bhawanshi-dosi ↗</a></td>
                  <td>개발자 신원, 소프트웨어 공학 배경 및 프로젝트 관리 투명성을 보증하는 공개 전문 프로필입니다.</td>
                </tr>
                <tr>
                  <td><strong>프로젝트 구조</strong></td>
                  <td><strong>Independent Health Informatics Project</strong></td>
                  <td>독립적 교육 목적 웹 서비스. 100% 무료 공공 접근; 상업적 편향이나 유료 기능이 일절 없습니다.</td>
                </tr>
                <tr>
                  <td><strong>본부 및 운영 위치</strong></td>
                  <td><strong>Ahmedabad, Gujarat, India</strong></td>
                  <td>소프트웨어 개발, 서버 인프라 관리, 편집 검토 및 6개 국어 글로벌 이용자 지원 거점입니다.</td>
                </tr>
                <tr>
                  <td><strong>공식 문의 데스크</strong></td>
                  <td><a href="mailto:support@realbmicalculator.com" class="font-mono text-[#464feb] font-bold">support@realbmicalculator.com</a></td>
                  <td>수학적 공식 피드백, 버그 제보, 학술 문의를 위해 운영되는 모니터링 편지함. 24–48시간 이내 직접 회신 원칙.</td>
                </tr>
                <tr>
                  <td><strong>데이터 프라이버시</strong></td>
                  <td><strong>100% 브라우저 클라이언트 연산</strong></td>
                  <td>어떠한 개인 건강 지표(신장, 체중 등)도 원격 서버로 전송되거나 저장되지 않습니다. 모든 계산은 브라우저에서 로컬로 처리됩니다.</td>
                </tr>
                <tr>
                  <td><strong>의학적 기준</strong></td>
                  <td><a href="/ko/sources/" class="text-[#464feb] font-bold">색인된 학술 문헌 목록 &rarr;</a></td>
                  <td>발표된 주요 의학 논문에 직접 기반합니다: WHO Technical Report Series 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, Devine 1974.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Main Layout -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI는 WHO 및 각국 보건 당국의 학술 기준을 준수하며 개인 건강 데이터를 일체 저장하지 않는 독립적 건강 공학 및 교육 연구 프로젝트입니다.</p>
                <p>투명하고 책임 있는 운영을 위해 아래의 공식 발행자 정보와 문의 가이드라인을 확인해 주시기 바랍니다.</p>
              </div>

              <!-- Verified Trust & Transparency Grid -->
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">설립자 및 총괄 개발자</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    독립 소프트웨어 엔지니어 및 디지털 헬스 인포매틱스 연구자 (Lead Developer &amp; Project Creator)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">프로젝트 운영 성격</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Independent Educational Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    100% 무료 공공 건강 도구 • 사용자 데이터 수집 및 서버 저장 일체 없음 (100% Client-Side Privacy)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">운영 및 개발 소재지</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    글로벌 디지털 헬스 연산 연구 거점 (전 세계 6개 국어 동시 서비스)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">공식 문의 접수처</p>
                  </div>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-bold font-mono text-[var(--accent)] hover:underline block break-all">
                    <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
                  </a>
                  <p class="text-xs text-emerald-400 font-semibold">영업일 기준 24~48시간 이내 전문 인력 직접 회신</p>
                </div>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="ko" />
              </div>

              <!-- Guidance & Editorial Sections -->
              <div class="space-y-6 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. 계산 공식 검증 및 학술적 피드백</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">미플린-세인트 지오(Mifflin-St Jeor) 기초대사량 수식, 옥스퍼드 2.5 지수 공식 및 WHO 아시아 성인 기준선 적용에 대한 연구자 및 의료진의 학술적 제언을 적극 환영합니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. 3D WebGL 그래픽 및 브라우저 호환성 문의</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">3D 바디 시각화 도구 실행 중 그래픽 지연이나 호환성 오류가 발생하는 경우, 사용 중인 기기 기종 및 브라우저 환경(Chrome, Safari, Whale 등)을 함께 알려주시면 신속히 조치하겠습니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. 개별 의료 상담 및 임상 진단 제공 불가 안내</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI의 계산기는 통계적 건강 지표를 제공하는 교육용 도구입니다. 특정 질환의 진단, 처방전 검토 또는 맞춤형 식이요법 처방과 같은 개별 의료 상담은 관련 법령에 따라 제공할 수 없습니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. 문의 이메일의 개인정보 보호 원칙</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">지원 센터로 발송된 모든 문의 메일은 엄격한 보안 하에 열람되며, 이용자의 이메일 주소는 외부 마케팅 업체에 공유되지 않고 문의 해결 목적으로만 한시적으로 보관됩니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">5. 외부 웹사이트 계산기 임베드(iFrame) 안내</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">건강, 피트니스 포털 또는 교육 기관 웹사이트에서 Real BMI의 계산기를 인용하거나 반응형 위젯으로 웹페이지에 삽입하고자 하는 경우 표준 임베드 코드를 자유롭게 활용하실 수 있습니다. 맞춤형 크기 조절이나 학술 인용 문의는 이메일을 통해 접수해 주세요.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
