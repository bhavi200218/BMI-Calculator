---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "제작자 및 지원 센터 문의 | Real BMI Calculator",
  "url": "https://realbmicalculator.com/ko/contact/",
  "description": "기술 지원, 수학적 공식 검증, 편집 문의 및 건강 계산기에 관한 의견은 Real BMI 지원 센터로 문의해 주세요.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Software Engineer & Lead Developer",
      "url": "https://realbmicalculator.com/ko/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Banswara",
      "addressRegion": "Rajasthan",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/ko/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="제작자 및 지원 센터 문의 | Real BMI Calculator" 
    description="기술 지원, 수학적 공식 검증, 편집 문의 및 건강 계산기에 관한 의견은 Real BMI 지원 센터로 문의해 주세요."
    canonicalURL="https://realbmicalculator.com/ko/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-20 md:pt-24 pb-16 px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto space-y-8">
          <!-- Header block -->
          <div class="space-y-3">
            <a href="/ko/" class="inline-flex items-center gap-2 min-h-[44px] px-3 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              홈
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">직통 문의</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">제작자 및 지원 센터 문의</h1>
            <p class="text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)] font-medium max-w-4xl">
              계산 공식에 대한 학술적 질의, 3D 시뮬레이터 그래픽 오류, 건강 가이드에 대한 의견이 있으신가요? 개발자 바완시 도시(Bhawanshi Dosi)에게 직접 문의해 주세요.
            </p>
          </div>

          <!-- Creator & Project Identity Card (Clean, Open, Modern) -->
          <div class="rounded-2xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-6 sm:p-7 space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                개인 웹사이트 및 투명성 보장
              </div>
              <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#464feb] hover:underline">
                <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                LinkedIn 프로필 ↗
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">설립자 및 수석 개발자</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Bhawanshi Dosi</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">소프트웨어 엔지니어 & 단독 웹마스터</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">운영 거점</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">인도 라자스탄주 반스와라</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">글로벌 서비스 (6개 언어)</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">플랫폼 아키텍처</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">독립 건강 교육 프로젝트</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">23개 무료 건강 계산기</p>
              </div>
            </div>
          </div>

          <!-- Interactive Contact Form Component -->
          <div id="contact-desk">
            <ContactForm lang="ko" />
          </div>

          <!-- Communication Guidelines (3 Clear Cards, No Line Dividers) -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                커뮤니케이션 가이드라인 및 편집 한계
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                개발자 인박스로 메시지를 보내시기 전에 아래 지원 범위를 확인해 주시기 바랍니다.
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  1. 개별 의료 상담 불가 안내
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Real BMI는 발표된 학술 공식에 기초한 통계적 인구 집단 선별 도구를 제공합니다. 개인 검진 결과 분석, 질병 진단, 맞춤형 식단 및 처방은 제공하지 않으므로 전문의와 상담하시기 바랍니다.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  2. 비공개 서신 및 공개 UGC 비운영 정책
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  방문자 개인정보를 보호하고 검증되지 않은 의료 정보 확산이나 스팸을 방지하기 위해, Real BMI는 공개 댓글창, 게시판 또는 포럼을 운영하지 않습니다. 모든 메시지는 제작자가 직접 확인하는 비공개 이메일로 처리됩니다.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  3. 건강 데이터 서버 무저장 원칙
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  모든 계산 로직은 자바스크립트를 통해 사용자의 브라우저 내에서만 실행됩니다. 신장, 체중, 체지방률 등 입력 수치는 서버로 전송되거나 데이터베이스에 저장되지 않습니다.
                </p>
              </div>
            </div>
          </div>

          <!-- Support FAQ Section -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                자주 묻는 질문 (FAQ)
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                공식 출처, WebGL 렌더링 성능, 데이터 프라이버시 및 계산기 임베드에 관한 핵심 질문입니다.
              </p>
            </div>
            <div class="space-y-3.5">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  계산 공식 오류 제보나 학술 자료는 어떻게 제출하나요?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  해당 계산기 URL, 공식 변수 및 공인 학술 출처(PubMed, WHO, CDC 링크 등)를 기재하여 <!--email_off-->support@realbmicalculator.com<!--/email_off-->으로 보내주시면 바완시 도시가 직접 검토합니다.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Real BMI 계산기를 제 웹사이트나 블로그에 삽입할 수 있나요?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  네. 교육용, 비상업용 또는 상업용 웹사이트에 iFrame 위젯으로 무료 삽입할 수 있습니다. 사용자가 공식 문서를 확인할 수 있도록 Real BMI 출처 링크를 유지해 주시기 바랍니다.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  입력한 체중이나 신체 측정 정보가 서버에 저장되나요?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  아닙니다. 모든 계산은 100% 브라우저 로컬에서 자바스크립트로 처리됩니다. 탭을 닫거나 새로고침하면 입력된 모든 데이터는 즉시 소멸됩니다.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  문의에 대한 답변은 얼마나 걸리나요?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  모든 메시지는 바완시 도시가 직접 검토하며, 일반적으로 영업일 기준 24~48시간 이내에 회신을 드립니다. 그래픽 버그는 기기 모델과 브라우저를 기재해 주시면 신속히 해결됩니다.
                </p>
              </div>
            </div>
          </div>

          <!-- Policy & Trust Links Strip (No Line Dividers) -->
          <div class="pt-2">
            <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--muted)]/20 p-5 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">
                편집 및 거버넌스 표준
              </span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-medium">
                <a href="/ko/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>편집 정책 및 방법론</span>
                  <span>&rarr;</span>
                </a>
                <a href="/ko/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>15개 주요 과학 논문 인용</span>
                  <span>&rarr;</span>
                </a>
                <a href="/ko/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>의학적 면책 조항</span>
                  <span>&rarr;</span>
                </a>
                <a href="/ko/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>개인정보 처리방침</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
    </main>
</Layout>
