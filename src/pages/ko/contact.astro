---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "고객 지원 및 편집팀 문의 | Real BMI Calculator",
  "url": "https://realbmicalculator.com/ko/contact/",
  "description": "Real BMI 기술 지원, 계산 공식에 대한 학술적 피드백, 편집 문의 및 건강 계산기 개선 제안을 위해 문의해 주세요.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "소프트웨어 엔지니어 & 리드 개발자",
      "url": "https://realbmicalculator.com/ko/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/ko/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="문의하기 | Real BMI Calculator" 
    description="Real BMI 기술 지원, 계산 공식에 대한 학술적 피드백, 편집 문의 및 건강 계산기 개선 제안을 위해 문의해 주세요."
    canonicalURL="https://realbmicalculator.com/ko/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-10">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/ko/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              홈
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">문의 및 소통</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">고객 지원 및 편집팀 문의</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              계산기 알고리즘 공식, 3D 신체 시각화 시뮬레이터 오류, 건강 가이드에 관한 질문이 있으신가요? 전담 팀에 직접 문의하세요.
            </p>
          </div>

          <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                편집 및 프로젝트 투명성 원칙
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">설립자 및 개발자</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">소프트웨어 엔지니어 & 리드 개발자</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">프로젝트 특성</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">독립 프로젝트</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">독립 건강 계산기 프로젝트</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">운영 본부</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">인도 구자라트주 아메다바드</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">글로벌 6개 국어 지원</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">공식 고객 지원 데스크</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">24~48시간 이내 회신</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">전문 프로필</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    LinkedIn 프로필 ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">검증된 제작자 신원</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Layout (Clean 2-Column: Form & Guidance on Left, Support Desk on Right) -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start pt-2">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI는 WHO 및 CDC의 공인된 의학 기준을 기반으로 사용자 개인정보를 철저히 보호하는 무료 독립 건강 계산기 프로젝트입니다.</p>
                <p>문의 유형에 맞는 안내 지침을 확인하신 후 아래 양식을 통해 메시지를 보내주시기 바랍니다.</p>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="ko" />
              </div>

              <!-- Guidance & Editorial Sections (Consolidated, Non-Redundant) -->
              <div class="space-y-4 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. 공식 검증 및 학술적 피드백</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">미플린-세인트 지어 공식, 옥스퍼드 2.5 BMI 모델, WHO 아시아인 비만 기준 등 탑재된 모든 수학적 모델을 정기적으로 재검증합니다. 학술 논문 인용이나 개선 제안을 환영합니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. 기술적 문제 및 3D WebGL 시각화 지원</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">3D 시뮬레이터나 대화형 차트가 정상적으로 렌더링되지 않는 경우, 운영체제(OS), 기기 모델, 브라우저 버전(Chrome, Safari 등)을 함께 기재해 주시면 신속한 디버깅이 가능합니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. 개인별 의료 상담 불가 안내</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI는 통계적 인구 집단 선별 도구이며 의료 기관이 아닙니다. 개인 건강검진 수치 해석, 질환 진단, 맞춤형 투약 및 식단 처방은 제공하지 않으므로 전문의와 상담하시기 바랍니다.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. 콘텐츠 품질 및 개인정보 보호 (개인 데이터 미저장)</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">사용자 프라이버시를 보호하고 콘텐츠 품질을 유지하기 위해, Real BMI는 공개 페이지에 개인 건강 정보가 절대 기록되지 않도록 사전 검증을 거칩니다. 문의 양식을 통해 접수된 모든 내용은 엄격한 보안 하에 처리됩니다.</p>
                  </div>
                
              </div>

              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    자주 묻는 지원 질문 (FAQ)
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    공식 출처, WebGL 렌더링 성능, 데이터 프라이버시 및 계산기 임베드에 관한 핵심 질문입니다.
                  </p>
                </div>
                <div class="space-y-4">
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">수학적 오류를 제보하거나 공식 업데이트를 제안하려면 어떻게 하나요?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">해당 계산기 URL, 공식 내용, 공인 학술 논문(WHO, CDC, PubMed 등)을 기재하여 문의 양식으로 보내주시면 편집팀에서 48시간 이내에 검토합니다.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">블로그나 피트니스 웹사이트에 Real BMI 계산기를 삽입(Embed)할 수 있나요?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">네. 비영리 및 상업적 웹사이트 모두에서 iframe 위젯을 자유롭게 삽입할 수 있습니다. realbmicalculator.com 출처 링크를 유지해 주시기 바랍니다.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">입력한 신체 측정값이나 체중 데이터가 서버에 저장되나요?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">아닙니다. 모든 계산은 브라우저 내부에서 자바스크립트를 통해 로컬로 처리됩니다. 체중, 키, 체지방률 등 어떠한 생체 데이터도 원격 서버로 전송되지 않습니다.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">지원 데스크 문의 시 답변을 받기까지 얼마나 걸리나요?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">영업일 기준 24~48시간 이내에 검토 후 답변드립니다. 긴급한 3D 렌더링 버그의 경우 기기 정보를 포함해 주시면 빠른 처리가 가능합니다.</p>
                    </div>
                  
                </div>
              </div>
            </div>

            <!-- Sidebar Card (Streamlined, Non-Redundant Support Desk) -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">프로젝트 및 지원 안내</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">독립 건강 계산기 프로젝트</p>
              </div>

              <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">운영 본부:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">인도 구자라트주 아메다바드</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">지원 이메일:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-sm font-bold font-mono text-[#464feb] hover:underline block break-all mt-0.5">
                    support@realbmicalculator.com
                  </a>
                  <p class="text-[11px] text-emerald-500 font-semibold mt-0.5">영업일 기준 24~48시간 내 회신</p>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">프라이버시 표준:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">100% 브라우저 로컬 연산 (건강 데이터 미저장)</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">프로젝트 범위:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">25개 무료 건강 계산기 및 공인 기준표</span>
                </div>
              </div>

              <div class="space-y-2 pt-4 border-t border-[var(--border)]">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">신뢰 정책 및 기준:</span>
                <div class="flex flex-col gap-2 text-xs font-medium">
                  <a href="/ko/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>편집 정책 및 방법론</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/ko/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>15개 공인 1차 학술 문헌</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/ko/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>의학적 면책 조항</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/ko/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>개인정보 처리방침</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>

              <div class="pt-4 border-t border-[var(--border)]">
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Send Message
                </a>
              </div>
            </aside>
          </div>
        </div>
    </main>
</Layout>
