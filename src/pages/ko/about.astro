---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Real BMI 소개 — 설립자 및 방법론 표준"
    description="Real BMI의 설립자 Bhawanshi Dosi, 세계보건기구(WHO)와 질병통제예방센터(CDC)의 근거 기반 표준, 제로 데이터 프라이버시 원칙을 소개합니다."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Real BMI 소개",
      "description": "Real BMI의 조직 배경, 기술 거버넌스 및 근거 기반 건강 지표 산출 방법론.",
      "url": "https://realbmicalculator.com/ko/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "설립자 겸 수석 개발자",
          "description": "클라이언트 사이드 의학 알고리즘 및 무저장 개인정보 보호 아키텍처를 설계한 Real BMI의 설립자.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
        "@type": "Person",
        "name": "Bhawanshi Dosi",
        "jobTitle": "Founder & Lead Developer",
        "url": "https://realbmicalculator.com/ko/about/"
      },
        "knowsAbout": [
          "체질량지수 (BMI)",
          "기초대사량 (BMR)",
          "총 일일 에너지 소비량 (TDEE)",
          "신체 구성 분석",
          "인체계측 기준 지침"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Real BMI 소개"
      eyebrow="미션 및 근거 기반 연구 방법론"
      description="설립자 Bhawanshi Dosi가 공인된 WHO 및 CDC 표준 지침을 기반으로 직접 제작 및 운영합니다."
      returnUrl="/ko/"
      returnLabel="홈"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong>는 인도 라자스탄주 반스와라에 거주하는 <strong>Bhawanshi Dosi</strong>가 설립하고 개발 및 유지 관리하는 개인 건강 지표 및 생체 계측 참조 웹사이트입니다. 불투명한 수학적 알고리즘과 민감한 개인 건강 정보의 서버 트래킹 문제를 해결하기 위해, 사용자의 기기 내부에서 100% 로컬 연산되는 투명한 계산 모델을 제공합니다.</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/ko/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              방법론 및 공식 확인하기 →
            </a>
            <a href="/ko/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              제작자에게 문의하기
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
