  <link rel="alternate" hreflang="en" href="https://realbmicalculator.com/en/dmca-policy/" />
  <link rel="alternate" hreflang="es" href="https://realbmicalculator.com/es/dmca-policy/" />
  <link rel="alternate" hreflang="fr" href="https://realbmicalculator.com/fr/dmca-policy/" />
  <link rel="alternate" hreflang="de" href="https://realbmicalculator.com/de/dmca-policy/" />
  <link rel="alternate" hreflang="ko" href="https://realbmicalculator.com/ko/dmca-policy/" />
  <link rel="alternate" hreflang="hi" href="https://realbmicalculator.com/hi/dmca-policy/" />
  <link rel="alternate" hreflang="x-default" href="https://realbmicalculator.com/en/dmca-policy/" />
  <style>
    :root {
      --background: #091212;
      --foreground: #FCFAF7;
      --accent: #E8674A;
      --card: #11201D;
      --border: #182B27;
      --muted: #162925;
      --muted-foreground: #8FA7A7;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      background-color: var(--background);
      color: var(--foreground);
      line-height: 1.6;
      padding: 2.5rem 1rem;
    }
    .container {
      max-width: 56rem;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      padding: 2.5rem 1.5rem;
    }
    h1 { font-size: 2rem; font-weight: 800; margin-bottom: 1rem; }
    p { margin-bottom: 1.25rem; color: var(--muted-foreground); }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.75rem 1.75rem;
      border-radius: 0.75rem;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
    }
    .lang-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.75rem;
      margin: 1.5rem 0;
    }
    .lang-link {
      padding: 0.75rem;
      border-radius: 0.5rem;
      background: var(--muted);
      border: 1px solid var(--border);
      color: var(--foreground);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <main class="container">
    <header role="banner" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid var(--border);">
      <a href="/en/" class="logo site-logo" rel="home" aria-label="Real BMI Homepage" style="display:inline-flex;align-items:center;gap:0.75rem;text-decoration:none;">
        <img src="/favicon.svg" alt="Real BMI Logo" width="32" height="32" style="border-radius:0.5rem;background:var(--accent);padding:0.25rem;object-fit:contain;" />
        <span class="site-title" style="font-size:1.15rem;font-weight:800;text-transform:uppercase;color:var(--foreground);">Real BMI</span>
      </a>
      <a href="/en/" style="font-size:0.85rem;font-weight:700;color:var(--accent);text-decoration:none;">← Return to Home</a>
    </header>
    <h1>Copyright &amp; DMCA Policy</h1>
    <p>Real BMI respects intellectual property rights and adheres to the Digital Millennium Copyright Act (17 U.S.C. § 512). Select your preferred language to review our full copyright guidelines, permitted educational fair use, and notice procedures:</p>
    <div class="lang-grid">
      <a href="/en/dmca-policy/" class="lang-link">🇺🇸 English</a>
      <a href="/es/dmca-policy/" class="lang-link">🇪🇸 Español</a>
      <a href="/fr/dmca-policy/" class="lang-link">🇫🇷 Français</a>
      <a href="/de/dmca-policy/" class="lang-link">🇩🇪 Deutsch</a>
      <a href="/ko/dmca-policy/" class="lang-link">🇰🇷 한국어</a>
      <a href="/hi/dmca-policy/" class="lang-link">🇮🇳 हिन्दी</a>
    </div>
    <div style="margin-top: 1.5rem;">
      <a href="/en/dmca-policy/" class="btn">View English Policy →</a>
    </div>
  </main>
</body>
</html>
