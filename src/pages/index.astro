---
// Root Homepage — Primary Interactive Health Suite & Global Gateway
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HomepageHubWrapper from '../components/HomepageHubWrapper.astro';
import LatestArticles from '../components/LatestArticles.astro';
import EmbedWidgetBox from '../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Real BMI — Health Research Hub & Screening Suite"
	description="Real BMI is an evidence-based health research platform and calculation suite offering peer-reviewed metabolic guides, published WHO & CDC standards, and 23 free private health calculators and screening tools."
	canonicalURL="https://realbmicalculator.com/"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  1. HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-20 md:pt-24 pb-6 px-4 md:px-6">
			<div class="max-w-7xl mx-auto space-y-6">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-3.5 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						WHO & CDC STANDARDS • PRIVATE CLIENT-SIDE CALCULATION<span class="sr-only">. </span>
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Calculate Your Body Mass Index (BMI) & Health Metrics<span class="sr-only">. </span>
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-base sm:text-xl text-[var(--accent)] font-semibold tracking-tight font-display">
						Free, Private & Instant Evidence-Based Screening<span class="sr-only">. </span>
					</p>
					<p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed">
						Instant Body Mass Index screening and evidence-based metabolic calculators built on published World Health Organization (WHO) and CDC public health frameworks.
					</p>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-2.5 sm:gap-3 pt-1">
					{[
						'100% Free & Instant',
						'Accurate Metric & Imperial Calculations',
						'Client-Side Privacy',
						'WHO & CDC Standards'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}<span class="sr-only">. </span>
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  2. 🔥 ALL HEALTH & FITNESS CALCULATORS  ═══════════════════ -->
		<section id="calculators" class="px-4 md:px-6 pt-0 pb-10 md:pb-14 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-6">
				<header class="space-y-3 pb-4 border-b border-[var(--border)]/40">
					<div class="flex items-center justify-between gap-4">
						<span class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">🔥 Evidence-Based Suite</span>
						<span class="text-xs font-mono text-[var(--accent)] font-bold px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 shrink-0">
							23 Tools
						</span>
					</div>
					<h2 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						All Health & Fitness Calculators
					</h2>
					<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium max-w-3xl leading-relaxed">
						Explore our complete suite of 23 evidence-based health, body composition, and metabolic screening calculators. Built in accordance with published World Health Organization (WHO), CDC, and National Institutes of Health (NIH) physiological frameworks, every tool operates 100% client-side for complete privacy.
					</p>
				</header>

				<HomepageHubWrapper lang="en" />
			</div>
		</section>

		<!-- ═══════════════════  6. 📖 LATEST ARTICLES  ═══════════════════ -->
		<section id="latest-articles" class="px-4 md:px-6 py-10 md:py-14 border-b border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<LatestArticles lang="en" limit={6} />
			</div>
		</section>

		<!-- ═══════════════════  3. ⭐ TRUST SIGNALS & STANDARDS  ═══════════════════ -->
		<!-- WHY PEOPLE CHOOSE REAL BMI -->
		<section class="px-4 md:px-6 py-12 md:py-16 border-b border-[var(--border)]/40 space-y-12">
			<div class="max-w-7xl mx-auto space-y-10">
				<div class="space-y-3 text-center sm:text-left max-w-3xl">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">Transparent Calculator Features</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						Scientific Accuracy & Data Privacy
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
						Real BMI delivers verified physiological calculations grounded in peer-reviewed clinical research, public health standards, and a strict client-side data privacy architecture.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: 'Algorithmic Transparency', description: 'Every formula is implemented directly from published peer-reviewed literature, including Mifflin-St Jeor, Devine, Mosteller, and Karvonen.' },
						{ title: 'Zero Biometric Telemetry', description: 'Your physiological data never leaves your device. All calculations execute in local browser memory with zero tracking cookies or cloud storage.' },
						{ title: 'Multidimensional Analysis', description: 'Body mass index is interpreted alongside waist-to-hip ratio, body fat percentage, and basal metabolic rate for comprehensive health context.' },
						{ title: 'Validated Reference Norms', description: 'Calculations are presented with official classification cutoffs established by the WHO, CDC, American Heart Association, and NIH.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-3 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-sm hover:-translate-y-0.5">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand & Methodology Box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6 shadow-md">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-80">Transparent Methodology</p>
							<p class="text-2xl md:text-3xl font-display font-bold tracking-tight uppercase">HOW OUR CALCULATORS WORK</p>
							<p class="text-xs md:text-sm font-medium opacity-90 leading-relaxed pt-1">Explore our published formulas, reference standards, inputs, outputs, and limitations for all 23 tools.</p>
						</div>
						<a href="/en/methodology/" class="px-4 py-2.5 rounded-xl bg-white text-slate-900 font-display text-xs font-bold uppercase tracking-wider hover:bg-slate-100 transition-all shadow-xs">
							View Calculator Methodology →
						</a>
					</div>
				</div>

				<!-- Editorial & Research Verification Banner -->
				<div class="pt-4">
					<MedicalEEATBanner lang="en" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  7. ❓ GLOBAL RESEARCH FRAMEWORK & FAQ  ═══════════════════ -->
		<section id="faq-standards" class="px-4 md:px-6 py-10 md:py-14 border-b border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-12">
				
				<!-- Global Health Research Pillars -->
				<div class="space-y-6">
					<div class="space-y-2 max-w-3xl">
						<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
							Methodological Foundation
						</span>
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
							Anthropometric Science & Metabolic Frameworks
						</h2>
						<p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed">
							Explore the clinical rationales, physiological equations, and population-level health standards that govern accurate body metric interpretation.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="p-6 md:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3">
							<h3 class="text-lg font-display font-bold uppercase text-[var(--foreground)]">
								1. Screening Metrics vs. Clinical Diagnosis
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Body Mass Index (BMI) is an epidemiological screening index conceived by Adolphe Quetelet. While highly correlated with adipose mass across broad demographic cohorts, BMI does not directly quantify visceral fat or distinguish skeletal muscle hypertrophy from adiposity. Consequently, health authorities advise pairing BMI with waist circumference or hydrostatic/DEXA body composition assessments.
							</p>
						</div>

						<div class="p-6 md:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3">
							<h3 class="text-lg font-display font-bold uppercase text-[var(--foreground)]">
								2. Metabolic Energy & Basal Expenditure
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Basal Metabolic Rate (BMR) quantifies the thermal energy required to sustain vegetative cellular function at rest in a thermoneutral environment. The Mifflin-St Jeor equation provides the highest clinical accuracy for modern non-obese and obese populations, serving as the mathematical cornerstone for estimating Total Daily Energy Expenditure (TDEE).
							</p>
						</div>

						<div class="p-6 md:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3">
							<h3 class="text-lg font-display font-bold uppercase text-[var(--foreground)]">
								3. Cardiovascular Autonomic Conditioning
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Individualized cardiovascular conditioning relies on Heart Rate Reserve (HRR) computation via the Karvonen formula rather than crude peak-heart-rate estimations. Accounting for resting autonomic tone enables calibrated aerobic, anaerobic, and VO2-max training zones that enhance endurance while reducing overtraining risk.
							</p>
						</div>

						<div class="p-6 md:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3">
							<h3 class="text-lg font-display font-bold uppercase text-[var(--foreground)]">
								4. Ethnic Variations in Cardiometabolic Risk
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Standard international WHO BMI cutoffs frequently underestimate visceral adiposity and cardiovascular disease susceptibility in individuals of Asian and South Asian descent. Real BMI provides population-adjusted thresholds where overweight classification begins at 23 kg/m² and obesity at 25 kg/m² in alignment with WHO Asian consultation standards.
							</p>
						</div>
					</div>
				</div>

				<!-- Historical Evolution & Biometric Matrix -->
				<div class="space-y-6 pt-4 border-t border-[var(--border)]/40">
					<div class="space-y-2 max-w-3xl">
						<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
							Clinical Context
						</span>
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
							The Evolution of Body Composition & Anthropometry
						</h2>
						<p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed">
							Understanding how modern biometric indices evolved from 19th-century statistical sociology into contemporary physiological medicine.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="p-6 md:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3">
							<h3 class="text-lg font-display font-bold uppercase text-[var(--foreground)]">
								From Quetelet's Social Physics to Ancel Keys
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								In 1832, Belgian mathematician Adolphe Quetelet introduced the weight-to-height-squared ratio to identify the characteristics of the average man. Over a century later in 1972, physiologist Ancel Keys validated Quetelet's index across 7,400 men across multiple continents, demonstrating that weight divided by height squared correlated most closely with body fat percentage while remaining independent of stature. Keys formally named this parameter the Body Mass Index (BMI).
							</p>
						</div>

						<div class="p-6 md:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3">
							<h3 class="text-lg font-display font-bold uppercase text-[var(--foreground)]">
								Beyond Height and Weight: Modern 3D & Metabolic Metrics
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Today, sports scientists and clinical practitioners acknowledge that weight and height alone cannot distinguish adipose tissue from visceral fat, bone mineral density, or skeletal muscle volume. By integrating waist-to-hip ratio, Jackson-Pollock skinfold equations, US Navy circumference models, and digital 3D optical scanning, Real BMI bridges historical population metrics with modern body composition science.
							</p>
						</div>
					</div>
				</div>

				<!-- Dedicated Global Hub FAQ -->
				<div class="space-y-6 pt-4 border-t border-[var(--border)]/40">
					<div class="space-y-2 max-w-3xl">
						<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
							Platform Inquiries
						</span>
						<h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
							Frequently Asked Questions
						</h2>
						<p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed">
							Essential answers regarding calculator precision, algorithmic formulas, and data privacy safeguards.
						</p>
					</div>

					<div class="space-y-4">
						<div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2">
							<h3 class="text-base font-display font-bold uppercase text-[var(--foreground)]">
								How do the 23 calculators on Real BMI complement each other?
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								No single anthropometric index captures the totality of physical wellness. Our suite connects foundational screening tools (BMI, 3D BMI) with functional metabolic equations (BMR, TDEE, Calorie Deficit) and specialized performance metrics (Heart Rate Zones, 1RM, Body Surface Area) to provide a complete, interconnected physiological profile.
							</p>
						</div>

						<div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2">
							<h3 class="text-base font-display font-bold uppercase text-[var(--foreground)]">
								Why does Real BMI process all calculations client-side?
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Biometric measurements such as height, weight, body fat, and age constitute personal health information. By executing all mathematical formulas directly in your web browser via client-side JavaScript, Real BMI ensures your metrics never travel over external networks or get logged in remote databases.
							</p>
						</div>

						<div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2">
							<h3 class="text-base font-display font-bold uppercase text-[var(--foreground)]">
								How should these metrics be used alongside medical care?
							</h3>
							<p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
								Real BMI calculators serve as informative screening guides and baseline educational tools. They do not replace diagnostic examinations, blood panels, or personalized therapeutic advice from licensed healthcare professionals. Always discuss unexpected or extreme metric shifts with your primary care physician.
							</p>
						</div>
					</div>
				</div>

				<EmbedWidgetBox lang="en" />
			</div>
		</section>

	</main>
</Layout>
