---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact et Équipe Éditoriale | Real BMI Calculator",
  "url": "https://realbmicalculator.com/fr/contact/",
  "description": "Contactez l'équipe de Real BMI pour toute assistance technique, retour sur nos formules, questions éditoriales ou suggestions d'amélioration.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Ingénieur Logiciel et Développeur Principal",
      "url": "https://realbmicalculator.com/fr/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/fr/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="Contact | Real BMI Calculator" 
    description="Contactez l'équipe de Real BMI pour toute assistance technique, retour sur nos formules, questions éditoriales ou suggestions d'amélioration."
    canonicalURL="https://realbmicalculator.com/fr/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-10">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/fr/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Accueil
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Nous Contacter</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contact et Équipe Éditoriale</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              Une question sur nos formules, un souci technique avec le visualiseur 3D ou des remarques sur nos guides santé ? Contactez directement notre équipe.
            </p>
          </div>

          <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Transparence Éditoriale et du Projet
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Fondateur et Créateur</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Ingénieur Logiciel et Développeur Principal</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Nature du Projet</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Projet Indépendant</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Projet Indépendant de Calculatrices de Santé</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Siège et Opérations</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, Inde</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Inde et Accès Mondial</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Support Officiel</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">Réponse sous 24 à 48 heures</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Profil Professionnel</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    Profil LinkedIn ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Identité Vérifiée du Créateur</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Layout (Clean 2-Column: Form & Guidance on Left, Support Desk on Right) -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start pt-2">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI est un projet indépendant de calculatrices de santé dédié à fournir des outils gratuits, respectueux de la vie privée et basés sur des algorithmes scientifiques de l'OMS et des CDC.</p>
                <p>Consultez nos directives ci-dessous ou utilisez le formulaire pour transmettre directement votre message à notre équipe.</p>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="fr" />
              </div>

              <!-- Guidance & Editorial Sections (Consolidated, Non-Redundant) -->
              <div class="space-y-4 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. Questions sur les Formules et Retours Académiques</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Nous vérifions en continu nos implémentations de modèles mathématiques établis (Mifflin-St Jeor, Oxford 2.5, seuils asiatiques de l'OMS). Si vous souhaitez nous suggérer une référence ou une mise à jour, notre équipe éditoriale examinera attentivement vos remarques.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. Support Technique et Visualiseur 3D WebGL</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Si vous rencontrez un problème d'affichage avec le simulateur 3D ou les graphiques interactifs, merci de préciser votre système d'exploitation, votre modèle d'appareil et votre navigateur (Chrome, Safari, Edge ou Firefox).</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. Absence de Conseil Médical Individuel</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI propose des outils éducatifs d'évaluation populationnelle et ne peut en aucun cas interpréter des analyses médicales personnelles, poser des diagnostics ou recommander des traitements. Aucune demande d'avis médical personnalisé ne pourra être traitée.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. Qualité du Contenu et Protection de la Vie Privée (Aucune Donnée Personnelle Stockée)</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Pour protéger la confidentialité et maintenir la qualité du contenu, Real BMI applique une politique stricte garantissant qu'aucune donnée médicale n'est enregistrée sur nos serveurs. Nous n'hébergeons aucun forum public ni profil utilisateur. Tous les messages transmis via notre formulaire restent strictement confidentiels.</p>
                  </div>
                
              </div>

              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    Questions Fréquentes sur le Support
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    Interrogations courantes sur les sources scientifiques, le rendu 3D WebGL, la confidentialité et l'intégration des calculatrices.
                  </p>
                </div>
                <div class="space-y-4">
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Comment signaler une erreur de calcul ou suggérer une mise à jour ?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Envoyez votre message via le formulaire en indiquant l'URL de la calculatrice, la formule concernée et les références scientifiques (OMS, CDC ou PubMed). Notre équipe étudie chaque remarque sous 48 heures.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Puis-je intégrer les calculatrices Real BMI sur mon site ou blog ?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Oui. Vous pouvez utiliser librement notre widget iframe sur des sites commerciaux ou non commerciaux, en conservant le lien d'attribution vers realbmicalculator.com.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Mes mesures de santé sont-elles enregistrées sur vos serveurs ?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Non. Tous les calculs s'exécutent localement dans votre navigateur via JavaScript. Aucun poids, aucune taille ou pourcentage de graisse n'est envoyé à nos serveurs.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Quel est le délai de réponse de l'équipe technique ?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Nous traitons les demandes sous 24 à 48 heures ouvrées. Pour les rapports de bogues WebGL urgents, mentionnez votre appareil et navigateur pour faciliter la reproduction.</p>
                    </div>
                  
                </div>
              </div>
            </div>

            <!-- Sidebar Card (Streamlined, Non-Redundant Support Desk) -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Projet et Support</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Projet Indépendant de Calculatrices de Santé</p>
              </div>

              <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Siège Opérationnel :</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Ahmedabad, Gujarat, Inde</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Courriel Support :</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-sm font-bold font-mono text-[#464feb] hover:underline block break-all mt-0.5">
                    support@realbmicalculator.com
                  </a>
                  <p class="text-[11px] text-emerald-500 font-semibold mt-0.5">Réponse humaine sous 24 à 48h ouvrées</p>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Confidentialité :</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Calcul 100% dans le Navigateur (Aucune donnée de santé stockée)</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Périmètre du Projet :</span>
                  <span class="text-[var(--muted-foreground)] font-medium">25 Outils de Santé Gratuits et Normes de Référence</span>
                </div>
              </div>

              <div class="space-y-2 pt-4 border-t border-[var(--border)]">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">Politiques et Références :</span>
                <div class="flex flex-col gap-2 text-xs font-medium">
                  <a href="/fr/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>Politique Éditoriale et Méthodologie</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/fr/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>15 Citations Scientifiques Primaires</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/fr/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>Avertissement Médical</span>
                    <span>&rarr;</span>
                  </a>
                  <a href="/fr/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                    <span>Politique de Confidentialité</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>

              <div class="pt-4 border-t border-[var(--border)]">
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Send Message
                </a>
              </div>
            </aside>
          </div>
        </div>
    </main>
</Layout>
