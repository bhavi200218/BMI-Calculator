---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contactez-nous | Real BMI Calculator",
  "url": "https://realbmicalculator.com/fr/contact/",
  "description": "Contactez Real BMI pour une assistance technique, des questions sur nos formules mathématiques, des propositions éditoriales ou l'utilisation de nos outils.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Founder & Lead Developer",
      "url": "https://realbmicalculator.com/fr/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ahmedabad",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/fr/contact/",
      "contactType": "customer support",
      "availableLanguage": ["English", "Spanish", "French", "German", "Korean", "Hindi"]
    }
  }
};
---

<Layout title="Contactez-nous | Real BMI Calculator" description="Contactez Real BMI pour une assistance technique, des questions sur nos formules mathématiques, des propositions éditoriales ou l'utilisation de nos outils.">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-12">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/fr/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Home
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Nous Contacter</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Contact et Équipe Éditoriale</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              Une question sur les formules mathématiques de nos simulateurs, un problème d'affichage 3D ou une suggestion sur nos guides de santé ? Écrivez directement à notre équipe.
            </p>
          </div>

                    <!-- Prominent Founder & Transparency Banner (High-Authority Trust Signal) -->
          <div class="rounded-2xl border-2 border-[var(--accent)]/40 bg-gradient-to-r from-[var(--card)] via-[var(--background)] to-[var(--card)] p-6 md:p-8 shadow-sm">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Transparence Éditoriale &amp; du Projet
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-1">
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Fondateur &amp; Développeur</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Ingénieur logiciel &amp; Développeur</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Nature du projet</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Projet Indépendant</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Informatique biomédicale ouverte</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Base opérationnelle</span>
                  <p class="text-base font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, Inde</p>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Inde et Accès Global</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Support officiel</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-mono font-bold text-[#464feb] hover:underline block break-all">support@realbmicalculator.com</a>
                  <p class="text-xs text-emerald-500 font-semibold">Protocole de réponse en 24–48h</p>
                </div>
                <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-1">
                  <span class="text-xs uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Profil Professionnel</span>
                  <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#464feb] hover:underline flex items-center gap-1.5 pt-0.5">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    Profil LinkedIn ↗
                  </a>
                  <p class="text-xs text-[var(--muted-foreground)] font-medium">Identité de créateur vérifiée</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Executive Ownership & Transparency Verification Table (AdSense / YMYL High-Trust Anchor) -->
          <div class="contact-table-wrap my-8 p-6 shadow-xs">
            <div class="mb-4 space-y-1">
              <p class="text-xs uppercase tracking-[0.28em] font-bold text-[var(--accent)]">Titularité &amp; Responsabilité Éditoriale</p>
              <h2 class="text-xl sm:text-2xl font-display font-black uppercase tracking-tight text-[var(--foreground)]">Informations sur l'Éditeur et le Projet</h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">Transparence de la propriété, profil du créateur et coordonnées du projet éducatif Real BMI :</p>
            </div>
            <table class="contact-matrix-table">
              <thead>
                <tr>
                  <th style="width: 26%;">Paramètre</th>
                  <th style="width: 32%;">Information</th>
                  <th style="width: 42%;">Notes &amp; Contexte</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Fondateur &amp; Développeur Principal</strong></td>
                  <td><strong>Bhawanshi Dosi</strong></td>
                  <td>Ingénieur logiciel et développeur en informatique de santé. Concepteur et développeur des algorithmes et calculateurs de Real BMI.</td>
                </tr>
                <tr>
                  <td><strong>Profil Professionnel</strong></td>
                  <td><a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-bold text-[#464feb] hover:underline"><svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>linkedin.com/in/bhawanshi-dosi ↗</a></td>
                  <td>Profil professionnel public vérifiant l'identité du créateur, ses compétences en ingénierie logicielle et la gouvernance du projet.</td>
                </tr>
                <tr>
                  <td><strong>Structure du Projet</strong></td>
                  <td><strong>Projet Indépendant d'Informatique Médicale</strong></td>
                  <td>Projet éducatif indépendant et autofinancé. 100% gratuit et ouvert au public ; aucune influence pharmaceutique, traceur publicitaire ou accès payant.</td>
                </tr>
                <tr>
                  <td><strong>Siège &amp; Localisation</strong></td>
                  <td><strong>Ahmedabad, Gujarat, Inde</strong></td>
                  <td>Base opérationnelle pour le développement d'algorithmes, la maintenance d'infrastructure, l'évaluation éditoriale et le support multilingue en 6 langues.</td>
                </tr>
                <tr>
                  <td><strong>Canal d'Assistance Direct</strong></td>
                  <td><a href="mailto:support@realbmicalculator.com" class="font-mono text-[#464feb] font-bold">support@realbmicalculator.com</a></td>
                  <td>Boîte de réception activement surveillée pour les retours sur les formules de calcul, rapports de bugs et questions académiques. Délai de réponse garanti : 24 à 48 heures.</td>
                </tr>
                <tr>
                  <td><strong>Confidentialité des Données</strong></td>
                  <td><strong>100% Exécution Côté Client (Browser-Only)</strong></td>
                  <td>Aucune donnée de santé personnelle (PII) n'est envoyée ou stockée sur des serveurs distants. Tous les calculs s'effectuent localement dans votre navigateur web.</td>
                </tr>
                <tr>
                  <td><strong>Standards Scientifiques</strong></td>
                  <td><a href="/fr/sources/" class="text-[#464feb] font-bold">Bibliographie Académique Indexée &rarr;</a></td>
                  <td>Directement adossé aux études de référence : OMS Série de Rapports Techniques 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987 et Devine 1974.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Main Layout -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI est un projet indépendant d'ingénierie et d'éducation sanitaire dédié à la mise à disposition d'outils gratuits, sans collecte de données et fondés sur les recommandations de l'OMS et des CDC.</p>
                <p>Veuillez consulter les mentions du projet et les consignes de communication ci-dessous.</p>
              </div>

              <!-- Verified Trust & Transparency Grid -->
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Fondateur &amp; Développeur</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Ingénieur logiciel indépendant et développeur en informatique de santé (Lead Developer)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Nature du Projet</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Independent Educational Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    100% gratuit et ouvert • Aucune conservation de données de santé (100% Client-Side Privacy)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Localisation &amp; Siège</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Ahmedabad, Gujarat, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Projet indépendant d'information sur la santé (Plateforme disponible en 6 langues)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Support Officiel</p>
                  </div>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-bold font-mono text-[var(--accent)] hover:underline block break-all">
                    <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
                  </a>
                  <p class="text-xs text-emerald-400 font-semibold">Réponse humaine personnalisée sous 24 à 48 heures ouvrées</p>
                </div>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="fr" />
              </div>

              <!-- Guidance & Editorial Sections -->
              <div class="space-y-6 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. Questions Méthodologiques et Validité Scientifique</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Nous vérifions en permanence nos algorithmes de calcul métabolique (Mifflin-St Jeor, formule d'Oxford, seuils OMS pour populations asiatiques). Vos retours d'expérience et citations biomédicales sont toujours analysés avec la plus grande rigueur.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. Assistance Technique et Rendu 3D WebGL</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Si vous observez un ralentissement ou une anomalie graphique sur notre Visualiseur Corporel 3D, merci de préciser votre système d'exploitation et votre navigateur (Safari, Chrome, Firefox, Edge) pour nous aider à corriger le comportement.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. Absence de Conseil Médical Personnalisé</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI délivre des estimations statistiques anonymes à vocation pédagogique. Notre équipe ne peut en aucun cas interpréter des bilans sanguins individuels, poser de diagnostic médical ou prescrire de traitement clinique.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. Protection de Votre Correspondance</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Vos échanges par courrier électronique demeurent strictement confidentiels. Nous ne transmettons aucune adresse à des réseaux publicitaires tiers et supprimons les correspondances une fois la demande traitée.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">5. Intégration de Widgets et Outils Embarqués</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Si vous gérez un site web de santé, de fitness ou une plateforme pédagogique et désirez intégrer nos calculateurs interactifs ou citer nos tableaux de référence, vous pouvez employer nos widgets iframe standards. Pour des configurations spécifiques, écrivez-nous en précisant votre support.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">6. Signalement de Nouvelles Directives Sanitaires</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Nos simulateurs s'appuient sur les consensus de l'OMS, des CDC et des sociétés savantes. Si les autorités de santé publique de votre région ont édité de nouveaux repères anthropométriques officiels, partagez-nous la référence pour étude par notre équipe éditoriale.</p>
                  </div>
                
              </div>
            </div>

            <!-- Sidebar Card -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Transparence Éditoriale</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Projet indépendant d'ingénierie numérique en santé</p>
              </div>

              <!-- Founder & Transparency Badges -->
              <div class="space-y-3 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Fondateur &amp; Lead Developer:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Nature du Projet:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Independent Educational Project</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Siège &amp; Opérations:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Ahmedabad, Gujarat, India</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Contact Officiel:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-[var(--accent)] hover:underline font-mono break-all font-semibold">
                    support@realbmicalculator.com
                  </a>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Délai de Réponse:</span>
                  <span class="text-emerald-400 font-medium">24–48 heures ouvrées</span>
                </div>
              </div>

              <div class="pt-2 space-y-2.5">
                <a href="mailto:support@realbmicalculator.com" class="inline-flex w-full items-center justify-center rounded-xl bg-[var(--accent)] px-6 py-3.5 text-xs font-display font-bold uppercase tracking-[0.15em] text-white transition-all hover:opacity-90 shadow-xs min-h-[44px]">
                  Envoyer un E-mail Direct →
                </a>
                <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  <svg class="w-4 h-4 fill-current text-[#464feb]" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  Se connecter sur LinkedIn ↗
                </a>
                  Envoyer un Courriel Direct →
                </a>
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Ouvrir le Formulaire Web ↓
                </a>
              </div>

              <div class="pt-4 border-t border-[var(--border)]/60 space-y-2 text-xs text-[var(--muted-foreground)]">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>100% Confidentialité Navigateur (Zéro Donnée Santé sur Serveur)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Normes Biomédicales Validées (OMS, CDC)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Modération et Réponse Humaine Garantie</span>
                </div>
              </div>
            </aside>
          </div>
        </div>
    
              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    Foire Aux Questions — Assistance & Contact
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    Réponses aux questions courantes concernant les sources scientifiques, le simulateur 3D WebGL, la confidentialité et l'intégration de nos outils.
