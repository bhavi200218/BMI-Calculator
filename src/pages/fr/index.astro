---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import HealthContent from '../../components/HealthContent.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Calculateur d'IMC – Indice de Masse Corporelle Gratuit"
	description="Calculez votre Indice de Masse Corporelle (IMC) en ligne gratuitement. Référence aux normes officielles de l'OMS et calcul confidentiel dans le navigateur."
	keywords="calculateur imc, calculer imc, indice de masse corporelle, calculateur imc gratuit, poids ideal, calcul calories, imc oms, tableau imc"
	canonicalURL="https://realbmicalculator.com/fr/"
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  1. HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-20 md:pt-24 pb-6 px-4 sm:px-6 lg:px-8 xl:px-12">
			<div class="w-full max-w-[1600px] mx-auto space-y-6">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-3.5 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						CALCULATEURS D'IMC ET DE SANTÉ<span class="sr-only">. </span>
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Calculateur d'Indice de Masse Corporelle (IMC)<span class="sr-only">. </span>
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-base sm:text-xl text-[var(--accent)] font-semibold tracking-tight font-display">
						Connaissez votre IMC et comprenez votre zone de poids santé.<span class="sr-only">. </span>
					</p>
					<p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed">
						Calculez votre IMC, votre fourchette de poids santé et vos besoins caloriques quotidiens avec nos calculateurs de santé gratuits. Les résultats s'appuient sur les recommandations de l'OMS et des CDC et sont calculés directement dans votre navigateur.
					</p>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-2.5 sm:gap-3 pt-1">
					{[
						'Gratuit',
						'kg et lbs',
						'Calculs confidentiels',
						'Directives de l\'OMS et des CDC'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}<span class="sr-only">. </span>
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  2. CALCULATEURS DE SANTÉ ET FITNESS  ═══════════════════ -->
		<section id="calculators" class="px-4 sm:px-6 lg:px-8 xl:px-12 pt-0 pb-8 md:pb-10 scroll-mt-20">
			<div class="w-full max-w-[1600px] mx-auto space-y-6">
				<header class="flex items-center justify-between gap-4 pb-2">
					<h2 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						Calculateurs de Santé et Fitness<span class="sr-only">. </span>
					</h2>
					<span class="text-xs font-mono text-[var(--accent)] font-bold px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 shrink-0">
						23 Outils
					</span>
				</header>

				<HomepageHubWrapper lang="fr" />
			</div>
		</section>

		<!-- ═══════════════════  6. 📖 LATEST ARTICLES  ═══════════════════ -->
		<section id="latest-articles" class="px-4 sm:px-6 lg:px-8 xl:px-12 pt-8 md:pt-10 pb-10 md:pb-14 scroll-mt-20">
			<div class="w-full max-w-[1600px] mx-auto">
				<LatestArticles lang="fr" limit={6} />
			</div>
		</section>

		<!-- ═══════════════════  3. ⭐ TRUST SIGNALS & STANDARDS  ═══════════════════ -->
		<!-- WHY PEOPLE CHOOSE REAL BMI -->
		<section class="px-4 sm:px-6 lg:px-8 xl:px-12 py-8 md:py-10">
			<div class="w-full max-w-[1600px] mx-auto space-y-6">
				<div class="space-y-2 text-center sm:text-left max-w-3xl">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.25em] text-[var(--accent)]">Fonctionnalités Transparentes</p>
					<h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						Précision Scientifique et Confidentialité
					</h2>
					<p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-normal leading-relaxed">
						Real BMI applique des formules de santé vérifiées. Chaque outil s'exécute dans votre navigateur pour protéger votre vie privée.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
					{[
						{ title: 'Formules Mathématiques Claires', description: 'Chaque outil utilise des formules publiées telles que Mifflin-St Jeor, Devine et Karvonen.' },
						{ title: 'Zéro Collecte de Données', description: 'Vos données de santé restent sur votre appareil. Nous ne stockons ni ne suivons vos saisies personnelles.' },
						{ title: 'Évaluation Corporelle Complète', description: 'Comparez votre IMC avec votre pourcentage de graisse corporelle et votre tour de taille.' },
						{ title: 'Seuils de Santé Officiels', description: 'Tous les résultats sont présentés avec les plages de référence standard de l’OMS et des CDC.' },
					].map(item => (
						<div class="p-4 sm:p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] space-y-1.5 transition-all duration-200 hover:border-[var(--accent)]/50 hover:shadow-xs">
							<h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-normal leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
				</div>

				<!-- Transparent Methodology Strip -->
				<div class="p-4 sm:p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all duration-200 hover:border-[var(--accent)]/40">
					<div class="space-y-1">
						<div class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
							<span class="text-[11px] font-display font-bold uppercase tracking-wider text-[var(--accent)]">Méthodologie Transparente</span>
						</div>
						<h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">Comment Fonctionnent Nos 23 Outils</h3>
						<p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-normal">Découvrez les formules publiées, normes de référence, paramètres et limites de chaque outil.</p>
					</div>
					<a href="/fr/methodology/" class="px-4 py-2.5 rounded-xl bg-[var(--accent)] text-white font-display text-xs font-bold uppercase tracking-wider hover:opacity-95 transition-all shadow-xs inline-flex items-center gap-1.5 shrink-0 self-start sm:self-auto">
						<span>Consulter la Méthodologie →</span>
					</a>
				</div>

				<!-- Editorial & Research Verification Banner -->
				<MedicalEEATBanner lang="fr" />
			</div>
		</section>

		<!-- ═══════════════════  7. ❓ REFERENCE STANDARDS & FAQ  ═══════════════════ -->
		<section id="faq-standards" class="px-4 sm:px-6 lg:px-8 xl:px-12 py-10 md:py-14 scroll-mt-20">
			<div class="w-full max-w-[1600px] mx-auto space-y-12">
				<HealthContent lang="fr" />
				<EmbedWidgetBox lang="fr" />
			</div>
		</section>

	</main>
</Layout>