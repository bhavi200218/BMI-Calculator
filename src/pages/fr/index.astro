---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HeroQuickLaunch from '../../components/HeroQuickLaunch.astro';
import HomepageHubWrapper from '../../components/HomepageHubWrapper.astro';
import FeaturedResearchGuides from '../../components/FeaturedResearchGuides.astro';
import LatestArticles from '../../components/LatestArticles.astro';
import HealthContent from '../../components/HealthContent.astro';
import EmbedWidgetBox from '../../components/EmbedWidgetBox.astro';
import MedicalEEATBanner from '../../components/MedicalEEATBanner.astro';
---

<Layout 
	title="Real BMI — Centre de Recherche en Santé & Calculateurs"
	description="Suite de santé fondée sur les preuves et calculateurs conformes aux normes OMS et CDC. Guides de recherche évalués par les pairs et confidentialité totale."
>
	<Navbar />
	
	<main class="pb-4 relative overflow-x-hidden">

		<!-- ═══════════════════  1. HERO & MAIN HEADLINE  ═══════════════════ -->
		<section class="pt-24 md:pt-28 pb-8 md:pb-12 px-4 md:px-6">
			<div class="max-w-7xl mx-auto space-y-8">

				<!-- Main H1 & Hero Header -->
				<div class="text-center space-y-4 max-w-4xl mx-auto">
					<!-- Eyebrow Tag / Pill -->
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
						<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
						CENTRE DE RECHERCHE EN SANTÉ • GUIDES SCIENTIFIQUES ET OUTILS
					</div>

					<!-- Main H1 headline -->
					<h1 class="text-2xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight leading-[1.1] text-[var(--foreground)]">
						Recherche en Santé Fondée sur des Preuves, Guides Métaboliques et Outils
					</h1>

					<!-- Supporting H2 Subtitle & Intro -->
					<p class="text-lg sm:text-xl md:text-2xl text-[var(--accent)] font-semibold tracking-tight font-display">
						Littérature Scientifique Évaluée par les Pairs • Algorithmes de Parité • Confidentialité Totale
					</p>
					<p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium max-w-2xl mx-auto leading-relaxed pt-1">
						Consultez des travaux de recherche rigoureux, des guides anthropométriques du cycle de vie et des calculateurs privés développés selon les cadres de l'OMS et des CDC.
					</p>
				</div>

				<!-- Stats Strip -->
				<div class="flex flex-wrap justify-center gap-3 sm:gap-4 pt-1">
					{[
						'18+ Calculateurs de Santé',
						'30+ Guides de Recherche',
						'15 Études Indexées',
						'Normes OMS et CDC'
					].map(badge => (
						<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
							{badge}
						</div>
					))}
				</div>

			</div>
		</section>

		<!-- ═══════════════════  2. 🔥 MOST POPULAR CALCULATORS (TOP LAUNCHPAD)  ═══════════════════ -->
		<section id="popular-calculators" class="px-4 md:px-6 pt-2 pb-10 md:pb-14 content-auto scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-8">
				<HeroQuickLaunch lang="fr" />
			</div>
		</section>

		<!-- ═══════════════════  3. COMPLETE INTERACTIVE DIRECTORY  ═══════════════════ -->
		<section id="calculators" class="px-4 md:px-6 py-8 md:py-12 content-auto border-t border-[var(--border)]/40 bg-[var(--card)]/20 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-6">
				<div class="flex items-center justify-between gap-4 pb-3 border-b border-[var(--border)]/40">
					<h2 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
						Tous les Calculateurs par Catégorie
					</h2>
					<span class="text-xs font-mono text-[var(--accent)] font-bold">
						18+ Outils
					</span>
				</div>

				<HomepageHubWrapper lang="fr" />
			</div>
		</section>

		<!-- ═══════════════════  4. 📚 RESEARCH GUIDES  ═══════════════════ -->
		<section id="featured-guides" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 bg-[var(--card)]/10 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<FeaturedResearchGuides lang="fr" />
			</div>
		</section>

		<!-- ═══════════════════  5. ⭐ TRUST SIGNALS & STANDARDS  ═══════════════════ -->
		<!-- WHY PEOPLE CHOOSE REAL BMI -->
		<section class="px-4 md:px-6 py-12 md:py-16 content-auto border-t border-[var(--border)]/40 space-y-12">
			<div class="max-w-7xl mx-auto space-y-10">
				<div class="space-y-3 text-center sm:text-left max-w-3xl">
					<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">Fonctionnalités Transparentes</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase leading-[0.98] text-[var(--foreground)]">
						Clarté pour vos objectifs de santé
					</h2>
					<p class="text-base md:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
						Que vous suiviez vos progrès ou planifiiez votre nutrition, Real BMI vous fournit des estimations rapides et fiables basées sur des directives publiées.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{[
						{ title: 'Estimations fondées sur des formules', description: 'Obtenez des repères clairs pour l’IMC, le TMB, la TDEE et le poids idéal à l’aide d’équations publiées.' },
						{ title: 'Confidentialité totale en local', description: 'Tous les calculs s’exécutent sur votre appareil — sans inscription ni stockage de vos données de santé.' },
						{ title: 'Fondé sur les normes publiques', description: 'Les résultats sont contextualisés avec les plages de référence établies par l’OMS et les CDC.' },
						{ title: 'Utile au quotidien', description: 'Analysez vos métriques sportives et votre composition corporelle avec des explications méthodologiques transparentes.' },
					].map(item => (
						<div class="group p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] space-y-3 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-sm hover:-translate-y-0.5">
							<h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">{item.title}</h3>
							<p class="text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
					
					<!-- Brand & Methodology Box -->
					<div class="p-7 md:p-8 rounded-[var(--radius)] border-[1.5px] border-[var(--accent)]/20 bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white flex flex-col items-start justify-between gap-6 shadow-md">
						<div class="space-y-2">
							<p class="text-xs font-display font-semibold uppercase tracking-[0.3em] opacity-80">Méthodologie Transparente</p>
							<p class="text-2xl md:text-3xl font-display font-bold tracking-tight uppercase">COMMENT FONCTIONNENT NOS OUTILS</p>
							<p class="text-xs md:text-sm font-medium opacity-90 leading-relaxed pt-1">Découvrez nos formules publiées, normes de référence, paramètres et limites pour les 18+ calculateurs.</p>
						</div>
						<a href="/fr/methodology/" class="px-4 py-2.5 rounded-xl bg-white text-slate-900 font-display text-xs font-bold uppercase tracking-wider hover:bg-slate-100 transition-all shadow-xs">
							Consulter la Méthodologie →
						</a>
					</div>
				</div>

				<!-- Editorial & Research Verification Banner -->
				<div class="pt-4">
					<MedicalEEATBanner lang="fr" />
				</div>
			</div>
		</section>

		<!-- ═══════════════════  6. 📖 LATEST ARTICLES  ═══════════════════ -->
		<section id="latest-articles" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto">
				<LatestArticles lang="fr" limit={6} />
			</div>
		</section>

		<!-- ═══════════════════  7. ❓ REFERENCE STANDARDS & FAQ  ═══════════════════ -->
		<section id="faq-standards" class="px-4 md:px-6 py-10 md:py-14 content-auto border-t border-[var(--border)]/40 scroll-mt-20">
			<div class="max-w-7xl mx-auto space-y-12">
				<HealthContent lang="fr" />
				<EmbedWidgetBox lang="fr" />
			</div>
		</section>

	</main>
</Layout>