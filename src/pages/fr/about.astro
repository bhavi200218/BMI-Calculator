---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="À Propos de Real BMI – Fondatrice & Normes Méthodologiques"
    description="Découvrez Real BMI, une plateforme indépendante de calculs de santé développée par Bhawanshi Dosi, basée sur les publications scientifiques de l'OMS et des CDC."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "À Propos de Real BMI",
      "description": "Historique de la plateforme, qualifications de la créatrice et méthodologie scientifique de Real BMI.",
      "url": "https://realbmicalculator.com/fr/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Fondatrice et Développeuse Principale",
          "description": "Ingénieure logicielle et créatrice de Real BMI, spécialisée dans les moteurs de calcul santé côté client sans rétention de données.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Fondatrice et Développeuse Principale",
          "url": "https://realbmicalculator.com/fr/about/"
        },
        "knowsAbout": [
          "Indice de Masse Corporelle (IMC)",
          "Métabolisme de Base (BMR)",
          "Dépense Énergétique Totale (TDEE)",
          "Composition Corporelle",
          "Normes Anthropométriques Officielles",
          "Tests Algorithmiques Automatisés"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="À Propos de Real BMI"
      eyebrow="Mission & Méthodologie Basée sur les Preuves"
      description="Fondée, programmée et maintenue par Bhawanshi Dosi sur la base des publications scientifiques de l'OMS et des CDC."
      returnUrl="/fr/"
      returnLabel="Accueil"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-8">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> est une plateforme individuelle de calcul biométrique et d'éducation en santé fondée, développée et administrée par <strong>Bhawanshi Dosi</strong>, une ingénieure logicielle basée à Banswara, Rajasthan, Inde. Le projet a été créé pour remédier à un écueil majeur des outils en ligne : des interfaces surchargées de publicités intrusives, des traceurs de données personnelles et des formules opaques sans justificatif scientifique. Real BMI met à disposition des calculateurs transparents et vérifiables qui s'exécutent intégralement sur votre appareil sans aucune conservation de données.</p>
            
            <!-- Creator Profile Card -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-2xl shadow-md shrink-0">
                BD
              </div>
              <div class="space-y-2 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl font-bold text-[var(--foreground)]">Bhawanshi Dosi</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">Fondatrice &amp; Ingénieure Logicielle</span>
                </div>
                <p class="text-xs font-medium text-[var(--accent)]">Banswara, Rajasthan, Inde &bull; Créatrice &amp; Webmaster</p>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Ingénieure logicielle spécialisée dans les moteurs de calcul santé côté client sans rétention de données. Bhawanshi effectue personnellement la recherche, la conception, le développement et la maintenance des 23 calculateurs de Real BMI, en calibrant chaque algorithme selon la littérature scientifique officielle (OMS, CDC, ICMR).
                </p>
              </div>
            </div>

            <!-- Non-Clinical Disclosure Banner -->
            <div class="p-5 rounded-xl border border-amber-500/30 bg-amber-500/5 text-amber-200/90 text-sm leading-relaxed space-y-2 not-prose">
              <div class="flex items-center gap-2 font-bold text-amber-400">
                <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Gouvernance Transparente &amp; Déclaration Non Médicale</span>
              </div>
              <p>
                Real BMI est un projet individuel d'ingénierie logicielle créé et géré exclusivement par Bhawanshi Dosi. La plateforme <strong>ne gère aucun comité de révision médicale clinique, comité de médecins ou panel multidisciplinaire</strong>. Tous les outils sont des applications algorithmiques de formules scientifiques établies conçues pour la sensibilisation éducative, non pour un diagnostic clinique.
              </p>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Pipeline de Tests Mathématiques et de Vérification Automatisée</h2>
            <p>Puisque Real BMI n'emploie pas de comité médical subjectif, l'exactitude des calculs est assurée par une <strong>ingénierie logicielle rigoureuse pilotée par les tests (TDD)</strong>. Chaque équation, constante de conversion et seuil de référence est systématiquement validé par une suite de plus de 920 tests unitaires et de régression automatisés à chaque mise à jour :</p>

            <div class="grid gap-4 sm:grid-cols-2 not-prose pt-1">
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Conformité aux Formules Médicales
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Les formules (Mifflin-St Jeor 1990, Mosteller 1987, Devine 1974, OMS 854) sont vérifiées sur des jeux de données cliniques étalons.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Parité Métrique et Impériale
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Les calculs métriques (kg/cm) et impériaux (lbs/pouces) sont vérifiés avec le facteur 703,06957964 et une tolérance de &plusmn;0,01.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Tests de Seuils et Limites
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Validation automatisée des seuils OMS (18,5, 25,0, 30,0) et des critères spécifiques asiatiques (23,0, 27,5 kg/m&sup2;) sur les valeurs limites.
                </p>
              </div>
              <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)]/60 space-y-1.5">
                <h4 class="font-bold text-sm text-[var(--foreground)] flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Audit Zéro Rétention
                </h4>
                <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
                  Des tests d'architecture garantissent qu'aucune donnée biométrique n'est jamais transmise sur le réseau ni enregistrée dans un cookie.
                </p>
              </div>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Normes Mathématiques Basées sur la Littérature Scientifique</h2>
            <p>Chaque formule utilisée sur Real BMI est issue de publications scientifiques examinées par des pairs et de lignes directrices officielles de santé publique : le rapport technique 854 de l'Organisation Mondiale de la Santé (OMS), la consultation OMS Asie-Pacifique parue dans <em>The Lancet</em>, l'équation de calorimétrie indirecte de Mifflin-St Jeor, la formule de surface corporelle de Mosteller et les seuils de poids idéal de Devine.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Architecture Locale Zéro Rétention</h2>
            <p>Contrairement aux services commerciaux qui collectent les mesures biométriques des utilisateurs, Real BMI exécute l'intégralité des calculs directement dans la mémoire de votre navigateur via JavaScript côté client. Aucun poids, taille, âge ou donnée personnelle n'est transféré sur un serveur ni conservé dans une base de données.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">Portée Éducative et Avis Médical</h2>
            <p>Real BMI est un recueil de calcul et de référence éducative, et ne constitue en aucun cas un cabinet médical, un centre hospitalier ou un service de diagnostic clinique. Les résultats générés visent à soutenir la sensibilisation au bien-être personnel et à faciliter les échanges éclairés avec un médecin ou un professionnel de santé diplômé.</p>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 shadow-[var(--shadow-soft)] space-y-6">
          <div class="space-y-2">
            <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Créatrice &amp; Vérification</p>
            <h2 class="text-xl sm:text-2xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Plateforme Indépendante</h2>
            <p class="text-xs text-[var(--muted-foreground)] font-medium">Gérée personnellement par Bhawanshi Dosi</p>
          </div>

          <div class="space-y-4 pt-3 border-t border-[var(--border)] text-xs">
            <div>
              <span class="font-bold text-[var(--foreground)] block">Fondatrice &amp; Développeuse :</span>
              <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi (Ingénieure Logicielle)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Base Opérationnelle :</span>
              <span class="text-[var(--muted-foreground)] font-medium">Banswara, Rajasthan, Inde</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Méthode de Validation :</span>
              <span class="text-[var(--muted-foreground)] font-medium">920+ Tests Logiciels Automatisés</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Comité Médical :</span>
              <span class="text-[var(--muted-foreground)] font-medium">Aucun (Outil Éducatif Non Clinique)</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Modèle d'Exécution :</span>
              <span class="text-[var(--muted-foreground)] font-medium">100 % Côté Client dans le Navigateur</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Protection des Données :</span>
              <span class="text-[var(--muted-foreground)] font-medium">Zéro Rétention de Données Personnelles</span>
            </div>
            <div>
              <span class="font-bold text-[var(--foreground)] block">Cadre Scientifique :</span>
              <span class="text-[var(--muted-foreground)] font-medium">OMS, CDC et Études Cliniques</span>
            </div>
          </div>

          <div class="space-y-3 pt-4 border-t border-[var(--border)]">
            <a href="/fr/sources/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] hover:bg-[var(--accent)]/15 transition text-center">
              Sources et Références (15 Études) →
            </a>
            <a href="/fr/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition text-center">
              Découvrir la Méthodologie (23 Outils) →
            </a>
            <a href="/fr/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15 text-center">
              Contacter la Fondatrice →
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
