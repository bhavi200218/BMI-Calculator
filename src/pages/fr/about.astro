---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="À Propos de Real BMI – Fondatrice & Normes Méthodologiques"
    description="Découvrez Real BMI, plateforme indépendante fondée par Bhawanshi Dosi et maintenue par l'Équipe Éditoriale de Real BMI. Fórmules de l'OMS et des CDC."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "À Propos de Real BMI",
      "description": "Historique de la plateforme, méthodologie de calcul et protocole d'évaluation de Real BMI.",
      "url": "https://realbmicalculator.com/fr/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Fondatrice et Développeuse Principale",
          "description": "Ingénieure logicielle et créatrice de Real BMI, spécialisée dans les moteurs de calcul santé côté client sans rétention de données.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
          "@type": "Organization",
          "name": "Équipe Éditoriale Real BMI",
          "url": "https://realbmicalculator.com/fr/about/#editorial-team",
          "description": "Équipe éditoriale et de recherche scientifique gérant les calculatrices de santé selon les normes de l'OMS et des CDC."
        },
        "knowsAbout": [
          "Indice de Masse Corporelle (IMC)",
          "Métabolisme de Base (BMR)",
          "Dépense Énergétique Totale (TDEE)",
          "Composition Corporelle",
          "Normes Antropométriques Officielles"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="À Propos de Real BMI"
      eyebrow="Mission & Méthodologie Basée sur les Preuves"
      description="Fondée par Bhawanshi Dosi et maintenue par l'Équipe Éditoriale de Real BMI sur la base des publications scientifiques de l'OMS et des CDC."
      returnUrl="/fr/"
      returnLabel="Accueil"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> est une plateforme individuelle de calcul biométrique et d'éducation en santé fondée, développée et administrée par <strong>Bhawanshi Dosi</strong> (Banswara, Rajasthan, Inde). Le projet a été créé pour remédier à un écueil majeur des outils en ligne : des interfaces surchargées de publicités intrusives, des traceurs de données personnelles et des formules opaques sans justificatif scientifique.</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/fr/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              Découvrir la Méthodologie et les Formules →
            </a>
            <a href="/fr/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              Contacter l'Équipe Éditoriale
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
