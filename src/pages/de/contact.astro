---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Kontakt zur Entwicklerin & Support | Real BMI Calculator",
  "url": "https://realbmicalculator.com/de/contact/",
  "description": "Kontaktieren Sie Real BMI für technischen Support, Feedback zu mathematischen Formeln, redaktionelle Anfragen oder Anregungen zu unseren Rechnern.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Software Engineer & Lead Developer",
      "url": "https://realbmicalculator.com/de/about/",
      "sameAs": [
        "https://www.linkedin.com/in/bhawanshi-dosi"
      ]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Banswara",
      "addressRegion": "Rajasthan",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/de/contact/",
      "contactType": "customer support",
      "availableLanguage": [
        "English",
        "Spanish",
        "French",
        "German",
        "Korean",
        "Hindi"
      ]
    }
  }
};
---

<Layout 
    title="Kontakt zur Entwicklerin & Support | Real BMI Calculator" 
    description="Kontaktieren Sie Real BMI für technischen Support, Feedback zu mathematischen Formeln, redaktionelle Anfragen oder Anregungen zu unseren Rechnern."
    canonicalURL="https://realbmicalculator.com/de/contact/"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-20 md:pt-24 pb-16 px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto space-y-8">
          <!-- Header block -->
          <div class="space-y-3">
            <a href="/de/" class="inline-flex items-center gap-2 min-h-[44px] px-3 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Startseite
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Direkter Kontakt</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Kontakt zur Entwicklerin & Support</h1>
            <p class="text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)] font-medium max-w-4xl">
              Haben Sie Fragen zu unseren Berechnungsformeln, technische Probleme mit der 3D-Simulation oder Anmerkungen zu unseren Ratgebern? Schreiben Sie direkt an Bhawanshi Dosi.
            </p>
          </div>

          <!-- Creator & Project Identity Card (Clean, Open, Modern) -->
          <div class="rounded-2xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-6 sm:p-7 space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Individuelle Website & Transparenz
              </div>
              <a href="https://www.linkedin.com/in/bhawanshi-dosi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#464feb] hover:underline">
                <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                LinkedIn-Profil ↗
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Gründerin & Entwicklerin</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Bhawanshi Dosi</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Softwareentwicklerin & Webmasterin</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Standort & Betrieb</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Banswara, Rajasthan, Indien</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Weltweit verfügbar (6 Sprachen)</p>
              </div>
              <div class="space-y-1">
                <span class="font-bold uppercase tracking-wider text-[var(--muted-foreground)] block text-[11px]">Plattform-Architektur</span>
                <p class="text-base font-display font-bold text-[var(--foreground)]">Unabhängiges Gesundheitsprojekt</p>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">23 kostenlose Gesundheitsrechner</p>
              </div>
            </div>
          </div>

          <!-- Interactive Contact Form Component -->
          <div id="contact-desk">
            <ContactForm lang="de" />
          </div>

          <!-- Communication Guidelines (3 Clear Cards, No Line Dividers) -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                Kommunikationsrichtlinien & Redaktionelle Grenzen
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                Bitte beachten Sie unsere Support-Grundsätze vor dem Versenden einer Anfrage.
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  1. Keine individuelle medizinische Beratung
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Real BMI bietet statistische und epidemiologische Orientierungswerte auf Basis wissenschaftlicher Formeln. Wir bewerten keine Laborbefunde, stellen keine Diagnosen und empfehlen keine Therapien. Bitte konsultieren Sie approbierte Ärzte für persönliche Gesundheitsfragen.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  2. Vertrauliche E-Mail (Keine öffentlichen Nutzerbeiträge)
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Um den Datenschutz zu wahren und ungesicherte Gesundheitsaussagen oder Spam zu vermeiden, betreibt Real BMI keine öffentlichen Foren oder Kommentarbereiche. Alle Nachrichten sind vertrauliche E-Mails, die direkt von der Entwicklerin beantwortet werden.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-2">
                <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                  3. Keine Speicherung von Gesundheitsdaten
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Die gesamte Berechnungslogik läuft ausschließlich lokal in Ihrem Browser über JavaScript ab. Körpergrößen, Gewichtsangaben und biometrische Werte werden niemals an Server übertragen oder in Datenbanken gespeichert.
                </p>
              </div>
            </div>
          </div>

          <!-- Support FAQ Section -->
          <div class="space-y-4 pt-2">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                Häufig gestellte Fragen (FAQ)
              </h2>
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                Typische Fragen zu Formeln, WebGL-3D-Simulation, Datenschutz und der Einbindung von Rechnern.
              </p>
            </div>
            <div class="space-y-3.5">
              <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--card)]/60 p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Wie melde ich Formelfehler oder reiche Studien ein?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Senden Sie eine E-Mail an <!--email_off-->support@realbmicalculator.com<!--/email_off--> mit der betreffenden Rechner-URL, der Formelvariable und wissenschaftlichen Quellenangaben (z. B. PubMed, WHO oder CDC). Bhawanshi Dosi prüft jedes Feedback persönlich.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Darf ich Real BMI Rechner auf meiner Website oder meinem Blog einbetten?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Ja. Sie können unsere Widgets per Iframe kostenlos auf Bildungs-, Vereins- oder kommerziellen Websites einbinden. Wir bitten lediglich um den Erhalt des Quellhinweises auf realbmicalculator.com.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Werden meine biometrischen Eingaben gespeichert oder getrackt?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Nein. Alle Berechnungen erfolgen zu 100% lokal im Browser mittels JavaScript. Beim Schließen oder Neuladen des Tabs werden alle Eingaben rückstandslos gelöscht.
                </p>
              </div>
              <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-1.5">
                <h3 class="text-sm sm:text-base font-bold text-[var(--foreground)]">
                  Wie schnell erhalte ich eine Antwort?
                </h3>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  Alle Mitteilungen werden von Bhawanshi Dosi persönlich geprüft und üblicherweise innerhalb von 24 bis 48 Geschäftsstunden beantwortet. Bei technischen Darstellungsfehlern hilft die Nennung von Gerät und Browser.
                </p>
              </div>
            </div>
          </div>

          <!-- Policy & Trust Links Strip (No Line Dividers) -->
          <div class="pt-2">
            <div class="rounded-xl border border-[var(--border)]/70 bg-[var(--muted)]/20 p-5 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] block">
                Redaktionelle und Transparenz-Standards
              </span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-medium">
                <a href="/de/editorial-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Redaktionelle Richtlinien & Methodik</span>
                  <span>&rarr;</span>
                </a>
                <a href="/de/sources/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>15 wissenschaftliche Quellen</span>
                  <span>&rarr;</span>
                </a>
                <a href="/de/disclaimer/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Medizinischer Haftungsausschluss</span>
                  <span>&rarr;</span>
                </a>
                <a href="/de/privacy-policy/" class="text-[#464feb] hover:underline flex items-center gap-1">
                  <span>Datenschutzerklärung</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
    </main>
</Layout>
