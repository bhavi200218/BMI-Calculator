---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactForm from '../../components/ContactForm.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Kontakt | Real BMI Calculator",
  "url": "https://realbmicalculator.com/de/contact/",
  "description": "Kontaktieren Sie das Real BMI Team für technischen Support, methodisches Feedback zu Rechnerformeln, redaktionelle Anfragen oder Anregungen.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Real BMI Calculator",
    "url": "https://realbmicalculator.com",
    "founder": {
      "@type": "Person",
      "name": "Bhawanshi Dosi",
      "jobTitle": "Founder & Lead Developer",
      "url": "https://realbmicalculator.com/de/about/"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Banswara",
      "addressRegion": "Rajasthan",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@realbmicalculator.com",
      "url": "https://realbmicalculator.com/de/contact/",
      "contactType": "customer support",
      "availableLanguage": ["English", "Spanish", "French", "German", "Korean", "Hindi"]
    }
  }
};
---

<Layout title="Kontakt | Real BMI Calculator" description="Kontaktieren Sie das Real BMI Team für technischen Support, methodisches Feedback zu Rechnerformeln, redaktionelle Anfragen oder Anregungen.">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactSchema)} />
    <Navbar />
    <main class="pt-36 md:pt-40 pb-20 px-4 md:px-6">
        <div class="max-w-7xl mx-auto space-y-12">
          <!-- Header block -->
          <div class="space-y-4 max-w-4xl">
            <a href="/de/" class="inline-flex items-center gap-2 min-h-[48px] px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)] hover:text-[var(--foreground)] transition-colors rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              Home
            </a>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--accent)]">Kontakt aufnehmen</p>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black uppercase tracking-tight leading-tight text-[var(--foreground)]">Technischer Support & Redaktion</h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[var(--muted-foreground)] font-medium pt-1">
              Haben Sie Fragen zu den wissenschaftlichen Berechnungsformeln, technische Anregungen zum 3D-Körper-Visualisierer oder Feedback zu unseren Leitfäden?
            </p>
          </div>

          <!-- Main Layout -->
          <div class="grid gap-10 lg:grid-cols-[1.45fr_0.85fr] items-start">
            <div class="space-y-10">
              <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-base sm:text-lg font-medium opacity-90 space-y-4">
                <p>Real BMI ist ein unabhängiges Gesundheitsprojekt für digitale Berechnungswerkzeuge, das sich dem Schutz der Privatsphäre und wissenschaftlich transparenten Formeln nach Leitlinien der WHO, CDC und Fachgesellschaften verschrieben hat.</p>
                <p>Unser Ziel ist es, allen Nutzern verlässliche, evidenzbasierte Rechner und detaillierte anthropometrische Referenzdaten völlig kostenfrei und barrierefrei zur Verfügung zu stellen.</p>
              </div>

              <!-- Verified Trust & Transparency Grid -->
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Gründer &amp; Entwickler</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Bhawanshi Dosi</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Unabhängiger Software-Ingenieur &amp; Gesundheitsinformatiker (Lead Developer &amp; Project Creator)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Projektstruktur</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Independent Educational Project</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    100% kostenfreie, gemeinnützige digitale Gesundheitswerkzeuge • Null Datenspeicherung (Client-Side Privacy)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Standort &amp; Betrieb</p>
                  </div>
                  <p class="text-lg font-display font-black text-[var(--foreground)]">Banswara, Rajasthan, India</p>
                  <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                    Globale digitale Gesundheitsinformatik (Verfügbar in 6 Sprachen weltweit)
                  </p>
                </div>

                <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 shadow-xs space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <p class="text-xs uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Offizieller Support-Kanal</p>
                  </div>
                  <a href="mailto:support@realbmicalculator.com" class="text-base font-bold font-mono text-[var(--accent)] hover:underline block break-all">
                    <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
                  </a>
                  <p class="text-xs text-emerald-400 font-semibold">Persönliche Prüfung &amp; Antwort innerhalb von 24–48 Stunden (Werktags)</p>
                </div>
              </div>

              <!-- Interactive Contact Form -->
              <div id="contact-form">
                <ContactForm lang="de" />
              </div>

              <!-- Guidance & Editorial Sections -->
              <div class="space-y-6 pt-4 border-t border-[var(--border)]">
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">1. Formelmethodik & Wissenschaftliches Feedback</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Wir überprüfen unsere Implementierungen der Mifflin-St Jeor-Gleichung, der Oxford-Exponent-Formel und der WHO-Viszeralgrenzwerte fortlaufend. Akademische Anmerkungen und wissenschaftliche Quellenangaben prüfen wir sehr gerne.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">2. Technische Fehlerbehebung & 3D WebGL Visualisierung</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Sollten bei der interaktiven Darstellung des 3D-Modells oder bei Rechnerausgaben Darstellungsfehler auftreten, nennen Sie uns bitte Ihr Betriebssystem sowie die Browserversion (Chrome, Safari, Edge, Firefox).</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">3. Keine Individuelle Medizinische Beratung</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Real BMI stellt pädagogische Orientierungswerte für Gesamtpopulationen bereit. Wir können keine persönlichen Blutwerte interpretieren, klinische Diagnosen stellen oder individuelle Diät- und Trainingspläne verordnen.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">4. Datenschutz bei E-Mail-Kommunikation</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Alle an uns gerichteten Anfragen werden absolut vertraulich behandelt. E-Mail-Adressen werden nicht an Dritte weitergegeben und ausschließlich zur Beantwortung Ihres konkreten Anliegens verwendet.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">5. Widget-Einbindung & Website-Integration</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Falls Sie ein Gesundheitsportal, einen Fitness-Blog oder ein Bildungsangebot betreiben und unsere interaktiven Rechner via iFrame einbetten oder auf unsere Richtlinien verlinken möchten, können Sie unsere Standard-Widgets nutzen. Bei individuellen Größenanpassungen kontaktieren Sie uns bitte per E-Mail.</p>
                  </div>
                
                  <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                    <h2 class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">6. Hinweise auf Neue Medizinische Leitlinien</h2>
                    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Wir gleichen unsere Berechnungsmodelle fortlaufend mit Veröffentlichungen von WHO, CDC und Fachgesellschaften ab. Sollten nationale Gesundheitsbehörden in Ihrem Land neue Grenzwerte herausgegeben haben, senden Sie uns gerne die offizielle Publikationsquelle.</p>
                  </div>
                
              </div>
            </div>

            <!-- Sidebar Card -->
            <aside class="sticky top-28 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Verifizierte Transparenzdaten</p>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight font-display">Real BMI</h2>
                <p class="text-xs text-[var(--muted-foreground)] font-medium">Unabhängiges Projekt für digitale Gesundheitsinformatik</p>
              </div>

              <!-- Founder & Transparency Badges -->
              <div class="space-y-3 pt-3 border-t border-[var(--border)] text-xs">
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Gründer &amp; Lead Developer:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Bhawanshi Dosi</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Projektstruktur:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Independent Educational Project</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Standort &amp; Betrieb:</span>
                  <span class="text-[var(--muted-foreground)] font-medium">Banswara, Rajasthan, India</span>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Offizieller Kontakt:</span>
                  <a href="mailto:support@realbmicalculator.com" class="text-[var(--accent)] hover:underline font-mono break-all font-semibold">
                    support@realbmicalculator.com
                  </a>
                </div>
                <div>
                  <span class="font-bold text-[var(--foreground)] block">Antwortzeit:</span>
                  <span class="text-emerald-400 font-medium">24–48 Stunden an Werktagen</span>
                </div>
              </div>

              <div class="pt-2 space-y-2.5">
                <a href="mailto:support@realbmicalculator.com" class="inline-flex w-full items-center justify-center rounded-xl bg-[var(--accent)] px-6 py-3.5 text-xs font-display font-bold uppercase tracking-[0.15em] text-white transition-all hover:opacity-90 shadow-xs min-h-[44px]">
                  Direkte E-Mail senden →
                </a>
                <a href="#contact-form" class="inline-flex w-full items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] px-6 py-3 text-xs font-display font-bold uppercase tracking-[0.15em] text-[var(--foreground)] transition-all min-h-[44px]">
                  Online-Formular öffnen ↓
                </a>
              </div>

              <div class="pt-4 border-t border-[var(--border)]/60 space-y-2 text-xs text-[var(--muted-foreground)]">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>100% Client-Side Privacy (Null Gesundheitsdaten auf Servern)</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Verifizierte WHO- &amp; CDC-Referenzstandards</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Persönliche menschliche Prüfung jeder Anfrage</span>
                </div>
              </div>
            </aside>
          </div>
        </div>
    
              <!-- Support FAQ Section -->
              <div class="faq-support-section space-y-6 pt-6 border-t border-[var(--border)]">
                <div class="space-y-2">
                  <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
                    Häufig Gestellte Fragen zum Support
                  </h2>
                  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
                    Antworten auf häufige Fragen zu wissenschaftlichen Quellen, 3D-WebGL-Simulator-Kompatibilität, Datenschutz und Rechner-Einbindung.
                  </p>
                </div>
                <div class="space-y-4">
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Wie kann ich einen Berechnungsfehler melden oder Formelaktualisierungen vorschlagen?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Senden Sie Ihre Anfrage über unser Online-Support-Formular mit der betreffenden Rechner-URL, der mathematischen Gleichung und wissenschaftlichen Quellenangaben (z. B. WHO, CDC oder Fachpublikationen). Unser Fachteam prüft alle Hinweise gewissenhaft.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Darf ich die Rechner von Real BMI auf meiner eigenen Website einbetten?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Ja. Sie können unsere responsiven Widget-Iframes kostenfrei auf Fitness-, Ernährungs- und Bildungsportalen einbinden. Die Angabe der Quellenverlinkung zu realbmicalculator.com gewährleistet die transparente Nachvollziehbarkeit für Ihre Nutzer.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Werden meine eingegebenen Körpermaße oder Rechenergebnisse gespeichert?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Nein. Alle Berechnungen erfolgen ausschließlich clientseitig in Ihrem Webbrowser via JavaScript. Es findet zu keinem Zeitpunkt eine Übertragung oder dauerhafte Speicherung Ihrer Gesundheitsdaten auf unseren Webservern statt.</p>
                    </div>
                  
                    <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6 space-y-2">
                      <h3 class="text-base sm:text-lg font-bold text-[var(--foreground)]">Wie schnell beantwortet das Support-Team von Real BMI eingehende Anfragen?</h3>
                      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">Anfragen werden werktags in der Regel innerhalb von 24 bis 48 Stunden beantwortet. Bei technischen Problemen mit dem 3D-Visualisierer bitten wir um Angabe Ihres Betriebssystems und Browsers zur schnellen Fehlerbehebung.</p>
                    </div>
                  
                </div>
              </div>
  
    </main>
</Layout>
