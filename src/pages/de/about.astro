---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Über Real BMI - Klinische Standards & Redaktionsteam"
    description="Erfahren Sie mehr über Real BMI, unser medizinisches Informatik- und Redaktionsteam, evidenzbasierte WHO- und CDC-Standards sowie Datenschutzgarantien."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Über Real BMI",
      "description": "Organisatorischer Hintergrund, redaktionelles Prüfverfahren und klinische Referenzmethodik für Real BMI.",
      "url": "https://realbmicalculator.com/de/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Organization",
          "name": "Real BMI Gesundheitsinformatik-Team",
          "description": "Entwicklerteam für Gesundheitsinformatik mit Spezialisierung auf clientseitige medizinische Algorithmen und datenschutzfreundliche Architektur."
        },
        "knowsAbout": [
          "Body-Mass-Index (BMI)",
          "Grundumsatz (BMR)",
          "Gesamtenergiebedarf (TDEE)",
          "Körperzusammensetzung",
          "Anthropometrische Richtwerte"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Über Real BMI"
      eyebrow="Mission & Klinische Methodik"
      description="Gepflegt vom Real BMI Gesundheitsinformatik- und Redaktionsteam auf Basis begutachteter Fachliteratur und offizieller WHO- und CDC-Standards."
      returnUrl="/de/"
      returnLabel="Startseite"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> ist eine unabhängige Plattform für digitale Gesundheitsberechnungen und biometrische Orientierungswerte, gegründet von <strong>Bhawanshi Dosi</strong> und gepflegt vom <strong>Real BMI Redaktions- und Informatikteam</strong> (Ahmedabad, Gujarat, Indien). Das Projekt entstand aus der Motivation, eine zentrale Schwachstelle moderner Online-Gesundheitsportale zu beseitigen: intransparente mathematische Schätzungen, überladene Werbelayouts und invasive Tracking-Mechanismen persönlicher Gesundheitsdaten. Real BMI liefert wissenschaftlich fundierte, quelloffen überprüfbare Rechenmodelle, die zu 100 % lokal auf Ihrem Endgerät berechnet werden – ohne jegliche Speicherung personenbezogener Daten.</p>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">1. Redaktionelle Leitung & Forschungsteam</h2>
            
            <!-- Klinisches Prüfgremium Profil -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start" id="editorial-board">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-black text-xl shadow-md shrink-0">
                HIT
              </div>
              <div class="space-y-2 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold text-[var(--foreground)]">
                    Real BMI Team für Gesundheitsinformatik & Forschung
                  </h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Team für Gesundheitsinformatik & Evidenzprüfung</span>
                </div>
                <p class="text-xs font-medium text-[var(--accent)]">Gesundheitsinformatik, Biostatistik &amp; Primärliteratur (WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, Devine 1974)</p>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Unser interdisziplinäres Team für Gesundheitsinformatik und Redaktionsarbeit überwacht die mathematische Formelableitung, bevölkerungsbezogene Referenzbereiche, klinische Schwellenwerte und Verifikationsprotokolle für sämtliche Rechenwerkzeuge und Gesundheitsratgeber auf Real BMI.
                </p>
                <div class="pt-1">
                  <a href="/de/editorial-policy/" class="text-xs font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
                    Redaktionsrichtlinien &amp; Prüfungsprotokoll einsehen →
                  </a>
                </div>
              </div>
            </div>

            <!-- Technisches & Redaktionelles Board -->
            <div class="p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] not-prose flex flex-col sm:flex-row gap-5 items-start">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--muted)] border border-[var(--border)] flex items-center justify-center text-[var(--accent)] font-display font-black text-xl shadow-md shrink-0">
                RB
              </div>
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold text-[var(--foreground)]">Real BMI Entwicklungs- &amp; Redaktionsvorstand</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">Informatik-Team</span>
                </div>
                <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                  Unser Entwicklerteam hat sich auf clientseitige Gesundheitsinformatik, numerische Berechnungsverfahren und datenschutzorientierte Webarchitektur spezialisiert. Real BMI liefert standardisierte Berechnungen direkt im Browser aus, ohne Zwischenserver, Nutzerkonten oder permanente Tracker.
                </p>
              </div>
            </div>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2" id="medical-review">2. Klinische Methodik &amp; Referenzstandards</h2>
            <p>Da biometrische Berechnungen persönliche Lebensstil- und Gesundheitsentscheidungen betreffen (YMYL — Your Money or Your Life), werden sämtliche Algorithmen strikt mit begutachteten Studien und Veröffentlichungen internationaler Fachgesellschaften abgeglichen:</p>
            <ul>
              <li><strong>Weltgesundheitsorganisation (WHO):</strong> Technische Berichtsreihe 854 (Physical Status: The Use and Interpretation of Anthropometry) und Richtlinien des WHO-Regionalbüros für den westlichen Pazifik für asiatische Populationen (Übergewicht ab 23 kg/m², Adipositas ab 25 kg/m²).</li>
              <li><strong>Centers for Disease Control and Prevention (CDC):</strong> Perzentilkurven und statistische Erhebungen des National Center for Health Statistics (NCHS) für Jugendliche und Erwachsene.</li>
              <li><strong>Metabolische Formeln &amp; Energiebedarf:</strong> Die Mifflin-St.Jeor-Gleichung (1990) als wissenschaftlich zuverlässigster Prädiktor für den Grundumsatz; revidierte Harris-Benedict-Formel (Roza &amp; Shizgal 1984); Katch-McArdle-Modelle auf Basis fettfreier Masse.</li>
              <li><strong>Körperfett- &amp; Oberflächenberechnungen:</strong> US-Navy-Umfangsmethode (Hodgdon &amp; Beckett 1984), Mosteller-Formel zur Körperoberfläche (BSA 1987) und 3D-Volumenmodellierungen.</li>
            </ul>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">3. Unser 5-stufiges Vorveröffentlichungs- &amp; Prüfprotokoll</h2>
            <p>Zur Wahrung höchster redaktioneller und technischer Qualität durchläuft jedes Rechnerwerkzeug und jeder Fachbeitrag ein verbindliches 5-stufiges Prüfverfahren vor der Liveschaltung:</p>
            <ol>
              <li><strong>Formelableitung aus Primärquellen:</strong> Rechenmodelle werden unmittelbar aus publizierten wissenschaftlichen Originalarbeiten abgeleitet und mit den aktuellen DGE-, WHO- und CDC-Richtlinien abgeglichen.</li>
              <li><strong>Einheitenparitäts-Validierung:</strong> Automatisierte Doppelstrom-Tests stellen sicher, dass sowohl im metrischen System (cm/kg) als auch im imperialen System (ft-in/lbs) identische physiologische Aussagen resultieren.</li>
              <li><strong>Zero-PII- und Datenschutzprüfung:</strong> Ein strukturierter Datenschutz-Audit garantiert, dass zu keinem Zeitpunkt personenbezogene Daten (Namen, E-Mail-Adressen, IP-Adressen) in Eingaben, Protokollen oder URL-Parametern exponiert werden.</li>
              <li><strong>Clientseitige Speicherisolation:</strong> Technische Verifikation, dass biometrische Eingaben im flüchtigen Browserspeicher verbleiben und niemals über externe HTTP-Endpunkte an Backend-Server übertragen werden.</li>
              <li><strong>Klinische Grenzwerte &amp; transparente Hinweispflicht:</strong> Jeder Rechner dokumentiert Limitationen (z. B. bei Kraftsportlern, Schwangeren oder Senioren mit Sarkopenie) und enthält klare gesundheitliche Einordnungen.</li>
            </ol>

            <h2 class="text-2xl font-bold font-display text-[var(--foreground)] pt-2">4. Medizinischer Hinweis &amp; Informationszweck</h2>
            <p>Real BMI versteht sich als mathematisches Orientierungs- und Bildungswerkzeug und nicht als Ersatz für eine ärztliche Konsultation, Diagnose oder Therapie. Die errechneten Richtwerte dienen dem persönlichen Überblick und der Vorbereitung auf ein qualifiziertes Gespräch mit einem Arzt, Ernährungsberater oder Fachtherapeuten.</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Veröffentlichte Formeln</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Berechnungen basieren auf dokumentierten mathematischen Formeln und Bevölkerungsbenchmarks.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Datenschutz Zuerst</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Eingaben verbleiben lokal auf Ihrem Endgerät und werden beim Schließen rückstandslos gelöscht.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">WHO &amp; CDC Standards</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Internationale Referenzbereiche mit populationsspezifischen asiatischen Schwellenwerten.</p>
            </div>
            <div class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6">
              <p class="text-sm uppercase tracking-[0.3em] font-bold text-[var(--accent)]">Evidenzbasierte Orientierung</p>
              <p class="mt-4 text-base text-[var(--foreground)] font-semibold">Wissenschaftlich fundierte Orientierungswerte für Training, Alltag und Ernährungsplanung.</p>
            </div>
          </div>
        </div>

        <aside class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-8 shadow-[var(--shadow-soft)] space-y-6">
          <p class="text-xs uppercase tracking-[0.32em] font-semibold text-[var(--accent)]">Projektmission</p>
          <h2 class="text-2xl font-black text-[var(--foreground)]">Transparente Referenz-Tools</h2>
          <p class="text-sm leading-relaxed text-[var(--muted-foreground)]">Real BMI wurde geschaffen, um allen Nutzern mathematisch transparente, werbungsarme und datenschutzfreundliche Gesundheitsberechnungen zugänglich zu machen. Wir verwenden keine undurchsichtigen proprietären Algorithmen.</p>

          <div class="space-y-4 text-xs text-[var(--muted-foreground)] leading-relaxed border-t border-[var(--border)] pt-4">
            <p><strong>Redaktionsleitung:</strong> Real BMI Gesundheitsinformatik- &amp; Redaktionsteam</p>
            <p><strong>Klinische Referenzen:</strong> <a href="/de/sources/" class="text-[var(--accent)] hover:underline font-semibold">15 Primärzitate</a> (WHO TRS 854, Lancet 2004, Mifflin MD 1990, Mosteller 1987, Devine 1974)</p>
            <p><strong>Architektur:</strong> 100 % Clientseitige Browser-Berechnung ohne Datenübertragung</p>
            <p><strong>Datenschutzstandard:</strong> Konform mit DSGVO und Google Publisher Richtlinien</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/de/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              Methodik &amp; Formeln einsehen →
            </a>
            <a href="/de/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              Redaktionsteam Kontaktieren
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
