---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';
---

<Layout 
    title="Über Real BMI - Gründerin & Methodische Standards"
    description="Erfahren Sie mehr über Real BMI, eine individuelle Plattform für Gesundheitsrechner, gegründet und gepflegt von Bhawanshi Dosi auf Basis von WHO- und CDC-Standards."
>
    <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Über Real BMI",
      "description": "Organisatorischer Hintergrund, redaktionelles Prüfverfahren und wissenschaftliche Referenzmethodik für Real BMI.",
      "url": "https://realbmicalculator.com/de/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Real BMI",
        "url": "https://realbmicalculator.com",
        "founder": {
          "@type": "Person",
          "name": "Bhawanshi Dosi",
          "jobTitle": "Gründerin und Leitende Entwicklerin",
          "description": "Software-Ingenieurin und Entwicklerin von Real BMI, spezialisiert auf datenschutzfreundliche clientseitige Gesundheitsrechner ohne Datenspeicherung.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Banswara",
            "addressRegion": "Rajasthan",
            "addressCountry": "IN"
          }
        },
        "author": {
        "@type": "Person",
        "name": "Bhawanshi Dosi",
        "jobTitle": "Founder & Lead Developer",
        "url": "https://realbmicalculator.com/de/about/"
      },
        "knowsAbout": [
          "Body-Mass-Index (BMI)",
          "Grundumsatz (BMR)",
          "Gesamtenergiebedarf (TDEE)",
          "Körperzusammensetzung",
          "Anthropometrische Richtwerte"
        ]
      }
    })}></script>
    <Navbar />
    <PageShell
      title="Über Real BMI"
      eyebrow="Mission & Evidenzbasierte Methodik"
      description="Gegründet und gepflegt von Bhawanshi Dosi anhand wissenschaftlicher Fachliteratur und veröffentlichter WHO- & CDC-Standards."
      returnUrl="/de/"
      returnLabel="Startseite"
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.85fr] items-start">
        <div class="space-y-10">
          <div class="space-y-6 prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] leading-relaxed text-lg font-medium opacity-90">
            <p><strong>Real BMI</strong> ist eine individuelle Plattform für digitale Gesundheitsberechnungen und biometrische Orientierungswerte, gegründet, entwickelt und gepflegt von <strong>Bhawanshi Dosi</strong> (Banswara, Rajasthan, Indien). Das Projekt entstand, um eine zentrale Schwachstelle moderner Online-Portale zu beseitigen: intransparente Rechenmodelle, überladene Werbelayouts und invasive Tracking-Mechanismen.</p>
          </div>

          <div class="space-y-3 pt-2">
            <a href="/de/methodology/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--border)] bg-[var(--muted)] px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--foreground)] hover:border-[var(--accent)] transition">
              Methodik &amp; Formeln einsehen →
            </a>
            <a href="/de/contact/" class="inline-flex items-center justify-center w-full rounded-full border border-[var(--accent)] bg-[var(--accent)]/10 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--accent)] transition hover:bg-[var(--accent)]/15">
              Entwicklerin Kontaktieren
            </a>
          </div>
        </aside>
      </div>
    </PageShell>
</Layout>
