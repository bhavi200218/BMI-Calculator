---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageShell from '../../components/PageShell.astro';

const sources = [
  {
    "title": "WHO Physischer Status: Nutzung und Interpretation der Anthropometrie",
    "org": "Weltgesundheitsorganisation (WHO / NLM PubMed)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/8594834/",
    "desc": "Offizieller WHO-Bericht zur Festlegung globaler BMI-Kategorien und Referenzschwellenwerte für Erwachsene.",
    "actionLabel": "WHO-Bericht einsehen"
  },
  {
    "title": "WHO-Expertenberatung: Angemessener BMI für asiatische Bevölkerungen",
    "org": "The Lancet (WHO-Expertenberatung)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/14726171/",
    "desc": "Bedeutende Lancet-Publikation 2004 mit Handlungsauslösern (23,0 kg/m² erhöhtes Risiko, 27,5 kg/m² hohes Risiko).",
    "actionLabel": "Lancet-Studie lesen"
  },
  {
    "title": "Konsensus-Erklärung zur Diagnose von Adipositas bei asiatischen Indern",
    "org": "ICMR & JAPI (Misra A, et al.)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/19702033/",
    "desc": "Nationale Leitlinie mit Referenzwerten (18,5–22,9 normal, 23,0–24,9 Übergewicht, ≥ 25,0 Adipositas).",
    "actionLabel": "ICMR-Leitlinie abrufen"
  },
  {
    "title": "CDC Erwachsenen-BMI-Screening-Standards",
    "org": "Centers for Disease Control and Prevention (CDC)",
    "url": "https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html",
    "desc": "Offizielle CDC-Standardgleichung für metrische und imperiale BMI-Berechnungen bei Erwachsenen.",
    "actionLabel": "CDC-Richtlinie öffnen"
  },
  {
    "title": "Mifflin-St Jeor Prädiktionsgleichung für den Ruheenergieverbrauch",
    "org": "American Journal of Clinical Nutrition (Mifflin MD, St Jeor ST)",
    "url": "https://pubmed.ncbi.nlm.nih.gov/2305711/",
    "desc": "Mifflin-St Jeor Formel zur Schätzung des Basal Metabolic Rate (BMR Grundumsatz).",
    "actionLabel": "AJCN-Originalstudie ansehen"
  },
  {
    "title": "US Navy Anthropometrische Logarithmus-Körperfettformel",
    "org": "Naval Health Research Center (Hodgdon JA, Beckett WS)",
    "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2872290/",
    "desc": "Maßbandgestützte logarithmische Formel zur Schätzung des prozentualen Körperfettanteils.",
    "actionLabel": "Forschungsbericht lesen"
  },
  {
    "title": "IDF-Konsensus zu abdominaler Adipositas und metabolischem Syndrom",
    "org": "International Diabetes Federation (IDF)",
    "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2782373/",
    "desc": "Taillenumfang-Schwellenwerte (>90 cm Männer, >80 cm Frauen) für asiatische Risikogruppen.",
    "actionLabel": "IDF-Konsensus prüfen"
  },
  {
    "title": "Oxford 2,5 Exponenten-Größenkorrigierte BMI-Formel",
    "org": "Universität Oxford (Prof. Nick Trefethen)",
    "url": "https://people.maths.ox.ac.uk/trefethen/bmi.html",
    "desc": "Mathematische Korrektur zur Kompensation dreidimensionaler Körperskalierungsverzerrungen.",
    "actionLabel": "Oxford-Dokumentation aufrufen"
  }
];
---

<Layout 
    title="Wissenschaftliche Quellen & Referenzen | Real BMI"
    description="Überprüfen Sie primäre Forschungsquellen, mathematische Formeln und offizielle WHO-, CDC- und ICMR-Richtlinien hinter den Berechnungen auf Real BMI."
>
    <Navbar />
    <PageShell
      title="Wissenschaftliche Quellen & Referenzen"
      eyebrow="Evidenzbasierte Gesundheitsstandards"
      description="Diese offiziellen Gesundheitsorganisationen und wissenschaftlichen Veröffentlichungen bilden die Grundlage aller Berechnungen auf Real BMI."
      returnUrl="/de/"
      returnLabel="Home"
    >
      <div class="space-y-8">
        <div class="prose prose-zinc dark:prose-invert max-w-none text-[var(--muted-foreground)] font-medium leading-relaxed space-y-4">
          <p class="text-lg">
            Transparenz und wissenschaftliche Fundierung stehen im Zentrum unseres Informationsportals. Alle auf Real BMI implementierten mathematischen Modelle, anthropometrischen Schwellenwerte und Kalorienformeln stützen sich direkt auf Veröffentlichungen führender Gesundheitsbehörden und von Fachkollegen begutachtete Fachliteratur.
          </p>
          <p class="text-sm md:text-base">
            Nachfolgend finden Sie die zentralen Primärquellen, klinischen Leitlinien und mathematischen Forschungsarbeiten mit direkten Verweisen auf die jeweiligen wissenschaftlichen Fachpublikationen:
          </p>
          <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-3 mt-4">
            <h2 class="text-lg md:text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-tight">Mathematische Methodik & Formelstandards</h2>
            <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed">
              Real BMI berechnet den Body-Mass-Index (BMI) nach der international anerkannten Quetelet-Formel [Gewicht (kg) / Körpergröße (m)²] und integriert zusätzlich die Oxford 2.5-Formel zur Kompensation dreidimensionaler Skalierungsverzerrungen bei sehr großen oder kleinen Personen. Zur Schätzung des Grundumsatzes (BMR) implementieren wir die klinisch validierte Mifflin-St Jeor-Gleichung, kombiniert mit evidenzbasierten Aktivitätsmultiplikatoren (PAL) von 1,2 bis 1,9 zur präzisen Ermittlung des Gesamtenergieumsatzes (TDEE).
            </p>
            <h2 class="text-lg md:text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-tight pt-2">Pädagogischer Anwendungsbereich & Abgrenzung</h2>
            <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed">
              Der Body-Mass-Index ist ein epidemiologisches Screening-Instrument auf Bevölkerungsebene und kein medizinisches Diagnosewerkzeug. Er differenziert nicht zwischen fettfreier Skelettmuskelmasse und internem viszeralem Fettgewebe. Real BMI empfiehlt Nutzerinnen und Nutzern, die Rechenergebnisse stets im Kontext ihrer individuellen Lebensgewohnheiten zu betrachten und für verbindliche medizinische Diagnosen oder Therapieentscheidungen qualifiziertes ärztliches Fachpersonal zu konsultieren.
            </p>
          </div>
        </div>

        <div class="grid gap-6">
          {sources.map((src) => (
            <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3 shadow-xs hover:border-[var(--accent)]/40 transition-all">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <span class="px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-wider border border-[var(--accent)]/20">
                  {src.org}
                </span>
                <a 
                  href={src.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--accent)] hover:underline"
                  aria-label={`${src.actionLabel}: ${src.title}`}
                >
                  {src.actionLabel}
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
              <h2 class="text-xl font-display font-bold text-[var(--foreground)]">{src.title}</h2>
              <p class="text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{src.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </PageShell>
</Layout>
