const t = translations[lang] || translations.en;
const cookiePolicyUrl = `/${lang}/cookie-policy/`;
---

<!-- Cookie Consent Banner -->
<div 
  id="cookieConsentBanner" 
  class="fixed bottom-0 inset-x-0 z-[100] p-3 sm:p-5 transition-transform duration-300 translate-y-full opacity-0 pointer-events-none"
  role="region"
  aria-label={t.bannerTitle}
>
  <div class="max-w-4xl mx-auto rounded-2xl bg-[var(--card)]/95 backdrop-blur-2xl border border-[var(--border)] shadow-2xl p-4 sm:p-6 text-[var(--foreground)]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 flex-1 pr-2">
        <p class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)] flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          {t.bannerTitle}
        </p>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {t.bannerDesc} 
          <a href={cookiePolicyUrl} class="text-[var(--accent)] underline hover:text-[var(--foreground)] ml-1 font-semibold">{t.policyLinkText}</a>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button 
          id="btnRejectCookies" 
          type="button"
          class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--muted)] hover:bg-[var(--border)] text-[var(--foreground)] border border-[var(--border)] transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.rejectNonEssential}<span class="sr-only">. </span>
        </button>

        <button 
          id="btnCustomizeCookies" 
          type="button"
          class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-transparent hover:bg-[var(--muted)] text-[var(--foreground)] border border-[var(--border)] transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.customize}<span class="sr-only">. </span>
        </button>

        <button 
          id="btnAcceptAllCookies" 
          type="button"
          class="min-h-[44px] px-5 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-gradient-to-r from-[var(--accent)] to-[#d44f30] text-white shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.acceptAll}<span class="sr-only">. </span>
        </button>

        <!-- Quick 1-tap dismiss button to avoid intrusive blocking on mobile -->
        <button 
          id="btnDismissBanner" 
          type="button"
          class="min-h-[44px] min-w-[44px] p-2 text-[var(--muted-foreground)] hover:text-[var(--foreground)] rounded-lg transition-colors cursor-pointer flex items-center justify-center shrink-0"
          aria-label={t.dismissLabel}
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Customize Preferences Panel (Clean accessible panel without intrusive modal attributes) -->
<div 
  id="cookiePreferencesSheet" 
  class="fixed inset-0 z-[110] bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
  role="region"
  aria-labelledby="cookieSheetTitle"
>
  <div class="w-full max-w-lg rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-2xl p-5 sm:p-7 text-[var(--foreground)] space-y-6 my-8">
    <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
      <div>
        <h2 id="cookieSheetTitle" class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {t.modalTitle}
        </h2>
        <p class="text-xs text-[var(--muted-foreground)] mt-1">
          {t.modalDesc}
        </p>
      </div>
      <button 
        id="btnCloseCookieSheet" 
        type="button" 
        class="min-h-[48px] min-w-[48px] p-2 text-[var(--muted-foreground)] hover:text-[var(--foreground)] rounded-lg transition-colors cursor-pointer flex items-center justify-center"
        aria-label={t.closeLabel}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
      <!-- Essential Storage (Always active) -->
      <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted)]/50 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-sm font-display font-bold uppercase tracking-wide text-[var(--foreground)]">
            {t.essentialTitle}
          </span>
          <span class="px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-500 border border-emerald-500/30">
            {t.essentialStatus}
          </span>
        </div>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          {t.essentialDesc}
        </p>
      </div>

      <!-- Analytics Storage -->
      <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)] space-y-2">
        <div class="flex items-center justify-between">
          <label for="prefAnalytics" class="text-sm font-display font-bold uppercase tracking-wide text-[var(--foreground)] cursor-pointer">
            {t.analyticsTitle}
          </label>
          <input 
            type="checkbox" 
            id="prefAnalytics" 
            class="w-5 h-5 rounded border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)] cursor-pointer"
          />
        </div>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          {t.analyticsDesc}
        </p>
      </div>

      <!-- Marketing Storage -->
      <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)] space-y-2">
        <div class="flex items-center justify-between">
          <label for="prefMarketing" class="text-sm font-display font-bold uppercase tracking-wide text-[var(--foreground)] cursor-pointer">
            {t.marketingTitle}
          </label>
          <input 
            type="checkbox" 
            id="prefMarketing" 
            class="w-5 h-5 rounded border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)] cursor-pointer"
          />
        </div>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          {t.marketingDesc}
        </p>
      </div>
    </div>

    <div class="pt-4 border-t border-[var(--border)] space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <button 
          id="btnModalRejectOptional" 
          type="button" 
          class="min-h-[44px] px-3 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--muted)] hover:bg-[var(--border)] text-[var(--foreground)] border border-[var(--border)] transition-all cursor-pointer text-center focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.rejectOptional}
        </button>
        <button 
          id="btnSavePreferences" 
          type="button" 
          class="min-h-[44px] px-3 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--card)] hover:bg-[var(--muted)] text-[var(--foreground)] border border-[var(--border)] transition-all cursor-pointer text-center shadow-xs focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.savePreferences}
        </button>
        <button 
          id="btnModalAcceptAll" 
          type="button" 
          class="min-h-[44px] px-3 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)] text-white shadow-md hover:brightness-110 active:scale-95 transition-all cursor-pointer text-center focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.acceptAll}
        </button>
      </div>
      <div class="flex items-center justify-between text-xs">
        <a href={cookiePolicyUrl} class="text-[var(--accent)] underline hover:text-[var(--foreground)] font-semibold inline-flex items-center">
          {t.policyLinkText}
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var CONSENT_KEY = 'cookie_consent_preferences';
    var banner = document.getElementById('cookieConsentBanner');
    var sheet = document.getElementById('cookiePreferencesSheet');
    var btnAcceptAll = document.getElementById('btnAcceptAllCookies');
    var btnReject = document.getElementById('btnRejectCookies');
    var btnCustomize = document.getElementById('btnCustomizeCookies');
    var btnCloseSheet = document.getElementById('btnCloseCookieSheet');
    var btnDismissBanner = document.getElementById('btnDismissBanner');
    var btnSavePrefs = document.getElementById('btnSavePreferences');
    var btnModalReject = document.getElementById('btnModalRejectOptional');
    var btnModalAccept = document.getElementById('btnModalAcceptAll');
    var prefAnalytics = document.getElementById('prefAnalytics');
    var prefMarketing = document.getElementById('prefMarketing');

    function getStoredPreferences() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch (e) {
        return null;
      }
    }

    function applyGtagConsent(prefs) {
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          'analytics_storage': prefs.analytics ? 'granted' : 'denied',
          'ad_storage': prefs.marketing ? 'granted' : 'denied',
          'ad_user_data': prefs.marketing ? 'granted' : 'denied',
          'ad_personalization': prefs.marketing ? 'granted' : 'denied'
        });
        if (prefs.analytics) {
          window.gtag('js', new Date());
          window.gtag('config', 'G-9D3TJCYP4R');
          if (!document.querySelector('script[src*="googletagmanager.com/gtag/js"]')) {
            var gtmScript = document.createElement('script');
            gtmScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-9D3TJCYP4R';
            gtmScript.async = true;
            gtmScript.crossOrigin = 'anonymous';
            gtmScript.referrerPolicy = 'strict-origin-when-cross-origin';
            document.head.appendChild(gtmScript);
          }
        }
      }
    }

    function clearNonEssentialCookies(prefs) {
      try {
        var cookiesToClear = [];
        if (!prefs.analytics) {
          cookiesToClear.push('_ga', '_gid', '_gat');
        }
        if (!prefs.marketing) {
          cookiesToClear.push('__gads', '__gpi', '_gcl_au');
        }
        var host = window.location.hostname;
        var parts = host.split('.');
        var domains = ['', host, '.' + host];
        if (parts.length > 2) {
          domains.push('.' + parts.slice(-2).join('.'));
        }
        var path = '/';
        cookiesToClear.forEach(function(name) {
          domains.forEach(function(dom) {
            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=' + path + (dom ? '; domain=' + dom : '');
          });
        });
        if (!prefs.analytics) {
          document.cookie.split(';').forEach(function(c) {
            var trimmed = c.trim();
            if (trimmed.indexOf('_ga_') === 0) {
              var cookieName = trimmed.split('=')[0];
              domains.forEach(function(dom) {
                document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=' + path + (dom ? '; domain=' + dom : '');
              });
            }
          });
        }
      } catch (e) {}
    }

    function savePreferences(analytics, marketing) {
      var prefs = {
        necessary: true,
        analytics: Boolean(analytics),
        marketing: Boolean(marketing),
        timestamp: new Date().toISOString()
      };
      try {
        localStorage.setItem(CONSENT_KEY, JSON.stringify(prefs));
      } catch (e) {}

      applyGtagConsent(prefs);
      clearNonEssentialCookies(prefs);
      hideBanner();
      hideSheet();
    }

    function showBanner() {
      if (!banner) return;
      banner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
    }

    function showSheet() {
      if (!sheet) return;
      var existing = getStoredPreferences() || { analytics: false, marketing: false };
      if (prefAnalytics) prefAnalytics.checked = Boolean(existing.analytics);
      if (prefMarketing) prefMarketing.checked = Boolean(existing.marketing);
      sheet.classList.remove('hidden');
      sheet.classList.add('flex');
    }

    function hideSheet() {
      if (!sheet) return;
      sheet.classList.remove('flex');
      sheet.classList.add('hidden');
    }

    // Initialize state with non-intrusive delay to protect mobile viewport and crawler first paint
    var currentPrefs = getStoredPreferences();
    if (!currentPrefs) {
      setTimeout(function() {
        if (!document.querySelector('.googlefc-consent-root') && !document.querySelector('.fc-dialog')) {
          showBanner();
        }
      }, 1500);

      if (typeof window.MutationObserver !== 'undefined') {
        var fcObserver = new MutationObserver(function() {
          if (document.querySelector('.googlefc-consent-root') || document.querySelector('.fc-dialog')) {
            hideBanner();
            fcObserver.disconnect();
          }
        });
        fcObserver.observe(document.body || document.documentElement, { childList: true, subtree: true });
      }
    } else {
      applyGtagConsent(currentPrefs);
    }

    if (btnAcceptAll) {
      btnAcceptAll.addEventListener('click', function() {
        savePreferences(true, true);
      });
    }

    if (btnReject) {
      btnReject.addEventListener('click', function() {
        savePreferences(false, false);
      });
    }

    if (btnCustomize) {
      btnCustomize.addEventListener('click', function() {
        showSheet();
      });
    }

    if (btnDismissBanner) {
      btnDismissBanner.addEventListener('click', function() {
        savePreferences(false, false);
      });
    }

    if (btnCloseSheet) {
      btnCloseSheet.addEventListener('click', function() {
        hideSheet();
      });
    }

    if (btnSavePrefs) {
      btnSavePrefs.addEventListener('click', function() {
        savePreferences(
          prefAnalytics ? prefAnalytics.checked : false,
          prefMarketing ? prefMarketing.checked : false
        );
      });
    }

    if (btnModalReject) {
      btnModalReject.addEventListener('click', function() {
        if (prefAnalytics) prefAnalytics.checked = false;
        if (prefMarketing) prefMarketing.checked = false;
        savePreferences(false, false);
      });
    }

    if (btnModalAccept) {
      btnModalAccept.addEventListener('click', function() {
        if (prefAnalytics) prefAnalytics.checked = true;
        if (prefMarketing) prefMarketing.checked = true;
        savePreferences(true, true);
      });
    }

    // Background click to close sheet
    if (sheet) {
      sheet.addEventListener('click', function(e) {
        if (e.target === sheet) hideSheet();
      });
    }

    // ESC key to close sheet
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && sheet && !sheet.classList.contains('hidden')) {
        hideSheet();
      }
    });

    // Global listener for "open-cookie-preferences" (Compliant with Google Funding Choices Revocation)
    window.openCookiePreferences = function() {
      if (window.googlefc && typeof window.googlefc.showRevocationMessage === 'function') {
        window.googlefc.showRevocationMessage();
      } else {
        showSheet();
      }
    };

    var footerTrigger = document.getElementById('openCookiePreferencesBtn');
    if (footerTrigger) {
      footerTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        window.openCookiePreferences();
      });
    }
  })();
</script>
