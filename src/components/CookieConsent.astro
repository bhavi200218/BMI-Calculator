const t = translations[lang] || translations.en;
const cookiePolicyUrl = `/${lang}/cookie-policy/`;
---

<!-- Cookie Consent Banner -->
<div 
  id="cookieConsentBanner" 
  class="fixed bottom-0 inset-x-0 z-[100] p-3 sm:p-5 transition-transform duration-300 translate-y-full opacity-0 pointer-events-none"
  role="region"
  aria-label={t.bannerTitle}
>
  <div class="max-w-4xl mx-auto rounded-2xl bg-[var(--card)]/95 backdrop-blur-2xl border border-[var(--border)] shadow-2xl p-4 sm:p-6 text-[var(--foreground)]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 flex-1 pr-2">
        <h3 class="text-sm sm:text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)] flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          {t.bannerTitle}
        </h3>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {t.bannerDesc} 
          <a href={cookiePolicyUrl} class="text-[var(--accent)] underline hover:text-[var(--foreground)] ml-1 font-semibold">{t.policyLinkText}</a>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button 
          id="btnRejectCookies" 
          type="button"
          class="min-h-[48px] px-4 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--muted)] hover:bg-[var(--border)] text-[var(--foreground)] border border-[var(--border)] transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.rejectNonEssential}
        </button>

        <button 
          id="btnCustomizeCookies" 
          type="button"
          class="min-h-[48px] px-4 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-transparent hover:bg-[var(--muted)] text-[var(--foreground)] border border-[var(--border)] transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.customize}
        </button>

        <button 
          id="btnAcceptAllCookies" 
          type="button"
          class="min-h-[48px] px-5 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-gradient-to-r from-[var(--accent)] to-[#d44f30] text-white shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
        >
          {t.acceptAll}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Customize Preferences Modal -->
<div 
  id="cookiePreferencesModal" 
  class="fixed inset-0 z-[110] bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookieModalTitle"
>
  <div class="w-full max-w-lg rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-2xl p-5 sm:p-7 text-[var(--foreground)] space-y-6 my-8">
    <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
      <div>
        <h3 id="cookieModalTitle" class="text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {t.modalTitle}
        </h3>
        <p class="text-xs text-[var(--muted-foreground)] mt-1">
          {t.modalDesc}
        </p>
      </div>
      <button 
        id="btnCloseCookieModal" 
        type="button" 
        class="min-h-[48px] min-w-[48px] p-2 text-[var(--muted-foreground)] hover:text-[var(--foreground)] rounded-lg transition-colors cursor-pointer flex items-center justify-center"
        aria-label={t.closeLabel}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
      <!-- Essential Storage (Always active) -->
      <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted)]/50 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-sm font-display font-bold uppercase tracking-wide text-[var(--foreground)]">
            {t.essentialTitle}
          </span>
          <span class="px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-500 border border-emerald-500/30">
            {t.essentialStatus}
          </span>
        </div>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          {t.essentialDesc}
        </p>
      </div>

      <!-- Analytics Storage -->
      <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)] space-y-2">
        <div class="flex items-center justify-between">
          <label for="prefAnalytics" class="text-sm font-display font-bold uppercase tracking-wide text-[var(--foreground)] cursor-pointer">
            {t.analyticsTitle}
          </label>
          <input 
            type="checkbox" 
            id="prefAnalytics" 
            class="w-5 h-5 rounded border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)] cursor-pointer"
          />
        </div>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          {t.analyticsDesc}
        </p>
      </div>

      <!-- Marketing Storage -->
      <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--card)] space-y-2">
        <div class="flex items-center justify-between">
          <label for="prefMarketing" class="text-sm font-display font-bold uppercase tracking-wide text-[var(--foreground)] cursor-pointer">
            {t.marketingTitle}
          </label>
          <input 
            type="checkbox" 
            id="prefMarketing" 
            class="w-5 h-5 rounded border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)] cursor-pointer"
          />
        </div>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          {t.marketingDesc}
        </p>
      </div>
    </div>

    <div class="pt-2 border-t border-[var(--border)] flex flex-wrap items-center justify-between gap-3">
      <a href={cookiePolicyUrl} class="text-xs text-[var(--accent)] underline hover:text-[var(--foreground)] font-semibold min-h-[48px] inline-flex items-center">
        {t.policyLinkText}
      </a>
      <div class="flex items-center gap-2">
        <button 
          id="btnSavePreferences" 
          type="button" 
          class="min-h-[48px] px-5 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)] text-white shadow-md hover:brightness-110 active:scale-95 transition-all cursor-pointer"
        >
          {t.savePreferences}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var CONSENT_KEY = 'cookie_consent_preferences';
    var banner = document.getElementById('cookieConsentBanner');
    var modal = document.getElementById('cookiePreferencesModal');
    var btnAcceptAll = document.getElementById('btnAcceptAllCookies');
    var btnReject = document.getElementById('btnRejectCookies');
    var btnCustomize = document.getElementById('btnCustomizeCookies');
    var btnCloseModal = document.getElementById('btnCloseCookieModal');
    var btnSavePrefs = document.getElementById('btnSavePreferences');
    var prefAnalytics = document.getElementById('prefAnalytics');
    var prefMarketing = document.getElementById('prefMarketing');

    function getStoredPreferences() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch (e) {
        return null;
      }
    }

    function applyGtagConsent(prefs) {
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          'analytics_storage': prefs.analytics ? 'granted' : 'denied',
          'ad_storage': prefs.marketing ? 'granted' : 'denied',
          'ad_user_data': prefs.marketing ? 'granted' : 'denied',
          'ad_personalization': prefs.marketing ? 'granted' : 'denied'
        });
      }
    }

    function savePreferences(analytics, marketing) {
      var prefs = {
        necessary: true,
        analytics: Boolean(analytics),
        marketing: Boolean(marketing),
        timestamp: new Date().toISOString()
      };
      try {
        localStorage.setItem(CONSENT_KEY, JSON.stringify(prefs));
      } catch (e) {}

      applyGtagConsent(prefs);
      hideBanner();
      hideModal();
    }

    function showBanner() {
      if (!banner) return;
      banner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
    }

    function showModal() {
      if (!modal) return;
      var existing = getStoredPreferences() || { analytics: false, marketing: false };
      if (prefAnalytics) prefAnalytics.checked = Boolean(existing.analytics);
      if (prefMarketing) prefMarketing.checked = Boolean(existing.marketing);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function hideModal() {
      if (!modal) return;
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }

    // Initialize state
    var currentPrefs = getStoredPreferences();
    if (!currentPrefs) {
      // Show consent banner after a short delay for smooth rendering, unless Google Funding Choices CMP is active
      setTimeout(function() {
        if (!document.querySelector('.googlefc-consent-root') && !document.querySelector('.fc-dialog')) {
          showBanner();
        }
      }, 700);
    } else {
      applyGtagConsent(currentPrefs);
    }

    if (btnAcceptAll) {
      btnAcceptAll.addEventListener('click', function() {
        savePreferences(true, true);
      });
    }

    if (btnReject) {
      btnReject.addEventListener('click', function() {
        savePreferences(false, false);
      });
    }

    if (btnCustomize) {
      btnCustomize.addEventListener('click', function() {
        showModal();
      });
    }

    if (btnCloseModal) {
      btnCloseModal.addEventListener('click', function() {
        hideModal();
      });
    }

    if (btnSavePrefs) {
      btnSavePrefs.addEventListener('click', function() {
        savePreferences(
          prefAnalytics ? prefAnalytics.checked : false,
          prefMarketing ? prefMarketing.checked : false
        );
      });
    }

    // Modal background click to close
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) hideModal();
      });
    }

    // ESC key to close modal
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        hideModal();
      }
    });

    // Global listener for "open-cookie-preferences" (Compliant with Google Funding Choices Revocation)
    window.openCookiePreferences = function() {
      if (window.googlefc && typeof window.googlefc.showRevocationMessage === 'function') {
        window.googlefc.showRevocationMessage();
      } else {
        showModal();
      }
    };

    var footerTrigger = document.getElementById('openCookiePreferencesBtn');
    if (footerTrigger) {
      footerTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        window.openCookiePreferences();
      });
    }
  })();
</script>
