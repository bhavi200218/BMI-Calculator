      { category: 'Übergewicht', range: '25.0 – 29.9', risk: 'Moderater Referenzschwellenwert', status: 'overweight' },
      { category: 'Adipositas Klasse I', range: '30.0 – 34.9', risk: 'Erhöhter Referenzschwellenwert', status: 'obesity-1' },
      { category: 'Adipositas Klasse II', range: '35.0 – 39.9', risk: 'Erhöhte Referenzkategorie', status: 'obesity-2' },
