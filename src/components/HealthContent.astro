            { age: '35 – 44 Years', men: '21.0 – 26.0 kg/m²', women: '20.5 – 25.5 kg/m²', note: 'Metabolic Maintenance Window' },
            { age: '45 – 54 Years', men: '22.0 – 27.0 kg/m²', women: '21.5 – 26.5 kg/m²', note: 'Midlife Balance & Visceral Fat Watch' },
            { age: '55 – 64 Years', men: '23.0 – 28.0 kg/m²', women: '22.5 – 27.5 kg/m²', note: 'Healthy Active Ageing Target' },
            { age: '65+ Years',     men: '24.0 – 29.0 kg/m²', women: '23.5 – 28.5 kg/m²', note: 'Geriatric Protective Muscle Reserve' }
