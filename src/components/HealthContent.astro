    faq: [
      { q: 'मानक बीएमआई और Real BMI में क्या अंतर है?', a: 'मानक बीएमआई केवल ऊंचाई और वजन का उपयोग करता है। Real BMI बीएमआई को डब्ल्यूएचओ/सीडीसी दिशानिर्देशों, बीएमआर (BMR) और टीडीईई (TDEE) के साथ एकीकृत करके पूर्ण स्वास्थ्य विश्लेषण प्रदान करता है।' },
      { q: 'बीएमआई (BMI) की गणना कैसे की जाती है?', a: 'बीएमआई = वजन (किलोग्राम) ÷ ऊंचाई² (मीटर)। इंपीरियल इकाइयों में: (वजन पाउंड ÷ ऊंचाई इंच²) × 703। हमारा कैलकुलेटर दोनों प्रणालियों में तुरंत गणना करता है।' },
      { q: 'पुरुषों और महिलाओं के लिए स्वस्थ बीएमआई क्या है?', a: 'अधिकांश वयस्कों के लिए स्वस्थ बीएमआई सीमा 18.5 से 24.9 है। हालांकि, दक्षिण एशियाई आबादी के लिए डब्ल्यूएचओ 22.9 तक स्वस्थ सीमा मानता है।' },
      { q: 'क्या मांसपेशियों वाले एथलीटों के लिए बीएमआई सटीक है?', a: 'बीएमआई एक प्राथमिक जांच उपकरण है, निदान नहीं। यह मांसपेशियों वाले एथलीटों में शरीर की वसा का अधिक अनुमान लगा सकता है, इसलिए इसे कमर की परिधि के साथ देखना चाहिए।' },
      { q: 'दक्षिण एशियाई लोगों के लिए बीएमआई सीमाएं कम क्यों हैं?', a: 'अनुसंधान से पता चलता है कि एशियाई आबादी में कम वजन पर भी पेट की आंतरिक (विसरल) वसा जमा होने का खतरा अधिक होता है, इसलिए 23.0 kg/m² से अधिक वजन माना जाता है।' },
      { q: '25 बीएमआई का क्या अर्थ है?', a: '25 का बीएमआई सामान्य सीमा और अधिक वजन श्रेणी के बीच की सीमा पर है। यह कमर के आकार और व्यायाम की आदतों की समीक्षा करने का संकेत है।' },
      { q: 'बीएमआर (BMR) क्या है और यह क्यों महत्वपूर्ण है?', a: 'बीएमआर वह न्यूनतम ऊर्जा है जिसका उपयोग आपका शरीर विश्राम की स्थिति में सांस लेने और अंग संचालन के लिए करता है।' },
      { q: 'टीडीईई (TDEE) क्या है और यह क्यों महत्वपूर्ण है?', a: 'टीडीईई अनुमान लगाता है कि आप शारीरिक गतिविधि और व्यायाम सहित एक दिन में कितनी कैलोरी बर्न करते हैं।' }
    ]
