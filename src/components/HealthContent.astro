        "risk": "कम वजन संदर्भ सीमा",
        "status": "underweight"
      },
      {
        "category": "सामान्य वजन",
        "range": "18.5 – 24.9",
        "risk": "सामान्य वजन संदर्भ सीमा",
        "status": "normal"
      },
      {
        "category": "अधिक वजन",
        "range": "25.0 – 29.9",
        "risk": "अधिक वजन संदर्भ सीमा",
        "status": "overweight"
      },
      {
        "category": "मोटापा श्रेणी I",
        "range": "30.0 – 34.9",
        "risk": "मोटापा श्रेणी I संदर्भ सीमा",
        "status": "obesity-1"
      },
      {
        "category": "मोटापा श्रेणी II",
        "range": "35.0 – 39.9",
        "risk": "मोटापा श्रेणी II संदर्भ सीमा",
        "status": "obesity-2"
      },
      {
        "category": "मोटापा श्रेणी III",
        "range": "≥ 40.0",
        "risk": "मोटापा श्रेणी III संदर्भ सीमा",
        "status": "obesity-3"
      }
    ],
    "faq": [
      {
        "q": "मानक बीएमआई और Real BMI में क्या अंतर है?",
        "a": "मानक बीएमआई केवल ऊंचाई और वजन का उपयोग करता है। Real BMI बीएमआई को डब्ल्यूएचओ/सीडीसी दिशानिर्देशों, बीएमआर (BMR) और टीडीईई (TDEE) के साथ मिलाकर अतिरिक्त संदर्भात्मक स्वास्थ्य जानकारी प्रदान करता है। यह अलग चिकित्सा माप या आधिकारिक डब्ल्यूएचओ वर्गीकरण नहीं है।"
      },
      {
        "q": "बीएमआई (BMI) की गणना कैसे की जाती है?",
        "a": "बीएमआई = वजन (किलोग्राम) ÷ ऊंचाई² (मीटर)। इंपीरियल इकाइयों में: (वजन पाउंड ÷ ऊंचाई इंच²) × 703। हमारा कैलकुलेटर दोनों प्रणालियों में तुरंत गणना करता है।"
      },
      {
        "q": "बीएमआई जनसंख्या स्वास्थ्य अध्ययनों से कैसे संबंधित है?",
        "a": "सार्वजनिक स्वास्थ्य साहित्य में बीएमआई स्तर (25.0 kg/m² और अधिक) का उपयोग जनसंख्या स्वास्थ्य अध्ययनों के लिए आधारभूत स्क्रीनिंग संदर्भ के रूप में किया जाता है।"
      },
      {
        "q": "बीएमआई के साथ कमर की परिधि (Waist Size) क्यों महत्वपूर्ण है?",
        "a": "कमर की परिधि का माप बीएमआई के साथ शरीर में वसा के वितरण के बारे में अतिरिक्त संदर्भात्मक जानकारी प्रदान करता है।"
      },
      {
        "q": "पुरुषों और महिलाओं के लिए स्वस्थ बीएमआई क्या है?",
        "a": "अधिकांश वयस्कों के लिए स्वस्थ बीएमआई सीमा 18.5 से 24.9 है। एशियाई आबादी के लिए, डब्ल्यूएचओ विशेषज्ञ परामर्श दिशानिर्देश 18.5 से 22.9 को स्वस्थ संदर्भ सीमा के रूप में पहचानते हैं, जबकि 23.0 kg/m² बढ़े हुए जोखिम से जुड़ा अतिरिक्त सार्वजनिक-स्वास्थ्य एक्शन पॉइंट है।"
      },
      {
        "q": "क्या मांसपेशियों वाले एथलीटों के लिए बीएमआई उपयुक्त है?",
        "a": "बीएमआई एक प्राथमिक जांच उपकरण है, निदान नहीं। यह मांसपेशियों वाले एथलीटों में शरीर की वसा का अधिक अनुमान लगा सकता है, इसलिए इसे कमर की परिधि के साथ देखना चाहिए।"
      },
      {
        "q": "डब्ल्यूएचओ विशेषज्ञ परामर्श एशियाई आबादी के लिए कम बीएमआई एक्शन पॉइंट की पहचान क्यों करते हैं?",
        "a": "एशियाई आबादी के लिए, डब्ल्यूएचओ विशेषज्ञ परामर्श मार्गदर्शन बीएमआई 23.0 kg/m² को बढ़े हुए जोखिम से जुड़े एक अतिरिक्त सार्वजनिक-स्वास्थ्य एक्शन पॉइंट के रूप में पहचानता है, क्योंकि शोध अध्ययनों में यूरोपीय संदर्भ समूहों की तुलना में कम बीएमआई स्तरों पर भी अधिक शारीरिक वसा प्रतिशत और हृदय संबंधी जोखिम कारक देखे गए हैं।"
      },
      {
        "q": "25 बीएमआई का क्या अर्थ है?",
        "a": "25 का बीएमआई सामान्य सीमा और अधिक वजन श्रेणी के बीच की सीमा पर है। यह कमर के आकार और व्यायाम की आदतों की समीक्षा करने का संकेत है।"
      },
      {
        "q": "बीएमआर (BMR) क्या है और यह क्यों महत्वपूर्ण है?",
        "a": "बीएमआर (BMR) एक प्रेडिक्टिव समीकरण के आधार पर अनुमानित विश्राम ऊर्जा व्यय प्रदान करता है, जो आपकी कैलोरी आवश्यकताओं का आधार तय करता है।"
      },
      {
        "q": "टीडीईई (TDEE) क्या है और यह क्यों महत्वपूर्ण है?",
        "a": "टीडीईई (Total Daily Energy Expenditure) अनुमान लगाता है कि आप शारीरिक गतिविधि और व्यायाम सहित एक दिन में कितनी कुल कैलोरी बर्न करते हैं।"
      }
    ]
  }
};

const t = content[lang] || content.en;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faq.map((item: { q: string; a: string }) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="insights" class="px-4 md:px-6 max-w-7xl mx-auto space-y-16 md:space-y-24 py-12 md:py-20 scroll-mt-28">

  <!-- ═══════════════════  HEALTH INSIGHTS HEADER & CARDS  ═══════════════════ -->
  <div class="space-y-10">
    <div class="space-y-3 max-w-3xl">
      <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{t.insightSub}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-[1.05]">
        {t.insightsMainTitle}
      </h2>
      <p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
        {t.insightsMainDesc}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 md:gap-10">
      {t.sections.map((section: any, idx: number) => (
        <article class="p-8 md:p-10 rounded-[var(--radius)] border-[1.5px] border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)] hover:shadow-[var(--shadow-card)] transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
          
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)] px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20">
                {t.insightSub} 0{idx + 1}
              </span>
            </div>
            
            <h3 class="text-xl md:text-2xl font-display font-bold uppercase leading-tight text-[var(--foreground)]">
              {section.title}
            </h3>

            <div class="space-y-3 text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium pt-1">
              {section.paragraphs ? (
                section.paragraphs.map((p: string) => (
                  <p>{p}</p>
                ))
              ) : (
                <p>{section.text}</p>
              )}
            </div>

            {section.bullets && (
              <ul class="space-y-2 pt-3 border-t border-[var(--border)]/60">
                {section.bullets.map((bullet: string) => (
                  <li class="flex items-start gap-2 text-xs md:text-sm text-[var(--muted-foreground)] leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0 mt-1.5"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          {section.toolLink && (
            <div class="pt-6 border-t border-[var(--border)]/60 mt-6 flex items-center justify-between">
              <a 
                href={section.toolLink.href} 
                class="inline-flex items-center gap-1.5 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] hover:underline"
              >
                <span>{section.toolLink.name}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <div class="h-1 w-12 bg-[var(--accent)] rounded-full group-hover:w-20 transition-all duration-300"></div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>

  <!-- ═══════════════════  WHO TABLE & SOURCES  ═══════════════════ -->
  {t.whoTable && (
    <div class="space-y-8 pt-8 border-t border-[var(--border)]">
      <div class="space-y-3">
        <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{t.whoSub}</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {t.whoTableTitle}
        </h2>
        <p class="text-base text-[var(--muted-foreground)] max-w-2xl font-medium">
          {t.whoDesc}
        </p>
      </div>

      <!-- Responsive Table Version -->
      <div class="rounded-2xl border-[1.5px] border-[var(--border)] bg-[var(--card)] shadow-[var(--shadow-soft)] overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left min-w-[500px] border-collapse">
            <thead>
              <tr class="bg-[var(--muted)]">
                <th class="px-6 py-5 text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">{t.colCategory}</th>
                <th class="px-6 py-5 text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">{t.colRange}</th>
                <th class="px-6 py-5 text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">{t.colRisk}</th>
              </tr>
            </thead>
            <tbody>
              {t.whoTable.map((row: any, i: number) => (
                <tr class={`transition-colors hover:bg-[var(--muted)]/50 ${i % 2 === 1 ? 'bg-[var(--muted)]/20' : ''}`}>
                  <td class="px-6 py-5 font-display font-bold text-[var(--foreground)] uppercase text-sm">{row.category}</td>
                  <td class="px-6 py-5 font-sans text-[var(--foreground)] text-sm font-semibold">{row.range}</td>
                  <td class="px-6 py-5">
                    <span class={`text-xs font-display font-extrabold uppercase tracking-widest px-4 py-1.5 rounded-full border ${
                      row.status === 'normal'      ? 'border-emerald-500/40 dark:border-emerald-500/50 text-emerald-950 dark:text-emerald-200 bg-emerald-100/90 dark:bg-emerald-950/60' :
                      row.status === 'underweight' ? 'border-sky-500/40 dark:border-sky-500/50 text-sky-950 dark:text-sky-200 bg-sky-100/90 dark:bg-sky-950/60' :
                      row.status === 'overweight'  ? 'border-amber-500/40 dark:border-amber-500/50 text-amber-950 dark:text-amber-200 bg-amber-100/90 dark:bg-amber-950/60' :
                                                     'border-rose-500/40 dark:border-rose-500/50 text-rose-950 dark:text-rose-200 bg-rose-100/90 dark:bg-rose-950/60'
                    }`}>{row.risk}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-xs text-[var(--muted-foreground)] font-medium pt-3 italic">
        {t.disclaimer}
      </p>

      <!-- Dedicated In-Depth Reference Banner -->
      <div class="rounded-xl border border-[var(--accent)]/30 bg-[var(--accent)]/5 p-5 md:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <p class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">{t.inDepthTitle}</p>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium">{t.inDepthSubtitle}</p>
        </div>
        <a href={`/${lang}/bmi-chart/`} class="inline-flex items-center gap-1.5 rounded-xl bg-slate-900 dark:bg-white px-4 py-2 text-xs font-display font-bold uppercase tracking-wider text-white dark:text-slate-900 hover:opacity-90 transition-opacity shrink-0 shadow-xs">
          <span>{t.inDepthLink}</span>
        </a>
      </div>

      <!-- Sources & References Box -->
      <div class="rounded-xl border border-[var(--border)] bg-[var(--card)]/80 p-5 md:p-6 shadow-[var(--shadow-soft)] flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <p class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)]">{t.sourcesTitle}</p>
          <p class="text-xs text-[var(--muted-foreground)] mt-1 font-medium">{t.sourcesSubtitle}</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <a href="https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] px-4 py-2.5 min-h-[48px] text-xs font-semibold text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors bg-[var(--muted)]/30">
            <span>{t.whoLink}</span>
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <a href="https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] px-4 py-2.5 min-h-[48px] text-xs font-semibold text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors bg-[var(--muted)]/30">
            <span>{t.cdcLink}</span>
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- ═══════════════════  FAQ ACCORDION  ═══════════════════ -->
  <div id="faq" class="space-y-12 pt-8 border-t border-[var(--border)] scroll-mt-28">
    <div class="space-y-3 text-center">
      <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{t.helpCenter}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase text-[var(--foreground)]">{t.faqTitle}</h2>
      <p class="text-base text-[var(--muted-foreground)] max-w-xl mx-auto font-medium">
        {t.faqSubtitle}
      </p>
    </div>

    <div class="space-y-4 max-w-7xl mx-auto">
      {t.faq.map((item: { q: string; a: string }) => (
        <details class="group rounded-xl border-[1.5px] border-[var(--border)] bg-[var(--card)] overflow-hidden cursor-pointer hover:border-[var(--accent)] transition-all duration-200 shadow-[var(--shadow-soft)]">
          <summary class="flex justify-between items-center font-display font-semibold text-base py-5 px-6 select-none list-none uppercase tracking-tight text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">
            <span class="pr-8">{item.q}</span>
            <span class="text-[var(--muted-foreground)] group-open:rotate-180 transition-transform duration-200 flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium pt-4 bg-[var(--muted)]/10">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
