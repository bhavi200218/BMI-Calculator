    helpCenter: 'Hilfe-Center',
    faqTitle: 'Häufig Gestellte Fragen',
    faqSubtitle: 'Alles, was Sie über BMI-Berechnungen, Stoffwechselraten und sportliche Messungen wissen müssen.',
    sections: [
      { title: 'Ihren Body-Mass-Index Verstehen', text: 'Der Body-Mass-Index (BMI) ist ein international anerkannter Screening-Standard zur Beurteilung Ihres Gewichts.' },
