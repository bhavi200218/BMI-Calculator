                  <th class="px-6 py-4">Men Ideal BMI</th>
                  <th class="px-6 py-4">Women Ideal BMI</th>
                  <th class="px-6 py-4">Clinical Guidance</th>
                </tr>
              </thead>
              <tbody class="text-sm font-medium divide-y divide-[var(--border)]/40">
                <tr class="hover:bg-[var(--muted)]/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-[var(--foreground)] font-display uppercase">18 – 24 Years</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">19.0 – 24.0 kg/m²</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">18.5 – 23.5 kg/m²</td>
                  <td class="px-6 py-4 text-xs text-[var(--muted-foreground)]">Peak Lean Mass & Metabolism</td>
                </tr>
                <tr class="hover:bg-[var(--muted)]/40 transition-colors bg-[var(--muted)]/10">
                  <td class="px-6 py-4 font-bold text-[var(--foreground)] font-display uppercase">25 – 34 Years</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">20.0 – 25.0 kg/m²</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">19.5 – 24.5 kg/m²</td>
                  <td class="px-6 py-4 text-xs text-[var(--muted-foreground)]">Adult Baseline Standard Range</td>
                </tr>
                <tr class="hover:bg-[var(--muted)]/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-[var(--foreground)] font-display uppercase">35 – 44 Years</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">21.0 – 26.0 kg/m²</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">20.5 – 25.5 kg/m²</td>
                  <td class="px-6 py-4 text-xs text-[var(--muted-foreground)]">Metabolic Maintenance Window</td>
                </tr>
                <tr class="hover:bg-[var(--muted)]/40 transition-colors bg-[var(--muted)]/10">
                  <td class="px-6 py-4 font-bold text-[var(--foreground)] font-display uppercase">45 – 54 Years</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">22.0 – 27.0 kg/m²</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">21.5 – 26.5 kg/m²</td>
                  <td class="px-6 py-4 text-xs text-[var(--muted-foreground)]">Midlife Balance & Visceral Fat Watch</td>
                </tr>
                <tr class="hover:bg-[var(--muted)]/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-[var(--foreground)] font-display uppercase">55 – 64 Years</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">23.0 – 28.0 kg/m²</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">22.5 – 27.5 kg/m²</td>
                  <td class="px-6 py-4 text-xs text-[var(--muted-foreground)]">Healthy Active Ageing Target</td>
                </tr>
                <tr class="hover:bg-[var(--muted)]/40 transition-colors bg-[var(--muted)]/10">
