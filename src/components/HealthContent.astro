      { q: 'Qu\'est-ce que le BMR ?', a: 'Le BMR fournit une estimation de la dépense énergétique au repos basée sur une équation prédictive.' },
      { q: 'Qu\'est-ce que le TDEE ?', a: 'Le TDEE estime votre dépense énergétique quotidienne totale avec l\'activité physique.' }
    ]
  },
  de: {
