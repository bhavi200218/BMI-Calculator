    whoSub: 'WHO-Standards',
    whoTableTitle: 'WHO BMI-Klassifizierungsstandards',
    whoDesc: 'Die Weltgesundheitsorganisation (WHO) unterteilt BMI-Werte in Zielbereiche zur Beurteilung von Gesundheitsindikatoren.',
    colCategory: 'Klassifizierungskategorie',
    colRange: 'BMI-Bereich',
    colRisk: 'Referenzstatus-Indikator',
    sourcesTitle: 'Quellen & Referenzen',
    sourcesSubtitle: 'Standards basierend auf WHO- und CDC-Richtlinien.',
    whoLink: 'WHO Adipositas-Leitfaden',
    cdcLink: 'CDC BMI-Leitfaden',
    helpCenter: 'Hilfe-Center',
    faqTitle: 'Häufig Gestellte Fragen',
