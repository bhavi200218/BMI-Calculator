      { q: '25 बीएमआई का क्या अर्थ है?', a: '25 का बीएमआई सामान्य सीमा और अधिक वजन श्रेणी के बीच की सीमा पर है। यह कमर के आकार और व्यायाम की आदतों की समीक्षा करने का संकेत है।' },
      { q: 'बीएमआर (BMR) क्या है और यह क्यों महत्वपूर्ण है?', a: 'बीएमआर (BMR) एक प्रेडिक्टिव समीकरण के आधार पर अनुमानित विश्राम ऊर्जा व्यय प्रदान करता है।' },
      { q: 'टीडीईई (TDEE) क्या है और यह क्यों महत्वपूर्ण है?', a: 'टीडीईई अनुमान लगाता है कि आप शारीरिक गतिविधि और व्यायाम सहित एक दिन में कितनी कैलोरी बर्न करते हैं।' }
    ]
