    sections: [
      { title: 'बॉडी मास इंडेक्स (BMI) को गहराई से समझें', text: 'बॉडी मास इंडेक्स (बीएमआई) दुनिया भर के स्वास्थ्य विशेषज्ञों द्वारा उपयोग किया जाने वाला एक अंतरराष्ट्रीय स्तर पर मान्यता प्राप्त जांच मानक है। यह आपकी ऊंचाई के अनुपात में आपके वजन की श्रेणी को वर्गीकृत करता है, जिससे हृदय और चयापचय संबंधी जोखिमों का त्वरित संदर्भ मिलता है। Real BMI कैलकुलेटर विश्व स्वास्थ्य संगठन (WHO) और CDC के आधिकारिक मानकों के आधार पर सटीक विश्लेषण प्रदान करता है।' },
      { title: 'बीएमआई, बीएमआर और टीडीईई का परस्पर संबंध', text: 'आपका बीएमआई (BMI) यह दर्शाता है कि आपका वजन संतुलित सीमा में है या नहीं। आपका बीएमआर (BMR) विश्राम अवस्था में आपके अंगों द्वारा आवश्यक बेसल ऊर्जा को उजागर करता है। अंत में, आपका टीडीईई (TDEE) दैनिक गतिविधियों को जोड़कर वजन बनाए रखने के लिए आवश्यक सटीक कैलोरी बताता है।' },
      { title: 'हृदय स्वास्थ्य एवं स्ट्रोक की रोकथाम', text: 'डब्ल्यूएचओ और नेशनल हार्ट फाउंडेशन के अनुसार बीएमआई (BMI) हृदय रोग और स्ट्रोक के जोखिम का एक प्रमुख शुरुआती संकेतक है। इसे हमेशा कमर के आकार, रक्तचाप और कोलेस्ट्रॉल के साथ मापा जाना चाहिए।' },
      { title: 'टाइप 2 डायबिटीज एवं विसरल वसा स्क्रीनिंग (डायबिटीज कनाडा मानक)', text: 'डायबिटीज कनाडा और डब्ल्यूएचओ (WHO) के दिशानिर्देशों के अनुसार, बढ़ा हुआ बीएमआई (≥25.0 kg/m² या एशियाई आबादी के लिए ≥23.0 kg/m²) और पेट की वसा सीधे टाइप 2 डायबिटीज और इंसुलिन प्रतिरोध के जोखिम को बढ़ाती है।' }
