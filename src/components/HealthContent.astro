---
import { type Locale } from '../utils/calculators';

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const { currentLocale } = Astro;
const lang = (propLang || currentLocale || 'en') as Locale;

const reviewBadge: Record<string, string> = {
  en: 'Reviewed against published health standards • Updated 2026',
  es: 'Revisado según estándares de salud publicados • Actualizado en 2026',
  fr: 'Vérifié selon les normes de santé publiées • Mis à jour en 2026',
  de: 'Nach veröffentlichten Gesundheitsstandards geprüft • Aktualisiert 2026',
  ko: '공표된 건강 지표에 따라 검토됨 • 2026년 업데이트',
  hi: 'प्रकाशित स्वास्थ्य मानकों के अनुसार समीक्षित • 2026 को अपडेट'
};

const content: Record<string, any> = {
  en: {
    insightSub: 'Health Insights',
    whoSub: 'WHO Standards',
    whoTableTitle: 'WHO BMI Classification Standards',
    disclaimer: "BMI is a screening measure and does not independently diagnose disease or determine an individual's overall health risk.",
    whoDesc: 'The World Health Organization (WHO) breaks BMI scores down into categorized reference ranges to mark health and nutritional indicators.',
    colCategory: 'Classification Category',
    colRange: 'BMI Range Box',
    colRisk: 'Reference Category',
    sourcesTitle: 'Sources & References',
    sourcesSubtitle: 'Standards based on official WHO & CDC global guidelines.',
    whoLink: 'WHO Obesity Guidance',
    cdcLink: 'CDC BMI Guide',
    inDepthTitle: 'Explore the Comprehensive BMI Chart & Risk Matrix',
    inDepthSubtitle: 'Need granular height-to-weight classifications, gender variance, or Asian population thresholds?',
    inDepthLink: 'View Complete BMI Chart & Analysis →',
    helpCenter: 'Help Center',
    faqTitle: 'Frequently Asked Questions',
    faqSubtitle: 'Everything you need to know about BMI calculations, metabolic ratios, accuracy, and athletic measurements.',
    sections: [
      { title: 'Anthropometric Screening & International Reference Standards', text: 'Body Mass Index (BMI = kg/m²) is an international epidemiological screening metric that benchmarks body weight relative to stature squared. Developed for population-level health surveillance, standard World Health Organization (WHO) and CDC criteria categorize adult scores into four primary tiers: Underweight (< 18.5), Healthy Reference Weight (18.5–24.9), Overweight (25.0–29.9), and Obesity Classes I–III (≥ 30.0). These categories offer an initial baseline for public health monitoring rather than an individualized clinical diagnosis.' },
      { title: 'Metabolic Energy Balance: Integrating BMR & TDEE', text: 'While BMI evaluates static body mass proportions, metabolic calculations estimate dynamic daily caloric expenditure. Basal Metabolic Rate (BMR), calculated via the validated Mifflin-St Jeor equation, isolates resting cellular energy expenditure needed for vital organ functions. Total Daily Energy Expenditure (TDEE) factors in physical activity level (PAL) multipliers ranging from sedentary (1.2) to highly active (1.725), providing actionable nutritional baselines for caloric maintenance, surplus, or deficit.' },
      { title: 'Body Composition & Abdominal Visceral Adiposity', text: 'Standard BMI cannot differentiate between lean skeletal muscle mass, bone density, and adipose tissue distribution. Visceral fat deposited deep within the abdominal cavity around vital organs poses significantly greater cardiometabolic risk than peripheral subcutaneous fat. Global health panels recommend pairing BMI screening with waist circumference measurements, establishing elevated risk cutoffs at ≥ 90 cm in Asian/South Asian men and ≥ 80 cm in women (compared to ≥ 102 cm and ≥ 88 cm in international Caucasian cohorts).' },
      { title: 'Clinical Limitations & Screening Scope', text: 'Calculators provide mathematical educational estimates, not clinical medical diagnoses. Highly trained athletes with dense muscular development often register an overweight BMI despite low body fat percentage, while older adults with sarcopenia (muscle loss) may present a normal BMI with elevated visceral adiposity. Comprehensive health evaluations require clinical review of blood pressure, fasting plasma glucose, HbA1c, and lipid profiles by a licensed physician.' }
    ],
    whoTable: [
      { category: 'Underweight', range: '< 18.5', risk: 'Underweight reference range', status: 'underweight' },
      { category: 'Healthy Weight', range: '18.5 – 24.9', risk: 'Healthy-weight reference range', status: 'normal' },
      { category: 'Overweight', range: '25.0 – 29.9', risk: 'Overweight reference range', status: 'overweight' },
      { category: 'Obesity Class I', range: '30.0 – 34.9', risk: 'Obesity Class I reference range', status: 'obesity-1' },
      { category: 'Obesity Class II', range: '35.0 – 39.9', risk: 'Obesity Class II reference range', status: 'obesity-2' },
      { category: 'Obesity Class III', range: '≥ 40.0', risk: 'Obesity Class III reference range', status: 'obesity-3' }
    ],
    faq: [
      { q: 'What is the difference between standard BMI and Real BMI?', a: 'Standard BMI calculates body mass strictly using height and weight. Real BMI combines BMI with complementary calculator results to provide additional educational context. Real BMI is not a separate medical measurement or official WHO classification.' },
      { q: 'How is BMI calculated?', a: 'BMI compares your weight and height using a simple formula: weight in kilograms divided by height in meters squared (kg/m²), or (weight in lbs / height in inches²) x 703 for imperial units.' },
      { q: 'How does BMI relate to population health studies?', a: 'Elevated BMI levels (25.0 kg/m² and above) are used in public health literature as a baseline screening reference for population health studies.' },
      { q: 'Why is waist circumference important alongside BMI?', a: 'Waist circumference measurements provide additional reference context regarding body fat distribution alongside BMI.' },
      { q: 'What is a healthy BMI for men and women?', a: 'For most adults, a healthy BMI range is 18.5 to 24.9. For Asian populations, WHO expert consultation guidance identifies BMI 18.5 to 22.9 as a healthy reference range, with 23.0 kg/m² representing an additional public-health action point associated with increased risk.' },
      { q: 'Is BMI accurate for muscular people or athletes?', a: 'BMI is a screening tool, not a diagnostic measurement of body fat. Because dense muscle tissue weighs more than fat volume, muscular athletes may register a higher BMI score while maintaining very low body fat.' },
      { q: 'Why do WHO expert consultations identify lower BMI action points for Asian populations?', a: 'For Asian populations, WHO expert consultation guidance identifies BMI 23.0 kg/m² as an additional public-health action point associated with increased risk, because population studies observe higher body fat percentages and elevated cardiometabolic risk at lower BMI levels compared to European reference groups.' },
      { q: 'What does a BMI of 25 mean?', a: 'A BMI of 25 sits at the baseline threshold between the healthy weight range and the overweight category. It serves as a practical reminder to assess waist circumference and physical activity habits.' },
      { q: 'What is BMR and why does it matter?', a: 'BMR provides an estimated resting energy expenditure based on a predictive equation. Knowing your estimated BMR helps establish baseline calorie guidelines.' },
      { q: 'What is TDEE and why does it matter?', a: 'TDEE (Total Daily Energy Expenditure) estimates the total calories burned daily including movement and exercise, serving as a general reference for maintaining or planning weight goals.' }
    ]
  },
  hi: {
    insightSub: 'स्वास्थ्य अंतर्दृष्टि',
    whoSub: 'डब्ल्यूएचओ (WHO) मानक',
    whoTableTitle: 'डब्ल्यूएचओ बीएमआई वर्गीकरण मानक',
    disclaimer: 'बीएमआई एक प्राथमिक जांच माप (स्क्रीनिंग टूल) है और यह स्वतंत्र रूप से बीमारी का निदान या किसी व्यक्ति के समग्र स्वास्थ्य जोखिम का निर्धारण नहीं करता है।',
    whoDesc: 'विश्व स्वास्थ्य संगठन (WHO) पोषण और स्वास्थ्य संकेतकों का आकलन करने के लिए बीएमआई स्कोर को संदर्भित श्रेणियों में वर्गीकृत करता है।',
    colCategory: 'वर्गीकरण श्रेणी',
    colRange: 'बीएमआई सीमा',
    colRisk: 'अनुमानित संदर्भ सीमा',
    sourcesTitle: 'स्रोत और संदर्भ',
    sourcesSubtitle: 'डब्ल्यूएचओ (WHO) और सीडीसी (CDC) के दिशानिर्देशों पर आधारित मानक।',
    whoLink: 'डब्ल्यूएचओ मोटापा गाइड',
    cdcLink: 'सीडीसी बीएमआई गाइड',
    inDepthTitle: 'विस्तृत बीएमआई चार्ट और स्वास्थ्य जोखिम मैट्रिक्स देखें',
    inDepthSubtitle: 'क्या आपको लंबाई और वजन के अनुसार विस्तृत वर्गीकरण, लिंग भेद या एशियाई आबादी के सीमा बिंदु चाहिए?',
    inDepthLink: 'पूर्ण बीएमआई चार्ट और विश्लेषण देखें →',
    helpCenter: 'सहायता केंद्र',
    faqTitle: 'अक्सर पूछे जाने वाले प्रश्न',
    faqSubtitle: 'बीएमआई गणना, चयापचय दर और स्वास्थ्य दिशानिर्देशों के बारे में अक्सर पूछे जाने वाले प्रश्न।',
    sections: [
      { title: 'एंथ्रोपोमेट्रिक स्क्रीनिंग एवं अंतरराष्ट्रीय संदर्भ मानक', text: 'बॉडी मास इंडेक्स (BMI = किग्रा/मी²) ऊंचाई के अनुपात में शरीर के वजन का मूल्यांकन करने वाला अंतरराष्ट्रीय पैमाना है। विश्व स्वास्थ्य संगठन (WHO) और सीडीसी दिशानिर्देशों के तहत वयस्कों को चार मुख्य श्रेणियों में वर्गीकृत किया गया है: कम वजन (< 18.5), स्वस्थ वजन सीमा (18.5–24.9), अधिक वजन (25.0–29.9) और मोटापा (≥ 30.0)। ये श्रेणियां आबादी-स्तरीय स्वास्थ्य निगरानी के लिए हैं, व्यक्तिगत नैदानिक पुष्टि के लिए नहीं।' },
      { title: 'चयापचय ऊर्जा संतुलन: बीएमआर और टीडीईई का समन्वय', text: 'जहां बीएमआई स्थिर शारीरिक संरचना को मापता है, वहीं बीएमआर और टीडीईई दैनिक कैलोरी ऊर्जा व्यय का अनुमान लगाते हैं। मिफ्लिन-सेंट जेओर फॉर्मूले द्वारा निकाला गया बेसल मेटाबॉलिक रेट (BMR) विश्राम अवस्था में अंगों के कार्य की ऊर्जा दर्शाता है। टोटल डेली एनर्जी एक्सपेंडिचर (TDEE) इसमें शारीरिक गतिविधि कारक (1.2 से 1.725) जोड़कर वजन नियंत्रण के लिए सटीक कैलोरी मार्गदर्शन प्रदान करता है।' },
      { title: 'शारीरिक संरचना एवं आंतरिक पेट की चर्बी (कमर संदर्भ)', text: 'बीएमआई मांसपेशियों और वसा के वितरण में अंतर नहीं कर सकता। आंतरिक पेट के अंगों के आसपास जमा विसरल फैट (चर्बी) सामान्य त्वचा के नीचे की वसा से अधिक हानिकारक होता है। आईसीएमआर और डब्ल्यूएचओ दिशानिर्देश बीएमआई के साथ कमर की परिधि मापने की सलाह देते हैं, जहां एशियाई पुरुषों में ≥ 90 सेमी और महिलाओं में ≥ 80 सेमी को बढ़े हुए स्वास्थ्य जोखिम का संकेत माना जाता है।' },
      { title: 'नैदानिक सीमाएं एवं शैक्षिक स्क्रीनिंग का दायरा', text: 'यह कैलकुलेटर प्राथमिक शैक्षिक संदर्भ के लिए है, किसी बीमारी का चिकित्सकीय निदान नहीं। मांसपेशियों वाले एथलीट कम वसा के बावजूद अधिक वजन की श्रेणी में आ सकते हैं, जबकि बुजुर्ग व्यक्ति मांसपेशियों की कमी (सार्कोपेनिया) के कारण सामान्य बीएमआई पर भी आंतरिक वसा रख सकते हैं। सटीक स्वास्थ्य मूल्यांकन के लिए पंजीकृत डॉक्टर से रक्तचाप, ब्लड शुगर और लिपिड प्रोफाइल की जांच करवाएं।' }
    ],
    whoTable: [
      { category: 'कम वजन', range: '< 18.5', risk: 'कम वजन संदर्भ सीमा', status: 'underweight' },
      { category: 'सामान्य वजन', range: '18.5 – 24.9', risk: 'सामान्य वजन संदर्भ सीमा', status: 'normal' },
      { category: 'अधिक वजन', range: '25.0 – 29.9', risk: 'अधिक वजन संदर्भ सीमा', status: 'overweight' },
      { category: 'मोटापा श्रेणी I', range: '30.0 – 34.9', risk: 'मोटापा श्रेणी I संदर्भ सीमा', status: 'obesity-1' },
      { category: 'मोटापा श्रेणी II', range: '35.0 – 39.9', risk: 'मोटापा श्रेणी II संदर्भ सीमा', status: 'obesity-2' },
      { category: 'मोटापा श्रेणी III', range: '≥ 40.0', risk: 'मोटापा श्रेणी III संदर्भ सीमा', status: 'obesity-3' }
    ],
    faq: [
      { q: 'मानक बीएमआई और Real BMI में क्या अंतर है?', a: 'मानक बीएमआई केवल ऊंचाई और वजन का उपयोग करता है। Real BMI बीएमआई को डब्ल्यूएचओ/सीडीसी दिशानिर्देशों, बीएमआर (BMR) और टीडीईई (TDEE) के साथ मिलाकर अतिरिक्त संदर्भात्मक स्वास्थ्य जानकारी प्रदान करता है। यह अलग चिकित्सा माप या आधिकारिक डब्ल्यूएचओ वर्गीकरण नहीं है।' },
      { q: 'बीएमआई (BMI) की गणना कैसे की जाती है?', a: 'बीएमआई = वजन (किलोग्राम) ÷ ऊंचाई² (मीटर)। इंपीरियल इकाइयों में: (वजन पाउंड ÷ ऊंचाई इंच²) × 703। हमारा कैलकुलेटर दोनों प्रणालियों में तुरंत गणना करता है।' },
      { q: 'बीएमआई जनसंख्या स्वास्थ्य अध्ययनों से कैसे संबंधित है?', a: 'सार्वजनिक स्वास्थ्य साहित्य में बीएमआई स्तर (25.0 kg/m² और अधिक) का उपयोग जनसंख्या स्वास्थ्य अध्ययनों के लिए आधारभूत स्क्रीनिंग संदर्भ के रूप में किया जाता है।' },
      { q: 'बीएमआई के साथ कमर की परिधि (Waist Size) क्यों महत्वपूर्ण है?', a: 'कमर की परिधि का माप बीएमआई के साथ शरीर में वसा के वितरण के बारे में अतिरिक्त संदर्भात्मक जानकारी प्रदान करता है।' },
      { q: 'पुरुषों और महिलाओं के लिए स्वस्थ बीएमआई क्या है?', a: 'अधिकांश वयस्कों के लिए स्वस्थ बीएमआई सीमा 18.5 से 24.9 है। एशियाई आबादी के लिए, डब्ल्यूएचओ विशेषज्ञ परामर्श दिशानिर्देश 18.5 से 22.9 को स्वस्थ संदर्भ सीमा के रूप में पहचानते हैं, जबकि 23.0 kg/m² बढ़े हुए जोखिम से जुड़ा अतिरिक्त सार्वजनिक-स्वास्थ्य एक्शन पॉइंट है।' },
      { q: 'क्या मांसपेशियों वाले एथलीटों के लिए बीएमआई उपयुक्त है?', a: 'बीएमआई एक प्राथमिक जांच उपकरण है, निदान नहीं। यह मांसपेशियों वाले एथलीटों में शरीर की वसा का अधिक अनुमान लगा सकता है, इसलिए इसे कमर की परिधि के साथ देखना चाहिए।' },
      { q: 'डब्ल्यूएचओ विशेषज्ञ परामर्श एशियाई आबादी के लिए कम बीएमआई एक्शन पॉइंट की पहचान क्यों करते हैं?', a: 'एशियाई आबादी के लिए, डब्ल्यूएचओ विशेषज्ञ परामर्श मार्गदर्शन बीएमआई 23.0 kg/m² को बढ़े हुए जोखिम से जुड़े एक अतिरिक्त सार्वजनिक-स्वास्थ्य एक्शन पॉइंट के रूप में पहचानता है, क्योंकि शोध अध्ययनों में यूरोपीय संदर्भ समूहों की तुलना में कम बीएमआई स्तरों पर भी अधिक शारीरिक वसा प्रतिशत और हृदय संबंधी जोखिम कारक देखे गए हैं।' },
      { q: '25 बीएमआई का क्या अर्थ है?', a: '25 का बीएमआई सामान्य सीमा और अधिक वजन श्रेणी के बीच की सीमा पर है। यह कमर के आकार और व्यायाम की आदतों की समीक्षा करने का संकेत है।' },
      { q: 'बीएमआर (BMR) क्या है और यह क्यों महत्वपूर्ण है?', a: 'बीएमआर (BMR) एक प्रेडिक्टिव समीकरण के आधार पर अनुमानित विश्राम ऊर्जा व्यय प्रदान करता है, जो आपकी कैलोरी आवश्यकताओं का आधार तय करता है।' },
      { q: 'टीडीईई (TDEE) क्या है और यह क्यों महत्वपूर्ण है?', a: 'टीडीईई (Total Daily Energy Expenditure) अनुमान लगाता है कि आप शारीरिक गतिविधि और व्यायाम सहित एक दिन में कितनी कुल कैलोरी बर्न करते हैं।' }
    ]
  },
