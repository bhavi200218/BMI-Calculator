          "टीडीईई (TDEE): शारीरिक गतिशीलता सहित 24 घंटे का कुल कैलोरी व्यय।"
        ],
        "toolLink": {
          "name": "बीएमआर और टीडीईई जांचें",
          "href": "/hi/tdee-calculator/"
        }
      },
      {
        "title": "शारीरिक संरचना एवं आंतरिक पेट की चर्बी (कमर संदर्भ)",
        "paragraphs": [
          "साधारण वजन कांटा मांसपेशियों और शरीर की चर्बी में अंतर नहीं कर सकता। पेट के आंतरिक अंगों के आसपास जमा विसरल फैट (आंतरिक वसा) त्वचा के नीचे की वसा की तुलना में अधिक स्वास्थ्य जोखिम पैदा करता है। इसलिए चिकित्सा विशेषज्ञ बीएमआई के साथ कमर का घेरा मापने की सलाह देते हैं—जिसमें कमर का माप आपकी कुल लंबाई के आधे से कम रखना सबसे सुरक्षित माना जाता है।"
        ],
        "bullets": [
          "पेट की आंतरिक चर्बी इंसुलिन प्रतिरोध और चयापचय जोखिमों से सीधे जुड़ी है।",
          "कमर-से-ऊंचाई अनुपात: कमर को अपनी लंबाई के आधे से कम रखना सर्वोत्तम है।"
        ],
        "toolLink": {
          "name": "कमर-से-कूल्हा अनुपात कैलकुलेटर",
          "href": "/hi/waist-to-hip-ratio-calculator/"
        }
      },
      {
        "title": "नैदानिक सीमाएं एवं शैक्षिक स्क्रीनिंग का दायरा",
        "paragraphs": [
          "स्क्रीनिंग सूत्र जनसंख्या के आंकड़ों पर आधारित शैक्षिक अनुमान प्रदान करते हैं, कोई चिकित्सीय निदान नहीं। अत्यधिक मांसपेशियों वाले एथलीटों का बीएमआई चर्बी न होने पर भी अधिक आ सकता है, जबकि बुजुर्गों में उम्र के साथ मांसपेशियों की कमी (सार्कोपेनिया) सामान्य वजन के पीछे अधिक आंतरिक वसा को छिपा सकती है। संपूर्ण स्वास्थ्य मूल्यांकन के लिए हमेशा पंजीकृत चिकित्सक से परामर्श और नियमित जांच कराएं।"
        ],
        "bullets": [
          "एथलीट शरीर संरचना: घनी मांसपेशियां अतिरिक्त चर्बी के बिना भी बीएमआई बढ़ा सकती हैं।",
          "उम्र बढ़ने पर मांसपेशियों की कमी: प्राकृतिक सार्कोपेनिया सामान्य माप को प्रभावित करता है।",
        ],
        "toolLink": {
          "name": "ऊंचाई अनुसार आदर्श वजन देखें",
          "href": "/hi/ideal-weight-calculator/"
        }
      }
    ],
    "whoTable": [
      {
        "category": "कम वजन",
        "range": "< 18.5",
        "risk": "कम वजन संदर्भ सीमा",
        "status": "underweight"
      },
      {
        "category": "सामान्य वजन",
        "range": "18.5 – 24.9",
        "risk": "सामान्य वजन संदर्भ सीमा",
        "status": "normal"
      },
      {
        "category": "अधिक वजन",
        "range": "25.0 – 29.9",
        "risk": "अधिक वजन संदर्भ सीमा",
        "status": "overweight"
      },
      {
        "category": "मोटापा श्रेणी I",
        "range": "30.0 – 34.9",
        "risk": "मोटापा श्रेणी I संदर्भ सीमा",
        "status": "obesity-1"
      },
      {
        "category": "मोटापा श्रेणी II",
        "range": "35.0 – 39.9",
        "risk": "मोटापा श्रेणी II संदर्भ सीमा",
        "status": "obesity-2"
      },
      {
        "category": "मोटापा श्रेणी III",
        "range": "≥ 40.0",
        "risk": "मोटापा श्रेणी III संदर्भ सीमा",
        "status": "obesity-3"
      }
    ],
    "faq": [
      {
        "q": "व्यक्तिगत स्वास्थ्य के मूल्यांकन में बीएमआई (BMI) कितना सटीक है?",
        "a": "बीएमआई एक व्यापक जनसंख्या स्क्रीनिंग टूल है, कोई चिकित्सीय रोग-निदान नहीं। यह बड़े समूहों में स्वास्थ्य जोखिमों का सटीक संकेत देता है, लेकिन मांसपेशियों, हड्डियों के घनत्व और चर्बी के बीच अंतर नहीं कर पाता। किसी व्यक्ति के लिए बीएमआई का सबसे बेहतर उपयोग तब होता है जब इसे कमर के माप, बॉडी फैट प्रतिशत और रक्त परीक्षणों के साथ देखा जाए।"
      },
      {
        "q": "एशियाई और भारतीय आबादी के लिए बीएमआई के मानक क्यों अलग हैं?",
        "a": "द लांसेट (2004) और विश्व स्वास्थ्य संगठन (WHO) के अध्ययनों के अनुसार, एशियाई और दक्षिण एशियाई लोगों में कम वजन पर भी आंतरिक चर्बी (विसेरल फैट) अधिक पाई जाती है। इसलिए एशियाई वयस्कों के लिए स्वस्थ बीएमआई सीमा 18.5 से 22.9 kg/m² मानी जाती है, 23.0 kg/m² पर स्वास्थ्य जोखिम की चेतावनी शुरू होती है और 27.5 kg/m² को उच्च जोखिम (मोटापा) माना जाता है।"
      },
      {
        "q": "क्या अधिक मांसपेशियों वाले एथलीटों का बीएमआई अधिक हो सकता है?",
        "a": "हाँ। कंकाल की मांसपेशियां शरीर की चर्बी से लगभग 18% अधिक सघन (dense) होती हैं। बॉडीबिल्डर और भारी कसरत करने वाले एथलीटों का फैट प्रतिशत बहुत कम (10-12%) होने पर भी उनका बीएमआई 25 या 30 से ऊपर (ओवरवेट/मोटापे की श्रेणी) आ सकता है। ऐसी स्थिति में बीएमआई के स्थान पर बॉडी फैट % या कमर-से-ऊंचाई का अनुपात मापना सही रहता है।"
      },
      {
        "q": "बीएमआई के साथ कमर-से-ऊंचाई अनुपात (WHtR) मापना क्यों जरूरी है?",
        "a": "कमर-से-ऊंचाई अनुपात (Waist-to-Height Ratio) पेट के आंतरिक अंगों के आसपास जमा हानिकारक विसेरल फैट की जांच करता है। यह फैट टाइप-2 डायबिटीज, फैटी लिवर और हाई बीपी के लिए मुख्य रूप से जिम्मेदार है। चिकित्सा दिशानिर्देशों के अनुसार कमर का घेरा हमेशा आपकी लंबाई के आधे से कम (WHtR < 0.50) होना चाहिए।"
      },
      {
        "q": "25.0 बीएमआई (BMI) का वास्तव में क्या अर्थ होता है?",
        "a": "25.0 kg/m² का बीएमआई अंतरराष्ट्रीय स्तर पर सामान्य वजन और अधिक वजन (ओवरवेट) के बीच का विभाजन बिंदु है। यह किसी गंभीर बीमारी का तुरंत संकेत नहीं है, बल्कि एक उपयोगी रिमाइंडर है कि आप अपने खान-पान, दैनिक शारीरिक गतिविधि, कमर के घेरे और ब्लड प्रेशर की नियमित जांच कराएं।"
      },
      {
        "q": "वयस्क पुरुषों और महिलाओं के लिए स्वस्थ बीएमआई सीमा क्या है?",
        "a": "डब्ल्यूएचओ के वैश्विक मानकों के अनुसार 18.5 से 24.9 kg/m² का बीएमआई स्वस्थ माना जाता है। एशियाई और भारतीय वयस्कों के लिए यह सीमा 18.5 से 22.9 kg/m² है। महिलाओं में प्राकृतिक रूप से पुरुषों की तुलना में शारीरिक फैट का स्तर कुछ अधिक होता है, लेकिन अंतरराष्ट्रीय बीएमआई श्रेणियां दोनों पर समान रूप से लागू होती हैं।"
      },
      {
        "q": "पेट की आंतरिक चर्बी (विसेरल फैट) त्वचा के नीचे की चर्बी से अधिक हानिकारक क्यों है?",
        "a": "विसेरल फैट पेट के अंदर लिवर, अग्न्याशय और आंतों के चारों ओर लिपटा रहता है और सीधे रक्तप्रवाह में सूजन पैदा करने वाले रसायन छोड़ता है। इसके विपरीत, जांघों या कूल्हों के नीचे की सबक्यूटेनियस फैट निष्क्रिय ऊर्जा भंडारण होती है। यही कारण है कि केवल वजन की तुलना में कमर का घेरा स्वास्थ्य के लिए अधिक बड़ा संकेतक है।"
      },
      {
        "q": "बुढ़ापा और मांसपेशियों की कमी (सार्कोपेनिया) बीएमआई को कैसे प्रभावित करते हैं?",
        "a": "60 वर्ष की आयु के बाद मांसपेशियों में प्राकृतिक क्षय (सार्कोपेनिया) होने लगता है। ऐसे में शरीर में चर्बी बढ़ने पर भी बीएमआई 'सामान्य' बना रह सकता है, जिससे छिपे हुए स्वास्थ्य जोखिम पकड़ में नहीं आते। वृद्धावस्था चिकित्सा में पोषण संबंधी दुर्बलता से बचने के लिए थोड़ा अधिक बीएमआई (23.0 से 27.0 kg/m²) भी सुरक्षित माना जाता है।"
      },
      {
        "q": "बीएमआर (BMR) और टीडीईई (TDEE) बीएमआई स्क्रीनिंग को कैसे पूरा करते हैं?",
        "a": "बीएमआई केवल लंबाई के अनुपात में वजन बताता है, जबकि बीएमआर (बेसल मेटाबॉलिक रेट) यह बताता है कि विश्राम की अवस्था में आपका शरीर जीवित रहने के लिए कितनी कैलोरी जलाता है। टीडीईई में आपकी दैनिक शारीरिक कसरत शामिल होती है, जिससे वजन नियंत्रित रखने या स्वस्थ कैलोरी डेफिसिट की सटीक योजना बनाई जा सकती है।"
      },
      {
        "q": "मानक बीएमआई और Real BMI में क्या अंतर है?",
        "a": "मानक बीएमआई आधिकारिक WHO और CDC सूत्र (kg/m²) के आधार पर ऊंचाई के सापेक्ष वजन का मूल्यांकन करता है। Real BMI सॉफ्टवेयर इंजीनियर भवांशी दोसी (बांसवाड़ा, राजस्थान, भारत) द्वारा निर्मित एक स्वतंत्र शैक्षिक स्वास्थ्य वेबसाइट है। यह मानक बीएमआई स्कोर के साथ-साथ कमर-से-ऊंचाई अनुपात, बीएमआर और टीडीईई जैसे स्थापित पूरक टूल्स को एक ही स्थान पर संदर्भात्मक रूप में प्रस्तुत करती है — बिना किसी व्यक्तिगत स्वास्थ्य डेटा को एकत्र या स्टोर किए।"
      }
    ]
  }
};

const t = content[lang] || content.en;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faq.map((item: { q: string; a: string }) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="insights" class="w-full space-y-10 md:space-y-12 py-4 scroll-mt-24">

  <!-- ═══════════════════  HEALTH INSIGHTS HEADER & CARDS  ═══════════════════ -->
  <div class="space-y-6">
    <div class="space-y-2 max-w-3xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
        {t.insightSub}<span class="sr-only">. </span>
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
        {t.insightsMainTitle}<span class="sr-only">. </span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
        {t.insightsMainDesc}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
      {t.sections.map((section: any, idx: number) => (
        <article class="p-5 md:p-6 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)] transition-all duration-200 flex flex-col justify-start group">
          
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] px-2.5 py-0.5 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20">
                Pillar 0{idx + 1}<span class="sr-only">. </span>
              </span>
            </div>
            
            <h3 class="text-base md:text-lg font-display font-bold uppercase leading-snug text-[var(--foreground)]">
              {section.title}<span class="sr-only">. </span>
            </h3>

            <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
              {section.paragraphs ? section.paragraphs[0] : section.text}
            </p>

            {section.bullets && (
              <ul class="space-y-1 pt-2 text-xs text-[var(--muted-foreground)]">
                {section.bullets.slice(0, 2).map((bullet: string) => (
                  <li class="flex items-start gap-1.5 leading-relaxed">
                    <span class="w-1 h-1 rounded-full bg-[var(--accent)] shrink-0 mt-1.5"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- ═══════════════════  WHO TABLE & SOURCES  ═══════════════════ -->
  {t.whoTable && (
    <div class="space-y-8 pt-4">
      <div class="space-y-3">
        <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{t.whoSub}<span class="sr-only">. </span></p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {t.whoTableTitle}<span class="sr-only">. </span>
        </h2>
        <p class="text-base text-[var(--muted-foreground)] max-w-2xl font-medium">
          {t.whoDesc}
        </p>
      </div>

      <!-- Responsive Table Version -->
      <div class="rounded-2xl border-[1.5px] border-[var(--border)] bg-[var(--card)] shadow-[var(--shadow-soft)] overflow-hidden">
        <div class="w-full">
          <table class="w-full text-left border-collapse table-auto">
            <thead>
              <tr class="bg-[var(--muted)]">
                <th class="px-2.5 py-3 sm:px-6 sm:py-3.5 text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">{t.colCategory}</th>
                <th class="px-2.5 py-3 sm:px-6 sm:py-3.5 text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">{t.colRange}</th>
                <th class="px-2.5 py-3 sm:px-6 sm:py-3.5 text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">{t.colRisk}</th>
              </tr>
            </thead>
            <tbody>
              {t.whoTable.map((row: any, i: number) => (
                <tr class={`transition-colors hover:bg-[var(--muted)]/50 ${i % 2 === 1 ? 'bg-[var(--muted)]/20' : ''}`}>
                  <td class="px-2.5 py-3 sm:px-6 sm:py-3.5 font-display font-bold text-[var(--foreground)] uppercase text-xs sm:text-sm">{row.category}</td>
                  <td class="px-2.5 py-3 sm:px-6 sm:py-3.5 font-sans text-[var(--foreground)] text-xs sm:text-sm font-semibold">{row.range}</td>
                  <td class="px-2.5 py-3 sm:px-6 sm:py-3.5">
                    <span class={`inline-block text-[10px] sm:text-xs font-display font-bold uppercase tracking-wider px-2 py-0.5 sm:px-3 sm:py-1 rounded-full border ${
                      row.status === 'normal'      ? 'border-emerald-500/40 dark:border-emerald-500/50 text-emerald-950 dark:text-emerald-200 bg-emerald-100/90 dark:bg-emerald-950/60' :
                      row.status === 'underweight' ? 'border-sky-500/40 dark:border-sky-500/50 text-sky-950 dark:text-sky-200 bg-sky-100/90 dark:bg-sky-950/60' :
                      row.status === 'overweight'  ? 'border-amber-500/40 dark:border-amber-500/50 text-amber-950 dark:text-amber-200 bg-amber-100/90 dark:bg-amber-950/60' :
                                                     'border-rose-500/40 dark:border-rose-500/50 text-rose-950 dark:text-rose-200 bg-rose-100/90 dark:bg-rose-950/60'
                    }`}>{row.risk}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-xs text-[var(--muted-foreground)] font-medium pt-2 italic">
        {t.disclaimer}
      </p>

      <!-- Dedicated In-Depth Reference Banner -->
      <div class="rounded-xl border border-[var(--accent)]/30 bg-[var(--accent)]/5 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="space-y-1">
          <p class="text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">{t.inDepthTitle}<span class="sr-only">. </span></p>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium">{t.inDepthSubtitle}</p>
        </div>
        <a href={`/${lang}/bmi-chart/`} class="inline-flex items-center gap-1.5 rounded-xl bg-slate-900 dark:bg-white px-4 py-2 text-xs font-display font-bold uppercase tracking-wider text-white dark:text-slate-900 hover:opacity-90 transition-opacity shrink-0 shadow-xs">
          <span>{t.inDepthLink}</span>
        </a>
      </div>

      <!-- Sources & References Box -->
      <div class="rounded-xl border border-[var(--border)] bg-[var(--card)]/80 p-4 sm:p-5 shadow-[var(--shadow-soft)] flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <p class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)]">{t.sourcesTitle}<span class="sr-only">. </span></p>
          <p class="text-xs text-[var(--muted-foreground)] mt-0.5 font-medium">{t.sourcesSubtitle}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] px-3.5 py-2 min-h-[44px] text-xs font-semibold text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors bg-[var(--muted)]/30">
            <span>{t.whoLink}</span>
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <a href="https://www.cdc.gov/bmi/faq/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] px-3.5 py-2 min-h-[44px] text-xs font-semibold text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors bg-[var(--muted)]/30">
            <span>{t.cdcLink}</span>
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- ═══════════════════  FAQ ACCORDION  ═══════════════════ -->
  <div id="faq" class="space-y-6 sm:space-y-8 pt-6 sm:pt-8 scroll-mt-28">
    <div class="space-y-2 text-center">
      <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{t.helpCenter}<span class="sr-only">. </span></p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase text-[var(--foreground)] tracking-tight">{t.faqTitle}<span class="sr-only">. </span></h2>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] max-w-xl mx-auto font-medium">
        {t.faqSubtitle}
      </p>
    </div>

    <div class="space-y-3 w-full">
      {t.faq.map((item: { q: string; a: string }) => (
        <details class="group rounded-xl border border-[var(--border)] bg-[var(--card)] overflow-hidden cursor-pointer hover:border-[var(--accent)] transition-all duration-200 shadow-[var(--shadow-soft)]">
          <summary class="flex justify-between items-center font-display font-semibold text-sm sm:text-base py-3.5 px-4 sm:py-4 sm:px-6 select-none list-none uppercase tracking-tight text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">
            <span class="pr-6">{item.q}</span>
            <span class="text-[var(--muted-foreground)] group-open:rotate-180 transition-transform duration-200 flex-shrink-0">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-4 pb-4 sm:px-6 sm:pb-6 text-xs sm:text-sm md:text-base leading-relaxed font-medium pt-3 bg-[var(--muted)]/10">
            <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
