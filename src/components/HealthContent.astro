                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">24.0 – 29.0 kg/m²</td>
                  <td class="px-6 py-4 font-semibold text-[var(--accent)]">23.5 – 28.5 kg/m²</td>
                  <td class="px-6 py-4 text-xs text-[var(--muted-foreground)]">Geriatric Protective Muscle Reserve</td>
