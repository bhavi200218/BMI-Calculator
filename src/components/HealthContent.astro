                  <span class="font-bold text-[var(--accent)] text-xs block">{item.men}</span>
                </div>
                <div class="p-2.5 rounded-lg bg-[var(--muted)]/40 space-y-1">
                  <span class="text-[10px] uppercase tracking-wider font-bold text-[var(--muted-foreground)] block">Women Ideal</span>
                  <span class="font-bold text-[var(--accent)] text-xs block">{item.women}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Desktop Table Version (Used by Google for Featured Snippets) -->
        <div class="hidden sm:block rounded-2xl border-[1.5px] border-[var(--border)] bg-[var(--card)] shadow-[var(--shadow-soft)] overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left min-w-[550px] border-collapse">
              <thead>
                <tr class="bg-[var(--muted)] text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">
