          "안정 시 심박수 65 BPM 이하는 효율적인 심박출량과 심혈관 질환 위험 감소를 의미합니다.",
          "존 2 유산소 훈련(60~70% HRR)은 미토콘드리아 밀도와 지방 대사 능력을 극대화합니다.",
          "Epley와 Brzycki 공식을 활용한 준최대 1RM 추정은 부상 위험 없이 안전하게 근력을 측정합니다."
        ],
        featuredGuides: [
          { title: "안정 시 심박수와 심혈관 장수 지표 분석", href: `/${lang}/blog/cardiovascular-fitness-resting-heart-rate/` },
          { title: "목표 심박수 트레이닝 존 (존 1부터 존 5까지)", href: `/${lang}/blog/target-heart-rate-training-zones/` },
          { title: "1RM 최대 근력 공식 및 훈련 중량 비율표", href: `/${lang}/blog/one-rep-max-strength-guide/` }
        ],
        featuredTools: [
          { title: "심박수 트레이닝 존 계산기", href: `/${lang}/heart-rate-zone-calculator/` },
          { title: "1RM 근력 계산기", href: `/${lang}/1rm-calculator/` },
          { title: "키에 따른 이상적 체중", href: `/${lang}/healthy-weight-by-height/` }
        ]
      }
    ]
  }
};

const current = data[lang] || data.en;
---

<section class="space-y-8 py-8 md:py-12" id="popular-topics">
  <!-- Section Header -->
  <div class="space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
      {current.eyebrow}
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-[1.05]">
      {current.title}
    </h2>
    <p class="text-base sm:text-lg text-[var(--muted-foreground)] max-w-3xl font-medium leading-relaxed">
      {current.subtitle}
    </p>
  </div>

  <!-- Topics Grid (2 Columns on Desktop) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
    {current.topics.map((topic) => (
      <div class="p-6 sm:p-8 rounded-3xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-6 hover:border-[var(--accent)]/60 transition-all duration-300 shadow-xs hover:shadow-md">
        
        <!-- Header & Description -->
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-display font-bold tracking-wider uppercase text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20">
              {topic.badge}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-display font-bold tracking-tight text-[var(--foreground)] uppercase leading-snug">
            {topic.title}
          </h3>

          <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">
            {topic.description}
          </p>

          <!-- Key Scientific Takeaways / Bullet Box -->
          <div class="p-4 rounded-2xl bg-[var(--muted)]/30 border border-[var(--border)]/50 space-y-2">
            <div class="text-[11px] font-display font-bold uppercase tracking-wider text-[var(--accent)]">
              {current.takeawaysLabel}
            </div>
            <ul class="space-y-1.5">
              {topic.keyInsights.map((insight) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--foreground)]/90 leading-relaxed font-medium">
                  <span class="text-[var(--accent)] font-bold shrink-0 mt-0.5">•</span>
                  <span>{insight}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Links Footer: Research Guides & Calculators -->
        <div class="space-y-4 pt-4 border-t border-[var(--border)]">
          <!-- Research Guides Links -->
          <div class="space-y-2">
            <p class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
              {current.guidesLabel}
            </p>
            <div class="flex flex-col gap-1.5">
              {topic.featuredGuides.map((guide) => (
                <a
                  href={guide.href}
                  class="group/link flex items-center justify-between text-xs sm:text-sm font-semibold text-[var(--accent)] hover:underline py-0.5"
                >
                  <span class="truncate pr-2">{guide.title}</span>
                  <span class="shrink-0 transition-transform group-hover/link:translate-x-1">→</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Direct Calculator Links -->
          <div class="space-y-2 pt-2">
            <p class="text-xs font-display font-bold uppercase tracking-wider text-[var(--muted-foreground)]">
              {current.toolsLabel}
            </p>
            <div class="flex flex-wrap gap-2">
              {topic.featuredTools.map((tool) => (
                <a
                  href={tool.href}
                  class="px-2.5 py-1 rounded-lg border border-[var(--border)] bg-[var(--background)] hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 text-xs font-medium text-[var(--foreground)] transition-colors"
                >
                  {tool.title}
                </a>
              ))}
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>
