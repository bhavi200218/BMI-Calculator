---
interface Props {
  lang?: string;
  slug?: string;
}

const { lang: propLang, slug } = Astro.props;
const { currentLocale } = Astro;
const lang = propLang || currentLocale || 'en';

const metabolicSlugs = [
  'bmr-calculator',
  'tdee-calculator',
  'maintenance-calorie-calculator',
  'calorie-calculator',
  'protein-intake-calculator',
  'water-intake-calculator',
  'macro-calculator',
  'diabetes-risk-calculator'
];

const fitnessSlugs = [
  'heart-rate-zone-calculator',
  'karvonen-heart-rate-calculator',
  '1rm-calculator',
  'one-rep-max-calculator'
];

const category = slug 
  ? (fitnessSlugs.includes(slug) ? 'fitness' : (metabolicSlugs.includes(slug) ? 'metabolic' : 'bmi'))
  : 'bmi';

