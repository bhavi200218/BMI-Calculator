---
interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const { currentLocale } = Astro;
const lang = propLang || currentLocale || 'en';

const content: Record<string, any> = {
  en: {
    eyebrow: "Evidence-Based Health Guide",
    title: "Body Mass Index (BMI) & Population Health Reference Guidance",
    sections: [
      {
        title: "How Do I Calculate My BMI & Related Metrics?",
        text: "You can evaluate your Body Mass Index (weight / height²) alongside your Basal Metabolic Rate (BMR), Total Daily Energy Expenditure (TDEE), and Waist-to-Height Ratio (WHtR). This provides educational context that accounts for muscle density, age, and waist-to-height reference proportions."
      },
      {
        title: "How Does Standard BMI Work?",
        text: "Standard BMI calculators use a mathematical formula recognized by WHO and CDC. Standard BMI measures total body mass relative to height. Real BMI presents BMI alongside complementary estimates and population-reference ranges for additional educational context."
      },
      {
        title: "How Do Multiple Metrics Provide Broader Context?",
        text: "No single number paints a complete picture of an individual's body composition. Combining standard BMI with Waist-to-Height Ratio (WHtR) and WHO Asian cutoffs (23.0 kg/m² for overweight) provides additional context for body composition and abdominal fat reference indicators."
      },
      {
        title: "Is a BMI of 25 Realistic?",
        text: "Yes, a BMI of 25.0 kg/m² represents the threshold between healthy weight and overweight for general adult populations under WHO guidelines. However, for muscular athletes, a BMI of 25 is common due to dense muscle mass, while for South Asian populations, overweight reference cutoffs begin at 23.0 kg/m²."
      },
      {
        title: "Body Mass Index (BMI) & Population Health Guidelines",
        text: "According to published literature from public health authorities (including the WHO and CDC), maintaining a Body Mass Index (BMI between 18.5 and 24.9 kg/m²) aligns with standard population reference baselines. Real BMI provides educational screening references aligned with these guidelines."
      },
      {
        title: "What is 'Real BMI' and How Does it Differ From Scale Weight?",
        text: "The term 'Real BMI' is used by this website to describe assessing your Body Mass Index (BMI) alongside complementary metrics — including Basal Metabolic Rate (BMR), Total Daily Energy Expenditure (TDEE), and waist circumference — rather than relying on height and weight alone. It is an informational concept, not a separate medical measurement or official WHO classification."
      },
      {
        title: "Is BMI Accurate for Everyone? The Athlete & Muscle Paradox",
        text: "While standard Body Mass Index formulas (weight/height²) apply universally, muscle density differs significantly from adipose tissue. Muscular athletes or weightlifters may register higher BMI values despite having low body fat percentage, because dense muscle weighs more than fat volume. Waist-to-height ratio can provide additional context alongside BMI, particularly when BMI may not reflect body composition."
      },
      {
        title: "Why WHO Recommends Lower BMI Cutoffs for Asian & South Asian Populations",
        text: "World Health Organization (WHO) published consensus recommends lower BMI cutoff thresholds for Asian and South Asian populations: 23.0 kg/m² for overweight reference (vs. 25.0 kg/m² standard) due to higher relative body fat at lower body mass indexes."
      },
      {
        title: "BMI Calculation Formula: Metric (kg/m²) vs. Imperial (lbs/in²)",
        text: "Our online Real BMI Calculator supports both metric and imperial measurements. In metric, the formula is: <code>BMI = weight (kg) / [height (m)]²</code>. In imperial units, the formula is: <code>BMI = [weight (lb) / height (in)²] x 703</code>."
      },
      {
        title: "Using BMI for Weight-Management Planning",
        text: "Estimated calorie needs can be used as one planning reference. Individual weight-management strategies vary, and modest energy adjustments alongside balanced nutrition and physical activity are commonly explored."
      }
    ]
  },
  hi: {
    eyebrow: "स्वास्थ्य एवं संदर्भ गाइड",
    title: "बॉडी मास इंडेक्स (BMI) और जनसंख्या स्वास्थ्य संदर्भ गाइड",
    sections: [
      {
        title: "बीएमआई और स्वास्थ्य संदर्भ: प्रकाशित मानक क्या कहते हैं?",
        text: "विश्व स्वास्थ्य संगठन (WHO) और CDC द्वारा प्रकाशित मानकों के अनुसार, 18.5 से 24.9 kg/m² का बीएमआई सामान्य जनसंख्या संदर्भ सीमा को दर्शाता है।"
      },
      {
        title: "'Real BMI' क्या है और यह साधारण तराजू से कैसे अलग है?",
        text: "'Real BMI' का तात्पर्य केवल वजन पर निर्भर रहने के बजाय बीएमआर (BMR), टीडीईई (TDEE) और कमर की परिधि के साथ बॉडी मास इंडेक्स का मूल्यांकन करना है। हमारा कैलकुलेटर बीएमआई और संबंधित स्वास्थ्य संदर्भ का अनुमान प्रदान करता है। यह चिकित्सा निदान के लिए नहीं है।"
      },
      {
        title: "एशियाई और भारतीय आबादी के लिए कम बीएमआई थ्रेसहोल्ड क्यों हैं?",
        text: "कुछ WHO विशेषज्ञ परामर्शों और एशियाई आबादी दिशानिर्देशों में बीएमआई 23.0 kg/m² से शुरू होने वाले अतिरिक्त संदर्भ थ्रेसहोल्ड का उपयोग किया जाता है।"
      },
      {
        title: "बीएमआई फॉर्मूला: मीट्रिक (kg/m²) बनाम इंपीरियल (lbs/in²)",
        text: "मीट्रिक पद्धति में: <code>BMI = वजन (kg) / [ऊंचाई (m)]²</code>। इंपीरियल पद्धति में: <code>BMI = [वजन (lb) / ऊंचाई (in)²] x 703</code>।"
      }
    ]
  },
  ko: {
    eyebrow: "근거 기반 건강 가이드",
    title: "체질량지수(BMI) 및 인구 보건학적 참조 가이드",
    sections: [
      {
        title: "BMI 및 연령별 건강 지표: 연구 결과",
        text: "세계보건기구(WHO) 및 CDC 표준에 따르면 적정 BMI(18.5~24.9 kg/m²)를 유지하는 것은 표준 인구 보건학적 참조 범위를 제시합니다."
      },
      {
        title: "'Real BMI'란 무엇이며 일반 체중계와 어떻게 다른가요?",
        text: "'Real BMI'는 단순 체중뿐만 아니라 기초대사량(BMR), 일일 총 에너지 소비량(TDEE), 허리둘레를 종합하여 체성분을 교육적으로 참고하는 지표입니다."
      }
    ]
  },
  es: {
    eyebrow: "Guía de Referencia de Salud",
    title: "Índice de Masa Corporal (IMC) y Contexto Poblacional",
    sections: [
      {
        title: "IMC y Estándares de la OMS y CDC",
        text: "Mantener un IMC dentro del rango de referencia estándar (entre 18.5 y 24.9 kg/m²) proporciona un marco de evaluación poblacional de peso."
      }
    ]
  },
  fr: {
    eyebrow: "Guide de Référence de Santé",
    title: "Indice de Masse Corporelle (IMC) et Contexte de Santé",
    sections: [
      {
        title: "IMC et Normes de l'OMS et CDC",
        text: "Maintenir un IMC de référence (entre 18,5 et 24,9 kg/m²) fournit un cadre d'évaluation globale du poids corporel."
      }
    ]
  },
  de: {
    eyebrow: "Gesundheits-Referenzleitfaden",
    title: "Body-Mass-Index (BMI) & Bevölkerungsspezifische Referenzwerte",
    sections: [
      {
        title: "BMI & Standards laut WHO & CDC",
        text: "Ein Referenz-BMI (zwischen 18,5 und 24,9 kg/m²) dient als allgemeiner Orientierungswert für das Körpergewicht."
      }
    ]
  }
};

const t = content[lang] || content.en;
---

<section class="px-4 md:px-6 my-10 max-w-7xl mx-auto space-y-8">
  <div class="space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
      <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
      {t.eyebrow}
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
      {t.title}
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {t.sections.map((sec: any) => (
      <div class="space-y-2.5">
        <h3 class="text-lg sm:text-xl font-display font-bold uppercase text-[var(--foreground)] tracking-tight">
          {sec.title}
        </h3>
        <p class="text-sm text-[var(--muted-foreground)] font-medium leading-relaxed" set:html={sec.text}>
        </p>
      </div>
    ))}
  </div>
</section>
