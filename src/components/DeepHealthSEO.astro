---
const { currentLocale } = Astro;
const lang = currentLocale || 'en';

const content: Record<string, any> = {
  en: {
    eyebrow: "Clinical Health Guide",
    title: "Body Mass Index (BMI) & Long-Term Health Risks: Official Guidance",
    sections: [
      {
        title: "Body Mass Index (BMI) & Cancer Risk: What Clinical Studies Show",
        text: "According to published clinical guidelines by the American Cancer Society (ACS) and World Health Organization (WHO), maintaining a healthy Body Mass Index (BMI between 18.5 and 24.9 kg/m²) significantly lowers lifetime risk for metabolic disorders, cardiovascular disease, and at least 13 types of cancer. Elevated body weight, particularly abdominal visceral adiposity, alters hormone balance (such as insulin and estrogen) and promotes chronic inflammation. Real BMI provides immediate screening feedback aligned with these medical guidelines."
      },
      {
        title: "What is 'Real BMI' and How Does it Differ From Weight Scales?",
        text: "The term 'Real BMI' refers to assessing your Body Mass Index (BMI) alongside critical physiological metrics — including Basal Metabolic Rate (BMR), Total Daily Energy Expenditure (TDEE), and waist circumference — rather than relying on weight alone. Traditional bathroom scales measure total mass but fail to distinguish between muscle, water, and visceral fat. Our Real BMI Calculator integrates official WHO and CDC guidelines to give you a complete, clinical-grade overview."
      },
      {
        title: "Is BMI Accurate for Everyone? The Athlete & Muscle Paradox",
        text: "While standard Body Mass Index formulas (weight/height²) apply universally, muscle density differs significantly from adipose tissue. Muscular athletes or weightlifters may register as 'Overweight' or 'Obese' despite having low body fat percentage, because dense muscle weighs more than fat volume. Real BMI highlights these nuances and recommends pairing BMI with waist-to-height ratio for active individuals."
      },
      {
        title: "Why WHO Recommends Lower BMI Thresholds for Asian & South Asian Populations",
        text: "World Health Organization (WHO) clinical consensus recommends lower BMI cutoff thresholds for Asian and South Asian populations: 23.0 kg/m² for overweight (vs. 25.0 kg/m² standard) due to higher risk of visceral fat accumulation at lower body mass indexes. Real BMI automatically accounts for regional risk cutoffs."
      },
      {
        title: "BMI Calculation Formula: Metric (kg/m²) vs. Imperial (lbs/in²)",
        text: "Our online Real BMI Calculator supports both metric and imperial measurements. In metric, the formula is: <code>BMI = weight (kg) / [height (m)]²</code>. In imperial units, the formula is: <code>BMI = [weight (lb) / height (in)²] x 703</code>. Inputting accurate measurements guarantees precise clinical classifications."
      },
      {
        title: "How to Use Real BMI for Safe, Sustainable Weight Loss",
        text: "Transitioning to a healthier Real BMI score requires consistent habits. Focus on a moderate calorie deficit (300 to 500 kcal below TDEE), balanced nutrition rich in whole foods, and regular resistance or aerobic exercise."
      }
    ]
  },
  hi: {
    eyebrow: "नैदानिक गाइड",
    title: "बॉडी मास इंडेक्स (BMI) और दीर्घकालिक स्वास्थ्य जोखिम: आधिकारिक गाइड",
    sections: [
      {
        title: "बीएमआई और कैंसर/चयापचय जोखिम: चिकित्सकीय अध्ययन क्या कहते हैं?",
        text: "अमेरिकन कैंसर सोसाइटी (ACS) और विश्व स्वास्थ्य संगठन (WHO) के नैदानिक अध्ययनों के अनुसार, एक स्वस्थ बीएमआई (18.5 से 22.9 / 24.9 kg/m²) बनाए रखने से चयापचय विकारों और पुरानी बीमारियों का खतरा काफी कम हो जाता है।"
      },
      {
        title: "'Real BMI' क्या है और यह साधारण तराजू से कैसे अलग है?",
        text: "'Real BMI' का तात्पर्य केवल वजन पर निर्भर रहने के बजाय बीएमआर (BMR), टीडीईई (TDEE) और कमर की परिधि के साथ बॉडी मास इंडेक्स का मूल्यांकन करना है। डब्ल्यूएचओ (WHO) और सीडीसी (CDC) मानकों के आधार पर हमारा कैलकुलेटर आपको सटीक नैदानिक परिणाम देता है।"
      },
      {
        title: "एशियाई और भारतीय आबादी के लिए कम बीएमआई सीमाएं क्यों हैं?",
        text: "विश्व स्वास्थ्य संगठन (WHO) एशियाई आबादी के लिए 23.0 kg/m² को ओवरवेट सीमा मानता है क्योंकि कम वजन पर भी पेट के आंतरिक अंगों के आसपास वसा का जोखिम अधिक होता है।"
      },
      {
        title: "बीएमआई फॉर्मूला: मीट्रिक (kg/m²) बनाम इंपीरियल (lbs/in²)",
        text: "मीट्रिक पद्धति में: <code>BMI = वजन (kg) / [ऊंचाई (m)]²</code>। इंपीरियल पद्धति में: <code>BMI = [वजन (lb) / ऊंचाई (in)²] x 703</code>।"
      }
    ]
  },
  ko: {
    eyebrow: "임상 가이드",
    title: "체질량지수(BMI) 및 만성 질환 위험: 공식 가이드",
    sections: [
      {
        title: "BMI 및 암/대사 질환 위험: 임상 연구 결과",
        text: "미국암학회(ACS) 및 세계보건기구(WHO) 연구에 따르면 적정 BMI(18.5~22.9/24.9 kg/m²)를 유지하는 것은 대사 질환 및 각종 성인병 위험을 크게 낮춥니다."
      },
      {
        title: "'Real BMI'란 무엇이며 일반 체중계와 어떻게 다른가요?",
        text: "'Real BMI'는 단순 체중뿐만 아니라 기초대사량(BMR), 일일 총 에너지 소비량(TDEE), 허리둘레를 종합하여 체성분을 정확히 평가하는 지표입니다."
      }
    ]
  },
  es: {
    eyebrow: "Guía Clínica",
    title: "Índice de Masa Corporal (IMC) y Riesgos para la Salud",
    sections: [
      {
        title: "IMC y Riesgo para la Salud según la ACS y OMS",
        text: "Mantener un IMC saludable (entre 18.5 y 24.9 kg/m²) reduce significativamente los riesgos de enfermedades metabólicas y cardiovasculares."
      }
    ]
  },
  fr: {
    eyebrow: "Guide Clinique",
    title: "Indice de Masse Corporelle (IMC) et Risques pour la Santé",
    sections: [
      {
        title: "IMC et Risques pour la Santé (ACS et OMS)",
        text: "Maintenir un IMC sain (entre 18,5 et 24,9 kg/m²) réduit considérablement les risques de maladies métaboliques."
      }
    ]
  },
  de: {
    eyebrow: "Klinische Leitlinien",
    title: "Body-Mass-Index (BMI) & Gesundheitliche Risiken",
    sections: [
      {
        title: "BMI & Gesundheitsrisiken laut ACS & WHO",
        text: "Ein gesunder BMI (zwischen 18,5 und 24,9 kg/m²) senkt das langfristige Risiko für Stoffwechselerkrankungen erheblich."
      }
    ]
  }
};

const t = content[lang] || content.en;
---

<section class="my-14 p-8 sm:p-10 rounded-3xl border border-[var(--border)] bg-[var(--card)] shadow-[var(--shadow-card)] space-y-8">
  <div class="space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
      <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
      {t.eyebrow}
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
      {t.title}
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {t.sections.map((sec: any) => (
      <div class="space-y-2.5">
        <h3 class="text-lg sm:text-xl font-display font-bold uppercase text-[var(--foreground)] tracking-tight">
          {sec.title}
        </h3>
        <p class="text-sm text-[var(--muted-foreground)] font-medium leading-relaxed" set:html={sec.text}>
        </p>
      </div>
    ))}
  </div>
</section>
