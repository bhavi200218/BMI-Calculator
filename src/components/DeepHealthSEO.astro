  'bmi-calculator',
  '3d-bmi-calculator',
  'bmi-chart',
  '3d-body-visualizer',
  'asian-bmi-calculator',
  'healthy-weight-by-height'
];

const metabolicSlugs = [
  'bmr-calculator',
  'tdee-calculator',
  'maintenance-calorie-calculator',
  'calorie-calculator',
  'macro-calculator'
];

const fitnessSlugs = [
  'heart-rate-zone-calculator',
  'karvonen-heart-rate-calculator',
  '1rm-calculator',
  'one-rep-max-calculator'
];

const indianSlugs = [
  'bmi-calculator-for-indians',
  'bmi-calculator-india'
];

const category = slug 
  ? (indianSlugs.includes(slug) ? 'indian' : (fitnessSlugs.includes(slug) ? 'fitness' : (metabolicSlugs.includes(slug) ? 'metabolic' : (bmiSlugs.includes(slug) ? 'bmi' : null))))
