---

<div class="space-y-6">
  <!-- Official Email Action Box -->
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)]/80 p-6 sm:p-8 shadow-xs space-y-5">
    <div class="space-y-1.5">
      <p class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)]">
        {d.emailTitle}
      </p>
      <p class="text-xl sm:text-2xl font-mono font-bold text-[var(--foreground)] select-all break-all" id="officialEmailText">
        <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
      </p>
      <p class="text-xs text-[var(--muted-foreground)] font-medium pt-0.5">
        {d.responseTime}
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-1">
      <a 
        href="#officialEmailText"
        data-mailto-action
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[var(--accent)] text-white text-xs font-display font-bold uppercase tracking-wider hover:opacity-90 active:scale-[0.99] transition-all shadow-sm cursor-pointer min-h-[44px]"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        {d.openEmailApp}
      </a>

      <button 
        type="button"
        id="copyEmailBtn"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] text-[var(--foreground)] text-xs font-display font-bold uppercase tracking-wider transition-all cursor-pointer min-h-[44px]"
      >
        <svg class="w-4 h-4 text-[var(--muted-foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10a2 2 0 00-2 2v3a2 2 0 002 2h10a2 2 0 002-2v-3a2 2 0 00-2-2z" />
        </svg>
        <span id="copyEmailText">{d.copyEmail}</span>
      </button>
    </div>

    <div id="copyToast" class="hidden text-xs font-bold text-emerald-500 pt-0.5">
      {d.copiedToast}
    </div>
  </div>

  <!-- Categorized Inquiry Dispatch Grid -->
  <div class="space-y-4 pt-1">
    <div class="space-y-1">
      <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-[var(--accent)]">
        {d.departmentsTitle}
      </h3>
      <p class="text-xs text-[var(--muted-foreground)] font-medium leading-relaxed">
        {d.departmentsSubtext}
      </p>
    </div>

    <div class="grid gap-3.5 sm:grid-cols-2">
      {d.departments.map((dept) => (
        <a 
          href="#officialEmailText"
          data-mailto-dept={dept.subject}
          class="group block p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)] hover:bg-[var(--muted)]/40 transition-all space-y-1.5 shadow-xs cursor-pointer"
        >
          <div class="flex items-start justify-between gap-2">
            <h4 class="text-sm font-display font-bold text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors">
              {dept.title}
            </h4>
            <span class="text-xs font-mono text-[var(--accent)] opacity-0 group-hover:opacity-100 transition-opacity">
              &rarr;
            </span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
            {dept.desc}
          </p>
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var u = 'support';
    var d = 'realbmicalculator.com';
    var email = u + '@' + d;

    var copyBtn = document.getElementById('copyEmailBtn');
    var toast = document.getElementById('copyToast');

    if (copyBtn) {
      copyBtn.addEventListener('click', async function() {
        try {
          await navigator.clipboard.writeText(email);
          if (toast) {
            toast.classList.remove('hidden');
            setTimeout(function() {
              toast.classList.add('hidden');
            }, 3000);
          }
        } catch (err) {
          window.location.href = 'mailto:' + email;
        }
      });
    }

    var mailtoBtn = document.querySelector('[data-mailto-action]');
    if (mailtoBtn) {
      mailtoBtn.addEventListener('click', function(e) {
        e.preventDefault();
        window.location.href = 'mailto:' + email;
      });
    }

    var deptLinks = document.querySelectorAll('[data-mailto-dept]');
    deptLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var subj = link.getAttribute('data-mailto-dept');
        window.location.href = 'mailto:' + email + (subj ? '?subject=' + encodeURIComponent(subj) : '');
      });
    });
  })();
</script>
