---

<div class="space-y-8">
  <!-- Primary Verified Direct Email Card -->
  <div class="rounded-2xl border-2 border-[var(--accent)]/30 bg-[var(--card)] p-6 sm:p-8 shadow-md space-y-6 relative overflow-hidden">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        {d.badge}
      </div>
      <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {d.heading}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed max-w-2xl">
        {d.subtext}
      </p>
    </div>

    <!-- Official Email Action Box -->
    <div class="p-6 rounded-xl border border-[var(--border)] bg-[var(--muted)]/50 space-y-4">
      <div class="space-y-1">
        <p class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--muted-foreground)]">
          {d.emailTitle}
        </p>
        <p class="text-xl sm:text-2xl font-mono font-bold text-[var(--accent)] select-all break-all" id="officialEmailText">
          <span>support</span><span>&#64;</span><span>realbmicalculator.com</span>
        </p>
        <p class="text-xs text-[var(--muted-foreground)] font-medium pt-1">
          {d.responseTime}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a 
          href="#officialEmailText"
          data-mailto-action
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--accent)] text-white text-xs font-display font-bold uppercase tracking-wider hover:opacity-90 active:scale-[0.99] transition-all shadow-sm cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {d.openEmailApp}
        </a>

        <button 
          type="button"
          id="copyEmailBtn"
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] text-[var(--foreground)] text-xs font-display font-bold uppercase tracking-wider transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-[var(--muted-foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10a2 2 0 00-2 2v3a2 2 0 002 2h10a2 2 0 002-2v-3a2 2 0 00-2-2z" />
          </svg>
          <span id="copyEmailText">{d.copyEmail}</span>
        </button>
      </div>

      <div id="copyToast" class="hidden text-xs font-bold text-emerald-500 pt-1">
        {d.copiedToast}
      </div>
    </div>
  </div>

  <!-- Categorized Inquiry Dispatch Grid -->
  <div class="space-y-4">
    <div class="space-y-1">
      <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-[var(--accent)]">
        {d.departmentsTitle}
      </h3>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {d.departments.map((dept) => (
        <a 
          href="#officialEmailText"
          data-mailto-dept={dept.subject}
          class="group block p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)] hover:bg-[var(--muted)]/40 transition-all space-y-2 shadow-xs cursor-pointer"
        >
          <div class="flex items-start justify-between gap-2">
            <h4 class="text-sm font-display font-bold text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors">
              {dept.title}
            </h4>
            <span class="text-xs font-mono text-[var(--accent)] opacity-0 group-hover:opacity-100 transition-opacity">
              →
            </span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
            {dept.desc}
          </p>
        </a>
      ))}
    </div>
  </div>

  <!-- Mandatory AdSense UGC & Moderation Policy Card -->
  <div class="rounded-xl border border-blue-500/30 bg-blue-500/5 p-5 space-y-2">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-blue-500">
        {d.ugcPolicyTitle}
      </h3>
    </div>
    <p class="text-xs text-[var(--foreground)]/90 leading-relaxed font-medium">
      {d.ugcPolicyText}
    </p>
  </div>

  <!-- Privacy Notice Guarantee -->
  <div class="rounded-xl border border-[var(--border)] bg-[var(--muted)]/30 p-4">
    <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
      <strong class="text-[var(--foreground)]">{d.privacyTitle}</strong> {d.privacyText} <a href={`/${lang}/privacy-policy/`} class="text-[var(--accent)] underline hover:text-[var(--foreground)]">{d.privacyLinkText}</a>{d.privacySuffix}
    </p>
  </div>
</div>

<script is:inline>
  (function() {
    var u = 'support';
    var d = 'realbmicalculator.com';
    var email = u + '@' + d;

    var copyBtn = document.getElementById('copyEmailBtn');
    var toast = document.getElementById('copyToast');

    if (copyBtn) {
      copyBtn.addEventListener('click', async function() {
        try {
          await navigator.clipboard.writeText(email);
          if (toast) {
            toast.classList.remove('hidden');
            setTimeout(function() {
              toast.classList.add('hidden');
            }, 3000);
          }
        } catch (err) {
          window.location.href = 'mailto:' + email;
        }
      });
    }

    var mailtoBtn = document.querySelector('[data-mailto-action]');
    if (mailtoBtn) {
      mailtoBtn.addEventListener('click', function(e) {
        e.preventDefault();
        window.location.href = 'mailto:' + email;
      });
    }

    var deptLinks = document.querySelectorAll('[data-mailto-dept]');
    deptLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var subj = link.getAttribute('data-mailto-dept');
        window.location.href = 'mailto:' + email + (subj ? '?subject=' + encodeURIComponent(subj) : '');
      });
    });
  })();
</script>
