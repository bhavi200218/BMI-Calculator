const d = dicts[lang] || dicts.en;
---

<div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 shadow-xs space-y-6">
  <div class="space-y-2">
    <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
      {d.heading}
    </h2>
    <p class="text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
      {d.subtext}
    </p>
  </div>

  <form id="contactForm" action="/api/contact" method="POST" class="space-y-5" novalidate>
    <!-- Hidden locale field for backend routing if needed -->
    <input type="hidden" name="lang" value={lang} />

    <!-- Anti-spam Honeypot -->
    <div class="hidden" aria-hidden="true">
      <label for="contact-honey">Leave this field blank</label>
      <input type="text" id="contact-honey" name="_honey" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <!-- Name Field -->
      <div class="space-y-1.5">
        <label for="contact-name" class="block text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
          {d.nameLabel} <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input 
          type="text" 
          id="contact-name" 
          name="name" 
          required 
          minlength="2" 
          maxlength="100" 
          autocomplete="name"
          placeholder={d.namePlaceholder}
          class="w-full px-4 py-3 text-sm rounded-xl border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)]/60 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent)]/40 focus:border-[var(--accent)] transition-all"
          aria-required="true"
        />
        <p id="nameError" class="text-xs text-red-500 hidden font-medium"></p>
      </div>

      <!-- Email Field -->
      <div class="space-y-1.5">
        <label for="contact-email" class="block text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
          {d.emailLabel} <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input 
          type="email" 
          id="contact-email" 
          name="email" 
          required 
          maxlength="254" 
          autocomplete="email"
          placeholder={d.emailPlaceholder}
          class="w-full px-4 py-3 text-sm rounded-xl border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)]/60 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent)]/40 focus:border-[var(--accent)] transition-all"
          aria-required="true"
        />
        <p id="emailError" class="text-xs text-red-500 hidden font-medium"></p>
      </div>
    </div>

    <!-- Subject Field -->
    <div class="space-y-1.5">
      <label for="contact-subject" class="block text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
        {d.subjectLabel} <span class="text-xs font-normal text-[var(--muted-foreground)] lowercase">{d.subjectOptional}</span>
      </label>
      <select 
        id="contact-subject" 
        name="subject"
        class="w-full px-4 py-3 text-sm rounded-xl border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] focus:outline-hidden focus:ring-2 focus:ring-[var(--accent)]/40 focus:border-[var(--accent)] transition-all cursor-pointer"
      >
        {d.subjects.map((s, idx) => (
          <option value={s} selected={idx === 0}>{s}</option>
        ))}
      </select>
    </div>

    <!-- Message Field -->
    <div class="space-y-1.5">
      <label for="contact-message" class="block text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
        {d.messageLabel} <span class="text-red-500" aria-hidden="true">*</span>
      </label>
      <textarea 
        id="contact-message" 
        name="message" 
        required 
        minlength="10" 
        maxlength="3000" 
        rows="5"
        placeholder={d.messagePlaceholder}
        class="w-full px-4 py-3 text-sm rounded-xl border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)]/60 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent)]/40 focus:border-[var(--accent)] transition-all resize-y"
        aria-required="true"
      ></textarea>
      <div class="flex justify-between items-center text-xs text-[var(--muted-foreground)]">
        <p id="messageError" class="text-red-500 hidden font-medium"></p>
        <p id="charCount" class="ml-auto font-medium">{d.charCount}</p>
      </div>
    </div>

    <!-- Privacy Notice -->
    <div class="rounded-xl bg-[var(--muted)]/50 border border-[var(--border)]/70 p-4">
      <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
        <strong class="text-[var(--foreground)]">{d.privacyTitle}</strong> {d.privacyText} <a href={`/${lang}/privacy-policy/`} class="text-[var(--accent)] underline hover:text-[var(--foreground)]">{d.privacyLinkText}</a>{d.privacySuffix}
      </p>
    </div>

    <!-- Feedback Alert Box -->
    <div id="formFeedback" class="hidden p-4 rounded-xl text-sm font-medium leading-relaxed" role="alert"></div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-4 flex-wrap">
      <button 
        type="submit" 
        id="submitBtn"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-[var(--accent)] text-white text-xs font-display font-bold uppercase tracking-widest hover:opacity-95 active:scale-[0.99] transition-all cursor-pointer shadow-md disabled:opacity-50"
      >
        <span id="btnText">{d.submitBtn}</span>
        <svg id="btnSpinner" class="hidden w-4 h-4 animate-spin text-white" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>
      <span class="text-xs text-[var(--muted-foreground)] font-medium">
        {d.orReachUs} <a href="mailto:support@realbmicalculator.com" itemprop="email" class="text-[var(--accent)] underline font-bold">support@realbmicalculator.com</a>
      </span>
    </div>
  </form>
</div>

<!-- Script for Contact Form Handling -->
<script is:inline define:vars={{ 
  nameErrText: d.nameError, 
  emailErrText: d.emailError, 
  msgErrText: d.messageError, 
  sendingText: d.sendingText, 
  submitBtnText: d.submitBtn,
  successTitle: d.successHeading,
  successMsg: d.successBody,
  fallbackTitle: d.fallbackHeading,
  fallbackMsg: d.fallbackBody,
  fallbackNoticeText: d.fallbackNotice,
  fallbackBtnText: d.fallbackBtn
}}>
  (function() {
    const form = document.getElementById('contactForm');
    if (!form) return;

    const nameInput = document.getElementById('contact-name');
    const emailInput = document.getElementById('contact-email');
    const subjectInput = document.getElementById('contact-subject');
    const messageInput = document.getElementById('contact-message');
    const honeyInput = document.getElementById('contact-honey');

    const nameError = document.getElementById('nameError');
    const emailError = document.getElementById('emailError');
    const messageError = document.getElementById('messageError');
    const feedback = document.getElementById('formFeedback');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function resetErrors() {
      if (nameError) nameError.classList.add('hidden');
      if (emailError) emailError.classList.add('hidden');
      if (messageError) messageError.classList.add('hidden');
      if (nameInput) nameInput.classList.remove('border-red-500');
      if (emailInput) emailInput.classList.remove('border-red-500');
      if (messageInput) messageInput.classList.remove('border-red-500');
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      resetErrors();

      let hasError = false;
      const name = nameInput ? nameInput.value.trim() : '';
      const email = emailInput ? emailInput.value.trim() : '';
      const subject = subjectInput ? subjectInput.value.trim() : 'Inquiry';
      const message = messageInput ? messageInput.value.trim() : '';
      const honey = honeyInput ? honeyInput.value.trim() : '';

      if (name.length < 2) {
        if (nameError) {
          nameError.textContent = nameErrText;
          nameError.classList.remove('hidden');
        }
        if (nameInput) nameInput.classList.add('border-red-500');
        hasError = true;
      }

      if (!emailRegex.test(email)) {
        if (emailError) {
          emailError.textContent = emailErrText;
          emailError.classList.remove('hidden');
        }
        if (emailInput) emailInput.classList.add('border-red-500');
        hasError = true;
      }

      if (message.length < 10) {
        if (messageError) {
          messageError.textContent = msgErrText;
          messageError.classList.remove('hidden');
        }
        if (messageInput) messageInput.classList.add('border-red-500');
        hasError = true;
      }

      if (hasError) return;

      // UI Loading State
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = sendingText;
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (feedback) feedback.classList.add('hidden');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, subject, message, _honey: honey })
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          if (feedback) {
            feedback.className = 'p-4 rounded-xl text-sm font-medium leading-relaxed bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400';
            feedback.innerHTML = '<strong>' + successTitle + '</strong> ' + successMsg;
            feedback.classList.remove('hidden');
          }
          form.reset();
        } else if (data.requiresConfig || res.status === 503 || res.status === 200) {
          // Transparent fallback to prefilled direct mailto
          const mailtoUrl = 'mailto:support@realbmicalculator.com?subject=' + encodeURIComponent('[' + subject + '] ' + name) + '&body=' + encodeURIComponent('From: ' + name + ' <' + email + '>\n\n' + message);
          if (feedback) {
            feedback.className = 'p-5 rounded-xl text-sm font-medium leading-relaxed bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 space-y-3';
            feedback.innerHTML = '<div><strong>' + fallbackTitle + '</strong> ' + fallbackMsg + '</div>' +
              '<div class="pt-1"><a href="' + mailtoUrl + '" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--accent)] text-white text-xs font-display font-bold uppercase tracking-wider hover:opacity-90 transition-all shadow-xs">' + fallbackBtnText + '</a></div>';
            feedback.classList.remove('hidden');
          }
        } else {
          throw new Error(data.error || 'Server error');
        }
      } catch (err) {
        const mailtoUrl = 'mailto:support@realbmicalculator.com?subject=' + encodeURIComponent('[' + subject + '] ' + name) + '&body=' + encodeURIComponent('From: ' + name + ' <' + email + '>\n\n' + message);
        if (feedback) {
          feedback.className = 'p-5 rounded-xl text-sm font-medium leading-relaxed bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 space-y-3';
          feedback.innerHTML = '<div><strong>' + fallbackNoticeText + '</strong></div>' +
            '<div class="pt-1"><a href="' + mailtoUrl + '" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--accent)] text-white text-xs font-display font-bold uppercase tracking-wider hover:opacity-90 transition-all shadow-xs">' + fallbackBtnText + '</a></div>';
          feedback.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = submitBtnText;
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  })();
</script>
