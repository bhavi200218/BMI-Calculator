    ],
    cats: {
      underweight: "Bajo peso (< 18.5)",
      normal: "Peso saludable (18.5 – 24.9)",
      overweight: "Sobrepeso (25.0 – 29.9)",
      obese: "Obesidad (≥ 30.0)"
    }
  },
  fr: {
    badge: "Outil Instantané sur Navigateur",
    title: "Calculez Votre IMC Instantanément",
    subtitle: "Évaluation rapide et confidentielle de l'Indice de Masse Corporelle selon l'OMS et le CDC.",
    metricLabel: "Métrique (cm / kg)",
