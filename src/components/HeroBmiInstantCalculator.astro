    ],
    cats: {
      underweight: "Untergewicht (< 18,5)",
      normal: "Normalgewicht (18,5 – 24,9)",
      overweight: "Übergewicht (25,0 – 29,9)",
      obese: "Adipositas (≥ 30,0)"
