    title: "Calcula tu IMC al Instante",
    subtitle: "Cribado de Índice de Masa Corporal rápido y privado según las normas de la OMS y CDC.",
    metricLabel: "Métrico (cm / kg)",
    imperialLabel: "Imperial (pies / pulg / lbs)",
    heightLabel: "Altura",
    weightLabel: "Peso",
    calcBtn: "Calcular IMC",
    resultScoreLabel: "Tu Puntuación de IMC",
    resultCatLabel: "Categoría",
    healthyRangeLabel: "Rango de Peso Saludable",
    viewFullBtn: "Abrir Calculadora Completa y Visualizador 3D →",
    badges: [
      "100% Gratis e Instantáneo",
      "Privacidad Total (Sin Almacenamiento)",
      "Sin Registro Requerido",
