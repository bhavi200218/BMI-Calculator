---
import type { Locale } from '../utils/calculators';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

interface InstantBmiLocale {
  badge: string;
  title: string;
  subtitle: string;
  metricLabel: string;
  imperialLabel: string;
  heightLabel: string;
  weightLabel: string;
  calcBtn: string;
  resultScoreLabel: string;
  resultCatLabel: string;
  healthyRangeLabel: string;
  viewFullBtn: string;
  badges: string[];
  cats: {
    underweight: string;
    normal: string;
    overweight: string;
    obese: string;
  };
}

const content: Record<Locale, InstantBmiLocale> = {
  en: {
    badge: "Instant Browser Tool",
    title: "Calculate Your BMI Instantly",
    subtitle: "Fast, private Body Mass Index screening based on WHO & CDC public health standards.",
    metricLabel: "Metric (cm / kg)",
    imperialLabel: "Imperial (ft / in / lbs)",
    heightLabel: "Height",
    weightLabel: "Weight",
    calcBtn: "Calculate BMI",
    resultScoreLabel: "Your BMI Score",
    resultCatLabel: "Category",
    healthyRangeLabel: "Healthy Weight Window",
    viewFullBtn: "Open Full BMI Calculator & 3D Visualizer →",
    badges: [
      "100% Free & Instant",
      "Privacy First (Zero Data Retained)",
      "No Sign-up Required",
      "WHO & CDC Standards"
    ],
    cats: {
      underweight: "Underweight (< 18.5)",
      normal: "Healthy Weight (18.5 – 24.9)",
      overweight: "Overweight (25.0 – 29.9)",
      obese: "Obesity (≥ 30.0)"
    }
  },
  hi: {
    badge: "त्वरित ब्राउज़र टूल",
    title: "तुरंत अपना बीएमआई (BMI) निकालें",
    subtitle: "WHO एवं CDC सार्वजनिक स्वास्थ्य मानकों पर आधारित तीव्र और 100% निजी स्क्रीनिंग।",
    metricLabel: "मीट्रिक (सेमी / किग्रा)",
    imperialLabel: "इंपीरियल (फीट / इंच / पाउंड)",
    heightLabel: "ऊंचाई",
