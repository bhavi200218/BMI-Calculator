---
interface Props {
  lang?: 'en' | 'es' | 'fr' | 'de' | 'ko' | 'hi';
}

const { lang = 'en' } = Astro.props;

const titles = {
  en: "Embed Free Real BMI Calculator On Your Website",
  es: "Incrustar Calculadora Real de IMC Gratis en su Sitio Web",
  fr: "Intégrer le Calculateur IMC Réel Gratuit sur Votre Site Web",
  de: "Kostenlosen Realen BMI-Rechner auf Ihrer Website Einbinden",
  ko: "무료 리얼 BMI 계산기를 귀하의 웹사이트에 간편하게 추가하세요",
  hi: "अपनी वेबसाइट पर मुफ़्त Real BMI Calculator जोड़ें"
};

const subtitles = {
  en: "Add a free, responsive BMI calculator to your blog, WordPress site, or website with a simple HTML embed code. No API key required.",
  es: "Agregue una calculadora de IMC gratuita y adaptable a su blog, sitio de WordPress o sitio web con un simple código HTML. No requiere clave API.",
  fr: "Ajoutez un calculateur d'IMC gratuit et adaptatif à votre blog ou site Web avec un simple code HTML. Aucune clé API requise.",
  de: "Binden Sie einen kostenlosen, responsiven BMI-Rechner mit einfachem HTML-Code in Ihren Blog oder Ihre Website ein. Keine API-Schlüssel erforderlich.",
  ko: "간단한 HTML 코드로 블로그나 웹사이트에 무료 반응형 BMI 계산기를 추가하세요. API 키가 필요하지 않습니다.",
  hi: "एक सरल HTML कोड के साथ अपने ब्लॉग, वर्डप्रेस साइट या वेबसाइट पर एक मुफ़्त, उत्तरदायी BMI कैलकुलेटर जोड़ें। किसी API कुंजी की आवश्यकता नहीं है।"
};

const copyText = {
  en: "Copy HTML Code",
  es: "Copiar Código HTML",
  fr: "Copier le Code HTML",
  de: "HTML-Code Kopieren",
  ko: "HTML 코드 복사",
  hi: "HTML कोड कॉपी करें"
};

const copiedText = {
  en: "Copied to Clipboard!",
  es: "¡Copiado al Portapapeles!",
  fr: "Copié dans le Presse-papiers !",
  de: "In die Zwischenablage Kopiert!",
  ko: "클립보드에 복사되었습니다!",
  hi: "क्लिपबोर्ड में कॉपी हो गया!"
};

const embedCode = `<iframe src="https://realbmicalculator.com/embed/bmi-calculator/" title="Real BMI Calculator Widget" width="100%" height="560" frameborder="0" loading="lazy" style="border:none; border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,0.15);"></iframe>
<div style="font-size:12px; font-family:sans-serif; text-align:center; margin-top:8px; color:#888;">
  Powered by <a href="https://realbmicalculator.com/${lang}/" target="_blank" rel="nofollow noopener" style="color:#D33A18; font-weight:600; text-decoration:none;">Real BMI Calculator</a>
</div>`;
---

<section class="w-full my-6 p-5 sm:p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-[var(--shadow-soft)]">
  <div class="space-y-5">
    <!-- Header Row -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div class="space-y-1.5 max-w-2xl">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 text-[11px] font-display font-bold uppercase tracking-wider text-[var(--accent)]">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          {{ en: 'Free Webmaster & Blogger Tool', es: 'Herramienta para Webmasters y Bloggers', fr: 'Outil pour Webmasters & Blogueurs', de: 'Webmaster- & Blogger-Tool', ko: '무료 웹마스터 및 블로거 도구', hi: 'वेबमास्टर एवं ब्लॉगर टूल' }[lang] || 'Free Webmaster & Blogger Tool'}<span class="sr-only">. </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-display font-extrabold uppercase text-[var(--foreground)] tracking-tight">
          {titles[lang] || titles.en}<span class="sr-only">. </span>
        </h3>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {subtitles[lang] || subtitles.en}
        </p>
      </div>

      <!-- Quick Live Preview Button -->
      <a 
        href="/embed/bmi-calculator/" 
        target="_blank" 
        rel="noopener" 
        class="inline-flex items-center justify-center gap-1.5 min-h-[40px] px-4 py-2 rounded-xl bg-[var(--muted)]/50 hover:bg-[var(--muted)] border border-[var(--border)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all cursor-pointer whitespace-nowrap self-start md:self-center shrink-0"
      >
        <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        {{ en: 'Live Widget Preview', es: 'Vista Previa del Widget', fr: 'Aperçu du Widget', de: 'Live-Widget-Vorschau', ko: '라이브 위젯 미리보기', hi: 'लाइव विजेट पूर्वावलोकन' }[lang] || 'Live Widget Preview'}
        <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- Compact Modern Embed Code Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 p-2.5 sm:p-3 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)]">
      <div class="flex items-center gap-2 overflow-hidden px-2">
        <svg class="w-4 h-4 text-[var(--muted-foreground)] shrink-0 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <code class="text-xs font-mono text-[var(--muted-foreground)] break-all select-all font-medium py-1">
          &lt;iframe src="https://realbmicalculator.com/embed/bmi-calculator/" width="100%" height="560" frameborder="0" loading="lazy"&gt;&lt;/iframe&gt;
        </code>
      </div>

      <!-- Copy Action Button -->
      <button 
        type="button" 
        id="copy-embed-code-btn" 
        class="inline-flex items-center justify-center gap-2 min-h-[42px] px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:opacity-90 active:scale-95 text-xs font-display font-bold uppercase tracking-wider shadow-xs transition-all cursor-pointer shrink-0"
      >
        <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span id="copy-btn-label">{copyText[lang] || copyText.en}</span>
      </button>
    </div>

    <!-- Feature Checklist & Webmaster Benefits -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 pt-1 text-xs text-[var(--muted-foreground)] font-medium">
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>{{ en: 'Mobile Responsive', es: 'Adaptable a Móviles', fr: 'Adapté aux Mobiles', de: 'Mobil Optimiert', ko: '모바일 반응형', hi: 'मोबाइल रिस्पॉन्सिव' }[lang] || 'Mobile Responsive'}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>{{ en: 'No API Required', es: 'Sin Clave API', fr: 'Sans Clé API', de: 'Kein API-Schlüssel', ko: 'API 키 불필요', hi: 'कोई API आवश्यक नहीं' }[lang] || 'No API Required'}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>{{ en: 'Free Commercial Use', es: 'Uso Comercial Gratis', fr: 'Usage Commercial Gratuit', de: 'Freie Nutzung', ko: '무료 상업적 이용', hi: 'मुफ़्त व्यावसायिक उपयोग' }[lang] || 'Free Commercial Use'}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>{{ en: 'Updates Automatically', es: 'Actualizaciones Automáticas', fr: 'Mises à Jour Automatiques', de: 'Automatische Updates', ko: '자동 업데이트', hi: 'स्वचालित अपडेट' }[lang] || 'Updates Automatically'}</span>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ embedCode, copiedText: copiedText[lang] || copiedText.en, defaultText: copyText[lang] || copyText.en }}>
  (function() {
    const copyBtn = document.getElementById('copy-embed-code-btn');
    const label = document.getElementById('copy-btn-label');

    if (!copyBtn || !label) return;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(embedCode);
        label.textContent = copiedText;
        copyBtn.classList.add('bg-emerald-600');
        
        setTimeout(() => {
          label.textContent = defaultText;
          copyBtn.classList.remove('bg-emerald-600');
        }, 3000);
      } catch (err) {
        console.error('Failed to copy embed code: ', err);
      }
    });
  })();
</script>
