---
interface Props {
  lang?: 'en' | 'es' | 'fr' | 'de' | 'ko' | 'hi';
}

const { lang = 'en' } = Astro.props;

const titles = {
  en: "Embed Free Real BMI Calculator On Your Website",
  es: "Incrustar Calculadora Real de IMC Gratis en su Sitio Web",
  fr: "Intégrer le Calculateur IMC Réel Gratuit sur Votre Site Web",
  de: "Kostenlosen Realen BMI-Rechner auf Ihrer Website Einbinden",
  ko: "무료 리얼 BMI 계산기를 귀하의 웹사이트에 임베드하세요",
  hi: "अपनी वेबसाइट पर फ्री Real BMI Calculator एम्बेड करें"
};

const subtitles = {
  en: "Offer instant clinical-grade BMI analytics to your audience. Copy and paste the HTML snippet into your blog, WordPress, or site.",
  es: "Ofrezca análisis clínicos de IMC instantáneos a sus lectores. Copie y pegue el fragmento HTML en su blog o sitio web.",
  fr: "Offrez des analyses IMC de niveau clinique à vos lecteurs. Copiez et collez l'extrait HTML sur votre site.",
  de: "Bieten Sie Ihren Lesern sofortige klinische BMI-Analysen. Kopieren Sie den HTML-Snippet auf Ihre Website.",
  ko: "독자들에게 실시간 임상급 BMI 분석을 제공하세요. 아래 HTML 코드를 복사하여 웹사이트에 추가하세요.",
  hi: "अपने पाठकों को वास्तविक समय में BMI विश्लेषण प्रदान करने के लिए नीचे दिए गए HTML कोड को अपनी वेबसाइट पर लगाएं।"
};

const copyText = {
  en: "Copy HTML Code",
  es: "Copiar Código HTML",
  fr: "Copier le Code HTML",
  de: "HTML-Code Kopieren",
  ko: "HTML 코드 복사",
  hi: "HTML कोड कॉपी करें"
};

const copiedText = {
  en: "Copied to Clipboard!",
  es: "¡Copiado al Portapapeles!",
  fr: "Copié dans le Presse-papiers !",
  de: "In die Zwischenablage Kopiert!",
  ko: "클립보드에 복사되었습니다!",
  hi: "क्लिपबोर्ड में कॉपी हो गया!"
};

const embedCode = `<iframe src="https://realbmicalculator.com/embed/bmi-calculator" width="100%" height="560" frameborder="0" loading="lazy" style="border:none; border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,0.15);"></iframe>
<div style="font-size:12px; font-family:sans-serif; text-align:center; margin-top:8px; color:#888;">
  Powered by <a href="https://realbmicalculator.com" target="_blank" rel="noopener" style="color:#E8674A; font-weight:600; text-decoration:none;">Real BMI Calculator</a>
</div>`;
---

<section class="w-full max-w-5xl mx-auto my-12 p-6 sm:p-8 rounded-3xl bg-[var(--card)] border border-[var(--border)] shadow-xl relative overflow-hidden group">
  <!-- Glowing Background Accent -->
  <div class="absolute -top-24 -right-24 w-80 h-80 bg-[var(--accent)]/10 rounded-full blur-3xl pointer-events-none group-hover:bg-[var(--accent)]/15 transition-all duration-500"></div>
  <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="space-y-6 relative z-10">
    <!-- Header Row -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[var(--border)] pb-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          Free Webmaster & Blogger Tool
        </div>
        <h3 class="text-2xl sm:text-3xl font-display font-extrabold uppercase text-[var(--foreground)] tracking-tight">
          {titles[lang] || titles.en}
        </h3>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {subtitles[lang] || subtitles.en}
        </p>
      </div>

      <!-- Quick Live Preview Button -->
      <a 
        href="/embed/bmi-calculator" 
        target="_blank" 
        rel="noopener" 
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--muted)]/50 hover:bg-[var(--muted)] border border-[var(--border)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all cursor-pointer whitespace-nowrap self-start md:self-center shadow-xs"
      >
        <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        Live Widget Preview
        <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- IDE-Style Code Box -->
    <div class="rounded-2xl border border-slate-700/60 bg-[#0B1120] shadow-2xl overflow-hidden">
      <!-- IDE Header Bar -->
      <div class="flex items-center justify-between px-4 py-3 bg-[#1E293B]/80 border-b border-slate-700/60 flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          </div>
          <span class="text-xs font-mono font-medium text-slate-400 ml-2">embed-snippet.html</span>
        </div>

        <!-- Copy Code Action Button -->
        <button 
          type="button" 
          id="copy-embed-code-btn" 
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-lg bg-[var(--accent)] hover:opacity-90 active:scale-95 text-white text-xs font-display font-bold uppercase tracking-wider shadow-md transition-all cursor-pointer border border-transparent"
        >
          <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span id="copy-btn-label">{copyText[lang] || copyText.en}</span>
        </button>
      </div>

      <!-- Code Text Display with Syntax Highlights -->
      <div class="p-4 md:p-5 font-mono text-xs sm:text-sm text-slate-200 overflow-x-auto leading-relaxed select-all">
        <pre class="whitespace-pre-wrap break-all"><code><span class="text-sky-400">&lt;iframe</span> <span class="text-amber-300">src</span>=<span class="text-emerald-300">"https://realbmicalculator.com/embed/bmi-calculator"</span> <span class="text-amber-300">width</span>=<span class="text-emerald-300">"100%"</span> <span class="text-amber-300">height</span>=<span class="text-emerald-300">"560"</span> <span class="text-amber-300">frameborder</span>=<span class="text-emerald-300">"0"</span> <span class="text-amber-300">loading</span>=<span class="text-emerald-300">"lazy"</span> <span class="text-amber-300">style</span>=<span class="text-emerald-300">"border:none; border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,0.15);"</span><span class="text-sky-400">&gt;&lt;/iframe&gt;</span>
<span class="text-sky-400">&lt;div</span> <span class="text-amber-300">style</span>=<span class="text-emerald-300">"font-size:12px; font-family:sans-serif; text-align:center; margin-top:8px; color:#888;"</span><span class="text-sky-400">&gt;</span>
  Powered by <span class="text-sky-400">&lt;a</span> <span class="text-amber-300">href</span>=<span class="text-emerald-300">"https://realbmicalculator.com"</span> <span class="text-amber-300">target</span>=<span class="text-emerald-300">"_blank"</span> <span class="text-amber-300">rel</span>=<span class="text-emerald-300">"noopener"</span> <span class="text-amber-300">style</span>=<span class="text-emerald-300">"color:#E8674A; font-weight:600; text-decoration:none;"</span><span class="text-sky-400">&gt;</span>Real BMI Calculator<span class="text-sky-400">&lt;/a&gt;</span>
<span class="text-sky-400">&lt;/div&gt;</span></code></pre>
      </div>
    </div>

    <!-- Feature Checklist -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--muted-foreground)] pt-1 font-medium">
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <span class="flex items-center gap-1.5 text-emerald-500 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          100% Free Forever
        </span>
        <span class="flex items-center gap-1.5 text-emerald-500 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Fully Responsive
        </span>
        <span class="flex items-center gap-1.5 text-emerald-500 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Automatic Updates
        </span>
      </div>
      <span class="text-[var(--accent)] font-semibold uppercase tracking-wider text-[11px]">No API Keys Required</span>
    </div>
  </div>
</section>

<script is:inline define:vars={{ embedCode, copiedText: copiedText[lang] || copiedText.en, defaultText: copyText[lang] || copyText.en }}>
  (function() {
    const copyBtn = document.getElementById('copy-embed-code-btn');
    const label = document.getElementById('copy-btn-label');

    if (!copyBtn || !label) return;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(embedCode);
        label.textContent = copiedText;
        copyBtn.classList.add('bg-emerald-600');
        
        setTimeout(() => {
          label.textContent = defaultText;
          copyBtn.classList.remove('bg-emerald-600');
        }, 3000);
      } catch (err) {
        console.error('Failed to copy embed code: ', err);
      }
    });
  })();
</script>
