    { name: 'WHO Globales Gesundheitsobservatorium - BMI-Klassifizierung', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC Erwachsenen-BMI-Richtlinien und Häufige Fragen', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  ko: [
    { name: 'WHO 세계보건기구 성인 BMI 분류 기준', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC 성인 BMI 가이드라인 및 자주 묻는 질문', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  hi: [
    { name: 'डब्ल्यूएचओ (WHO) वैश्विक स्वास्थ्य ऑब्जर्वेटरी वयस्क बीएमआई वर्गीकरण', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'सीडीसी (CDC) वयस्क बीएमआई दिशानिर्देश एवं प्रश्नोत्तर', url: 'https://www.cdc.gov/bmi/faq/' }
  ]
};

const activeReferences = toolSpecificReferences[effectiveSlug] || (defaultReferencesByLang[lang] || defaultReferencesByLang.en);
const currentCalc = propCalc || calculators.find(c => c.slug === slug || c.slug === effectiveSlug);
const cleanToolName = currentCalc?.name[lang] || currentCalc?.name?.en || (currentData.title ? currentData.title.split('–')[0].split('—')[0].split('-')[0].trim() : 'Calculator');
const workedExample = getWorkedExample(effectiveSlug, lang, cleanToolName);
const variablesGuide = getInputVariablesGuide(currentCalc?.inputs || [], lang, effectiveSlug, cleanToolName);
const clinicalGuide = getToolInterpretationAndLimitations(effectiveSlug, lang);
const infographic = getToolInfographic(effectiveSlug, lang, cleanToolName);

const numSegments = infographic.segments.length;
const totalSvgWidth = 760;
const svgGap = 10;
const segWidth = (totalSvgWidth - (numSegments - 1) * svgGap) / numSegments;

const sectionHeading = {
  en: `${cleanToolName} Standards & Reference Ranges`,
  es: `Estándares y Rangos de Referencia para ${cleanToolName}`,
  fr: `Normes et Repères de Référence pour ${cleanToolName}`,
  de: `Standards & Referenzbereiche für ${cleanToolName}`,
  ko: `${cleanToolName} 공식 기준 및 참조 범위`,
  hi: `${cleanToolName} के लिए आधिकारिक मानक एवं संदर्भ सीमाएं`
}[lang] || `${cleanToolName} Standards & Reference Ranges`;

const referenceTableSubtitle = {
  en: `Official public health benchmarks, clinical calculation steps, and reference ranges for ${cleanToolName}.`,
  es: `Pautas oficiales de salud pública, pasos de cálculo clínico y rangos de referencia para ${cleanToolName}.`,
  fr: `Directives officielles de santé publique, étapes de calcul clinique et plages de référence pour ${cleanToolName}.`,
  de: `Offizielle Richtlinien der öffentlichen Gesundheit, klinische Berechnungsschritte und Referenzbereiche für ${cleanToolName}.`,
  ko: `${cleanToolName}에 대한 공식 공중보건 기준, 임상적 계산 절차 및 건강 참조 범위 요약.`,
  hi: `${cleanToolName} के लिए आधिकारिक सार्वजनिक स्वास्थ्य मानक, नैदानिक गणना चरण और स्वास्थ्य संदर्भ सीमाएं।`
}[lang] || `Official benchmarks and reference ranges for ${cleanToolName}.`;

const accordionTitles: Record<Locale, { formula: string; formulaSub: string; limitations: string; limitationsSub: string }> = {
  en: {
    formula: 'Formula Details, Input Variables & Measurement Units',
    formulaSub: 'How the math works, key inputs, and measurement units for this tool.',
    limitations: 'Clinical Limitations & Physiological Context',
    limitationsSub: 'Important body limits, special cases for athletes or seniors, and safety tips.'
  },
  es: {
    formula: 'Detalles de la Fórmula, Variables y Unidades de Medida',
    formulaSub: 'Ecuaciones de cálculo matemático, especificaciones de variables y unidades métricas e imperiales.',
    limitations: 'Limitaciones Clínicas y Contexto Fisiológico',
    limitationsSub: 'Restricciones fisiológicas clave, casos límite (atletas, adultos mayores) y guías de cribado.'
  },
  fr: {
    formula: 'Détails des Formules, Variables et Unités de Mesure',
    formulaSub: 'Équations mathématiques, spécifications des variables et unités métriques et impériales.',
    limitations: 'Limites Cliniques et Contexte Physiologique',
    limitationsSub: 'Contraintes physiologiques clés, cas particuliers (sportifs, personnes âgées) et repères de dépistage.'
  },
  de: {
    formula: 'Formeldetails, Eingabevariablen & Maßeinheiten',
    formulaSub: 'Mathematische Berechnungsgleichungen, Variablendefinitionen und metrische / imperiale Einheiten.',
    limitations: 'Klinische Grenzen & Physiologischer Kontext',
    limitationsSub: 'Wichtige physiologische Einschränkungen, Sonderfälle (Sportler, Senioren) und Screening-Leitlinien.'
  },
  ko: {
    formula: '계산 공식 세부사항, 입력 변수 및 측정 단위',
    formulaSub: '수학적 계산 공식, 변수 정의 및 미터법 / 야드파운드법 단위 사양입니다.',
    limitations: '임상적 한계점 및 생리학적 고려사항',
    limitationsSub: '주요 생리학적 한계, 특수 집단(운동선수, 노년층) 예외 사항 및 공중보건 선별 지침입니다.'
  },
  hi: {
    formula: 'सूत्र विवरण, इनपुट चर एवं माप इकाइयाँ',
    formulaSub: 'गणितीय गणना समीकरण, चर विनिर्देश और मीट्रिक / इंपीरियल रूपांतरण इकाइयाँ।',
    limitations: 'नैदानिक सीमाएं एवं शारीरिक संदर्भ',
    limitationsSub: 'प्रमुख शारीरिक सीमाएं, विशेष मामले (एथलीट, बुजुर्ग) और स्क्रीनिंग दिशानिर्देश।'
  }
};

const curAccordion = accordionTitles[lang] || accordionTitles.en;
---

<!-- Embed Tool-Specific FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="mt-8 space-y-8">
  
  <!-- Header -->
  <div class="space-y-3">
    <p class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)]">
      {currentData.eyebrow}<span class="sr-only">. </span>
    </p>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-[var(--foreground)] tracking-tight uppercase leading-tight">
      {sectionHeading}<span class="sr-only">. </span>
    </h2>
    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium pt-1">
      {referenceTableSubtitle}
    </p>
  </div>

  <!-- ═══════════════════ 1. IMMEDIATE VISIBLE FLOW: WHO REFERENCE TABLE ═══════════════════ -->
  {currentData.tableRows && (
    <div class="space-y-4">
      <h3 class="text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {currentData.tableTitle}<span class="sr-only">. </span>
      </h3>

      <!-- Responsive Semantic Reference Table (Single Accessible Source of Truth) -->
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-md overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm min-w-[30rem]">
          <thead>
            <tr class="bg-[var(--muted)]/50 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs font-bold">
              <th class="p-4">{ui.cat}<span class="sr-only">. </span></th>
              <th class="p-4">{ui.metric}<span class="sr-only">. </span></th>
              <th class="p-4">{ui.guidance}<span class="sr-only">. </span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]/60 text-[var(--muted-foreground)] font-medium">
            {(currentData.tableRows || []).map((row: { col1: string; col2: string; col3: string }) => (
              <tr class="hover:bg-[var(--muted)]/30 transition-colors">
                <td class="p-4 font-bold text-[var(--foreground)] sm:whitespace-nowrap">{row.col1}<span class="sr-only">. </span></td>
                <td class="p-4 font-mono sm:whitespace-nowrap text-[var(--accent)] font-semibold">{row.col2}<span class="sr-only">. </span></td>
                <td class="p-4 text-xs sm:text-sm">{row.col3}<span class="sr-only">. </span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- ═══════════════════ 2. VISUAL REFERENCE INFOGRAPHIC ═══════════════════ -->
