---

<!-- Embed Tool-Specific FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="mt-6 pt-6 border-t border-[var(--border)] space-y-8">
  
  <!-- Header -->
  <div class="space-y-3">
    <p class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)]">
      {currentData.eyebrow}
    </p>
    <h2 class="text-3xl md:text-4xl font-display font-bold text-[var(--foreground)] tracking-tight uppercase leading-tight">
      {currentData.title}
    </h2>
    <p class="text-base text-[var(--muted-foreground)] leading-relaxed max-w-3xl font-medium">
      {currentData.intro}
    </p>
  </div>

  <!-- Formula Box -->
  <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border border-[var(--border)] shadow-lg space-y-4">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <h3 class="text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {currentData.formulaTitle}
      </h3>
      {currentData.formulaCode && (
        <span class="px-3 py-1 rounded-md bg-[var(--accent)]/10 text-[var(--accent)] font-mono text-xs font-bold border border-[var(--accent)]/20">
          {currentData.formulaCode}
        </span>
      )}
    </div>
    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium">
      {currentData.formulaDesc}
    </p>
  </div>

  <!-- Reference Table (Responsive: Stacked Cards on Mobile, Table on Desktop) -->
  {currentData.tableRows && (
    <div class="space-y-4">
      <h3 class="text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {currentData.tableTitle}
      </h3>

      <!-- Mobile Stacked Card View (No Horizontal Scroll) -->
      <div class="grid gap-3.5 md:hidden">
        {currentData.tableRows.map(row => (
          <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2.5 shadow-xs">
            <div class="flex items-center justify-between gap-2 border-b border-[var(--border)]/60 pb-2">
              <span class="font-display font-bold text-sm text-[var(--foreground)]">{row.col1}</span>
              <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded-md bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
                {row.col2}
              </span>
            </div>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
              {row.col3}
            </p>
          </div>
        ))}
      </div>

      <!-- Desktop Table View -->
      <div class="hidden md:block rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-md overflow-hidden">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-[var(--muted)]/50 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs font-bold">
              <th class="p-4">{ui.cat}</th>
              <th class="p-4">{ui.metric}</th>
              <th class="p-4">{ui.guidance}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]/60 text-[var(--muted-foreground)] font-medium">
            {currentData.tableRows.map(row => (
              <tr class="hover:bg-[var(--muted)]/30 transition-colors">
                <td class="p-4 font-bold text-[var(--foreground)]">{row.col1}</td>
                <td class="p-4 font-mono">{row.col2}</td>
                <td class="p-4">{row.col3}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- FAQ Accordion List -->
  <div class="space-y-6 pt-4">
    <h3 class="text-2xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
      {ui.faq}
    </h3>
    <div class="grid gap-4">
      {currentData.faqs.map(faq => (
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2">
          <h4 class="text-base md:text-lg font-display font-bold text-[var(--foreground)]">
            {faq.question}
          </h4>
          <p class="text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Authority Medical Reference Badges & External Citations -->
  <div class="p-6 rounded-2xl bg-[var(--muted)]/40 border border-[var(--border)] space-y-3">
    <div class="text-xs font-display font-bold uppercase tracking-widest text-[var(--accent)]">{ui.refs}</div>
    <div class="flex flex-wrap gap-6 text-xs font-semibold text-[var(--muted-foreground)]">
      {activeReferences.map((ref) => (
        <a href={ref.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[var(--accent)] transition-colors underline decoration-[var(--accent)]/40 underline-offset-4">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          {ref.name}
        </a>
      ))}
    </div>
  </div>

</section>
