    overweight: isPregnancy ? '임신전 25–29.9 (과체중)' : is1RM ? '근비대 / 성장 (6-12회)' : '과체중 / 주의 요망',
    obese: isPregnancy ? '임신전 ≥30.0 (비만)' : is1RM ? '최대 근력 (1-5회)' : '비만 / 고위험군'
  }
};

const spectrumUi = rawSpectrumUi[lang] || rawSpectrumUi.en;

const accordionTitles: Record<Locale, { formula: string; formulaSub: string; limitations: string; limitationsSub: string }> = {
  en: {
    formula: 'Formula Details, Input Variables & Measurement Units',
    formulaSub: 'Mathematical calculation equations, variable specifications, and metric / imperial conversion units.',
    limitations: 'Clinical Limitations & Physiological Context',
    limitationsSub: 'Key physiological constraints, edge cases (athletes, elderly), and screening guidelines.'
  },
  es: {
    formula: 'Detalles de la Fórmula, Variables y Unidades de Medida',
    formulaSub: 'Ecuaciones de cálculo matemático, especificaciones de variables y unidades métricas e imperiales.',
    limitations: 'Limitaciones Clínicas y Contexto Fisiológico',
    limitationsSub: 'Restricciones fisiológicas clave, casos límite (atletas, adultos mayores) y guías de cribado.'
  },
  fr: {
    formula: 'Détails des Formules, Variables et Unités de Mesure',
    formulaSub: 'Équations mathématiques, spécifications des variables et unités métriques et impériales.',
    limitations: 'Limites Cliniques et Contexte Physiologique',
    limitationsSub: 'Contraintes physiologiques clés, cas particuliers (sportifs, personnes âgées) et repères de dépistage.'
  },
  de: {
    formula: 'Formeldetails, Eingabevariablen & Maßeinheiten',
    formulaSub: 'Mathematische Berechnungsgleichungen, Variablendefinitionen und metrische / imperiale Einheiten.',
    limitations: 'Klinische Grenzen & Physiologischer Kontext',
    limitationsSub: 'Wichtige physiologische Einschränkungen, Sonderfälle (Sportler, Senioren) und Screening-Leitlinien.'
  },
  ko: {
    formula: '계산 공식 세부사항, 입력 변수 및 측정 단위',
    formulaSub: '수학적 계산 공식, 변수 정의 및 미터법 / 야드파운드법 단위 사양입니다.',
    limitations: '임상적 한계점 및 생리학적 고려사항',
    limitationsSub: '주요 생리학적 한계, 특수 집단(운동선수, 노년층) 예외 사항 및 공중보건 선별 지침입니다.'
  },
  hi: {
    formula: 'सूत्र विवरण, इनपुट चर एवं माप इकाइयाँ',
    formulaSub: 'गणितीय गणना समीकरण, चर विनिर्देश और मीट्रिक / इंपीरियल रूपांतरण इकाइयाँ।',
    limitations: 'नैदानिक सीमाएं एवं शारीरिक संदर्भ',
    limitationsSub: 'प्रमुख शारीरिक सीमाएं, विशेष मामले (एथलीट, बुजुर्ग) और स्क्रीनिंग दिशानिर्देश।'
  }
};

const curAccordion = accordionTitles[lang] || accordionTitles.en;
---

<!-- Embed Tool-Specific FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="mt-6 pt-6 border-t border-[var(--border)] space-y-8">
  
  <!-- Header -->
  <div class="space-y-3">
    <p class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)]">
      {currentData.eyebrow}
    </p>
    <h2 class="text-3xl md:text-4xl font-display font-bold text-[var(--foreground)] tracking-tight uppercase leading-tight">
      {currentData.title}
    </h2>
    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-medium pt-1">
      {referenceTableSubtitle}
    </p>
  </div>

  <!-- ═══════════════════ 1. IMMEDIATE VISIBLE FLOW: WHO REFERENCE TABLE ═══════════════════ -->
  {currentData.tableRows && (
    <div class="space-y-4">
      <h3 class="text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {currentData.tableTitle}
      </h3>

      <!-- Responsive Semantic Reference Table (Single Accessible Source of Truth) -->
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-md overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm min-w-[500px]">
          <thead>
            <tr class="bg-[var(--muted)]/50 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs font-bold">
              <th class="p-4">{ui.cat}</th>
              <th class="p-4">{ui.metric}</th>
              <th class="p-4">{ui.guidance}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]/60 text-[var(--muted-foreground)] font-medium">
            {(currentData.tableRows || []).map((row: { col1: string; col2: string; col3: string }) => (
              <tr class="hover:bg-[var(--muted)]/30 transition-colors">
                <td class="p-4 font-bold text-[var(--foreground)] whitespace-nowrap">{row.col1}</td>
                <td class="p-4 font-mono whitespace-nowrap text-[var(--accent)] font-semibold">{row.col2}</td>
                <td class="p-4 text-xs sm:text-sm">{row.col3}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- ═══════════════════ 2. VISUAL REFERENCE INFOGRAPHIC ═══════════════════ -->
  <figure role="group" aria-labelledby={`fig-caption-${effectiveSlug}`} class="p-6 md:p-8 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-md space-y-4">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div class="space-y-1">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
          {spectrumUi.badge}
        </span>
        <h4 class="text-base sm:text-lg font-display font-bold text-[var(--foreground)] uppercase">
          {currentData.title} — {spectrumUi.titleSuffix}
        </h4>
      </div>
      <span class="text-xs text-[var(--muted-foreground)] font-mono">
        {spectrumUi.source}
      </span>
    </div>

    <!-- Scalable Visual Spectrum Diagram -->
    <div class="w-full bg-[var(--muted)]/50 rounded-xl p-4 border border-[var(--border)] overflow-x-auto">
      <svg class="w-full min-w-[500px] h-auto max-h-36 text-[var(--foreground)]" viewBox="0 0 800 110" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`Infographic illustrating ${currentData.title}`}>
        <title>{currentData.title} — {spectrumUi.titleSuffix}</title>
        <desc>{spectrumUi.desc}</desc>
        <!-- Bar Segments -->
        <rect x="20" y="20" width="180" height="38" rx="6" fill="#38bdf8" fill-opacity="0.25" stroke="#38bdf8" stroke-width="2"/>
        <text x="110" y="44" text-anchor="middle" fill="#38bdf8" font-size="12" font-weight="700" font-family="sans-serif">{spectrumUi.underweight}</text>
        <text x="110" y="78" text-anchor="middle" fill="#8FA7A7" font-size="11" font-family="sans-serif">{spectrumRanges.range1}</text>

        <rect x="210" y="20" width="180" height="38" rx="6" fill="#34d399" fill-opacity="0.25" stroke="#34d399" stroke-width="2"/>
        <text x="300" y="44" text-anchor="middle" fill="#34d399" font-size="12" font-weight="700" font-family="sans-serif">{spectrumUi.normal}</text>
        <text x="300" y="78" text-anchor="middle" fill="#8FA7A7" font-size="11" font-family="sans-serif">{spectrumRanges.range2}</text>

        <rect x="400" y="20" width="180" height="38" rx="6" fill="#fbbf24" fill-opacity="0.25" stroke="#fbbf24" stroke-width="2"/>
        <text x="490" y="44" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="700" font-family="sans-serif">{spectrumUi.overweight}</text>
        <text x="490" y="78" text-anchor="middle" fill="#8FA7A7" font-size="11" font-family="sans-serif">{spectrumRanges.range3}</text>

        <rect x="590" y="20" width="190" height="38" rx="6" fill="#f87171" fill-opacity="0.25" stroke="#f87171" stroke-width="2"/>
        <text x="685" y="44" text-anchor="middle" fill="#f87171" font-size="12" font-weight="700" font-family="sans-serif">{spectrumUi.obese}</text>
        <text x="685" y="78" text-anchor="middle" fill="#8FA7A7" font-size="11" font-family="sans-serif">{spectrumRanges.range4}</text>
      </svg>
    </div>

    <!-- Official Accessible Figcaption & Image Credit Signal -->
    <figcaption id={`fig-caption-${effectiveSlug}`} class="text-xs text-[var(--muted-foreground)] leading-relaxed text-center pt-2">
      {figCaptionText}
    </figcaption>
  </figure>

  <!-- ═══════════════════ 3. STEP-BY-STEP WORKED EXAMPLE (HIGH CLARITY & VISIBLE) ═══════════════════ -->
  <div class="p-6 md:p-8 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-md space-y-5">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
        {workedExample.eyebrow}
      </div>
      <h3 class="text-xl md:text-2xl font-display font-bold text-[var(--foreground)] uppercase tracking-tight">
        {workedExample.title}
      </h3>
      {workedExample.subtitle && (
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium pt-0.5 leading-relaxed">
          {workedExample.subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
      <!-- Inputs & Derivation Steps -->
      <div class="space-y-3.5">
        <div class="p-3.5 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)]/70 space-y-2">
          <h4 class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
            {workedExample.inputHeading}
          </h4>
          <div class="flex flex-wrap gap-2">
            {workedExample.inputs.map((inp) => (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--card)] border border-[var(--border)] text-xs font-medium text-[var(--foreground)]">
                <span class="text-[var(--muted-foreground)]">{inp.label}:</span>
                <strong class="font-mono text-[var(--accent)]">{inp.value}</strong>
              </span>
            ))}
          </div>
        </div>

        <div class="space-y-2">
          <h4 class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
            {workedExample.stepsHeading}
          </h4>
          <ol class="space-y-1.5 text-xs text-[var(--muted-foreground)] font-medium">
            {workedExample.steps.map((st, sIdx) => (
              <li class="flex items-start gap-2 p-2 rounded-lg bg-[var(--muted)]/20 border border-[var(--border)]/50">
                <span class="flex items-center justify-center w-4 h-4 rounded-full bg-[var(--accent)]/15 text-[var(--accent)] text-[10px] font-bold font-mono shrink-0 mt-0.5">
                  {sIdx + 1}
                </span>
                <span class="leading-relaxed">{st}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <!-- Result Output & Interpretation Context -->
      <div class="space-y-3.5">
        <div class="p-4 rounded-xl bg-gradient-to-br from-[var(--accent)]/10 via-[var(--accent)]/5 to-transparent border border-[var(--accent)]/30 space-y-1.5">
          <p class="text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)]">
            {workedExample.resultHeading}
          </p>
          <div class="text-lg md:text-xl font-display font-bold text-[var(--foreground)]">
            {workedExample.result.value}
          </div>
        </div>

        <div class="space-y-1.5">
          <h4 class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
            {workedExample.interpretationHeading}
          </h4>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
            {workedExample.interpretation}
          </p>
        </div>
      </div>
    </div>

    <div class="pt-2 border-t border-[var(--border)]/70 flex items-center gap-2 text-xs text-[var(--muted-foreground)] font-medium">
      <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span>{workedExample.disclaimer}</span>
    </div>
  </div>

  <!-- ═══════════════════ 4. COLLAPSIBLE ACCORDION: FORMULA DETAILS, INPUT VARIABLES & MEASUREMENT UNITS ═══════════════════ -->
  <details class="group rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-sm transition-all overflow-hidden">
    <summary class="p-6 md:p-7 flex items-center justify-between cursor-pointer list-none select-none hover:bg-[var(--muted)]/20 transition-colors">
      <div class="flex items-center gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center font-bold text-base shrink-0">
          📐
        </div>
        <div class="space-y-0.5 text-left">
          <h3 class="text-base sm:text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)] group-open:text-[var(--accent)] transition-colors">
            {curAccordion.formula}
          </h3>
          <p class="text-xs text-[var(--muted-foreground)] font-medium leading-relaxed">
            {curAccordion.formulaSub}
          </p>
        </div>
      </div>
      <div class="w-8 h-8 rounded-full bg-[var(--muted)]/60 flex items-center justify-center text-[var(--muted-foreground)] group-open:rotate-180 transition-transform shrink-0 ml-3">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </div>
    </summary>

    <div class="p-6 md:p-8 pt-2 border-t border-[var(--border)] space-y-6">
      <!-- Formula Box -->
      <div class="p-5 md:p-6 rounded-xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border border-[var(--border)] shadow-sm space-y-3">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h4 class="text-lg font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
            {currentData.formulaTitle}
          </h4>
          {currentData.formulaCode && (
            <span class="px-3 py-1 rounded-md bg-[var(--accent)]/10 text-[var(--accent)] font-mono text-xs font-bold border border-[var(--accent)]/20">
              {currentData.formulaCode}
            </span>
          )}
        </div>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-sans font-medium">
          {currentData.formulaDesc}
        </p>
      </div>

      <!-- Input Variables & Measurement Units Guide -->
      {variablesGuide.items.length > 0 && (
        <div class="p-5 md:p-6 rounded-xl bg-[var(--card)] border border-[var(--border)] shadow-sm space-y-4">
          <div class="space-y-1">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              {variablesGuide.title}
            </div>
            <p class="text-xs text-[var(--muted-foreground)] font-medium">
              {variablesGuide.subtitle}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {variablesGuide.items.map((item) => (
              <div class="p-3.5 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)]/70 flex flex-col justify-between space-y-2.5">
                <div class="space-y-1">
                  <h5 class="text-xs font-display font-bold text-[var(--foreground)] tracking-tight">
                    {item.name}
                  </h5>
                  <p class="text-[11px] text-[var(--muted-foreground)] leading-relaxed font-medium">
                    {item.description}
                  </p>
                </div>
                <div class="pt-2 border-t border-[var(--border)]/50 flex items-center justify-between gap-2 text-[11px] font-mono">
                  <span class="text-[var(--accent)] font-semibold">
                    <span class="text-[var(--muted-foreground)] font-sans">{variablesGuide.metricLabel}:</span> {item.metricUnit}
                  </span>
                  <span class="text-[var(--muted-foreground)]">|</span>
                  <span class="text-[var(--foreground)] font-semibold">
                    <span class="text-[var(--muted-foreground)] font-sans">{variablesGuide.imperialLabel}:</span> {item.imperialUnit}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </details>

  <!-- ═══════════════════ 5. COLLAPSIBLE ACCORDION: CLINICAL LIMITATIONS & PHYSIOLOGICAL CONTEXT ═══════════════════ -->
  <details class="group rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-sm transition-all overflow-hidden">
    <summary class="p-6 md:p-7 flex items-center justify-between cursor-pointer list-none select-none hover:bg-[var(--muted)]/20 transition-colors">
      <div class="flex items-center gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center font-bold text-base shrink-0">
          🔬
        </div>
        <div class="space-y-0.5 text-left">
          <h3 class="text-base sm:text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)] group-open:text-[var(--accent)] transition-colors">
            {curAccordion.limitations}
          </h3>
          <p class="text-xs text-[var(--muted-foreground)] font-medium leading-relaxed">
            {curAccordion.limitationsSub}
          </p>
        </div>
      </div>
      <div class="w-8 h-8 rounded-full bg-[var(--muted)]/60 flex items-center justify-center text-[var(--muted-foreground)] group-open:rotate-180 transition-transform shrink-0 ml-3">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </div>
    </summary>

    <div class="p-6 md:p-8 pt-2 border-t border-[var(--border)] space-y-6">
      <div class="p-5 md:p-6 rounded-xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border border-[var(--border)] shadow-sm space-y-5">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
            {clinicalGuide.sectionTitle}
          </div>
          <p class="text-xs text-[var(--muted-foreground)] font-medium">
            {clinicalGuide.sectionSubtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Interpretation Panel -->
          <div class="p-4 rounded-xl bg-[var(--card)] border border-[var(--border)] space-y-2">
            <h4 class="text-sm font-display font-bold text-[var(--foreground)] uppercase tracking-wide flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {clinicalGuide.interpretationTitle}
            </h4>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
              {clinicalGuide.interpretationText}
            </p>
          </div>

          <!-- Limitations Panel -->
          <div class="p-4 rounded-xl bg-[var(--card)] border border-[var(--border)] space-y-2">
            <h4 class="text-sm font-display font-bold text-[var(--foreground)] uppercase tracking-wide flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              {clinicalGuide.limitationsTitle}
            </h4>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
              {clinicalGuide.limitationsText}
            </p>
          </div>
        </div>

        <!-- Consultation Notice -->
        <div class="p-3.5 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)]/70 flex items-start gap-2.5">
          <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div class="space-y-0.5 text-xs text-[var(--muted-foreground)] font-medium">
            <strong class="text-[var(--foreground)]">{clinicalGuide.medicalNoticeTitle}:</strong> {clinicalGuide.medicalNoticeText}
          </div>
        </div>
      </div>
    </div>
  </details>

  <!-- ═══════════════════ 6. FAQ SECTION (HIGH VISIBILITY & INTENT) ═══════════════════ -->
  <div class="space-y-6 pt-4">
    <div class="space-y-1">
      <h3 class="text-2xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {ui.faq}
      </h3>
      {ui.faqSubtitle && (
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium pt-0.5 leading-relaxed">
          {ui.faqSubtitle}
        </p>
      )}
    </div>
    <div class="grid gap-3.5">
      {(currentData.faqs || []).map((faq: { question: string; answer: string }) => {
        const parsed = formatFaqAnswer(faq.answer);
        const fl = faqLabels[lang] || faqLabels.en;
        return (
          <div class="p-5 md:p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3 shadow-xs">
            <h4 class="text-sm md:text-base font-display font-bold text-[var(--foreground)]">
              {faq.question}
            </h4>
            {parsed.detailed ? (
              <div class="space-y-2.5 pt-0.5">
                <div class="p-3.5 rounded-xl bg-[var(--accent)]/5 border-l-[3px] border-[var(--accent)] text-xs sm:text-sm font-semibold text-[var(--foreground)]">
                  <span class="text-[var(--accent)] uppercase tracking-wider text-[10px] font-bold block mb-1 font-display">
                    {fl.short}
                  </span>
                  {parsed.short}
                </div>
                <div class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium space-y-1">
                  <span class="text-[var(--foreground)] uppercase tracking-wider text-[10px] font-bold block opacity-75 font-display">
                    {fl.detailed}
                  </span>
                  <p>{parsed.detailed}</p>
                </div>
              </div>
            ) : (
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                {faq.answer}
              </p>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <!-- Authority Medical Reference Badges & External Citations -->
  <div class="p-5 md:p-6 rounded-2xl bg-[var(--muted)]/40 border border-[var(--border)] space-y-3">
    <div class="text-xs font-display font-bold uppercase tracking-widest text-[var(--accent)]">{ui.refs}</div>
    <div class="flex flex-wrap gap-4 sm:gap-6 text-xs font-semibold text-[var(--muted-foreground)]">
      {activeReferences.map((ref) => (
        <a href={ref.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[var(--accent)] transition-colors underline decoration-[var(--accent)]/40 underline-offset-4">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          {ref.name}
        </a>
      ))}
    </div>
  </div>

  <!-- ═══════════════════ 7. EDITORIAL ATTR & TRANSPARENCY CARD ═══════════════════ -->
  <div class="p-5 md:p-6 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center text-white font-display font-bold text-xs shadow-xs">
