            </h4>
            {parsed.detailed ? (
              <div class="space-y-2.5 pt-0.5">
                <div class="p-3.5 rounded-xl bg-[var(--accent)]/5 border-l-[3px] border-[var(--accent)] text-xs sm:text-sm font-semibold text-[var(--foreground)]">
                  <span class="text-[var(--accent)] uppercase tracking-wider text-[10px] font-bold block mb-1 font-display">
                    {fl.short}
                  </span>
                  {parsed.short}
                </div>
                <div class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium space-y-1">
                  <span class="text-[var(--foreground)] uppercase tracking-wider text-[10px] font-bold block opacity-75 font-display">
                    {fl.detailed}
                  </span>
                  <p>{parsed.detailed}</p>
                </div>
              </div>
            ) : (
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                {faq.answer}
              </p>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <!-- Authority Medical Reference Badges & External Citations -->
  <div class="p-5 md:p-6 rounded-2xl bg-[var(--muted)]/40 border border-[var(--border)] space-y-3">
