  ? {
      range1: '< 7 Points',
      range2: '7 – 11 Points',
      range3: '12 – 14 Points',
      range4: '≥ 15 Points',
    }
  : {
      range1: '< 18.5',
      range2: '18.5 – 24.9',
      range3: '25.0 – 29.9',
      range4: '≥ 30.0',
    };

