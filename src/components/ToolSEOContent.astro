---
import { calculators, type CalculatorConfig, type Locale } from '../utils/calculators';
import { seoDatabase, tableUi, type ToolContent } from '../data/seoDatabase';
import { getWorkedExample } from '../utils/workedExamples';
import { getInputVariablesGuide, getToolInterpretationAndLimitations } from '../utils/calculatorGuides';

interface Props {
  slug: string;
  lang: Locale;
  calculator?: CalculatorConfig;
}

const { slug, lang = 'en', calculator: propCalc } = Astro.props;

const ui = tableUi[lang] || tableUi.en;

function formatFaqAnswer(text: string): { short: string; detailed: string } {
  if (!text) return { short: '', detailed: '' };
  const clean = text.trim();
  const match = clean.match(/^((?:(?:Yes|No|Oui|Non|Ja|Nein|네|아니오|हाँ|नहीं)[.!?।]s+)?.*?(?:[.!?।](?!d)))s+([sS]+)$/);
  if (match) {
    return {
      short: match[1].trim(),
      detailed: match[2].trim()
    };
  }
  return {
    short: clean,
    detailed: ''
  };
}

const faqLabels: Record<string, { short: string; detailed: string }> = {
  en: { short: 'Short Answer:', detailed: 'Detailed Explanation:' },
  es: { short: 'Respuesta Breve:', detailed: 'Explicación Detallada:' },
  fr: { short: 'En Bref :', detailed: 'Explication Détaillée :' },
  de: { short: 'Kurzantwort:', detailed: 'Ausführliche Erklärung:' },
  ko: { short: '핵심 답변:', detailed: '상세 설명:' },
  hi: { short: 'संक्षिप्त उत्तर:', detailed: 'विस्तृत व्याख्या:' },
};


const effectiveSlug = (slug === 'new-bmi-calculator') ? '3d-bmi-calculator' : slug;
const enData = seoDatabase[effectiveSlug]?.['en'] || seoDatabase['bmi-calculator']['en'];
const langFallback = seoDatabase[effectiveSlug]?.[lang] || seoDatabase['bmi-calculator']?.[lang] || enData;
const rawData = seoDatabase[effectiveSlug]?.[lang] || langFallback;

// Deduplicate FAQs by question text
const rawFaqs = (rawData.faqs && rawData.faqs.length > 0) ? rawData.faqs : langFallback.faqs;
const uniqueFaqMap = new Map<string, { question: string; answer: string }>();
(rawFaqs || []).forEach((faq: { question: string; answer: string }) => {
  if (faq && faq.question && !uniqueFaqMap.has(faq.question.trim())) {
    uniqueFaqMap.set(faq.question.trim(), faq);
  }
});
const uniqueFaqs = Array.from(uniqueFaqMap.values());

const currentData: ToolContent = {
  ...langFallback,
  ...rawData,
  tableRows: (rawData.tableRows && rawData.tableRows.length > 0) ? rawData.tableRows : langFallback.tableRows,
  faqs: uniqueFaqs
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": uniqueFaqs.map((faq: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

