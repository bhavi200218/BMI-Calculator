---
import { calculators, type CalculatorConfig, type Locale } from '../utils/calculators';
import { seoDatabase, tableUi, type ToolContent } from '../data/seoDatabase';
import { getWorkedExample } from '../utils/workedExamples';
import { getInputVariablesGuide, getToolInterpretationAndLimitations } from '../utils/calculatorGuides';

interface Props {
  slug: string;
  lang: Locale;
  calculator?: CalculatorConfig;
}

const { slug, lang = 'en', calculator: propCalc } = Astro.props;

const ui = tableUi[lang] || tableUi.en;

const effectiveSlug = (slug === '3d-body-visualizer' || slug === 'new-bmi-calculator') ? '3d-bmi-calculator' : slug;
const enData = seoDatabase[effectiveSlug]?.['en'] || seoDatabase['bmi-calculator']['en'];
const langFallback = seoDatabase[effectiveSlug]?.[lang] || seoDatabase['bmi-calculator']?.[lang] || enData;
const rawData = seoDatabase[effectiveSlug]?.[lang] || langFallback;

// Deduplicate FAQs by question text
const rawFaqs = (rawData.faqs && rawData.faqs.length > 0) ? rawData.faqs : langFallback.faqs;
const uniqueFaqMap = new Map<string, { question: string; answer: string }>();
(rawFaqs || []).forEach((faq: { question: string; answer: string }) => {
  if (faq && faq.question && !uniqueFaqMap.has(faq.question.trim())) {
    uniqueFaqMap.set(faq.question.trim(), faq);
  }
});
const uniqueFaqs = Array.from(uniqueFaqMap.values());

const currentData: ToolContent = {
  ...langFallback,
  ...rawData,
  tableRows: (rawData.tableRows && rawData.tableRows.length > 0) ? rawData.tableRows : langFallback.tableRows,
  faqs: uniqueFaqs
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": uniqueFaqs.map((faq: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const toolSpecificReferences: Record<string, { name: string; url: string }[]> = {
  'bmr-calculator': [
    { name: 'Mifflin MD, St Jeor GE, et al. Predictive BMR Equation Study (AJCN)', url: 'https://pubmed.ncbi.nlm.nih.gov/2305711/' },
    { name: 'NIH PMC Research: Evaluation of Predictive Energy Equations', url: 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4564867/' }
  ],
  'tdee-calculator': [
    { name: 'FAO/WHO/UNU Human Energy Requirements Guidelines', url: 'https://www.fao.org/3/y5686e/y5686e00.htm' },
    { name: 'NIH National Library of Medicine: Energy Balance & Activity Multipliers', url: 'https://www.ncbi.nlm.nih.gov/books/NBK218769/' }
  ],
  'maintenance-calorie-calculator': [
    { name: 'FAO/WHO/UNU Human Energy Requirements Guidelines', url: 'https://www.fao.org/3/y5686e/y5686e00.htm' },
    { name: 'NIH National Library of Medicine: Energy Balance & Activity Multipliers', url: 'https://www.ncbi.nlm.nih.gov/books/NBK218769/' }
  ],
  'calorie-calculator': [
    { name: 'NIH / NIDDK (National Institute of Diabetes and Digestive and Kidney Diseases) Body Weight Planner', url: 'https://www.niddk.nih.gov/bwp' },
    { name: 'CDC Healthy Weight & Energy Balance Reference', url: 'https://www.cdc.gov/healthyweight/losing_weight/index.html' }
  ],
  'ideal-weight-calculator': [
    { name: 'Devine BJ. Ideal Body Weight Equations (Drug Intell Clin Pharm 1974)', url: 'https://pubmed.ncbi.nlm.nih.gov/4819440/' },
    { name: 'NIH PMC Evaluation of Historical Ideal Body Weight Formulas', url: 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4891157/' }
  ],
  'lean-body-mass-calculator': [
    { name: 'Boer P. Estimated Lean Body Mass Index Study (1984)', url: 'https://pubmed.ncbi.nlm.nih.gov/6497914/' },
    { name: 'NIH PMC Research: Anthropometric Equations for Body Composition', url: 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7355018/' }
  ],
  'macro-calculator': [
    { name: 'USDA Dietary Guidelines for Americans (Acceptable Macronutrient Distribution Ranges)', url: 'https://www.dietaryguidelines.gov/' },
    { name: 'ISSN Position Stand: Diets and Body Composition', url: 'https://jissn.biomedcentral.com/articles/10.1186/s12970-017-0174-y' }
  ],
  'waist-to-hip-ratio-calculator': [
    { name: 'WHO Waist Circumference and Waist-to-Hip Ratio Report (2011)', url: 'https://www.who.int/publications/i/item/9789241501491' },
    { name: 'NIH PMC Anthropometric Proxy Measures for Abdominal Adiposity', url: 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4926839/' }
  ],
  'protein-intake-calculator': [
    { name: 'ISSN Position Stand: Protein and Exercise', url: 'https://jissn.biomedcentral.com/articles/10.1186/s12970-017-0177-8' },
    { name: 'NIH Dietary Reference Intakes for Protein', url: 'https://www.ncbi.nlm.nih.gov/books/NBK56068/' }
  ],
  'pregnancy-weight-gain-calculator': [
    { name: 'ACOG Gestational Weight Gain FAQ & Guidelines', url: 'https://www.acog.org/womens-health/faqs/weight-gain-during-pregnancy' },
    { name: 'Institute of Medicine (IOM) Pregnancy Weight Guidelines', url: 'https://www.ncbi.nlm.nih.gov/books/NBK32813/' }
  ],
  'heart-rate-zone-calculator': [
    { name: 'American Heart Association (AHA) Target Heart Rates', url: 'https://www.heart.org/en/healthy-living/fitness/fitness-basics/target-heart-rates' },
    { name: 'Karvonen Heart Rate Reserve Study Reference', url: 'https://pubmed.ncbi.nlm.nih.gov/13443783/' }
  ],
  'body-fat-calculator': [
    { name: 'US Navy Physical Readiness Program Body Composition Method', url: 'https://www.navyfitness.org/nutrition/body-composition' },
    { name: 'ACE Body Fat Norms & Classification Standards', url: 'https://www.acefitness.org/resources/everyone/blog/112/percent-body-fat-norms-for-men-and-women/' }
  ],
  'bmi-calculator-for-indians': [
    { name: 'WHO Expert Consultation: Appropriate body-mass index for Asian populations and its implications for policy and intervention strategies (Lancet 2004)', url: 'https://pubmed.ncbi.nlm.nih.gov/14726171/' },
    { name: 'Consensus Guidelines for Asian Indians: Misra A, et al. Obesity, Metabolic Syndrome and BMI Cutoffs (JAPI 2009 / ICMR)', url: 'https://pubmed.ncbi.nlm.nih.gov/19702022/' }
  ],
  'bmi-calculator-india': [
    { name: 'WHO Expert Consultation: Appropriate body-mass index for Asian populations and its implications for policy and intervention strategies (Lancet 2004)', url: 'https://pubmed.ncbi.nlm.nih.gov/14726171/' },
    { name: 'Consensus Guidelines for Asian Indians: Misra A, et al. Obesity, Metabolic Syndrome and BMI Cutoffs (JAPI 2009 / ICMR)', url: 'https://pubmed.ncbi.nlm.nih.gov/19702022/' }
  ],
  'asian-bmi-calculator': [
    { name: 'WHO Expert Consultation: Appropriate body-mass index for Asian populations (Lancet 2004)', url: 'https://pubmed.ncbi.nlm.nih.gov/14726171/' },
    { name: 'WHO Western Pacific Region: The Asia-Pacific Perspective: Redefining Obesity and its Treatment', url: 'https://iris.who.int/handle/10665/206936' }
  ]
};

const defaultReferencesByLang: Record<Locale, { name: string; url: string }[]> = {
  en: [
    { name: 'WHO Global Health Observatory Adult BMI Classification', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC Adult BMI Guidelines, Screening Limits & Formula FAQ', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  es: [
    { name: 'OMS Observatorio Mundial de la Salud - Clasificación del IMC', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC Pautas de IMC para Adultos y Preguntas Frecuentes', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  fr: [
    { name: 'OMS Observatoire Mondial de la Santé - Classification de l\'IMC', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC Directives d\'IMC pour Adultes et Foire Aux Questions', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  de: [
    { name: 'WHO Globales Gesundheitsobservatorium - BMI-Klassifizierung', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC Erwachsenen-BMI-Richtlinien und Häufige Fragen', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  ko: [
    { name: 'WHO 세계보건기구 성인 BMI 분류 기준', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'CDC 성인 BMI 가이드라인 및 자주 묻는 질문', url: 'https://www.cdc.gov/bmi/faq/' }
  ],
  hi: [
    { name: 'डब्ल्यूएचओ (WHO) वैश्विक स्वास्थ्य ऑब्जर्वेटरी वयस्क बीएमआई वर्गीकरण', url: 'https://www.who.int/data/gho/data/themes/topics/indicator-groups/GHO/bmi-among-adults' },
    { name: 'सीडीसी (CDC) वयस्क बीएमआई दिशानिर्देश एवं प्रश्नोत्तर', url: 'https://www.cdc.gov/bmi/faq/' }
  ]
};

const activeReferences = toolSpecificReferences[effectiveSlug] || (defaultReferencesByLang[lang] || defaultReferencesByLang.en);
const workedExample = getWorkedExample(effectiveSlug, lang);
const currentCalc = propCalc || calculators.find(c => c.slug === slug || c.slug === effectiveSlug);
const variablesGuide = getInputVariablesGuide(currentCalc?.inputs || [], lang);
const clinicalGuide = getToolInterpretationAndLimitations(effectiveSlug, lang);
---

<!-- Embed Tool-Specific FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="mt-6 pt-6 border-t border-[var(--border)] space-y-8">
  
  <!-- Header -->
  <div class="space-y-3">
    <p class="text-xs font-display font-bold uppercase tracking-[0.25em] text-[var(--accent)]">
      {currentData.eyebrow}
    </p>
    <h2 class="text-3xl md:text-4xl font-display font-bold text-[var(--foreground)] tracking-tight uppercase leading-tight">
      {currentData.title}
    </h2>
  </div>

  <!-- Formula Box -->
  <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border border-[var(--border)] shadow-lg space-y-4">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <h3 class="text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {currentData.formulaTitle}
      </h3>
      {currentData.formulaCode && (
        <span class="px-3 py-1 rounded-md bg-[var(--accent)]/10 text-[var(--accent)] font-mono text-xs font-bold border border-[var(--accent)]/20">
          {currentData.formulaCode}
        </span>
      )}
    </div>
    <p class="text-sm md:text-base text-[var(--muted-foreground)] leading-relaxed font-sans font-medium">
      {currentData.formulaDesc}
    </p>
  </div>

  <!-- Input Variables & Measurement Units Guide -->
  {variablesGuide.items.length > 0 && (
    <div class="p-6 md:p-8 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-md space-y-5">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
          {variablesGuide.title}
        </div>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium">
          {variablesGuide.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {variablesGuide.items.map((item) => (
          <div class="p-4 rounded-xl bg-[var(--muted)]/30 border border-[var(--border)]/70 flex flex-col justify-between space-y-3">
            <div class="space-y-1.5">
              <h4 class="text-sm font-display font-bold text-[var(--foreground)] tracking-tight">
                {item.name}
              </h4>
              <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium">
                {item.description}
              </p>
            </div>
            <div class="pt-2 border-t border-[var(--border)]/50 flex items-center justify-between gap-2 text-[11px] font-mono">
              <span class="text-[var(--accent)] font-semibold">
                <span class="text-[var(--muted-foreground)] font-sans">{variablesGuide.metricLabel}:</span> {item.metricUnit}
              </span>
              <span class="text-[var(--muted-foreground)]">|</span>
              <span class="text-[var(--foreground)] font-semibold">
                <span class="text-[var(--muted-foreground)] font-sans">{variablesGuide.imperialLabel}:</span> {item.imperialUnit}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Transparent Worked Example & Clinical/Educational Interpretation Guide -->
  <div class="p-6 md:p-8 rounded-2xl bg-[var(--card)] border border-[var(--border)] shadow-md space-y-6">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
        {workedExample.eyebrow}
      </div>
      <h3 class="text-xl md:text-2xl font-display font-bold text-[var(--foreground)] uppercase tracking-tight">
        {workedExample.title}
      </h3>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <!-- Left Column: Inputs & Derivation Steps -->
      <div class="space-y-4">
        <div class="p-4 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)]/70 space-y-2">
          <h4 class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
            {workedExample.inputHeading}
          </h4>
          <div class="flex flex-wrap gap-2">
            {workedExample.inputs.map((inp) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-[var(--card)] border border-[var(--border)] text-xs font-medium text-[var(--foreground)]">
                <span class="text-[var(--muted-foreground)]">{inp.label}:</span>
                <strong class="font-mono text-[var(--accent)]">{inp.value}</strong>
              </span>
            ))}
          </div>
        </div>

        <div class="space-y-2">
          <h4 class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
            {workedExample.stepsHeading}
          </h4>
          <ol class="space-y-2 text-xs sm:text-sm text-[var(--muted-foreground)] font-medium">
            {workedExample.steps.map((st, sIdx) => (
              <li class="flex items-start gap-2.5 p-2.5 rounded-lg bg-[var(--muted)]/20 border border-[var(--border)]/50">
                <span class="flex items-center justify-center w-5 h-5 rounded-full bg-[var(--accent)]/15 text-[var(--accent)] text-[10px] font-bold font-mono shrink-0 mt-0.5">
                  {sIdx + 1}
                </span>
                <span class="leading-relaxed">{st}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <!-- Right Column: Result Output & Clinical Context -->
      <div class="space-y-4">
        <div class="p-5 rounded-xl bg-gradient-to-br from-[var(--accent)]/10 via-[var(--accent)]/5 to-transparent border border-[var(--accent)]/30 space-y-2">
          <p class="text-[11px] font-display font-bold uppercase tracking-wider text-[var(--accent)]">
            {workedExample.resultHeading}
          </p>
          <div class="text-lg sm:text-xl font-display font-bold text-[var(--foreground)]">
            {workedExample.result.value}
          </div>
        </div>

        <div class="space-y-2">
          <h4 class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
            {workedExample.interpretationHeading}
          </h4>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
            {workedExample.interpretation}
          </p>
        </div>
      </div>
    </div>

    <!-- Educational Transparency Notice -->
    <div class="pt-3 border-t border-[var(--border)]/70 flex items-center gap-2 text-[11px] sm:text-xs text-[var(--muted-foreground)] font-medium">
      <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span>{workedExample.disclaimer}</span>
    </div>
  </div>

  <!-- Reference Table (Responsive: Stacked Cards on Mobile, Table on Desktop) -->
  {currentData.tableRows && (
    <div class="space-y-4">
      <h3 class="text-xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
        {currentData.tableTitle}
      </h3>

      <!-- Responsive Semantic Reference Table (Single Accessible Source of Truth) -->
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-md overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm min-w-[500px]">
          <thead>
            <tr class="bg-[var(--muted)]/50 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs font-bold">
              <th class="p-4">{ui.cat}</th>
              <th class="p-4">{ui.metric}</th>
              <th class="p-4">{ui.guidance}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]/60 text-[var(--muted-foreground)] font-medium">
            {(currentData.tableRows || []).map((row: { col1: string; col2: string; col3: string }) => (
              <tr class="hover:bg-[var(--muted)]/30 transition-colors">
                <td class="p-4 font-bold text-[var(--foreground)] whitespace-nowrap">{row.col1}</td>
                <td class="p-4 font-mono whitespace-nowrap text-[var(--accent)] font-semibold">{row.col2}</td>
                <td class="p-4 text-xs sm:text-sm">{row.col3}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Result Interpretation & Clinical Limitations Guide -->
  <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-br from-[var(--card)] to-[var(--background)] border border-[var(--border)] shadow-md space-y-6">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
        {clinicalGuide.sectionTitle}
      </div>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium">
        {clinicalGuide.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Interpretation Panel -->
      <div class="p-5 rounded-xl bg-[var(--card)] border border-[var(--border)] space-y-2.5">
        <h4 class="text-sm sm:text-base font-display font-bold text-[var(--foreground)] uppercase tracking-wide flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {clinicalGuide.interpretationTitle}
        </h4>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {clinicalGuide.interpretationText}
        </p>
      </div>

      <!-- Limitations Panel -->
      <div class="p-5 rounded-xl bg-[var(--card)] border border-[var(--border)] space-y-2.5">
        <h4 class="text-sm sm:text-base font-display font-bold text-[var(--foreground)] uppercase tracking-wide flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          {clinicalGuide.limitationsTitle}
        </h4>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {clinicalGuide.limitationsText}
        </p>
      </div>
    </div>

    <!-- Educational Consultation Banner -->
    <div class="p-4 rounded-xl bg-[var(--muted)]/40 border border-[var(--border)]/70 flex items-start gap-3">
      <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div class="space-y-0.5 text-xs text-[var(--muted-foreground)] font-medium">
        <strong class="text-[var(--foreground)]">{clinicalGuide.medicalNoticeTitle}:</strong> {clinicalGuide.medicalNoticeText}
      </div>
    </div>
  </div>

  <!-- FAQ Accordion List -->
  <div class="space-y-6 pt-4">
    <h3 class="text-2xl font-display font-bold text-[var(--foreground)] uppercase tracking-wide">
      {ui.faq}
    </h3>
    <div class="grid gap-4">
      {(currentData.faqs || []).map((faq: { question: string; answer: string }) => (
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2">
          <h4 class="text-base md:text-lg font-display font-bold text-[var(--foreground)]">
            {faq.question}
          </h4>
          <p class="text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Authority Medical Reference Badges & External Citations -->
  <div class="p-6 rounded-2xl bg-[var(--muted)]/40 border border-[var(--border)] space-y-3">
    <div class="text-xs font-display font-bold uppercase tracking-widest text-[var(--accent)]">{ui.refs}</div>
    <div class="flex flex-wrap gap-6 text-xs font-semibold text-[var(--muted-foreground)]">
      {activeReferences.map((ref) => (
        <a href={ref.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[var(--accent)] transition-colors underline decoration-[var(--accent)]/40 underline-offset-4">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          {ref.name}
        </a>
      ))}
    </div>
