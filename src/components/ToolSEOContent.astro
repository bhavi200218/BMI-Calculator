           lang === 'ko' ? '도구 설계 및 수학적 모델링' :
           lang === 'hi' ? 'उपकरण डिज़ाइन और गणितीय मॉडलिंग' :
           'Tool Design & Mathematical Modeling'}
        </p>
        <p class="text-xs sm:text-sm font-bold text-[var(--foreground)]">
          {lang === 'es' ? 'Equipo Editorial de Real BMI' :
           lang === 'fr' ? 'Équipe Éditoriale Real BMI' :
           lang === 'de' ? 'Real BMI Redaktionsteam' :
           lang === 'ko' ? 'Real BMI 편집팀' :
           lang === 'hi' ? 'Real BMI संपादकीय टीम' :
           'Real BMI Editorial Team'} 
          <span class="text-xs font-normal text-[var(--muted-foreground)]">
            {lang === 'es' ? '• Estándares de Investigación y Algoritmos' :
             lang === 'fr' ? '• Normes de Recherche et Algorithmes' :
             lang === 'de' ? '• Forschungs- & Algorithmische Standards' :
             lang === 'ko' ? '• 연구 및 알고리즘 표준 관리' :
             lang === 'hi' ? '• शोध एवं एल्गोरिदम मानक' :
             '• Research & Algorithmic Standards'}
          </span>
        </p>
      </div>
    </div>
    <div class="text-xs text-[var(--muted-foreground)] sm:text-right space-y-1">
      <p class="text-[11px] sm:text-xs">
        {lang === 'es' ? 'Fórmulas alineadas con estándares de la OMS, CDC e ICMR' :
         lang === 'fr' ? 'Formules alignées sur les publications OMS, CDC et ICMR' :
         lang === 'de' ? 'Formeln abgestimmt auf Standards von WHO, CDC & ICMR' :
         lang === 'ko' ? 'WHO, CDC 및 ICMR 지침에 맞춘 공식 적용' :
         lang === 'hi' ? 'WHO, CDC और ICMR साहित्य के अनुरूप गणितीय सूत्र' :
         'Formulas aligned with published WHO, CDC & ICMR benchmarks'}
      </p>
      <div class="flex flex-wrap sm:justify-end gap-3 font-semibold text-[var(--accent)] text-xs">
        <a href={`/${lang}/about/`} class="underline hover:text-[var(--foreground)]">
          {lang === 'es' ? 'Sobre el Equipo' :
           lang === 'fr' ? 'À Propos de l\'Équipe' :
           lang === 'de' ? 'Über das Team' :
           lang === 'ko' ? '팀 소개' :
           lang === 'hi' ? 'टीम परिचय' :
           'About Team'}
        </a>
        <a href={`/${lang}/editorial-policy/`} class="underline hover:text-[var(--foreground)]">
          {lang === 'es' ? 'Política Editorial' :
           lang === 'fr' ? 'Politique Éditoriale' :
           lang === 'de' ? 'Redaktionsrichtlinie' :
