const isAsianBmi = effectiveSlug === 'asian-bmi-calculator';
const isPregnancy = effectiveSlug === 'pregnancy-weight-gain-calculator';
const is1RM = effectiveSlug === '1rm-calculator' || effectiveSlug === 'one-rep-max-calculator';
const isCardio = effectiveSlug === 'heart-rate-zone-calculator' || effectiveSlug === 'karvonen-heart-rate-calculator';
const isBodyFat = effectiveSlug === 'body-fat-calculator' || effectiveSlug === 'lean-body-mass-calculator';
const isProtein = effectiveSlug === 'protein-intake-calculator';
const isWater = effectiveSlug === 'water-intake-calculator';
const isWHR = effectiveSlug === 'waist-to-hip-ratio-calculator';
