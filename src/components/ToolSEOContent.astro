  ? {
      range1: '0.8 g/kg',
      range2: '1.2 – 1.6 g/kg',
      range3: '1.6 – 2.0 g/kg',
      range4: '2.0 – 2.4 g/kg',
    }
  : isWater
  ? {
      range1: '2.0 – 2.5 L / day',
      range2: '2.5 – 3.2 L / day',
      range3: '3.2 – 4.0 L / day',
      range4: '> 4.0 L / day',
    }
  : isWHR
  ? {
      range1: '< 0.85 M / < 0.75 F',
      range2: '0.85–0.90 M / 0.75–0.80 F',
      range3: '0.90–0.95 M / 0.80–0.85 F',
      range4: '≥ 0.95 M / ≥ 0.85 F',
    }
  : isMetabolic
  ? {
      range1: '-500 kcal / day',
      range2: '-250 kcal / day',
      range3: '0 kcal (TDEE)',
      range4: '+300 to +500 kcal',
    }
