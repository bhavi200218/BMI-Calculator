    { name: 'ACSM Guidelines for Exercise Testing and Prescription', url: 'https://www.acsm.org/education-resources/books/guidelines-exercise-testing-prescription' }
  ],
  '1rm-calculator': [
    { name: 'ACSM Position Stand: Progression Models in Resistance Training for Healthy Adults', url: 'https://pubmed.ncbi.nlm.nih.gov/19204579/' },
    { name: 'LeSuer DA, et al. Accuracy of Prediction Equations for Estimating 1-RM Performance (J Strength Cond Res)', url: 'https://pubmed.ncbi.nlm.nih.gov/9565931/' },
    { name: 'Epley B. Poundage Chart. Boyd Epley Workout', url: 'https://pubmed.ncbi.nlm.nih.gov/9565931/' },
    { name: 'Brzycki M. Strength Testing—Predicting a One-Rep Max (JOHPERD)', url: 'https://www.tandfonline.com/doi/abs/10.1080/07303084.1993.10606684' }
  ],
  'body-fat-calculator': [
    { name: 'Hodgdon JA, Beckett MB. Prediction of percent body fat for U.S. Navy men and women from body circumferences (Naval Health Res Ctr 1984)', url: 'https://apps.dtic.mil/sti/citations/ADA143896' },
    { name: 'Siri WE. Body composition from fluid spaces and density (Tech Rep Donner Lab Univ Calif 1961)', url: 'https://pubmed.ncbi.nlm.nih.gov/' },
    { name: 'US Navy Physical Readiness Program Body Composition Method', url: 'https://www.navyfitness.org/fitness/500-physical-readiness/physical-readiness-test' },
    { name: 'ACE Body Fat Norms & Classification Standards', url: 'https://www.acefitness.org/resources/everyone/blog/percent-body-fat-norms-for-men-and-women/' }
  ],
  'body-surface-area-calculator': [
    { name: 'Mosteller RD. Simplified Calculation of Body-Surface Area (N Engl J Med 1987)', url: 'https://pubmed.ncbi.nlm.nih.gov/3657876/' },
