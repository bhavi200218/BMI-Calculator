---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const labels: Record<string, any> = {
  en: {
    badge: "Silo Architecture",
    title: "Calculator Directory & Navigation Hierarchy",
    subtitle: "Explore our organized hubs for BMI standards, regional benchmarks, body visualizers, and energy calculators.",
    bmiHub: "BMI Calculator Hub",
    otherHub: "Other Calculators Hub",
    india: "BMI Calculator India",
    asian: "Asian BMI Calculator",
    threeD: "3D BMI Calculator",
    chart: "BMI Chart",
    healthyWeight: "Healthy Weight Chart",
    men: "BMI for Men",
    women: "BMI for Women",
    age: "BMI by Age (Adults)",
    bmrSiloTitle: "BMR Sub-Silo",
    tdeeSiloTitle: "TDEE Sub-Silo",
    bodyCompSiloTitle: "Body Composition Sub-Silo",
    bmrList: [
      { name: "Mifflin St Jeor Formula", url: "/en/mifflin-st-jeor-calculator/" },
      { name: "BMR vs TDEE Comparison", url: "/en/bmr-vs-tdee/" },
      { name: "BMR Calculator by Age", url: "/en/bmr-calculator-by-age/" }
    ],
    tdeeList: [
      { name: "Maintenance Calories", url: "/en/maintenance-calorie-calculator/" },
      { name: "TDEE Calculator", url: "/en/tdee-calculator/" },
      { name: "TDEE vs BMR Guide", url: "/en/tdee-vs-bmr/" }
    ],
    bodyCompList: [
      { name: "Body Fat Calculator", url: "/en/body-fat-calculator/" },
      { name: "Lean Body Mass (LBM)", url: "/en/lean-body-mass-calculator/" },
      { name: "Waist-to-Hip Ratio (WHR)", url: "/en/waist-to-hip-ratio-calculator/" }
    ]
  },
  hi: {
    badge: "वेबसाइट संरचना",
    title: "कैलकुलेटर निर्देशिका एवं नेविगेशन संरचना",
    subtitle: "बीएमआई मानकों, क्षेत्रीय कटऑफ, 3डी विजुअलाइज़र और ऊर्जा कैलकुलेटर के लिए हमारे व्यवस्थित हब का अन्वेषण करें।",
    bmiHub: "बीएमआई कैलकुलेटर हब",
    otherHub: "अन्य कैलकुलेटर हब",
    india: "बीएमआई कैलकुलेटर इंडिया",
    asian: "एशियन बीएमआई कैलकुलेटर",
    threeD: "3D बीएमआई विजुअलाइजर",
    chart: "बीएमआई चार्ट",
    healthyWeight: "ऊंचाई अनुसार वजन चार्ट",
    men: "पुरुषों के लिए बीएमआई",
    women: "महिलाओं के लिए बीएमआई",
    age: "आयु अनुसार बीएमआई (वयस्क)",
    bmrSiloTitle: "बीएमआर (BMR) सब-साइलो",
    tdeeSiloTitle: "टीडीईई (TDEE) सब-साइलो",
    bodyCompSiloTitle: "बॉडी कम्पोजिशन सब-साइलो",
    bmrList: [
      { name: "मिफ्लिन-सेंट जिओर फॉर्मूला", url: "/hi/mifflin-st-jeor-calculator/" },
      { name: "बीएमआर बनाम टीडीईई तुलना", url: "/hi/bmr-vs-tdee/" },
      { name: "आयु अनुसार बीएमआर", url: "/hi/bmr-calculator-by-age/" }
    ],
    tdeeList: [
      { name: "मेंटेनेंस कैलोरी", url: "/hi/maintenance-calorie-calculator/" },
      { name: "टीडीईई कैलकुलेटर", url: "/hi/tdee-calculator/" },
      { name: "टीडीईई बनाम बीएमआर गाइड", url: "/hi/tdee-vs-bmr/" }
    ],
    bodyCompList: [
      { name: "बॉडी फैट कैलकुलेटर", url: "/hi/body-fat-calculator/" },
      { name: "लीन बॉडी मास (LBM)", url: "/hi/lean-body-mass-calculator/" },
      { name: "कमर-कूल्हे का अनुपात (WHR)", url: "/hi/waist-to-hip-ratio-calculator/" }
    ]
  }
};

const t = labels[lang] || labels.en;
---

<section class="py-12 px-4 sm:px-6 my-8 rounded-3xl border border-[var(--border)] bg-[var(--card)]/40 backdrop-blur-xl shadow-[var(--shadow-soft)]">
  <div class="max-w-6xl mx-auto space-y-8">

    <!-- Section Header -->
    <div class="text-center space-y-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--accent)]/30 bg-[var(--accent)]/10 text-[11px] font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">
        {t.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {t.title}
      </h2>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] max-w-2xl mx-auto font-medium">
        {t.subtitle}
      </p>
    </div>

    <!-- Tree Architecture Container -->
    <div class="space-y-8 pt-4">

      <!-- Root Node -->
      <div class="flex justify-center">
        <a href={`/${lang}/`} class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl border-2 border-[var(--accent)] bg-[var(--card)] text-sm font-display font-bold uppercase tracking-wider text-[var(--foreground)] shadow-md hover:scale-105 transition-transform">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span>
          realbmicalculator.com
        </a>
      </div>

      <!-- Main Branches Grid -->
      <div class="grid md:grid-cols-2 gap-8 relative">

        <!-- Branch 1: BMI Calculator Hub -->
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-5 shadow-xs">
          <div class="flex items-center gap-2 pb-3 border-b border-[var(--border)]">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <h3 class="font-display font-bold text-base uppercase tracking-tight text-[var(--foreground)]">
              {t.bmiHub}
            </h3>
          </div>

          <!-- Sub-branches: India, Asian, 3D BMI -->
          <div class="grid sm:grid-cols-3 gap-2.5">
            <a href={`/${lang}/bmi-calculator-india/`} class="p-2.5 text-center rounded-xl border border-[var(--border)] bg-[var(--muted)]/50 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors text-xs font-display font-bold uppercase text-[var(--foreground)]">
              🇮🇳 {t.india}
            </a>
            <a href={`/${lang}/asian-bmi-calculator/`} class="p-2.5 text-center rounded-xl border border-[var(--border)] bg-[var(--muted)]/50 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors text-xs font-display font-bold uppercase text-[var(--foreground)]">
              🌏 {t.asian}
            </a>
            <a href={`/${lang}/3d-bmi-calculator/`} class="p-2.5 text-center rounded-xl border border-[var(--border)] bg-[var(--muted)]/50 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors text-xs font-display font-bold uppercase text-[var(--foreground)]">
              🧊 {t.threeD}
            </a>
          </div>

          <!-- Children Sub-nodes -->
          <div class="pt-2">
            <div class="text-[10px] font-display font-bold uppercase tracking-[0.18em] text-[var(--accent)] mb-2.5">
              Specific BMI Tools & References
            </div>
            <div class="grid sm:grid-cols-2 gap-2">
              <a href={`/${lang}/bmi-chart/`} class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-xs text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors">
                <span class="text-[var(--accent)]">↳</span> {t.chart}
              </a>
              <a href={`/${lang}/healthy-weight-by-height/`} class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-xs text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors">
                <span class="text-[var(--accent)]">↳</span> {t.healthyWeight}
              </a>
              <a href={`/${lang}/bmi-calculator-for-men/`} class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-xs text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors">
                <span class="text-[var(--accent)]">↳</span> {t.men}
              </a>
              <a href={`/${lang}/bmi-calculator-for-women/`} class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-xs text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors">
                <span class="text-[var(--accent)]">↳</span> {t.women}
              </a>
              <a href={`/${lang}/bmi-calculator-by-age-adults/`} class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-xs text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors sm:col-span-2">
                <span class="text-[var(--accent)]">↳</span> {t.age}
              </a>
            </div>
          </div>
        </div>

        <!-- Branch 2: Other Calculators Hub (Categorized Sub-silos) -->
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-5 shadow-xs">
          <div class="flex items-center gap-2 pb-3 border-b border-[var(--border)]">
            <span class="w-3 h-3 rounded-full bg-cyan-500"></span>
            <h3 class="font-display font-bold text-base uppercase tracking-tight text-[var(--foreground)]">
              {t.otherHub}
            </h3>
          </div>

          <!-- Sub-Silo 1: BMR -->
          <div class="space-y-2">
            <div class="text-[10px] font-display font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
              {t.bmrSiloTitle}
            </div>
            <div class="grid sm:grid-cols-3 gap-2">
              {t.bmrList.map((item: any) => (
                <a href={item.url} class="p-2 rounded-xl border border-[var(--border)] bg-[var(--muted)]/40 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors text-xs font-display font-semibold text-[var(--foreground)] text-center">
                  {item.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Sub-Silo 2: TDEE -->
          <div class="space-y-2 pt-2 border-t border-[var(--border)]/50">
            <div class="text-[10px] font-display font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
              {t.tdeeSiloTitle}
            </div>
            <div class="grid sm:grid-cols-3 gap-2">
              {t.tdeeList.map((item: any) => (
                <a href={item.url} class="p-2 rounded-xl border border-[var(--border)] bg-[var(--muted)]/40 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors text-xs font-display font-semibold text-[var(--foreground)] text-center">
                  {item.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Sub-Silo 3: Body Composition -->
          <div class="space-y-2 pt-2 border-t border-[var(--border)]/50">
            <div class="text-[10px] font-display font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
              {t.bodyCompSiloTitle}
            </div>
            <div class="grid sm:grid-cols-3 gap-2">
              {t.bodyCompList.map((item: any) => (
                <a href={item.url} class="p-2 rounded-xl border border-[var(--border)] bg-[var(--muted)]/40 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors text-xs font-display font-semibold text-[var(--foreground)] text-center">
                  {item.name}
                </a>
              ))}
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
