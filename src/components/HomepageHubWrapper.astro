---
import type { Locale } from '../utils/calculators';
import { calculators } from '../utils/calculators';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const groupTitles: Record<string, Record<Locale, string>> = {
  bmi_weight: {
    en: 'BMI & Weight Calculators',
    es: 'Calculadoras de IMC y Peso',
    fr: 'Calculateurs d\'IMC et de Poids',
    de: 'BMI- & Gewichtsrechner',
    ko: 'BMI 및 체중 계산기',
    hi: 'बीएमआई एवं वजन कैलकुलेटर'
  },
  health_body: {
    en: 'Health & Body Composition',
    es: 'Salud y Composición Corporal',
    fr: 'Santé et Composition Corporelle',
    de: 'Gesundheit & Körperzusammensetzung',
    ko: '건강 및 체성분',
    hi: 'स्वास्थ्य एवं शारीरिक संरचना'
  },
  calories_nutrition: {
    en: 'Calories & Nutrition',
    es: 'Calorías y Nutrición',
    fr: 'Calories et Nutrition',
    de: 'Kalorien & Ernährung',
    ko: '칼로리 및 영양',
    hi: 'कैलोरी एवं पोषण'
  },
  fitness_specialized: {
    en: 'Fitness & Specialized Calculators',
    es: 'Calculadoras de Fitness y Especializadas',
    fr: 'Calculateurs de Fitness et Spécialisés',
    de: 'Fitness- & Spezialrechner',
    ko: '피트니스 및 특수 계산기',
    hi: 'फिटनेस एवं विशिष्ट कैलकुलेटर'
  }
};

const gTitle = {
  bmi_weight: groupTitles.bmi_weight[lang] || groupTitles.bmi_weight.en,
  health_body: groupTitles.health_body[lang] || groupTitles.health_body.en,
  calories_nutrition: groupTitles.calories_nutrition[lang] || groupTitles.calories_nutrition.en,
  fitness_specialized: groupTitles.fitness_specialized[lang] || groupTitles.fitness_specialized.en,
};

const groups = [
  {
    key: 'bmi_weight',
    title: gTitle.bmi_weight,
    gridClass: 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3',
    slugs: [
      'bmi-calculator',
      '3d-bmi-calculator',
      'bmi-chart',
      'healthy-weight-by-height',
      'ideal-weight-calculator',
      'bmi-calculator-for-indians',
      'asian-bmi-calculator'
    ]
  },
  {
    key: 'health_body',
    title: gTitle.health_body,
    gridClass: 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-5 gap-3',
    slugs: [
      'diabetes-risk-calculator',
      'body-fat-calculator',
      'lean-body-mass-calculator',
      'waist-to-hip-ratio-calculator',
      'body-surface-area-calculator'
    ]
  },
  {
    key: 'calories_nutrition',
    title: gTitle.calories_nutrition,
    gridClass: 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3',
    slugs: [
      'bmr-calculator',
      'tdee-calculator',
      'maintenance-calorie-calculator',
      'calorie-calculator',
      'macro-calculator',
      'protein-intake-calculator',
      'water-intake-calculator'
    ]
  },
  {
    key: 'fitness_specialized',
    title: gTitle.fitness_specialized,
    gridClass: 'grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-3',
    slugs: [
      'heart-rate-zone-calculator',
      'karvonen-heart-rate-calculator',
      '1rm-calculator',
      'pregnancy-weight-gain-calculator'
    ]
  }
];
---

<div class="space-y-8 animate-in" style="animation-delay: 150ms;">
  {groups.map(group => (
    <div class="calc-group space-y-3">
      <h3 class="text-xs sm:text-sm font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)]">
        {group.title}<span class="sr-only">. </span>
      </h3>
      <div class={group.gridClass}>
        {group.slugs.map(slug => {
          const calc = calculators.find(c => c.slug === slug);
          if (!calc) return null;
          return (
            <a
              href={`/${lang}/${calc.slug}/`}
              class={`calc-tab-btn flex items-center justify-center min-h-[56px] h-full rounded-xl border border-[var(--border)] bg-[var(--card)] text-[var(--foreground)] hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 transition-all duration-300 px-3 py-2.5 cursor-pointer shadow-xs no-underline ${calc.slug === '3d-bmi-calculator' ? 'border-[var(--accent)]/50 bg-[var(--accent)]/[0.04]' : ''}`}
            >
              <span class="text-xs sm:text-sm font-display font-bold uppercase text-center tracking-tight leading-tight max-w-full text-balance break-words">
                {calc.name[lang] || calc.name['en']}<span class="sr-only">. </span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  ))}
</div>

<style>
  .calc-tab-btn {
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
</style>
