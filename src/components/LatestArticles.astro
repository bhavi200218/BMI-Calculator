---
import { blogArticles, isSubstantialArticle } from '../utils/blogArticles';
import type { Locale } from '../utils/calculators';

interface Props {
  lang?: Locale | string;
  slugs?: string[];
  title?: string;
  subtitle?: string;
  limit?: number;
}

const { lang: propLang, slugs: propSlugs, title: propTitle, subtitle: propSubtitle, limit: propLimit } = Astro.props;
const { currentLocale } = Astro;
const lang = (propLang || currentLocale || 'en') as Locale;

const labels: Record<string, { latest: string; viewAll: string; readArticle: string }> = {
  en: {
    latest: "Health Articles & Guides",
    viewAll: "View All Articles",
    readArticle: "Read Article →"
  },
  es: {
    latest: "Artículos y Guías de Salud",
    viewAll: "Ver Todos los Artículos",
    readArticle: "Leer Artículo →"
  },
  fr: {
    latest: "Articles et Guides Santé",
    viewAll: "Voir Tous les Articles",
    readArticle: "Lire l'Article →"
  },
  de: {
    latest: "Gesundheitsartikel & Leitfäden",
    viewAll: "Alle Artikel Anzeigen",
    readArticle: "Artikel Lesen →"
  },
  ko: {
    latest: "건강 아티클 및 가이드",
    viewAll: "모든 아티클 보기",
    readArticle: "아티클 읽기 →"
  },
  hi: {
    latest: "स्वास्थ्य लेख एवं गाइड",
    viewAll: "सभी लेख देखें",
    readArticle: "लेख पढ़ें →"
  }
};

const HOMEPAGE_ARTICLE_SLUGS = [
  'what-is-bmi',
  'is-bmi-accurate',
  'bmi-chart',
  'healthy-weight-chart',
  'bmi-chart-for-men-women',
  'bmi-by-age'
];

const allSlugs = Object.keys(blogArticles);
const candidateSlugs = (propSlugs && propSlugs.length > 0)
  ? propSlugs.filter(s => blogArticles[s])
  : HOMEPAGE_ARTICLE_SLUGS;

const effectiveLimit = propLimit || (propSlugs ? propSlugs.length : 6);
const selectedSlugs = candidateSlugs.slice(0, effectiveLimit);

const articlesList = selectedSlugs.map(slug => {
  const item = blogArticles[slug];
  return {
    slug,
    title: item.title[lang] || item.title.en,
    category: item.category ? (item.category[lang] || item.category.en) : 'Health',
    description: item.description ? (item.description[lang] || item.description.en) : '',
  };
});

const t = labels[lang] || labels.en;
const sectionTitle = propTitle || t.latest;
const blogIndexUrl = lang === 'en' ? '/en/blog/' : `/${lang}/blog/`;
---

<div class="space-y-6" id="articles">
  <!-- Section Header -->
  <header class="flex items-center justify-between gap-4 pb-2">
    <div>
      <h2 class="text-xl md:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {sectionTitle}<span class="sr-only">. </span>
      </h2>
      {propSubtitle && (
        <p class="text-sm text-[var(--muted-foreground)] font-medium pt-1">
          {propSubtitle}
        </p>
      )}
    </div>
    
    <a href={blogIndexUrl} class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-xl border border-[var(--accent)]/30 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] hover:bg-[var(--accent)] hover:text-white transition-all duration-200 shadow-xs shrink-0">
      <span>{t.viewAll}<span class="sr-only">. </span></span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </header>

  <!-- Article Cards Grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      articlesList.map((article) => (
        <a href={isSubstantialArticle(article.slug, lang) ? `/${lang}/blog/${article.slug}/` : `/en/blog/${article.slug}/`} class="group block h-full">
          <div class="h-full p-4 sm:p-5 rounded-xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-3 hover:border-[var(--accent)] hover:shadow-xs transition-all duration-200">
            <div class="space-y-2.5">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-display font-bold uppercase tracking-wider text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20">
                  {article.category}<span class="sr-only">. </span>
                </span>
              </div>

              <h3 class="text-base sm:text-lg font-display font-bold leading-snug text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors duration-200 line-clamp-2">
                {article.title}<span class="sr-only">. </span>
              </h3>

              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-2">
                {article.description}
              </p>
            </div>

            <div class="flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] pt-2">
              <span>{t.readArticle}<span class="sr-only">. </span></span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>
