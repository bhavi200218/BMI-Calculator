---
import { blogArticles } from '../utils/blogArticles';

const { currentLocale } = Astro;
const lang = currentLocale || 'en';

const labels: Record<string, any> = {
  en: {
    library: "Articles & Health Library",
    latest: "Latest Health Articles & Guides",
    subtitle: "Evidence-based health guides, clinical BMI standards, and weight loss calculation formulas.",
    viewAll: "View All Articles",
    readArticle: "Read Article →"
  },
  es: {
    library: "Biblioteca de Salud y Artículos",
    latest: "Últimos Artículos y Guías de Salud",
    subtitle: "Guías de salud basadas en evidencia, estándares clínicos de IMC y fórmulas de cálculo para la pérdida de peso.",
    viewAll: "Ver Todos los Artículos",
    readArticle: "Leer Artículo →"
  },
  fr: {
    library: "Bibliothèque d'Articles et Santé",
    latest: "Derniers Articles et Guides Santé",
    subtitle: "Guides de santé basés sur des preuves, normes cliniques de l'IMC et formules de calcul de perte de poids.",
    viewAll: "Voir Tous les Articles",
    readArticle: "Lire l'Article →"
  },
  de: {
    library: "Gesundheitsbibliothek & Artikel",
    latest: "Neueste Gesundheitsartikel & Leitfäden",
    subtitle: "Evidenzbasierte Gesundheitsleitfäden, klinische BMI-Standards und Berechnungsformeln zur Gewichtsabnahme.",
    viewAll: "Alle Artikel Anzeigen",
    readArticle: "Artikel Lesen →"
  },
  ko: {
    library: "아티클 및 건강 라이브러리",
    latest: "최신 건강 아티클 및 가이드",
    subtitle: "증거 기반 건강 가이드, 임상 BMI 표준 및 체중 감량 계산 공식.",
    viewAll: "모든 아티클 보기",
    readArticle: "아티클 읽기 →"
  },
  hi: {
    library: "लेख एवं स्वास्थ्य पुस्तकालय",
    latest: "नवीनतम स्वास्थ्य लेख एवं गाइड",
    subtitle: "प्रमाण-आधारित स्वास्थ्य गाइड, नैदानिक बीएमआई मानक और वजन घटाने के गणना फॉर्मूले।",
    viewAll: "सभी लेख देखें",
    readArticle: "लेख पढ़ें →"
  }
};

const articleSlugs = Object.keys(blogArticles);
const articlesList = articleSlugs.slice(0, 6).map(slug => {
  const item = blogArticles[slug];
  return {
    slug,
    title: item.title[lang] || item.title.en,
    category: item.category ? (item.category[lang] || item.category.en) : 'Health',
    description: item.description ? (item.description[lang] || item.description.en) : '',
  };
});

const t = labels[lang] || labels.en;
---

<section class="space-y-6 py-6" id="articles">
  <!-- Section Header -->
  <div class="flex items-center justify-between gap-4 flex-wrap pb-2">
    <div class="space-y-1">
      <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">
        {t.library}
      </p>
      <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight uppercase text-[var(--foreground)] leading-tight">
        {t.latest}
      </h2>
      <p class="text-sm md:text-base text-[var(--muted-foreground)] max-w-2xl font-medium">
        {t.subtitle}
      </p>
    </div>
    
    <a href={`/${lang}/blog`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-[var(--accent)]/30 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] hover:bg-[var(--accent)] hover:text-white transition-all duration-200 shadow-sm">
      <span>{t.viewAll}</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <!-- Article Cards Grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      articlesList.map((article) => (
        <a href={`/${lang}/blog/${article.slug}`} class="group block h-full">
          <div class="h-full p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] flex flex-col justify-between space-y-4 hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-display font-semibold tracking-wider text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20 max-w-[80%] truncate">
                  {article.category}
                </span>
                <span class="text-[11px] font-sans font-medium text-[var(--muted-foreground)] shrink-0">
                  Guide
                </span>
              </div>

              <h3 class="text-lg md:text-xl font-display font-bold leading-snug text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors duration-200 line-clamp-2">
                {article.title}
              </h3>

              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-3">
                {article.description}
              </p>
            </div>

            <div class="flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] pt-4 border-t border-[var(--border)]/40">
              <span>{t.readArticle}</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
