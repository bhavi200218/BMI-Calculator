const current = data[lang] || data.en;
---

<div class="space-y-6">
  <!-- 4 Core Calculators Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {current.tools.map((tool) => (
      <a
        href={tool.href}
        class="group p-5 rounded-2xl border border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)] hover:bg-[var(--accent)]/[0.03] transition-all duration-300 flex flex-col justify-between space-y-3 shadow-xs hover:shadow-md no-underline"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[10px] font-display font-bold uppercase tracking-wider text-[var(--accent)] px-2 py-0.5 rounded-md bg-[var(--accent)]/10 border border-[var(--accent)]/20">
              {tool.tag}
            </span>
            <div class="w-7 h-7 rounded-lg bg-[var(--muted)]/50 flex items-center justify-center text-[var(--accent)] group-hover:bg-[var(--accent)] group-hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon} />
              </svg>
            </div>
          </div>
          <h3 class="text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors">
            {tool.name}
          </h3>
          <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-2">
            {tool.desc}
          </p>
        </div>
        <div class="pt-2 flex items-center text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] gap-1 group-hover:translate-x-1 transition-transform">
          <span>{lang === 'hi' ? 'कैलकुलेटर खोलें' : lang === 'es' ? 'Abrir herramienta' : lang === 'fr' ? "Ouvrir l'outil" : lang === 'de' ? 'Rechner öffnen' : lang === 'ko' ? '도구 열기' : 'Open Tool'}</span>
          <span>→</span>
        </div>
      </a>
    ))}
  </div>

  <!-- Dual Action Jump Bar -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
    <a
      href="#all-calculators"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-[var(--border)] bg-[var(--card)] text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all shadow-xs"
    >
      <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
      <span>{current.allToolsBtn}</span>
    </a>
    
    <a
      href="#popular-topics"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-[var(--accent)]/30 bg-[var(--accent)]/10 text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] hover:bg-[var(--accent)] hover:text-white transition-all shadow-xs"
    >
      <span>{current.browseResearchBtn}</span>
    </a>
  </div>
</div>
