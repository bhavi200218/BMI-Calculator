};

const current = data[lang] || data.en;
---

<div class="space-y-8">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
      <span>{current.badge}</span>
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
      {current.title}
    </h2>
    <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed max-w-2xl mx-auto">
      {current.subtitle}
    </p>
  </div>

  <!-- 8 Core Calculators Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {current.tools.map((tool) => (
      <a
        href={tool.href}
        class="group p-5 rounded-2xl border border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)] hover:bg-[var(--accent)]/[0.03] transition-all duration-300 flex flex-col justify-between space-y-4 shadow-xs hover:shadow-md no-underline"
      >
        <div class="space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[10px] font-display font-bold uppercase tracking-wider text-[var(--accent)] px-2 py-0.5 rounded-md bg-[var(--accent)]/10 border border-[var(--accent)]/20">
              {tool.tag}
            </span>
            <div class="w-8 h-8 rounded-lg bg-[var(--muted)]/50 flex items-center justify-center text-[var(--accent)] group-hover:bg-[var(--accent)] group-hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon} />
              </svg>
            </div>
          </div>
          <h3 class="text-base font-display font-bold uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors">
            {tool.name}
          </h3>
          <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-medium line-clamp-2">
            {tool.desc}
          </p>
        </div>
        <div class="pt-2 border-t border-[var(--border)]/40 flex items-center justify-between text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)]">
          <span>{current.openLabel}</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    ))}
  </div>
</div>
