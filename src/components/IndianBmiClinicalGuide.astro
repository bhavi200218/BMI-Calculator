        {c.phenotypeLead}
      </p>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">
        {c.phenotypeP1}
      </p>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium">
        {c.phenotypeP2}
      </p>
    </div>

    <!-- Clinical Comparison Table -->
    <div class="space-y-3">
      <h3 class="text-lg sm:text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {c.comparisonTitle}
      </h3>
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] overflow-x-auto shadow-xs">
        <table class="w-full text-left border-collapse text-xs sm:text-sm min-w-[600px]">
          <thead>
            <tr class="bg-[var(--muted)]/50 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs font-bold">
              <th class="p-3.5 sm:p-4">{c.compHeaders.marker}</th>
              <th class="p-3.5 sm:p-4 text-[var(--accent)]">{c.compHeaders.southAsian}</th>
              <th class="p-3.5 sm:p-4">{c.compHeaders.western}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]/60 text-[var(--muted-foreground)] font-medium">
            {c.compRows.map(row => (
              <tr class="hover:bg-[var(--muted)]/20 transition-colors">
                <td class="p-3.5 sm:p-4 font-bold text-[var(--foreground)]">{row.marker}</td>
                <td class="p-3.5 sm:p-4 text-[var(--foreground)] font-semibold bg-[var(--accent)]/[0.03]">{row.southAsian}</td>
                <td class="p-3.5 sm:p-4">{row.western}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══════════════════  2. WAIST CIRCUMFERENCE & CENTRAL ADIPOSITY  ═══════════════════ -->
  <div class="space-y-6 pt-6 border-t border-[var(--border)]/60 scroll-mt-24" id="waist-guide">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-display font-bold uppercase tracking-widest border border-amber-500/20">
        ICMR Action Cutoffs
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
        {c.waistTitle}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-3xl leading-relaxed">
        {c.waistSubtitle}
      </p>
    </div>

    <!-- Cutoff Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {c.waistCutoffs.map(item => (
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2 shadow-xs">
          <div class="text-xs font-display font-bold uppercase tracking-wider text-[var(--muted-foreground)]">
            {item.group}
          </div>
          <div class="text-2xl sm:text-3xl font-display font-bold text-[var(--accent)]">
            {item.threshold}
          </div>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium pt-1">
            {item.context}
          </p>
        </div>
      ))}
    </div>

    <!-- Measurement Steps Box -->
    <div class="p-6 md:p-8 rounded-2xl bg-[var(--muted)]/30 border border-[var(--border)] space-y-4">
      <h3 class="text-base sm:text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {c.waistStepsTitle}
      </h3>
      <ol class="space-y-2 text-xs sm:text-sm text-[var(--foreground)]/90 font-medium">
        {c.waistSteps.map((step, idx) => (
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-[var(--accent)] text-white text-xs font-bold shrink-0 mt-0.5">
              {idx + 1}
            </span>
            <span class="leading-relaxed">{step}</span>
          </li>
        ))}
      </ol>
      <div class="pt-3 border-t border-[var(--border)]/70 text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed">
        <strong class="text-[var(--foreground)] font-display uppercase tracking-wide">{c.whtrRuleTitle}:</strong> {c.whtrRuleText}
      </div>
    </div>
  </div>

  <!-- ═══════════════════  3. INDIAN DIET EXAMPLES & MEAL ARCHITECTURE  ═══════════════════ -->
  <div class="space-y-6 pt-6 border-t border-[var(--border)]/60 scroll-mt-24" id="indian-diet">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-display font-bold uppercase tracking-widest border border-emerald-500/20">
        Clinical Nutrition Strategy
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
        {c.dietTitle}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-3xl leading-relaxed">
        {c.dietSubtitle}
      </p>
    </div>

    <!-- Thali Concept Breakdown (3 Pillars) -->
    <div class="p-6 md:p-8 rounded-3xl bg-[var(--card)] border border-[var(--border)] shadow-sm space-y-5">
      <h3 class="text-lg sm:text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {c.thaliConceptTitle}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {c.thaliComponents.map(comp => (
          <div class="p-5 rounded-2xl bg-[var(--muted)]/30 border border-[var(--border)]/70 space-y-2">
            <span class="text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)]">
              {comp.portion}
            </span>
            <h4 class="text-base font-display font-bold text-[var(--foreground)]">
              {comp.name}
            </h4>
            <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
              {comp.items}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Meal Plans Grid (Veg vs Non-Veg) -->
    <div class="space-y-4 scroll-mt-24" id="sample-meal-plans">
      <h3 class="text-lg sm:text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {c.sampleMealTitle}
      </h3>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Vegetarian Plan -->
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-[var(--border)]">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <h4 class="text-sm sm:text-base font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
              Vegetarian Balanced Indian Menu
            </h4>
          </div>
          <div class="space-y-3">
            {c.vegMeals.map(m => (
              <div class="space-y-1">
                <span class="text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)]">
                  {m.meal}
                </span>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  {m.details}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Non-Vegetarian Plan -->
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-[var(--border)]">
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <h4 class="text-sm sm:text-base font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
              Non-Vegetarian Balanced Indian Menu
            </h4>
          </div>
          <div class="space-y-3">
            {c.nonVegMeals.map(m => (
              <div class="space-y-1">
                <span class="text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)]">
                  {m.meal}
                </span>
                <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
                  {m.details}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- Smart Swaps Table -->
    <div class="space-y-3 scroll-mt-24" id="food-swaps">
      <h3 class="text-lg sm:text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {c.swapsTitle}
      </h3>
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] overflow-x-auto shadow-xs">
        <table class="w-full text-left border-collapse text-xs sm:text-sm min-w-[650px]">
          <thead>
            <tr class="bg-[var(--muted)]/50 border-b border-[var(--border)] text-[var(--foreground)] font-display uppercase tracking-wider text-xs font-bold">
              <th class="p-3.5 sm:p-4 text-red-500">Traditional High-GI Item</th>
              <th class="p-3.5 sm:p-4 text-emerald-500">Smart Nutritional Swap</th>
              <th class="p-3.5 sm:p-4">Clinical Advantage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]/60 text-[var(--muted-foreground)] font-medium">
            {c.swaps.map(item => (
              <tr class="hover:bg-[var(--muted)]/20 transition-colors">
                <td class="p-3.5 sm:p-4 line-through text-[var(--muted-foreground)]/80 font-medium">{item.insteadOf}</td>
                <td class="p-3.5 sm:p-4 font-bold text-[var(--foreground)]">{item.chooseThis}</td>
                <td class="p-3.5 sm:p-4 text-xs sm:text-sm leading-relaxed">{item.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══════════════════  4. CLINICAL FAQS SECTION  ═══════════════════ -->
  <div class="space-y-6 pt-6 border-t border-[var(--border)]/60 scroll-mt-24" id="indian-clinical-faqs">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-display font-bold uppercase tracking-widest border border-blue-500/20">
        Clinical Inquiries
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-tight">
        {c.faqTitle}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium max-w-3xl leading-relaxed">
        {c.faqSubtitle}
      </p>
    </div>

    <!-- FAQ Accordion / Cards List -->
    <div class="space-y-3">
      {c.faqs.map(faq => {
        const parsed = formatFaqAnswer(faq.a);
        const fl = faqLabels[lang] || faqLabels.en;
        return (
          <details class="group p-5 rounded-2xl border border-[var(--border)] bg-[var(--card)] hover:border-[var(--accent)]/50 transition-colors shadow-xs">
            <summary class="flex items-center justify-between cursor-pointer list-none font-display font-bold text-sm sm:text-base text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors select-none">
              <span class="pr-4">{faq.q}</span>
              <span class="w-6 h-6 rounded-full bg-[var(--muted)]/60 flex items-center justify-center shrink-0 text-xs transition-transform group-open:rotate-180">
                ▼
              </span>
            </summary>
            {parsed.detailed ? (
              <div class="pt-3 border-t border-[var(--border)]/40 mt-3 space-y-2.5">
                <div class="p-3.5 rounded-xl bg-[var(--accent)]/5 border-l-[3px] border-[var(--accent)] text-xs sm:text-sm font-semibold text-[var(--foreground)]">
                  <span class="text-[var(--accent)] uppercase tracking-wider text-[10px] font-bold block mb-1 font-display">
                    {fl.short}
                  </span>
                  {parsed.short}
                </div>
                <div class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium space-y-1">
                  <span class="text-[var(--foreground)] uppercase tracking-wider text-[10px] font-bold block opacity-75 font-display">
                    {fl.detailed}
                  </span>
                  <p>{parsed.detailed}</p>
                </div>
              </div>
            ) : (
              <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed pt-3 border-t border-[var(--border)]/40 mt-3">
                {faq.a}
              </p>
            )}
          </details>
        );
      })}
    </div>
  </div>

</section>
