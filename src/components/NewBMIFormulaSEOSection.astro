      }
    ],
    tableTitle: "Height-Adjusted Score Comparison Matrix",
    tableHeaders: ["Height Group", "Example Person", "Standard BMI (m²)", "Height-Adjusted BMI (m²·⁵)", "Formula Score Difference"],
