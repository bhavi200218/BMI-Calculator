    formulaExplanation: "Der 2,5-Exponent-Skalierungsfaktor kompensiert Höhenverzerrungen für fairere Werte.",
    cards: [
      { title: "Kleine Körpergröße (< 160 cm)", desc: "Der Standard-BMI unterschätzt das Fettgewebe bei kleineren Menschen. Die 2,5-Formel liefert realistischere Werte." },
      { title: "Durchschnittliche Größe (169 – 175 cm)", desc: "Bei ca. 170 cm Körpergröße liefern Standard-BMI und 3D-Höhen-BMI nahezu identische Zahlen." },
      { title: "Große Körpergröße (> 183 cm)", desc: "Der Standard-BMI stuft große Menschen oft fälschlicherweise als 'übergewichtig' ein. Der 3D-BMI korrigiert den Wert." }
    ],
    tableTitle: "Vergleichsmatrix: Höhenbereinigter BMI",
    tableHeaders: ["Größengruppe", "Beispiel", "Standard-BMI (m²)", "3D-Höhen-BMI (m²·⁵)", "Differenz"],
    tableRows: [
      { height: "Klein (152 cm)", example: "60 kg", std: "26.0 (Übergewicht)", newBmi: "26.9 (Bereinigt)", diff: "+ 0.9 Pkt" },
      { height: "Mittel (170 cm)", example: "70 kg", std: "24.2 (Normal)", newBmi: "24.2 (Normal)", diff: "0.0 (Identisch)" },
      { height: "Groß (190 cm)", example: "90 kg", std: "24.9 (Normal)", newBmi: "23.4 (Normal)", diff: "- 1.5 Pkt" },
      { height: "Sehr Groß (200 cm)", example: "105 kg", std: "26.3 (Übergewicht)", newBmi: "24.3 (Normal)", diff: "- 2.0 Pkt" }
    ],
    disclaimer: "Mathematischer Hinweis: Die 2,5-Exponent-Höhenanpassung ist eine mathematische Verfeinerung."
  },
  ko: {
    badge: "3D 수학적 신장 보정 표준",
    title: "표준 BMI vs. 새로운 신장 보정 3D BMI",
    subtitle: "기존 BMI가 키가 크거나 작은 사람에게 왜곡을 일으키는 이유와 2.5 지수 공식이 3D 체적을 보정하는 방법.",
    formulaTitle: "수학 공식: 표준 vs. 신장 보정 BMI",
    standardFormula: "표준 BMI = 체중 (kg) ÷ 키² (m²)",
