      { title: "Petite Taille (< 160 cm)", desc: "L'IMC standard sous-estime la graisse chez les personnes petites. La formule 2.5 offre un résultat plus réaliste." },
      { title: "Taille Moyenne (169 – 175 cm)", desc: "Pour les adultes proches de 170 cm, l'IMC standard et l'IMC 3D ajusté donnent des chiffres identiques." },
      { title: "Grande Taille (> 183 cm)", desc: "L'IMC standard surévalue la masse chez les personnes grandes. La formule ajustée réduit le score de 1 à 2 points." }
    ],
    tableTitle: "Matrice Comparative IMC Ajusté à la Taille",
    tableHeaders: ["Groupe de Taille", "Exemple", "IMC Standard (m²)", "IMC Ajusté 3D (m²·⁵)", "Différence"],
    tableRows: [
      { height: "Petit (152 cm)", example: "60 kg", std: "26.0 (Surpoids)", newBmi: "26.9 (Ajusté)", diff: "+ 0.9 pts" },
      { height: "Moyen (170 cm)", example: "70 kg", std: "24.2 (Normal)", newBmi: "24.2 (Normal)", diff: "0.0 (Identique)" },
      { height: "Grand (190 cm)", example: "90 kg", std: "24.9 (Normal)", newBmi: "23.4 (Normal)", diff: "- 1.5 pts" },
      { height: "Très Grand (200 cm)", example: "105 kg", std: "26.3 (Surpoids)", newBmi: "24.3 (Normal)", diff: "- 2.0 pts" }
    ],
    disclaimer: "Note Mathématique : L'ajustement à l'exposant 2.5 est un raffinement mathématique pour réduire les distorsions."
  },
