    tableRows: [
      { height: "단신 (152 cm)", example: "60 kg", std: "26.0 (과체중)", newBmi: "26.9 (보정됨)", diff: "+ 0.9점" },
      { height: "평균 (170 cm)", example: "70 kg", std: "24.2 (정상)", newBmi: "24.2 (정상)", diff: "0.0 (동일)" },
      { height: "장신 (190 cm)", example: "90 kg", std: "24.9 (정상)", newBmi: "23.4 (정상)", diff: "- 1.5점" },
      { height: "최장신 (200 cm)", example: "105 kg", std: "26.3 (과체중)", newBmi: "24.3 (정상)", diff: "- 2.0점" }
