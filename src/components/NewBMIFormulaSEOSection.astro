    disclaimer: "Mathematical Consensus Note: The 2.5 exponent height adjustment is a mathematical refinement designed to reduce height-scaling distortion. Both metrics serve as clinical screening indicators."
  },
  hi: {
    badge: "गणितीय 3D ऊंचाई-समायोजन मानक",
    title: "मानक बीएमआई बनाम नया ऊंचाई-समायोजित बीएमआई फॉर्मूला",
    subtitle: "समझें कि पारंपरिक बीएमआई लंबे और नाटे लोगों के लिए आंकड़े क्यों बिगाड़ता है, और 2.5 ऊंचाई-घात फॉर्मूला 3D शरीर के आकार को कैसे सटीक बनाता है।",
    formulaTitle: "मानक बनाम ऊंचाई-समायोजित फॉर्मूला तुलना",
    standardFormula: "मानक बीएमआई = वजन (किग्रा) ÷ ऊंचाई² (मीटर²)",
    newFormula: "ऊंचाई-समायोजित बीएमआई = 1.3 × वजन (किग्रा) ÷ ऊंचाई²·⁵ (मीटर²·⁵)",
    formulaExplanation: "मानक बीएमआई वजन को ऊंचाई के वर्ग (2D) से विभाजित करता है। लेकिन मनुष्य 3-आयामी (त्रिविमीय) रूप से बढ़ते हैं। 2.5 घात फॉर्मूला ऊंचाई के भ्रम को दूर करता है।",
    cards: [
      {
        title: "कम ऊंचाई वाले लोगों पर प्रभाव (< 160 सेमी)",
        desc: "मानक बीएमआई कम ऊंचाई वाले लोगों के शरीर की वसा को कम आंकता है। 2.5 घात फॉर्मूला थोड़ा अधिक और अधिक यथार्थवादी स्कोर प्रदान करता है।"
      },
      {
        title: "औसत ऊंचाई संरेखण (169 – 175 सेमी)",
