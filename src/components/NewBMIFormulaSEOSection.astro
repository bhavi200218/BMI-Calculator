      { height: "Average (170 cm / 5'7\")", example: "70 kg (154 lbs)", std: "24.2 (Normal)", newBmi: "24.2 (Normal)", diff: "0.0 (Identical)" },
      { height: "Tall (190 cm / 6'3\")", example: "90 kg (198 lbs)", std: "24.9 (Normal)", newBmi: "23.4 (Normal)", diff: "- 1.5 points" },
      { height: "Very Tall (200 cm / 6'7\")", example: "105 kg (231 lbs)", std: "26.3 (Overweight)", newBmi: "24.3 (Normal)", diff: "- 2.0 points" }
