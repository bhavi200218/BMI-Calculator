    disclaimer: "수학적 참고 사항: 2.5 지수 신장 보정은 키 왜곡을 줄이기 위한 수학적 보정 공식입니다."
  }
};

const t = translations[lang] || translations.en;
---

<section class="my-12 px-4 md:px-6 max-w-7xl mx-auto">
  <div class="rounded-3xl border border-[var(--border)] bg-[var(--card)] p-6 sm:p-10 shadow-sm space-y-8">
    
    <!-- Header -->
    <div class="space-y-3 max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[var(--accent)]/30 bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
        {t.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Math Formula Box -->
    <div class="p-6 rounded-2xl border border-[var(--accent)]/20 bg-[var(--accent)]/5 space-y-4">
      <div class="text-xs font-display font-semibold uppercase tracking-widest text-[var(--accent)]">{t.formulaTitle}</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono font-bold text-sm sm:text-base">
        <div class="p-3.5 rounded-xl border border-[var(--border)] bg-[var(--card)] text-[var(--muted-foreground)]">
          {t.standardFormula}
        </div>
        <div class="p-3.5 rounded-xl border border-[var(--accent)]/40 bg-[var(--accent)]/10 text-[var(--accent)]">
          {t.newFormula}
        </div>
      </div>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">
        {t.formulaExplanation}
      </p>
    </div>

    <!-- 3 Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.cards.map((card: any) => (
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-3 transition-all duration-200 hover:border-[var(--accent)]/40">
          <h3 class="text-base font-display font-bold text-[var(--foreground)]">{card.title}</h3>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{card.desc}</p>
        </div>
      ))}
    </div>

    <!-- Comparison Table -->
    <div class="space-y-4">
      <h3 class="text-base sm:text-xl font-display font-bold uppercase tracking-tight leading-snug break-words text-[var(--foreground)]">
        {t.tableTitle}
      </h3>
      <!-- Desktop Table (hidden on mobile) -->
      <div class="hidden md:block overflow-x-auto rounded-2xl border border-[var(--border)] bg-[var(--card)]">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead class="bg-[var(--muted)]/60 text-[var(--foreground)] font-display font-bold uppercase tracking-wider border-b border-[var(--border)]">
            <tr>
              {t.tableHeaders.map((head: string) => (
                <th class="p-3.5 sm:p-4">{head}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)] font-medium text-[var(--muted-foreground)]">
            {t.tableRows.map((row: any) => (
              <tr class="hover:bg-[var(--muted)]/20 transition-colors">
                <td class="p-3.5 sm:p-4 font-bold text-[var(--foreground)]">{row.height}</td>
                <td class="p-3.5 sm:p-4 font-mono">{row.example}</td>
                <td class="p-3.5 sm:p-4">{row.std}</td>
                <td class="p-3.5 sm:p-4 font-bold text-[var(--accent)]">{row.newBmi}</td>
                <td class="p-3.5 sm:p-4 font-mono font-semibold text-emerald-600 dark:text-emerald-400">{row.diff}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Stacked Card Matrix (No side scroller on mobile) -->
      <div class="md:hidden space-y-3">
        {t.tableRows.map((row: any) => (
          <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2 text-xs font-medium">
            <div class="flex items-center justify-between border-b border-[var(--border)]/40 pb-2">
              <span class="font-bold text-[var(--foreground)] font-display uppercase">{row.height}</span>
              <span class="font-mono text-[var(--muted-foreground)]">{row.example}</span>
            </div>
            <div class="space-y-1.5 pt-0.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-[var(--muted-foreground)]">Standard BMI:</span>
                <span class="font-semibold text-[var(--foreground)]">{row.std}</span>
              </div>
              <div class="flex items-center justify-between text-xs">
                <span class="text-[var(--muted-foreground)]">3D Adjusted BMI:</span>
                <span class="font-bold text-[var(--accent)]">{row.newBmi}</span>
              </div>
              <div class="flex items-center justify-between text-xs pt-1 border-t border-[var(--border)]/30">
                <span class="text-[var(--muted-foreground)]">Difference:</span>
                <span class="font-mono font-semibold text-emerald-600 dark:text-emerald-400">{row.diff}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Disclaimer -->
    <p class="text-xs text-[var(--muted-foreground)] italic font-medium pt-2 border-t border-[var(--border)]/40">
      {t.disclaimer}
    </p>

  </div>
</section>
