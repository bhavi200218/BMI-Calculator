    tableRows: [
      { height: "कम ऊंचाई (152 सेमी)", example: "60 किग्रा", std: "26.0 (अधिक वजन)", newBmi: "26.9 (समायोजित)", diff: "+ 0.9 अंक" },
      { height: "औसत ऊंचाई (170 सेमी)", example: "70 किग्रा", std: "24.2 (सामान्य)", newBmi: "24.2 (सामान्य)", diff: "0.0 (समान)" },
      { height: "लंबे (190 सेमी)", example: "90 किग्रा", std: "24.9 (सामान्य)", newBmi: "23.4 (सामान्य)", diff: "- 1.5 अंक" },
      { height: "अत्यधिक लंबे (200 सेमी)", example: "105 किग्रा", std: "26.3 (अधिक वजन)", newBmi: "24.3 (सामान्य)", diff: "- 2.0 अंक" }
    ],
    disclaimer: "गणितीय टिप्पणी: 2.5 घात ऊंचाई समायोजन एक गणितीय सुधार है जो ऊंचाई के कारण होने वाली त्रुटियों को कम करता है।"
  },
  es: {
    badge: "Estándar Matemático 3D de Corrección por Altura",
    title: "IMC Estándar vs. Nuevo IMC Ajustado por Altura",
    subtitle: "Por qué el IMC tradicional distorsiona las lecturas para personas altas y bajas, y cómo la fórmula de exponente 2.5 corrige el volumen 3D.",
    formulaTitle: "Fórmulas Matemáticas: IMC Estándar vs. Ajustado",
    standardFormula: "IMC Estándar = peso (kg) ÷ altura² (m²)",
    newFormula: "IMC Ajustado = 1.3 × peso (kg) ÷ altura²·⁵ (m²·⁵)",
    formulaExplanation: "El IMC estándar escala en 2D (altura²). El factor de escala de exponente 2.5 compensa la distorsión volumétrica 3D.",
    cards: [
      { title: "Baja Estatura (< 160 cm)", desc: "El IMC estándar subestima la grasa en personas bajas. La fórmula 2.5 proporciona una puntuación más realista." },
      { title: "Estatura Promedio (169 – 175 cm)", desc: "Para adultos cerca de 170 cm, el IMC estándar y el IMC 3D ajustado entregan números casi idénticos." },
      { title: "Estatura Alta (> 183 cm)", desc: "El IMC estándar sobreestima el peso en adultos altos. La fórmula ajustada reduce el puntaje entre 1 y 2 puntos." }
    ],
    tableTitle: "Matriz Comparativa de IMC Ajustado por Altura",
    tableHeaders: ["Grupo de Altura", "Ejemplo", "IMC Estándar (m²)", "IMC Ajustado 3D (m²·⁵)", "Diferencia"],
    tableRows: [
      { height: "Bajo (152 cm)", example: "60 kg", std: "26.0 (Sobrepeso)", newBmi: "26.9 (Ajustado)", diff: "+ 0.9 pts" },
      { height: "Promedio (170 cm)", example: "70 kg", std: "24.2 (Normal)", newBmi: "24.2 (Normal)", diff: "0.0 (Idéntico)" },
      { height: "Alto (190 cm)", example: "90 kg", std: "24.9 (Normal)", newBmi: "23.4 (Normal)", diff: "- 1.5 pts" },
      { height: "Muy Alto (200 cm)", example: "105 kg", std: "26.3 (Sobrepeso)", newBmi: "24.3 (Normal)", diff: "- 2.0 pts" }
    ],
    disclaimer: "Nota Matemática: El ajuste por exponente 2.5 es un refinamiento matemático para reducir distorsiones de escala."
  },
  fr: {
    badge: "Norme Mathématique 3D d'Ajustement à la Taille",
    title: "IMC Standard vs Nouvel IMC Ajusté à la Taille",
    subtitle: "Pourquoi l'IMC traditionnel fausse les résultats pour les personnes grandes et petites, et comment l'exposant 2.5 corrige le volume 3D.",
