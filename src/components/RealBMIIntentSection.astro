      { title: "डब्ल्यूएचओ एशियाई विसरल कटऑफ", std: "❌ एशियाई 23.0 kg/m² जोखिम सीमा की अनदेखी करता है", real: "✅ डब्ल्यूएचओ एशियाई संशोधित कटऑफ को पूर्णतः एकीकृत करता है" },
      { title: "मेटाबॉलिक कैलोरी लक्ष्य", std: "❌ केवल एक स्थिर वजन-ऊंचाई संख्या देता है", real: "✅ दैनिक बीएमआर एवं टीडीईई कैलोरी आवश्यकताओं की गणना करता है" },
      { title: "कमर की परिधि एवं विसरल फैट", std: "❌ कमर की परिधि या पेट की वसा का आकलन नहीं कर पाता", real: "✅ बीएमआई को कमर-से-हिप अनुपात उपकरण के साथ जोड़ता है" }
