---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const data: Record<string, any> = {
  en: {
    eyebrow: "Search Intent & Clinical Guidance",
    mainTitle: "Is BMI Accurate? The Truth About 'Real BMI' vs Standard Weight Scales",
    mainSubtitle: "While traditional Body Mass Index (BMI) is the world's most widely used health screening tool, millions of people ask: Is BMI actually accurate for my unique body type?",
    cards: [
      {
        tag: "01 / Definition",
        title: "What is 'Real BMI'?",
        desc: "The term 'Real BMI' refers to assessing body mass index alongside complementary physiological metrics — including Basal Metabolic Rate (BMR), Total Daily Energy Expenditure (TDEE), and waist circumference — rather than relying on weight alone."
      },
      {
        tag: "02 / Muscle Density",
        title: "The Muscular Athlete Paradox",
        desc: "Standard BMI formulas (weight/height²) treat all mass equally. Muscular athletes or weightlifters often register as 'Overweight' or 'Obese' despite having low body fat percentage, because dense muscle weighs more than fat volume."
      },
      {
        tag: "03 / Ethnic Thresholds",
        title: "Asian & Regional Risk Guidelines",
        desc: "World Health Organization (WHO) clinical consensus recommends lower BMI cutoff thresholds for Asian and South Asian populations: 23 kg/m² for overweight (vs. 25 kg/m² standard) due to higher risk of visceral fat at lower body mass."
      },
      {
        tag: "04 / Visceral Fat",
        title: "Beyond the Scale: Abdominal Adiposity",
        desc: "BMI measures total body mass, not fat distribution. Deep visceral fat surrounding abdominal organs carries significantly higher metabolic and cardiovascular risks than subcutaneous fat on hips or legs."
      },
      {
        tag: "05 / Heart Risk",
        title: "Cardiovascular & Stroke Risks",
        desc: "Elevated BMI (≥25 kg/m²) correlates with hypertension and arterial strain according to National Heart Foundations. Evaluating BMI alongside waist circumference offers far superior heart attack and stroke risk prevention."
      },
      {
        tag: "06 / Special Groups",
        title: "Special Population Disclaimers",
        desc: "Standard BMI formulas carry clinical limitations for pregnant women (gestational weight), youth under 19 (percentile growth charts), seniors 65+ (muscle protective reserve), and high-muscle athletes."
      }
    ],
    compBadge: "Clinical Evidence Comparison",
    compTitle: "Standard BMI vs. Real BMI Calculator",
    colMetric: "Clinical Metric / Flaw",
    colStd: "Standard Scale BMI",
    colReal: "Real BMI Calculator",
    compRows: [
      { title: "Muscular Athlete Density", std: "❌ Mislabels lean muscle mass as 'Overweight' or 'Obese'", real: "✅ Adjusts with BMR & Body Fat % estimates" },
      { title: "WHO Asian Visceral Cutoff", std: "❌ Ignores Asian 23.0 kg/m² overweight risk threshold", real: "✅ Fully integrates WHO Asian revised cutoffs" },
      { title: "Metabolic Calorie Target", std: "❌ Only provides static weight-to-height number", real: "✅ Calculates BMR & TDEE daily calorie needs" },
      { title: "Abdominal Visceral Fat Assessment", std: "❌ Cannot measure waist circumference or visceral risk", real: "✅ Pairs BMI with Waist-to-Hip Ratio tool" }
    ],
    ctaTitle: "Want to know if BMI is actually accurate for you?",
    ctaDesc: "Read our full clinical breakdown on 2026 medical research, muscle density flaws, and WHO ethnic guidelines.",
    ctaBtn: "Read Full Guide: Is BMI Accurate?"
  },
  hi: {
    eyebrow: "सर्च इंटेंट और क्लिनिकल गाइडेंस",
    mainTitle: "क्या BMI सटीक है? 'Real BMI' बनाम मानक तराजू का सच",
    mainSubtitle: "हालाँकि पारंपरिक बॉडी मास इंडेक्स (BMI) दुनिया का सबसे व्यापक रूप से इस्तेमाल किया जाने वाला स्वास्थ्य उपकरण है, फिर भी लाखों लोग पूछते हैं: क्या बीएमआई मेरे शरीर के प्रकार के लिए सटीक है?",
    cards: [
      {
        tag: "01 / परिभाषा",
        title: "'Real BMI' क्या है?",
        desc: "'Real BMI' का तात्पर्य केवल वजन पर भरोसा करने के बजाय पूरक शारीरिक मीट्रिक - जिसमें बीएमआर (BMR), टीडीईई (TDEE) और कमर की परिधि शामिल है - के साथ बॉडी मास इंडेक्स का मूल्यांकन करना है।"
      },
      {
        tag: "02 / मांसपेशी घनत्व",
