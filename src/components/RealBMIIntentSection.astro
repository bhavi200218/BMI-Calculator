    mainSubtitle: "Bien que l'Indice de Masse Corporelle (IMC) traditionnel soit l'outil de dépistage de santé le plus répandu au monde, des millions de personnes s'interrogent : l'IMC est-il réellement adapté à ma morphologie unique ?",
    cards: [
      {
        tag: "01 / Définition",
        title: "Qu'est-ce que le 'Real BMI' ?",
        desc: "Le concept Real BMI associe le calcul standard de l'IMC à des indicateurs complémentaires (BMR, TDEE, tour de taille) pour fournir un contexte éducatif élargi. Il ne s'agit pas d'un diagnostic médical distinct ni d'une classification officielle séparée de l'OMS."
      },
      {
        tag: "02 / Densité Musculaire",
        title: "Le Paradoxe de l'Athlète Musclé",
        desc: "La formule standard (poids/taille²) traite toute masse corporelle de manière uniforme. Les athlètes ou adeptes de musculation sont fréquemment classés en 'Surpoids' ou 'Obésité' malgré un taux de masse grasse très bas, car le muscle dense pèse plus lourd que le tissu adipeux."
      },
      {
        tag: "03 / Seuils Régionaux",
        title: "Recommandations Asiatiques et Régionales de l'OMS",
        desc: "Les directives de consultation d'experts de l'OMS recommandent des seuils d'IMC abaissés pour les populations d'Asie et d'Asie du Sud : 23,0 kg/m² pour le seuil d'alerte au surpoids (contre 25,0 kg/m² standard) en raison d'un risque accru d'accumulation de graisse viscérale à un IMC plus modéré."
      },
      {
        tag: "04 / Graisse Viscérale",
        title: "Au-delà du Poids : Adiposité Abdominale",
        desc: "L'IMC mesure la masse corporelle globale sans distinguer la répartition des graisses. La graisse viscérale profonde entourant les organes abdominaux présente des facteurs de risque métabolique et cardiovasculaire bien plus élevés que la graisse sous-cutanée des hanches ou des membres."
      },
      {
        tag: "05 / Risque Cardiovasculaire",
        title: "Références de Santé Cardiovasculaire",
        desc: "Un IMC élevé (≥ 25 kg/m²) est associé à des repères cliniques artériels et cardiométaboliques reconnus par les fondations de cardiologie. L'évaluation conjointe de l'IMC et du tour de taille fournit un éclairage supplémentaire essentiel sur la répartition des graisses abdominales."
      },
      {
        tag: "06 / Populations Spécifiques",
        title: "Limites pour les Groupes Particuliers",
        desc: "Les formules d'IMC habituelles possèdent des limites documentées pour les femmes enceintes (poids gestationnel), les enfants et adolescents de moins de 19 ans (courbes de percentiles), les seniors de plus de 65 ans (masse musculaire protectrice) et les personnes très sportives."
      }
    ],
    compBadge: "Aperçu des Indicateurs de Santé",
    compTitle: "IMC Standard et Indicateurs de Santé Complémentaires",
    compDesc: "Comparez les calculs standard de l'Indice de Masse Corporelle (IMC) avec des indicateurs complémentaires de métabolisme et de composition corporelle. Bien que l'IMC standard fournisse une estimation rapide au niveau populationnel basée sur la taille et le poids (kg/m²), il ne fait pas la distinction entre la masse musculaire squelettique et le tissu adipeux, et ne mesure pas la graisse viscérale abdominale. Découvrez comment le métabolisme de base (BMR), la dépense énergétique journalière (TDEE), les mesures de tour de taille et les seuils régionaux de l'OMS apportent un contexte plus complet.",
    colMetric: "Indicateur de Santé",
    colStd: "Focus de Référence Standard",
    colReal: "Aspect Évalué",
    compRows: [
      { title: "Score IMC Standard", std: "Poids rapporté à la taille² (kg/m²)", real: "Ligne de base de dépistage populationnel OMS & CDC (ne modifie ni n'ajuste l'IMC)" },
      { title: "Ratio Tour de Taille / Taille (WHtR)", std: "Dépistage de l'adiposité centrale", real: "Distribution et évaluation du risque de graisse viscérale abdominale" },
      { title: "Directrices de l'OMS pour Populations Asiatiques", std: "Sensibilité ethnique régionale", real: "Seuil d'alerte au surpoids abaissé à 23,0 kg/m²" },
      { title: "Estimations Métaboliques BMR & TDEE", std: "Équations de dépense énergétique", real: "Repères complémentaires pour le maintien calorique et l'équilibre nutritionnel" }
    ],
    ctaTitle: "Souhaitez-vous savoir si l'IMC est réellement adapté à votre profil ?",
    ctaDesc: "Consultez notre guide approfondi sur la densité musculaire, les recherches cliniques et les recommandations régionales de l'OMS.",
    ctaBtn: "Lire le Guide Complet : L'IMC est-il Fiable ?"
  },
  de: {
    eyebrow: "Gesundheits-Referenzleitlinien",
    mainTitle: "Wie genau ist der BMI? Die Wahrheit über 'Real BMI'",
    mainSubtitle: "Obwohl der Body-Mass-Index (BMI) das weltweit am häufigsten genutzte Screening-Tool ist, fragen sich Millionen Menschen nach seiner Genauigkeit.",
    cards: [
      {
        tag: "01 / Definition",
        title: "Was ist 'Real BMI'?",
        desc: "'Real BMI' bewertet den Body-Mass-Index zusammen mit physiologischen Werten wie Grundumsatz (BMR), Gesamtenergieumsatz (TDEE) und Taillenumfang für einen breiteren Bildungskontext."
      },
      {
        tag: "02 / Muskeldichte",
        title: "Das Sportler-Paradoxon",
        desc: "Die Standardformel bewertet jede Masse gleich. Muskulöse Sportler werden oft als 'Übergewichtig' eingestuft, obwohl ihr Körperfettanteil sehr niedrig ist, da Muskeln dichter sind."
      },
      {
        tag: "03 / Asiatische Standards",
        title: "Regionale WHO-Richtlinien",
        desc: "Die WHO empfiehlt für asiatische Bevölkerungen einen niedrigeren Grenzwert von 23,0 kg/m² für Übergewicht wegen des höheren Risikos für viszerales Fett bei geringerem Gewicht."
      },
      {
        tag: "04 / Viszeralfett",
        title: "Bauchfett & Gesundheit",
        desc: "Der BMI misst die Gesamtmasse, nicht die Fettverteilung. Tiefes viszerales Bauchfett birgt deutlich höhere Stoffwechselrisiken als Unterhautfettgewebe."
      },
      {
        tag: "05 / Herz-Kreislauf-Risiko",
        title: "Kardiovaskuläre Referenzwerte",
        desc: "Ein erhöhter BMI (≥ 25 kg/m²) korreliert mit arteriellen und kardiovaskulären Risikofaktoren. Die gemeinsame Betrachtung von BMI und Taillenumfang liefert entscheidenden Kontext."
      },
      {
        tag: "06 / Besondere Gruppen",
        title: "Grenzen bei spezifischen Gruppen",
        desc: "Standard-BMI-Formeln haben dokumentierte Grenzen bei Schwangeren (Gestationsgewicht), Jugendlichen unter 19 (Perzentilenkurven), Senioren ab 65 und Kraftsportlern."
      }
    ],
    compBadge: "Übersicht der Gesundheitsindikatoren",
    compTitle: "Standard-BMI und Ergänzende Gesundheitsindikatoren",
    compDesc: "Vergleichen Sie klassische Body-Mass-Index (BMI)-Berechnungen mit ergänzenden Stoffwechsel- und Körperzusammensetzungs-Parametern. Während der Standard-BMI eine schnelle statistische Orientierung auf Bevölkerungsebene anhand von Größe und Gewicht (kg/m²) bietet, differenziert er nicht zwischen Muskelmasse und Fettgewebe und erfasst kein tiefes viszerales Bauchfett. Erfahren Sie, wie Grundumsatz (BMR), Gesamtenergieumsatz (TDEE), Taillenumfang und regionale WHO-Schwellenwerte einen umfassenderen gesundheitlichen Kontext liefern.",
    colMetric: "Gesundheitsindikator",
    colStd: "Standard-Referenzfokus",
    colReal: "Bewerteter Aspekt",
    compRows: [
      { title: "Standard-BMI-Wert", std: "Gewicht im Verhältnis zur Größe² (kg/m²)", real: "Basis-Screening-Richtwert der WHO & CDC (verändert oder passt den BMI-Wert nicht an)" },
      { title: "Taille-zu-Größe-Verhältnis (WHtR)", std: "Screening zentraler Adipositas", real: "Unabhängige Risikobewertung von viszeralem Bauchfett" },
      { title: "Asiatische WHO-Grenzwerte", std: "Ethnische Schwellenwert-Anpassung", real: "Überarbeitete Übergewichts-Risikokategorie ab 23,0 kg/m²" },
      { title: "Stoffwechsel-Schätzungen (BMR & TDEE)", std: "Gleichungen zum Energieverbrauch", real: "Ergänzende Richtwerte für Kalorienbedarf und Ernährungsplanung" }
    ],
    ctaTitle: "Möchten Sie wissen, ob der BMI für Sie wirklich genau ist?",
    ctaDesc: "Lesen Sie unsere detaillierte Analyse zu Muskeldichte und WHO-Richtlinien.",
    ctaBtn: "Vollständigen Leitfaden Lesen: Wie Genau Ist Der BMI?"
  }
};

const t = data[lang] || data.en;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
  
  <!-- Section Header -->
  <div class="max-w-3xl space-y-3 mb-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-bold uppercase tracking-widest border border-[var(--accent)]/20">
      <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
      {t.eyebrow}
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-[1.08]">
      {t.mainTitle}
    </h2>

    <p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
      {t.mainSubtitle}
    </p>
  </div>

  <!-- 4 Feature Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {t.cards.map((card: any) => (
      <div class="group relative p-7 sm:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3 transition-all duration-300 hover:border-[var(--accent)] hover:shadow-lg hover:-translate-y-1">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-[var(--accent)] opacity-80">
          {card.tag}
        </span>
        <h3 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors">
          {card.title}
        </h3>
        <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
          {card.desc}
        </p>
      </div>
    ))}
  </div>

  <!-- Comparison Table: Standard BMI vs Real BMI -->
  <div class="mt-10 space-y-4">
    <div class="space-y-2 max-w-3xl">
      <p class="text-xs font-mono font-bold uppercase tracking-widest text-[var(--accent)]">{t.compBadge || "Methodology Comparison"}</p>
      <h3 class="text-lg sm:text-2xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-snug break-words">{t.compTitle || "Standard BMI vs. Real BMI Calculator"}</h3>
      {t.compDesc && (
        <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed font-medium pt-1">
          {t.compDesc}
        </p>
      )}
    </div>

    <!-- Desktop Table (hidden on mobile) -->
    <div class="hidden md:block rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-[var(--shadow-soft)] overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-[var(--muted)] text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)]">
            <th class="px-6 py-4 text-[var(--foreground)]">{t.colMetric || "Health Metric"}</th>
            <th class="px-6 py-4 text-[var(--foreground)]">{t.colStd || "Standard Baseline Focus"}</th>
            <th class="px-6 py-4 text-[var(--foreground)]">{t.colReal || "What It Evaluates"}</th>
          </tr>
        </thead>
        <tbody class="text-xs sm:text-sm font-medium divide-y divide-[var(--border)]/40">
          {(t.compRows || [
            { title: "Standard BMI Score", std: "Weight relative to height²", real: "WHO & CDC population screening baseline" },
            { title: "Waist-to-Height Ratio (WHtR)", std: "Central adiposity screening", real: "Abdominal visceral fat risk distribution" },
            { title: "WHO Asian Cutoff Guidelines", std: "Ethnic threshold adjustment", real: "Revised 23.0 kg/m² overweight risk category" },
            { title: "BMR & TDEE Metabolic Estimates", std: "Energy expenditure equations", real: "Estimated daily calorie maintenance requirements" }
          ]).map((row: any, i: number) => (
            <tr class={`hover:bg-[var(--muted)]/40 transition-colors ${i % 2 === 1 ? 'bg-[var(--muted)]/10' : ''}`}>
              <td class="px-6 py-4 font-bold text-[var(--foreground)] font-display uppercase">{row.title}</td>
              <td class="px-6 py-4 text-[var(--muted-foreground)]">{row.std}</td>
              <td class="px-6 py-4 text-[var(--foreground)]">{row.real}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Responsive Cards (visible on mobile, no side scrollbar) -->
    <div class="md:hidden space-y-3">
      {(t.compRows || [
        { title: "Standard BMI Score", std: "Weight relative to height²", real: "WHO & CDC population screening baseline" },
        { title: "Waist-to-Height Ratio (WHtR)", std: "Central adiposity screening", real: "Abdominal visceral fat risk distribution" },
        { title: "WHO Asian Cutoff Guidelines", std: "Ethnic threshold adjustment", real: "Revised 23.0 kg/m² overweight risk category" },
        { title: "BMR & TDEE Metabolic Estimates", std: "Energy expenditure equations", real: "Estimated daily calorie maintenance requirements" }
      ]).map((item: any) => (
        <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2 text-xs font-medium">
          <div class="font-bold text-[var(--foreground)] font-display uppercase text-xs border-b border-[var(--border)]/40 pb-2">{item.title}</div>
          <div class="space-y-1.5 pt-1">
            <div class="text-[var(--muted-foreground)]"><strong class="text-[var(--foreground)] font-semibold">{t.colStd || "Standard Focus"}:</strong> {item.std}</div>
            <div class="text-[var(--foreground)]"><strong class="text-[var(--foreground)] font-semibold">{t.colReal || "Evaluates"}:</strong> {item.real}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Editorial Article CTA Banner -->
  <div class="mt-8 p-6 sm:p-8 rounded-2xl border border-[var(--accent)]/30 bg-[var(--accent)]/5 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="space-y-1 text-center sm:text-left">
      <h4 class="text-lg font-bold text-[var(--foreground)]">{t.ctaTitle || "Want to know if BMI is actually accurate for you?"}</h4>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)]">{t.ctaDesc || "Read our analysis on published research, formula scaling, and WHO ethnic guidelines."}</p>
    </div>
    <a href={`/${lang}/blog/is-bmi-accurate`} class="calc-btn-gradient shrink-0 px-6 py-3.5 rounded-xl font-bold uppercase text-xs tracking-wider inline-flex items-center gap-2 transition-transform hover:scale-105">
      {t.ctaBtn || "Read Full Guide: Is BMI Accurate?"}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </a>
  </div>

</section>
