      },
      {
        tag: "06 / विशेष वर्ग",
        title: "विशेष आबादी की सीमाएं",
        desc: "मानक बीएमआई फॉर्मूला गर्भवती महिलाओं, 19 वर्ष से कम उम्र के बच्चों/किशोरों, 65+ वरिष्ठ नागरिकों और एथलीटों के लिए पूर्णतः सटीक नहीं होता है।"
      }
    ],
    compBadge: "नैदानिक साक्ष्य तुलना",
    compTitle: "मानक बीएमआई बनाम Real BMI कैलकुलेटर",
    colMetric: "नैदानिक मीट्रिक / सीमा",
    colStd: "मानक बीएमआई",
    colReal: "Real BMI कैलकुलेटर",
    compRows: [
