  },
  ko: {
    reviewedTag: "방법론 및 출처",
    reviewedTitle: "WHO 및 CDC 지침 준수",
    reviewedDesc: "모든 계산 및 건강 지표는 세계보건기구(WHO) 및 CDC의 발표된 수학적 공식과 참조 데이터를 기반으로 합니다.",
    boardLabel: "방법론 및 작성자",
    boardValue: "Bhawanshi Dosi 제작 및 관리",
    lastUpdated: "방법론 업데이트: 2026",
    icdCode: "참조 기반 계산기 방법론",
    sourcesTitle: "주요 출처 및 인용",
    sources: [
      { name: "WHO 비만 지침", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "세계보건기구" },
      { name: "ACS 체중 및 암 위험 표준", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "미국암학회" },
      { name: "CDC 성인 BMI 표준", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC 국립보건통계센터" },
      { name: "NIH 체성분 평가", url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2872290/", org: "미국 국립보건원" }
    ],
