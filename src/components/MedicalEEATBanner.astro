---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const labels: Record<string, any> = {
  en: {
    reviewedTag: "Methodology & Sources",
    reviewedTitle: "Based on Published WHO & CDC Guidelines",
    reviewedDesc: "All calculations, reference ranges, and health metrics are built using published mathematical equations and public health guidelines from the World Health Organization (WHO), American Cancer Society (ACS), and Centers for Disease Control and Prevention (CDC).",
    boardLabel: "Methodology & Author",
    boardValue: "Created & Maintained by Bhawanshi Dosi",
    lastUpdated: "Methodology updated: 2026",
    icdCode: "Reference-based calculator methodology",
    sourcesTitle: "Primary Reference Sources & Citations",
    sources: [
      { name: "WHO Obesity & Overweight Guidelines", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "World Health Organization" },
      { name: "ACS Body Weight & Health Reference Standards", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "American Cancer Society (ACS)" },
      { name: "CDC Adult BMI Reference Standards", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC National Center for Health Statistics" },
      { name: "NIH Body Composition Assessment", url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2872290/", org: "National Institutes of Health (PMC)" }
    ],
