---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const labels: Record<string, any> = {
  en: {
    reviewedTag: "Clinical E-E-A-T Standard",
    reviewedTitle: "Medically Reviewed & Scientifically Validated",
    reviewedDesc: "All calculations, reference ranges, and health metrics are calibrated using official guidelines from the World Health Organization (WHO), American Cancer Society (ACS), and Centers for Disease Control and Prevention (CDC).",
    boardLabel: "Reviewed by",
    boardValue: "Real BMI Clinical Editorial Board",
    lastUpdated: "Updated: 2026 Clinical Protocols",
    icdCode: "ICD-10-CM Z68 Verified",
    sourcesTitle: "Primary Scientific Sources & Citations",
    sources: [
      { name: "WHO Obesity & Overweight Guidelines", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "World Health Organization" },
      { name: "ACS Body Weight & Cancer Risk Standards", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "American Cancer Society (ACS)" },
      { name: "CDC Adult BMI Clinical Standard", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC National Center for Health Statistics" },
