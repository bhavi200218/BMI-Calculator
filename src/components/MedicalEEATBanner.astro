---

<section class="px-4 md:px-6 max-w-7xl mx-auto my-10 space-y-6">
  <div class="space-y-6">
    
    <!-- Top Badges Strip -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-semibold uppercase tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          {t.reviewedTag}
        </span>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium text-[var(--muted-foreground)] bg-[var(--muted)]/40 border border-[var(--border)]">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {t.icdCode}
        </span>
      </div>

      <span class="inline-flex items-center gap-1 text-xs font-sans text-[var(--muted-foreground)] opacity-90">
        <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t.lastUpdated}
      </span>
    </div>

    <!-- Main Content Grid: Reference Framework & Citations -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Title, Description & Reference Framework -->
      <div class="lg:col-span-7 space-y-4">
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold text-[var(--foreground)] tracking-tight">
            {t.reviewedTitle}
          </h2>
          <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
            {t.reviewedDesc}
          </p>
        </div>

        <div class="flex items-center gap-3 pt-1">
          <div class="w-9 h-9 rounded-full bg-[var(--accent)]/15 border border-[var(--accent)]/30 flex items-center justify-center text-[var(--accent)] font-bold shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-[var(--muted-foreground)] font-semibold">{t.boardLabel}</div>
            <div class="text-sm font-display font-bold text-[var(--foreground)]">{t.boardValue}</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Scientific Sources & Citations -->
      <div class="lg:col-span-5 bg-[var(--muted)]/20 p-4 sm:p-5 rounded-xl border border-[var(--border)]/70 space-y-3">
        <div class="flex items-center gap-2 text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
          <svg class="w-4 h-4 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          {t.sourcesTitle}
        </div>

        <div class="space-y-2">
          {t.sources.map((src: any) => (
            <a 
              href={src.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-2 p-2.5 rounded-lg bg-[var(--card)] border border-[var(--border)]/50 hover:border-[var(--accent)]/50 hover:shadow-xs transition-all text-xs font-medium text-[var(--foreground)]"
            >
              <div>
                <div class="font-semibold group-hover:text-[var(--accent)] transition-colors">{src.name}</div>
                <div class="text-xs text-[var(--muted-foreground)]">{src.org}</div>
              </div>
              <svg class="w-3.5 h-3.5 text-[var(--muted-foreground)] group-hover:text-[var(--accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Author & Research Team (E-E-A-T Compliance, pure SVG/CSS monogram badges, zero image files) -->
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 sm:p-6 space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border)]/50">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">{t.authorBadge}</span>
        </div>
        <a href={`/${lang}/about/#editorial-board`} class="text-xs font-display font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
          <span>{t.authorProfileLink}</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
        <!-- Lead Editorial & Research Team Column -->
        <div class="flex gap-4 items-start">
          <a href={`/${lang}/about/#editorial-board`} class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white font-display font-black text-base flex items-center justify-center shrink-0 shadow-md ring-2 ring-[var(--accent)]/30 hover:opacity-90 transition-opacity">
            RB
          </a>
          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <a href={`/${lang}/about/#editorial-board`} class="text-base font-display font-bold text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">
                {t.authorName}
              </a>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">{t.verifiedBadge || 'Verified Panel'}</span>
            </div>
            <p class="text-xs font-medium text-[var(--accent)]">{t.authorRole}</p>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-sans">{t.authorBio}</p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {t.authorCredentials.map((cred: string) => (
                <span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-medium bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">
                  {cred}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Evidence Review Protocol Column -->
        <div class="flex gap-4 items-start">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white font-display font-black text-base flex items-center justify-center shrink-0 shadow-md ring-2 ring-emerald-500/30">
            RB
          </div>
          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-display font-bold text-[var(--foreground)]">{t.reviewPanelName}</h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/30">{t.reviewProtocolTitle}</span>
            </div>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-sans">{t.reviewProtocolDesc}</p>
            <div class="flex flex-wrap gap-3 pt-1 text-xs font-medium">
              <a href={`/${lang}/editorial-policy/`} class="text-[var(--foreground)] hover:text-[var(--accent)] underline decoration-dotted transition-colors">{t.editorialPolicy}</a>
              <a href={`/${lang}/sources/`} class="text-[var(--foreground)] hover:text-[var(--accent)] underline decoration-dotted transition-colors">{t.scientificSources}</a>
              <a href={`/${lang}/contact/`} class="text-[var(--foreground)] hover:text-[var(--accent)] underline decoration-dotted transition-colors">{t.editorialContact}</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Seamless Medical Disclaimer -->
    <div class="text-xs text-[var(--muted-foreground)] font-sans leading-relaxed opacity-85 flex items-start gap-2 pt-2">
      <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{t.disclaimer}</span>
    </div>

  </div>
</section>
