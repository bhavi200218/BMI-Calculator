---

<div class="w-full pt-2 space-y-6">
  <div class="space-y-6">
    
    <!-- Top Badges Strip -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-semibold uppercase tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          {t.reviewedTag}<span class="sr-only">. </span>
        </span>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium text-[var(--muted-foreground)] bg-[var(--muted)]/40 border border-[var(--border)]">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {t.icdCode}<span class="sr-only">. </span>
        </span>
      </div>

      <span class="inline-flex items-center gap-1 text-xs font-sans text-[var(--muted-foreground)] opacity-90">
        <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t.lastUpdated}<span class="sr-only">. </span>
      </span>
    </div>

    <!-- Main Content Grid: Reference Framework & Citations -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Left Column: Title, Description & Reference Framework -->
      <div class="lg:col-span-6 space-y-3">
        <h3 class="text-base sm:text-lg font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
          {t.reviewedTitle}<span class="sr-only">. </span>
        </h3>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed">
          {t.reviewedDesc}
        </p>

        <div class="inline-flex items-center gap-2 pt-1 text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
          <span class="font-display font-semibold uppercase tracking-wider text-[var(--foreground)]">{t.boardLabel}:</span>
          <span class="text-[var(--muted-foreground)]">{t.boardValue}<span class="sr-only">. </span></span>
        </div>
      </div>

      <!-- Right Column: Scientific Sources & Citations (Clean 2x2 Grid) -->
      <div class="lg:col-span-6 space-y-2.5">
        <div class="flex items-center gap-2 text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
          <svg class="w-3.5 h-3.5 text-[var(--accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          {t.sourcesTitle}<span class="sr-only">. </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {t.sources.map((src: any) => (
            <a 
              href={src.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group flex flex-col justify-between p-2.5 rounded-lg bg-[var(--card)] border border-[var(--border)] hover:border-[var(--accent)]/60 hover:shadow-2xs transition-all text-xs"
            >
              <div class="flex items-start justify-between gap-1.5">
                <span class="font-semibold text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors line-clamp-1">{src.name}<span class="sr-only">. </span></span>
                <svg class="w-3 h-3 text-[var(--muted-foreground)] group-hover:text-[var(--accent)] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <span class="text-[11px] text-[var(--muted-foreground)] pt-0.5 line-clamp-1">{src.org}<span class="sr-only">. </span></span>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Author & Technical Verification (E-E-A-T Compliance, pure SVG/CSS monogram badges, zero image files) -->
    <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-4 sm:p-5 space-y-4">
      <div class="flex items-center gap-2 pb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)]">{t.authorBadge}<span class="sr-only">. </span></span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
        <!-- Lead Creator & Developer Column -->
        <div class="flex gap-3.5 items-start">
          <a href={`/${lang}/about/`} class="w-10 h-10 rounded-xl bg-gradient-to-br from-[var(--accent)] to-[#d44f30] text-white font-display font-black text-sm flex items-center justify-center shrink-0 shadow-2xs ring-1 ring-[var(--accent)]/30 hover:opacity-90 transition-opacity">
            {t.authorInitials || 'BD'}<span class="sr-only">. </span>
          </a>
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <a href={`/${lang}/about/`} class="text-sm sm:text-base font-display font-bold text-[var(--foreground)] hover:text-[var(--accent)] transition-colors">
                {t.authorName}<span class="sr-only">. </span>
              </a>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/30">{t.verifiedBadge || 'Developer'}<span class="sr-only">. </span></span>
            </div>
            <p class="text-xs font-medium text-[var(--accent)]">{t.authorRole}<span class="sr-only">. </span></p>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-sans">{t.authorBio}</p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {t.authorCredentials.map((cred: string) => (
                <span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-medium bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">
                  {cred}<span class="sr-only">. </span>
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Algorithmic Verification Protocol Column -->
        <div class="flex gap-3.5 items-start">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center shrink-0 shadow-2xs ring-1 ring-emerald-500/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h4 class="text-sm sm:text-base font-display font-bold text-[var(--foreground)]">{t.reviewPanelName}<span class="sr-only">. </span></h4>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/30">{t.reviewProtocolTitle}<span class="sr-only">. </span></span>
            </div>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-sans">{t.reviewProtocolDesc}</p>
            <div class="flex flex-wrap gap-3 pt-1 text-xs font-medium">
              <a href={`/${lang}/editorial-policy/`} class="text-[var(--foreground)] hover:text-[var(--accent)] underline decoration-dotted transition-colors">{t.editorialPolicy}</a><span class="sr-only">. </span>
              <a href={`/${lang}/sources/`} class="text-[var(--foreground)] hover:text-[var(--accent)] underline decoration-dotted transition-colors">{t.scientificSources}</a><span class="sr-only">. </span>
              <a href={`/${lang}/contact/`} class="text-[var(--foreground)] hover:text-[var(--accent)] underline decoration-dotted transition-colors">{t.editorialContact}</a><span class="sr-only">. </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Explicit Semantic Medical Disclaimer Region (Universal AdSense, YMYL & Quality Scanner Recognition) -->
    <aside id="medical-disclaimer" class="medical-disclaimer rounded-xl border border-amber-500/30 bg-amber-500/5 p-3.5 sm:p-4 text-xs text-[var(--foreground)] font-sans leading-relaxed space-y-1.5 shadow-2xs" aria-label="Medical Disclaimer">
      <div class="flex items-center gap-2 text-amber-500 font-display font-bold uppercase tracking-wider text-xs">
        <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>{disclaimerTitles[lang] || disclaimerTitles.en}</span>
      </div>
      <p class="text-[var(--muted-foreground)] leading-relaxed font-sans">
        {t.disclaimer}
      </p>
    </aside>

  </div>
</div>
