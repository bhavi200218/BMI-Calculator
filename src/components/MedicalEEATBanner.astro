  },
  ko: {
    reviewedTag: "임상 E-E-A-T 표준",
    reviewedTitle: "의학적 검토 및 과학적 검증 완료",
    reviewedDesc: "모든 계산 및 건강 지표는 세계보건기구(WHO), 미국암학회(ACS) 및 CDC의 공식 지침에 따라 보정됩니다.",
    boardLabel: "검토자",
