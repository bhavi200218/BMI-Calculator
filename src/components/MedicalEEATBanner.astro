      { name: "WHO 비만 지침", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "세계보건기구" },
      { name: "ACS 체중 및 암 위험 표준", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "미국암학회" },
      { name: "CDC 성인 BMI 임상 표준", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC 국립보건통계센터" },
      { name: "NIH 체성분 평가", url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2872290/", org: "미국 국립보건원" }
    ],
