  hi: {
    reviewedTag: "विधि एवं शोध स्रोत",
    reviewedTitle: "WHO एवं CDC दिशानिर्देशों के संदर्भों पर आधारित",
    reviewedDesc: "सभी गणनाएं और संदर्भ श्रेणियां विश्व स्वास्थ्य संगठन (WHO) और सीडीसी (CDC) के प्रकाशित गणितीय सूत्रों और संदर्भ डेटा पर आधारित हैं।",
    boardLabel: "विधि एवं रचयिता",
    boardValue: "Bhawanshi Dosi द्वारा निर्मित एवं संचालित",
    lastUpdated: "विधि अद्यतन: 2026",
    icdCode: "संदर्भ-आधारित कैलकुलेटर विधि",
    sourcesTitle: "प्राथमिक संदर्भ स्रोत और उद्धरण",
    sources: [
      { name: "डब्ल्यूएचओ मोटापा दिशानिर्देश", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "विश्व स्वास्थ्य संगठन" },
      { name: "अमेरिकन कैंसर सोसाइटी वजन एवं स्वास्थ्य गाइड", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "American Cancer Society (ACS)" },
      { name: "सीडीसी एडल्ट बीएमआई मानक", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "सीडीसी हेल्थ स्टैटिस्टिक्स" },
      { name: "एनआईएच शरीर संरचना मूल्यांकन", url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2872290/", org: "नेशनल इंस्टीट्यूट ऑफ हेल्थ" }
    ],
    disclaimer: "अस्वीकरण: Real BMI कैलकुलेटर केवल शैक्षिक और नियोजन उद्देश्यों के लिए अनुमान प्रदान करता है। यह कोई मेडिकल प्रैक्टिस या डॉक्टर द्वारा समीक्षित सेवा नहीं है।"
  },
  es: {
    reviewedTag: "Metodología y Fuentes",
    reviewedTitle: "Basado en Directrices de la OMS y los CDC",
    reviewedDesc: "Todos los cálculos y rangos de referencia se basan en fórmulas matemáticas publicadas y pautas oficiales de la OMS y los CDC.",
    boardLabel: "Metodología y Autor",
    boardValue: "Creado y Mantenido por Bhawanshi Dosi",
    lastUpdated: "Metodología actualizada: 2026",
    icdCode: "Metodología basada en referencias",
    sourcesTitle: "Fuentes Primarias y Citas",
    sources: [
      { name: "Pautas de Obesidad de la OMS", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "Organización Mundial de la Salud" },
      { name: "Estándares de Peso y Cáncer de la ACS", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "Sociedad Americana del Cáncer" },
      { name: "Estándar de IMC de los CDC", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC Centro de Estadísticas de Salud" },
      { name: "Evaluación de Composición Corporal de los NIH", url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2872290/", org: "Institutos Nacionales de Salud" }
    ],
    disclaimer: "Aviso Educativo: Real BMI Calculator proporciona estimaciones educativas basadas en datos poblacionales. Real BMI es un proyecto independiente y no una práctica médica."
  },
  fr: {
    reviewedTag: "Méthodologie & Sources",
    reviewedTitle: "Basé sur les Directives de l'OMS et des CDC",
    reviewedDesc: "Tous les calculs et plages de référence sont établis selon les formules publiées et les directives officielles de l'OMS et des CDC.",
    boardLabel: "Méthodologie & Auteur",
    boardValue: "Créé et Maintenu par Bhawanshi Dosi",
    lastUpdated: "Méthodologie mise à jour: 2026",
    icdCode: "Méthodologie basée sur des références",
    sourcesTitle: "Sources Scientifiques et Citations",
    sources: [
      { name: "Directives de l'OMS sur l'Obésité", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "Organisation Mondiale de la Santé" },
      { name: "Normes Poids et Cancer de l'ACS", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "American Cancer Society" },
      { name: "Norme d'IMC des CDC", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC National Center for Health Statistics" },
      { name: "Évaluation de la Composition Corporelle du NIH", url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2872290/", org: "National Institutes of Health" }
    ],
    disclaimer: "Avertissement Éducatif: Real BMI Calculator fournit des estimations éducatives. Il s'agit d'un projet indépendant et non d'un service médical."
  },
  de: {
    reviewedTag: "Methodik & Quellen",
    reviewedTitle: "Basiert auf WHO- & CDC-Richtlinien",
    reviewedDesc: "Alle Berechnungen und Referenzbereiche basieren auf veröffentlichten Formeln und offiziellen Richtlinien der WHO und CDC.",
    boardLabel: "Methodik & Autor",
    boardValue: "Erstellt & Gepflegt von Bhawanshi Dosi",
    lastUpdated: "Methodik aktualisiert: 2026",
    icdCode: "Referenzbasierte Rechner-Methodik",
    sourcesTitle: "Primäre Quellen & Zitate",
    sources: [
      { name: "WHO Adipositas-Richtlinien", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight", org: "Weltgesundheitsorganisation" },
      { name: "ACS Gewicht & Krebsrisiko Standards", url: "https://www.cancer.org/cancer/risk-prevention/diet-physical-activity/body-weight-and-cancer-risk.html", org: "American Cancer Society" },
      { name: "CDC Erwachsenen-BMI-Standard", url: "https://www.cdc.gov/healthyweight/assessing/bmi/adult_bmi/index.html", org: "CDC National Center for Health Statistics" },
