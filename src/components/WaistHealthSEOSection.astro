---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const translations: Record<string, any> = {
  en: {
    badge: "WHO & NIH Health References",
    title: "BMI & Waist Circumference: Dual Health Screening",
    subtitle: "Why global medical institutions evaluate Body Mass Index (BMI) alongside Waist Circumference to detect hidden metabolic and cardiovascular risks.",
    heroTitle: "Why BMI Alone Isn't the Whole Picture",
    heroDesc: "Traditional Body Mass Index (BMI = kg/m²) is an essential population screening metric, but it cannot differentiate between muscle mass and visceral abdominal fat. Leading global health authorities—including the World Health Organization (WHO) and National Institutes of Health (NIH)—recommend pairing BMI with waist circumference for a broader educational health screening.",
    cards: [
      {
        title: "1. Central Obesity vs. Subcutaneous Fat",
        desc: "Subcutaneous fat on arms or legs is relatively benign. In contrast, visceral abdominal fat ('central obesity') surrounds vital internal organs and secretes inflammatory cytokines that increase heart disease and Type 2 Diabetes risk."
      },
      {
        title: "2. The 'Normal BMI' Central Obesity Paradox",
        desc: "Up to 15% of adults with a 'Normal' BMI (18.5 – 24.9 kg/m²) carry excessive waist circumference. This hidden visceral adiposity carries metabolic risk profiles similar to clinical obesity."
      },
      {
        title: "3. The 0.5 Waist-to-Height Rule",
        desc: "Medical guidelines suggest keeping your waist circumference to less than half your height (Waist ÷ Height < 0.5). A ratio over 0.5 indicates increased cardiovascular strain regardless of body weight."
      }
    ],
    tableTitle: "Combined BMI & Waist Circumference Health Risk Matrix",
    tableHeaders: ["BMI Category", "BMI Range", "Men Waist ≤102cm / Women ≤88cm", "Men Waist >102cm / Women >88cm (High Waist)"],
    tableRows: [
      { cat: "Underweight", range: "< 18.5 kg/m²", lowRisk: "Optimal Baseline Indicator", highRisk: "Elevated Indicator" },
      { cat: "Normal Weight", range: "18.5 – 24.9 kg/m²", lowRisk: "Minimal Risk (Reference Window)", highRisk: "Elevated Indicator (Visceral Context)" },
      { cat: "Overweight", range: "25.0 – 29.9 kg/m²", lowRisk: "Elevated Indicator", highRisk: "High Screening Indicator" },
      { cat: "Obesity Class I", range: "30.0 – 34.9 kg/m²", lowRisk: "High Screening Indicator", highRisk: "Elevated Screening Indicator" },
      { cat: "Obesity Class II & III", range: "≥ 35.0 kg/m²", lowRisk: "Elevated Screening Indicator", highRisk: "Substantial Screening Indicator" }
    ],
    disclaimer: "Guidance Note: This screening matrix aligns with published reference standards from NIH & WHO health guidelines. It serves as an educational risk indicator and does not replace professional medical advice."
  },
  hi: {
    badge: "WHO एवं NIH स्वास्थ्य संदर्भ",
    title: "बीएमआई एवं कमर की परिधि: संयुक्त स्वास्थ्य संदर्भ",
    subtitle: "स्वास्थ्य संस्थान चयापचय और शारीरिक संदर्भ के लिए बॉडी मास इंडेक्स (BMI) के साथ कमर का आकार क्यों मापते हैं।",
    heroTitle: "बीएमआई अकेला पूरा सच क्यों नहीं है?",
    heroDesc: "पारंपरिक बॉडी मास इंडेक्स (BMI = kg/m²) एक महत्वपूर्ण प्राथमिक जांच मीट्रिक है, लेकिन यह मांसपेशियों और पेट के अंदरूनी विसरल फैट के बीच अंतर नहीं कर पाता है। एनआईएच (NIH) और डब्ल्यूएचओ (WHO) जैसे स्वास्थ्य संस्थान व्यापक स्वास्थ्य संदर्भ के लिए बीएमआई के साथ कमर की परिधि मापने की सलाह देते हैं।",
    cards: [
      {
        title: "1. पेट की विसरल वसा बनाम चमड़ी की वसा",
        desc: "हाथ-पैरों पर जमा चमड़ी के नीचे की वसा कम हानिकारक होती है। इसके विपरीत, पेट के अंगों को घेरने वाली विसरल वसा (Central Obesity) चयापचय संबंधी चिंताओं को बढ़ा सकती है।"
      },
      {
        title: "2. 'सामान्य बीएमआई' पर भी पेट की वसा का जोखिम",
        desc: "सामान्य बीएमआई (18.5 – 24.9 kg/m²) वाले लगभग 15% लोगों में भी कमर का आकार अधिक हो सकता है। यह छिपा हुआ विसरल फैट अतिरिक्त स्वास्थ्य संदर्भ प्रदान करता है।"
      },
      {
        title: "3. 0.5 कमर-से-ऊंचाई का नियम",
        desc: "स्वास्थ्य दिशानिर्देश सलाह देते हैं कि अपनी कमर का आकार अपनी ऊंचाई के आधे से कम रखें (कमर ÷ ऊंचाई < 0.5)।"
      }
    ],
    tableTitle: "संयुक्त बीएमआई एवं कमर परिधि स्वास्थ्य संदर्भ तालिका",
    tableHeaders: ["बीएमआई श्रेणी", "बीएमआई सीमा", "पुरुष कमर ≤102cm / महिला ≤88cm", "पुरुष कमर >102cm / महिला >88cm (अधिक कमर)"],
    tableRows: [
      { cat: "कम वजन (Underweight)", range: "< 18.5 kg/m²", lowRisk: "कम जोखिम", highRisk: "बढ़ा हुआ संकेतक" },
      { cat: "सामान्य वजन (Normal)", range: "18.5 – 24.9 kg/m²", lowRisk: "न्यूनतम जोखिम (संदर्भ सीमा)", highRisk: "बढ़ा हुआ संकेतक (पेट की वसा)" },
      { cat: "अधिक वजन (Overweight)", range: "25.0 – 29.9 kg/m²", lowRisk: "बढ़ा हुआ संकेतक", highRisk: "उच्च स्क्रीनिंग संकेतक" },
      { cat: "मोटापा श्रेणी I (Obesity I)", range: "30.0 – 34.9 kg/m²", lowRisk: "उच्च स्क्रीनिंग संकेतक", highRisk: "अधिक स्क्रीनिंग संकेतक" },
      { cat: "मोटापा श्रेणी II और III", range: "≥ 35.0 kg/m²", lowRisk: "अधिक स्क्रीनिंग संकेतक", highRisk: "गंभीर स्क्रीनिंग संकेतक" }
    ],
    disclaimer: "मार्गदर्शन टिप्पणी: यह तालिका एनआईएच और डब्ल्यूएचओ दिशानिर्देशों के आधार पर तैयार की गई है। यह डॉक्टरी सलाह का विकल्प नहीं है।"
  },
  es: {
    badge: "Referencias de Salud OMS y NIH",
    title: "IMC y Circunferencia de Cintura: Contexto de Evaluación",
    subtitle: "Por qué las instituciones de salud evalúan el Índice de Masa Corporal (IMC) junto con la circunferencia de cintura para evaluar indicadores metabólicos.",
    heroTitle: "¿Por qué el IMC por sí solo no es suficiente?",
    heroDesc: "El IMC tradicional es una métrica de evaluación esencial, pero no distingue entre masa muscular y grasa abdominal visceral. Las autoridades de salud recomiendan evaluar el IMC junto con la cintura.",
    cards: [
      { title: "1. Obesidad Central vs. Grasa Subcutánea", desc: "La grasa visceral profunda alrededor de los órganos abdominales incrementa los indicadores metabólicos." },
      { title: "2. La Paradoja del IMC Normal", desc: "Hasta un 15% de los adultos con IMC normal presentan circunferencia de cintura elevada." },
      { title: "3. La Regla del 0.5 Cintura-Altura", desc: "Se sugiere mantener la circunferencia de cintura en menos de la mitad de la altura (Cintura ÷ Altura < 0.5)." }
    ],
    tableTitle: "Matriz de Evaluación: IMC y Cintura",
    tableHeaders: ["Categoría IMC", "Rango IMC", "Hombres ≤102cm / Mujeres ≤88cm", "Hombres >102cm / Mujeres >88cm"],
    tableRows: [
      { cat: "Bajo Peso", range: "< 18.5 kg/m²", lowRisk: "Bajo Riesgo", highRisk: "Indicador Elevado" },
      { cat: "Peso Normal", range: "18.5 – 24.9 kg/m²", lowRisk: "Riesgo Mínimo (Línea de Base)", highRisk: "Indicador Elevado (Grasa Visceral)" },
      { cat: "Sobrepeso", range: "25.0 – 29.9 kg/m²", lowRisk: "Indicador Elevado", highRisk: "Alto Indicador de Evaluación" },
      { cat: "Obesidad Clase I", range: "30.0 – 34.9 kg/m²", lowRisk: "Alto Indicador", highRisk: "Indicador Elevado" },
      { cat: "Obesidad Clase II y III", range: "≥ 35.0 kg/m²", lowRisk: "Indicador Elevado", highRisk: "Indicador Sustancial" }
    ],
    disclaimer: "Nota Informativa: Esta matriz de evaluación se alinea con los estándares de la OMS y los NIH."
  },
  fr: {
    badge: "Références de Santé OMS & NIH",
    title: "IMC & Tour de Taille : Contextualisation de Santé",
    subtitle: "Pourquoi les institutions de santé évaluent l'Indice de Masse Corporelle (IMC) avec le tour de taille pour apprécier les métriques métaboliques.",
    heroTitle: "Pourquoi l'IMC seul ne suffit pas",
    heroDesc: "L'IMC traditionnel est une métrique essentielle mais ne distingue pas la masse musculaire de la graisse viscérale abdominale.",
    cards: [
      { title: "1. Obésité Centrale vs Graisse Sous-cutanée", desc: "La graisse viscérale abdominale profonde augmente les facteurs de risque métaboliques." },
      { title: "2. Le Paradoxe de l'IMC Normal", desc: "Jusqu'à 15% des adultes avec un IMC normal présentent un tour de taille élevé." },
      { title: "3. La Règle 0.5 Taille-Taille", desc: "Maintenez votre tour de taille à moins de la moitié de votre taille en hauteur (Taille ÷ Hauteur < 0.5)." }
    ],
    tableTitle: "Matrice d'Évaluation de Santé : IMC & Tour de Taille",
    tableHeaders: ["Catégorie IMC", "Plage IMC", "Hommes ≤102cm / Femmes ≤88cm", "Hommes >102cm / Femmes >88cm"],
    tableRows: [
      { cat: "Insuffisance Pondérale", range: "< 18.5 kg/m²", lowRisk: "Faible Risque", highRisk: "Indicateur Élevé" },
      { cat: "Poids Normal", range: "18.5 – 24.9 kg/m²", lowRisk: "Risque Minimal", highRisk: "Indicateur Élevé (Graisse Viscérale)" },
      { cat: "Surpoids", range: "25.0 – 29.9 kg/m²", lowRisk: "Indicateur Élevé", highRisk: "Indicateur de Dépistage Élevé" },
      { cat: "Obésité Classe I", range: "30.0 – 34.9 kg/m²", lowRisk: "Indicateur Élevé", highRisk: "Indicateur Substantiel" },
      { cat: "Obésité Classe II & III", range: "≥ 35.0 kg/m²", lowRisk: "Indicateur Substantiel", highRisk: "Indicateur Majeur" }
    ],
    disclaimer: "Note d'Information : Cette matrice de dépistage s'aligne sur les normes de l'OMS et des NIH."
  },
  de: {
    badge: "Gesundheitsreferenzen der WHO & NIH",
    title: "BMI & Taillenumfang: Kontextuelle Bewertung",
    subtitle: "Warum Gesundheitseinrichtungen den Body-Mass-Index (BMI) zusammen mit dem Taillenumfang bewerten.",
    heroTitle: "Warum der BMI alleine nicht das ganze Bild zeigt",
    heroDesc: "Der traditionelle BMI ist eine wichtige Kennzahl, unterscheidet jedoch nicht zwischen Muskelmasse und viszeralem Bauchfett.",
    cards: [
      { title: "1. Zentrale Adipositas vs. Subkutanes Fett", desc: "Viszerales Bauchfett stellt einen wichtigen metabolischen Indikator dar." },
      { title: "2. Das BMI-Normal-Paradoxon", desc: "Bis zu 15% der Erwachsenen mit 'normalem' BMI weisen einen erhöhten Taillenumfang auf." },
      { title: "3. Die 0,5-Taillen-Höhen-Regel", desc: "Empfehlung: Taillenumfang weniger als die Hälfte der Körpergröße (Taille ÷ Höhe < 0,5)." }
    ],
    tableTitle: "Gesundheits-Bewertungs-Matrix: BMI & Taillenumfang",
    tableHeaders: ["BMI-Kategorie", "BMI-Bereich", "Männer ≤102cm / Frauen ≤88cm", "Männer >102cm / Frauen >88cm"],
    tableRows: [
      { cat: "Untergewicht", range: "< 18.5 kg/m²", lowRisk: "Niedriges Risiko", highRisk: "Erhöhtes Risiko" },
      { cat: "Normalgewicht", range: "18.5 – 24.9 kg/m²", lowRisk: "Minimales Risiko", highRisk: "Erhöhter Indikator (Viszeralfett)" },
      { cat: "Übergewicht", range: "25.0 – 29.9 kg/m²", lowRisk: "Erhöhter Indikator", highRisk: "Hoher Dépistage-Indikator" },
      { cat: "Adipositas Klasse I", range: "30.0 – 34.9 kg/m²", lowRisk: "Hoher Indikator", highRisk: "Substanzieller Indikator" },
      { cat: "Adipositas Klasse II & III", range: "≥ 35.0 kg/m²", lowRisk: "Substanzieller Indikator", highRisk: "Wesentlicher Indikator" }
    ],
    disclaimer: "Hinweis: Diese Matrix orientiert sich an den Standards der WHO und NIH."
  },
  ko: {
    badge: "WHO 및 NIH 건강 참고 기준",
    title: "BMI 및 허리둘레: 건강 스크리닝 참고",
    subtitle: "전 세계 보건 기관이 체질량지수(BMI)와 허리둘레를 함께 참조하는 이유.",
    heroTitle: "BMI 단독 측정의 한계",
    heroDesc: "전통적인 BMI는 중요한 선별 지표이지만 근육량과 복부 내장지방을 구분하지 못합니다.",
    cards: [
      { title: "1. 복부 비만 vs 피하 지방", desc: "복부 장기 주변의 내장지방은 중요한 대사적 건강 지표입니다." },
      { title: "2. 정상 BMI의 복부 비만 역설", desc: "정상 BMI 성인의 최대 15%가 과도한 허리둘레를 나타냅니다." },
      { title: "3. 0.5 허리-신장 비율 법칙", desc: "허리둘레를 키의 절반 이하로 유지하는 것을 권장합니다 (허리둘레 ÷ 키 < 0.5)." }
    ],
    tableTitle: "BMI 및 허리둘레 건강 참고 행렬",
    tableHeaders: ["BMI 범주", "BMI 범위", "남성 ≤102cm / 여성 ≤88cm", "남성 >102cm / 여성 >88cm"],
    tableRows: [
      { cat: "저체중", range: "< 18.5 kg/m²", lowRisk: "낮은 위험", highRisk: "지표 증가" },
      { cat: "정상 체중", range: "18.5 – 24.9 kg/m²", lowRisk: "최소 위험 (기준)", highRisk: "위험 지표 증가 (내장지방)" },
      { cat: "과체중", range: "25.0 – 29.9 kg/m²", lowRisk: "지표 증가", highRisk: "높은 스크리닝 지표" },
      { cat: "1단계 비만", range: "30.0 – 34.9 kg/m²", lowRisk: "높은 스크리닝 지표", highRisk: "상승된 스크리닝 지표" },
      { cat: "2단계 및 3단계 비만", range: "≥ 35.0 kg/m²", lowRisk: "상승된 스크리닝 지표", highRisk: "주요 스크리닝 지표" }
    ],
    disclaimer: "안내 참고 사항: 이 스크리닝 행렬은 WHO 및 NIH 건강 기준에 따릅니다."
  }
};

const t = translations[lang] || translations.en;
---

<section class="px-4 md:px-6 my-10 max-w-7xl mx-auto space-y-8">
    
    <!-- Top Pill & Title -->
    <div class="space-y-3 max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[var(--accent)]/30 bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
        {t.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Hero Card Breakdown -->
    <div class="p-6 rounded-2xl border border-[var(--accent)]/20 bg-[var(--accent)]/5 space-y-3">
      <h3 class="text-lg font-display font-bold text-[var(--foreground)]">{t.heroTitle}</h3>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{t.heroDesc}</p>
    </div>

    <!-- 3 Core Medical Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.cards.map((card: any) => (
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-3 transition-all duration-200 hover:border-[var(--accent)]/40">
          <h4 class="text-base font-display font-bold text-[var(--foreground)]">{card.title}</h4>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{card.desc}</p>
        </div>
      ))}
    </div>

    <!-- Combination Table -->
    <div class="space-y-4">
      <h3 class="text-base sm:text-xl font-display font-bold uppercase tracking-tight leading-snug break-words text-[var(--foreground)]">
        {t.tableTitle}
      </h3>
    <!-- Combination Table (Desktop Table) -->
    <div class="hidden md:block overflow-x-auto rounded-2xl border border-[var(--border)] bg-[var(--card)]">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead class="bg-[var(--muted)]/60 text-[var(--foreground)] font-display font-bold uppercase tracking-wider border-b border-[var(--border)]">
          <tr>
            {t.tableHeaders.map((head: string) => (
              <th class="p-3.5 sm:p-4">{head}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--border)] font-medium text-[var(--muted-foreground)]">
          {t.tableRows.map((row: any) => (
            <tr class="hover:bg-[var(--muted)]/20 transition-colors">
              <td class="p-3.5 sm:p-4 font-bold text-[var(--foreground)]">{row.cat}</td>
              <td class="p-3.5 sm:p-4 font-mono">{row.range}</td>
              <td class="p-3.5 sm:p-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                  {row.lowRisk}
                </span>
              </td>
              <td class="p-3.5 sm:p-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/30">
                  {row.highRisk}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Stacked Card Matrix (No side scrollbar on mobile) -->
    <div class="md:hidden space-y-3">
      {t.tableRows.map((row: any) => (
        <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2 text-xs font-medium">
          <div class="flex items-center justify-between border-b border-[var(--border)]/40 pb-2">
            <span class="font-bold text-[var(--foreground)] font-display uppercase">{row.cat}</span>
            <span class="font-mono text-[var(--accent)] font-semibold">{row.range}</span>
          </div>
          <div class="space-y-1.5 pt-0.5">
            <div class="flex items-center justify-between text-xs">
              <span class="text-[var(--muted-foreground)]">Normal Waist:</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                {row.lowRisk}
              </span>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span class="text-[var(--muted-foreground)]">Elevated Waist:</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/30">
                {row.highRisk}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
    </div>

    <!-- Medical Note -->
    <p class="text-xs text-[var(--muted-foreground)] italic font-medium pt-2 border-t border-[var(--border)]/40">
      {t.disclaimer}
    </p>

</section>
