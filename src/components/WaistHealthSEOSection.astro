      { cat: "सामान्य वजन (Normal)", range: "18.5 – 24.9 kg/m²", lowRisk: "न्यूनतम जोखिम (उत्तम)", highRisk: "बढ़ा हुआ जोखिम (पेट की वसा)" },
      { cat: "अधिक वजन (Overweight)", range: "25.0 – 29.9 kg/m²", lowRisk: "बढ़ा हुआ जोखिम", highRisk: "उच्च हृदय जोखिम" },
      { cat: "मोटापा श्रेणी I (Obesity I)", range: "30.0 – 34.9 kg/m²", lowRisk: "उच्च जोखिम", highRisk: "अत्यधिक उच्च जोखिम" },
      { cat: "मोटापा श्रेणी II और III", range: "≥ 35.0 kg/m²", lowRisk: "अत्यधिक उच्च जोखिम", highRisk: "अत्यंत गंभीर जोखिम" }
