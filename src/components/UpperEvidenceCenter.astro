---

<section id="upper-evidence-hub" class="space-y-10 not-prose">

  <!-- Header for Upper Evidence Hub -->
  <div class="text-center max-w-4xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--accent)]/20 bg-[var(--accent)]/5 text-xs font-display font-bold uppercase tracking-[0.2em] text-[var(--accent)] shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
      {current.sectionEyebrow}
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
      {current.sectionTitle}
    </h2>
    <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed max-w-2xl mx-auto">
      {current.sectionSubtitle}
    </p>
  </div>

  <!-- 4 Interactive Research & Evidence Pillar Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {current.pillars.map(pillar => (
      <a 
        href={pillar.href}
        class="group p-5 sm:p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--card)]/90 hover:border-[var(--accent)]/60 transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between gap-5 relative overflow-hidden"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold font-mono tracking-wider bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20 uppercase">
              {pillar.badge}
            </span>
            <div class="w-8 h-8 rounded-lg bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.iconPath}></path>
              </svg>
            </div>
          </div>

          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-[var(--accent)] font-display">{pillar.eyebrow}</p>
            <h3 class="text-lg font-bold font-display uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors mt-0.5">
              {pillar.title}
            </h3>
          </div>

          <p class="text-xs text-[var(--muted-foreground)] leading-relaxed font-sans line-clamp-3">
            {pillar.desc}
          </p>
        </div>

        <div class="pt-2 border-t border-[var(--border)]/60 flex items-center justify-between text-xs font-bold text-[var(--accent)] group-hover:translate-x-0.5 transition-transform">
          <span>{pillar.linkText}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </div>
      </a>
    ))}
  </div>

  <!-- Executive Clinical Evidence Matrix Table -->
  <div class="p-6 sm:p-8 rounded-2xl border border-[var(--border)] bg-[var(--card)]/80 shadow-xs space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[var(--border)]/60 pb-4">
      <div>
        <h3 class="text-base sm:text-lg font-bold font-display uppercase tracking-tight text-[var(--foreground)]">
          {current.tableTitle}
        </h3>
        <p class="text-xs text-[var(--muted-foreground)] font-medium mt-0.5">
          {current.tableSubtitle}
        </p>
      </div>
      <a 
        href={`/${lang}/sources/`} 
        class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--accent)] hover:underline decoration-dotted shrink-0"
      >
        <span>View Full 15 Studies Matrix →</span>
      </a>
    </div>

    <!-- Academic Evidence Table with Required Styles -->
    <div class="overflow-x-auto">
      <table class="evidence-matrix-table w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr>
            <th class="p-3">{current.colDomain}</th>
            <th class="p-3">{current.colStudy}</th>
            <th class="p-3">{current.colGuide}</th>
            <th class="p-3">{current.colTool}</th>
          </tr>
        </thead>
        <tbody>
          {current.matrixRows.map(row => (
            <tr>
              <td class="p-3 font-semibold text-[var(--foreground)]">{row.domain}</td>
              <td class="p-3 font-mono text-[11px] sm:text-xs">
                <a href={row.studyLink} target="_blank" rel="noopener noreferrer" class="hover:underline">
                  {row.study}
                </a>
              </td>
              <td class="p-3">
                <a href={`/${lang}/blog/${row.guideSlug}/`} class="font-medium hover:underline">
                  {row.guideTitle}
                </a>
              </td>
              <td class="p-3">
                <a href={`/${lang}/${row.toolSlug}/`} class="font-medium hover:underline">
                  {row.toolTitle} →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

</section>

<style>
  /* Academic Reference & Table Standards */
  .evidence-matrix-table a {
    text-decoration: none;
    color: #464feb;
  }
  .evidence-matrix-table a:hover {
    text-decoration: underline;
  }
  .evidence-matrix-table tr th,
  .evidence-matrix-table tr td {
    border: 1px solid #e6e6e6;
  }
  .evidence-matrix-table tr th {
    background-color: #f5f5f5;
    color: #1e293b;
    font-weight: 700;
  }
  :global(.dark) .evidence-matrix-table tr th,
  :global(.dark) .evidence-matrix-table tr td {
    border-color: rgba(255, 255, 255, 0.12);
  }
  :global(.dark) .evidence-matrix-table tr th {
    background-color: rgba(255, 255, 255, 0.05);
    color: #f1f5f9;
  }
</style>
