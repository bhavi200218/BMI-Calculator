---

<section class="my-12 px-4 md:px-6 max-w-7xl mx-auto">
  <div class="rounded-3xl border border-[var(--border)] bg-gradient-to-b from-[var(--card)] to-[var(--muted)]/20 p-6 sm:p-10 shadow-sm space-y-8">
    
    <!-- Header -->
    <div class="space-y-3 max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[var(--accent)]/30 bg-[var(--accent)]/10 text-[var(--accent)] text-xs font-display font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
        {t.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-medium leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Formula Box -->
    <div class="p-5 sm:p-6 rounded-2xl border border-[var(--accent)]/20 bg-[var(--accent)]/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="text-xs font-display font-semibold uppercase tracking-widest text-[var(--accent)]">{t.formulaTitle}</div>
        <div class="text-lg sm:text-xl font-mono font-bold text-[var(--foreground)]">{t.formulaText}</div>
      </div>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium max-w-lg leading-snug">
        {t.formulaNote}
      </p>
    </div>

    <!-- 3 Core Clinical Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.cards.map((card: any) => (
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-3 transition-all duration-200 hover:border-[var(--accent)]/40 hover:shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-[var(--accent)]/15 border border-[var(--accent)]/30 flex items-center justify-center text-[var(--accent)]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-display font-bold text-[var(--foreground)]">{card.title}</h3>
          <p class="text-xs sm:text-sm text-[var(--muted-foreground)] font-medium leading-relaxed">{card.desc}</p>
        </div>
      ))}
    </div>

    <!-- Risk Matrix Table -->
    <div class="space-y-4">
      <h3 class="text-base sm:text-xl font-display font-bold uppercase tracking-tight leading-snug break-words text-[var(--foreground)]">
        {t.riskMatrixTitle}
      </h3>
      <!-- Desktop Table (hidden on mobile) -->
      <div class="hidden md:block overflow-x-auto rounded-2xl border border-[var(--border)] bg-[var(--card)]">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-[var(--muted)]/50 text-[var(--foreground)] font-display font-bold uppercase tracking-wider border-b border-[var(--border)]">
            <tr>
              {t.matrixHeaders.map((head: string) => (
                <th class="p-3.5 sm:p-4">{head}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)] font-medium text-[var(--muted-foreground)]">
            {t.matrixRows.map((row: any) => (
              <tr class="hover:bg-[var(--muted)]/20 transition-colors">
                <td class="p-3.5 sm:p-4 font-bold text-[var(--foreground)]">{row.cat}</td>
                <td class="p-3.5 sm:p-4 font-mono">{row.std}</td>
                <td class="p-3.5 sm:p-4 font-mono text-[var(--accent)] font-semibold">{row.asian}</td>
                <td class="p-3.5 sm:p-4">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                    row.status === 'danger' ? 'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/30' :
                    row.status === 'warning' ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30' :
                    'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30'
                  }`}>
                    {row.risk}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Stacked Card Matrix (No side scroller on mobile) -->
      <div class="md:hidden space-y-3">
        {t.matrixRows.map((row: any) => (
          <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] space-y-2 text-xs font-medium">
            <div class="flex items-center justify-between border-b border-[var(--border)]/40 pb-2">
              <span class="font-bold text-[var(--foreground)] font-display uppercase">{row.cat}</span>
              <span class={`inline-block px-2 py-0.5 rounded-full text-[11px] font-semibold ${
                row.status === 'danger' ? 'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/30' :
                row.status === 'warning' ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30' :
                'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30'
              }`}>
                {row.risk}
              </span>
            </div>
            <div class="space-y-1 pt-0.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-[var(--muted-foreground)]">Standard Cutoff:</span>
                <span class="font-mono font-semibold text-[var(--foreground)]">{row.std}</span>
              </div>
              <div class="flex items-center justify-between text-xs">
                <span class="text-[var(--muted-foreground)]">Asian / Ethnic Cutoff:</span>
                <span class="font-mono font-semibold text-[var(--accent)]">{row.asian}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Medical Note -->
    <p class="text-xs text-[var(--muted-foreground)] italic font-medium pt-2 border-t border-[var(--border)]/40">
      {t.disclaimer}
    </p>

  </div>
</section>
