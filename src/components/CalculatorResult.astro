---
import { getCalculatorTranslations, type Locale } from '../utils/calculators';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getCalculatorTranslations(lang);

const studioEyebrow = {
  en: 'Interactive Result Studio',
  es: 'Panel de Resultados Interactivo',
  fr: 'Studio de Résultats Interactif',
  de: 'Interaktives Ergebnis-Studio',
  ko: '실시간 결과 스튜디오',
  hi: 'इंटरएक्टिव परिणाम स्टूडियो'
}[lang];

const resultEyebrow = {
  en: 'Calculated Metric',
  es: 'Métrica Calculada',
  fr: 'Métrique Calculée',
  de: 'Berechneter Wert',
  ko: '계산된 지표',
  hi: 'गणना की गई माप'
}[lang];
---

<div id="resultStudio" class="melove-result-card flex flex-col h-full overflow-hidden w-full max-w-full">

  <!-- ── INITIAL STATE ─────────────────────────── -->
  <div id="initialState" class="flex-1 flex flex-col items-center justify-center gap-4 sm:gap-6 p-6 sm:p-10 text-center min-h-[260px] sm:min-h-[300px]" role="status" aria-live="polite">
    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-dashed border-[var(--border)] flex items-center justify-center shrink-0">
      <svg class="w-7 h-7 sm:w-8 sm:h-8 text-[var(--muted-foreground)] opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <div class="space-y-2 sm:space-y-3">
      <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{studioEyebrow}</p>
      <p class="text-sm sm:text-base text-[var(--muted-foreground)] font-semibold">{t.waiting}</p>
    </div>
  </div>

  <!-- ── RESULT STATE ──────────────────────────── -->
  <div id="resultContent" class="hidden flex-1 flex flex-col" aria-hidden="true">

    <!-- Top Bar -->
    <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5 p-4 sm:p-6 md:px-10 md:pt-10 pb-4 border-b border-[var(--border)]">
      <div>
        <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">{resultEyebrow}</p>
        <h3 id="resultHeaderLabel" class="text-xl sm:text-2xl font-display font-bold uppercase text-[var(--foreground)] break-words"></h3>
      </div>
      <span id="primaryUnitLabel" class="hidden px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full bg-[var(--accent)] text-[var(--accent-foreground)] text-[11px] sm:text-xs font-display font-semibold uppercase tracking-widest whitespace-nowrap shadow-[var(--shadow-accent)] shrink-0"></span>
    </div>

    <!-- Big Score Display -->
    <div class="flex-1 flex flex-col justify-between p-4 sm:p-6 md:px-10 md:pb-10 space-y-6 sm:space-y-8">

      <div class="text-center py-2 sm:py-4">
        <div id="primaryDisplay" class="text-4xl sm:text-6xl md:text-7xl font-display font-bold tracking-tighter leading-none text-[var(--foreground)] break-words"></div>
        <p id="primaryNameLabel" class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--muted-foreground)] mt-3 sm:mt-4"></p>
      </div>

      <!-- Stats Grid -->
      <div id="secondaryGrid" class="grid grid-cols-1 min-[380px]:grid-cols-2 gap-3 sm:gap-4">
        <!-- Rendered dynamically on custom event -->
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4 pt-2">
        <button id="copyBtn" class="py-3.5 sm:py-5 rounded-[var(--radius-sm)] bg-[var(--muted)] border-[1.5px] border-[var(--border)] text-[11px] sm:text-xs font-display font-bold uppercase tracking-widest hover:border-[var(--accent)] hover:bg-[var(--card-hover)] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer text-[var(--foreground)]">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          {lang === 'es' ? 'Copiar' : lang === 'fr' ? 'Copier' : lang === 'de' ? 'Kopieren' : lang === 'ko' ? '복사' : lang === 'hi' ? 'कॉपी करें' : 'Copy'}
        </button>
        <button id="shareBtn" class="py-3.5 sm:py-5 rounded-[var(--radius-sm)] bg-[var(--foreground)] text-[var(--background)] text-[11px] sm:text-xs font-display font-bold uppercase tracking-widest hover:opacity-85 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-[var(--shadow-card)]">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
          {lang === 'es' ? 'Compartir' : lang === 'fr' ? 'Partager' : lang === 'de' ? 'Teilen' : lang === 'ko' ? '공유' : lang === 'hi' ? 'साझा करें' : 'Share'}
        </button>
      </div>

    </div>
  </div>
</div>

<style>
  .melove-result-card {
    background: var(--card);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    transition: box-shadow 0.2s ease;
    min-height: 480px;
  }
</style>

<script is:inline>
  let lastCalcResult = null;

  function resetResultState() {
    const initialState = document.getElementById('initialState');
    const rc = document.getElementById('resultContent');
    if (initialState) {
      initialState.classList.remove('hidden');
      initialState.removeAttribute('aria-hidden');
    }
    if (rc) {
      rc.classList.add('hidden');
      rc.classList.remove('animate-in');
      rc.setAttribute('aria-hidden', 'true');
    }
    const pDisplay = document.getElementById('primaryDisplay');
    if (pDisplay) pDisplay.textContent = '';
    const pName = document.getElementById('primaryNameLabel');
    if (pName) pName.textContent = '';
    const headerLabel = document.getElementById('resultHeaderLabel');
    if (headerLabel) headerLabel.textContent = '';
    const unitLabel = document.getElementById('primaryUnitLabel');
    if (unitLabel) {
      unitLabel.textContent = '';
      unitLabel.classList.add('hidden');
    }
    const secGrid = document.getElementById('secondaryGrid');
    if (secGrid) secGrid.innerHTML = '';
  }

  const getStr = (obj) => {
    if (!obj && obj !== 0) return '';
    if (typeof obj === 'string' || typeof obj === 'number') return obj;
    const docLang = (document.documentElement.lang || 'en').slice(0, 2);
    return obj[docLang] || obj['en'] || Object.values(obj)[0] || '';
  };

  window.addEventListener('calculationCompleted', (e) => {
    lastCalcResult = e.detail;
    renderCalcOutput();
  });

  function renderCalcOutput() {
    if (!lastCalcResult) {
      resetResultState();
      return;
    }
    const { primary, secondary } = lastCalcResult;
    if (!primary) return;

    const initial = document.getElementById('initialState');
    if (initial) {
      initial.classList.add('hidden');
      initial.setAttribute('aria-hidden', 'true');
    }
    
    const rc = document.getElementById('resultContent');
    if (rc) {
      rc.classList.remove('hidden');
      rc.classList.add('animate-in');
      rc.removeAttribute('aria-hidden');
    }

    const primaryLabel = getStr(primary.label);

    const headerLabel = document.getElementById('resultHeaderLabel');
    if (headerLabel) headerLabel.textContent = primaryLabel;

    const unitLabel = document.getElementById('primaryUnitLabel');
    if (unitLabel) {
      const uVal = (primary.unit || '').trim();
      if (uVal && uVal !== '--') {
        unitLabel.textContent = uVal;
        unitLabel.classList.remove('hidden');
      } else {
        unitLabel.classList.add('hidden');
      }
    }

    const pDisplay = document.getElementById('primaryDisplay');
    if (pDisplay) pDisplay.textContent = getStr(primary.value);

    const pName = document.getElementById('primaryNameLabel');
    if (pName) pName.textContent = primaryLabel;

    const grid = document.getElementById('secondaryGrid');
    if (grid && Array.isArray(secondary)) {
      grid.innerHTML = secondary.map(s => {
        const label = getStr(s.label);
        const valStr = getStr(s.value);
        const unitStr = s.unit ? `<span class="text-xs font-sans font-medium opacity-40">${s.unit}</span>` : '';
        return `
          <div class="p-5 rounded-[var(--radius-sm)] bg-[var(--muted)] border border-[var(--border)] space-y-1.5 hover:border-[var(--accent)] transition-colors duration-200">
            <p class="text-xs font-display font-semibold uppercase tracking-widest text-[var(--muted-foreground)] opacity-70">${label}</p>
            <p class="text-xl font-display font-bold text-[var(--foreground)]">
              ${valStr} ${unitStr}
            </p>
          </div>
        `;
      }).join('');
    }

    // Share Click
    const shareBtn = document.getElementById('shareBtn');
    if (shareBtn) {
      shareBtn.onclick = async () => {
        try {
          await navigator.share({
            title: primaryLabel,
            text: `${primaryLabel}: ${primary.value} ${primary.unit || ''}`,
            url: location.href
          });
        } catch {}
      };
    }

    // Copy Click
    const copyBtn = document.getElementById('copyBtn');
    if (copyBtn) {
      copyBtn.onclick = () => {
        let report = `${primaryLabel}: ${primary.value} ${primary.unit || ''}\n`;
        if (Array.isArray(secondary)) {
          secondary.forEach(s => {
            const label = getStr(s.label);
            const val = getStr(s.value);
            report += `${label}: ${val} ${s.unit || ''}\n`;
          });
        }

        const lang = (document.documentElement.lang || 'en').slice(0, 2);
        const copySuccess = {
          en: '✓ Copied!',
          es: '✓ ¡Copiado!',
          fr: '✓ Copié !',
          de: '✓ Kopiert!',
          ko: '✓ 복사됨!',
          hi: '✓ कॉपी किया गया!'
        }[lang] || '✓ Copied!';

        navigator.clipboard.writeText(report).then(() => {
          const orig = copyBtn.innerHTML;
          copyBtn.innerHTML = `<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> ${copySuccess}`;
          setTimeout(() => copyBtn.innerHTML = orig, 2000);
        });
      };
    }
  }
</script>
