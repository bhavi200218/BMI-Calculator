    cards: [
      {
        tag: "01 / शारीरिक स्क्रीनिंग",
        title: "बीएमआई, बीएआई और शरीर की वसा की व्याख्या",
        summary: "एंथ्रोपोमेट्रिक पैमाने ऊंचाई और परिधि के अनुपात में शरीर के वजन का मूल्यांकन करते हैं। इन मानकों को समझकर आप अपने स्वास्थ्य का सही आकलन कर सकते हैं।",
        bullets: [
          "बॉडी मास इंडेक्स (BMI = kg/m²) ऊंचाई के वर्ग से वजन की तुलना करता है और वैश्विक स्तर पर प्राथमिक स्वास्थ्य स्क्रीनिंग मानक है।",
          "बॉडी एडिपोसिटी इंडेक्स (BAI) वजन पर निर्भर हुए बिना कूल्हे की परिधि और ऊंचाई से वसा का अनुमान लगाता है।",
          "सीमाएं: मानक फॉर्मूले मांसपेशियों और वसा में अंतर नहीं कर पाते। मांसपेशियों वाले एथलीट या बुजुर्गों के स्कोर में अंतर हो सकता है।"
        ],
        links: [
          { name: "बीएमआई कैलकुलेटर", href: `/${lang}/bmi-calculator/` },
          { name: "शरीर की वसा कैलकुलेटर", href: `/${lang}/body-fat-calculator/` },
          { name: "एशियाई बीएमआई कैलकुलेटर", href: `/${lang}/asian-bmi-calculator/` }
        ]
      },
      {
        tag: "02 / मेटाबॉलिक संतुलन",
        title: "दैनिक ऊर्जा के लिए बीएमआर और टीडीईई का समन्वय",
        summary: "मेटाबॉलिक फॉर्मूले स्थिर वजन के स्थान पर दैनिक कैलोरी ऊर्जा व्यय का अनुमान लगाते हैं, जिससे संतुलित खानपान की वैज्ञानिक योजना बनती है।",
        bullets: [
          "बेसल मेटाबॉलिक रेट (BMR) विश्राम अवस्था में शरीर के महत्वपूर्ण अंगों को जीवित रखने के लिए आवश्यक न्यूनतम ऊर्जा दर्शाता है।",
          "टोटल डेली एनर्जी एक्सपेंडिचर (TDEE) इसमें शारीरिक गतिविधि कारक (1.2 से 1.9) और भोजन पचाने की ऊर्जा जोड़ता है।",
          "उपयोग: TDEE आपका वजन बनाए रखने वाला स्तर है। सुरक्षित रूप से वजन घटाने के लिए 300–500 कैलोरी की मध्यम कमी रखें।"
        ],
        links: [
          { name: "बीएमआर कैलकुलेटर", href: `/${lang}/bmr-calculator/` },
          { name: "टीडीईई कैलकुलेटर", href: `/${lang}/tdee-calculator/` },
          { name: "मेंटेनेंस कैलोरी कैलकुलेटर", href: `/${lang}/maintenance-calorie-calculator/` }
        ]
      },
      {
        tag: "03 / क्षेत्रीय संदर्भ व विसरल फैट",
        title: "एशियाई कट-ऑफ और आंतरिक पेट की चर्बी",
        summary: "वजन यह नहीं बताता कि चर्बी कहाँ जमा है। पेट के आंतरिक अंगों के आसपास जमा विसरल फैट त्वचा के नीचे की चर्बी से अधिक हानिकारक होता है।",
        bullets: [
          "डब्ल्यूएचओ एशियाई मानकों के अनुसार अधिक वजन का जोखिम 23.0 kg/m² और उच्च जोखिम 27.5 kg/m² पर शुरू हो जाता है।",
          "कमर-से-ऊंचाई और कमर-से-कूल्हे का अनुपात आंतरिक चर्बी का सटीक संकेत देते हैं। पुरुषों में कमर ≥ 90 सेमी और महिलाओं में ≥ 80 सेमी जोखिम का संकेत है।",
          "आदर्श वजन फॉर्मूले (Devine, Robinson) हड्डियों की बनावट और ऊंचाई के अनुसार लक्ष्य वजन सीमा दर्शाते हैं।"
        ],
        links: [
          { name: "आदर्श वजन कैलकुलेटर", href: `/${lang}/ideal-weight-calculator/` },
          { name: "कमर से कूल्हा अनुपात कैलकुलेटर", href: `/${lang}/waist-to-hip-ratio-calculator/` },
          { name: "ऊंचाई अनुसार स्वस्थ वजन", href: `/${lang}/healthy-weight-by-height/` }
        ]
      }
    ]
  }
};

const current = data[lang] || data.en;
---

<section id="understand-numbers" class="px-4 md:px-6 py-12 md:py-20 border-t border-[var(--border)] bg-[var(--card)]/40 scroll-mt-28">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <p class="text-xs font-display font-semibold uppercase tracking-[0.3em] text-[var(--accent)]">
        {current.eyebrow}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-[var(--foreground)] leading-[1.05]">
        {current.title}
      </h2>
      <p class="text-base sm:text-lg text-[var(--muted-foreground)] font-medium leading-relaxed">
        {current.subtitle}
      </p>
    </div>

    <!-- 3 Core Guidance Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {current.cards.map((card) => (
        <div class="rounded-2xl border-[1.5px] border-[var(--border)] bg-[var(--card)] p-6 md:p-8 flex flex-col justify-between space-y-6 shadow-[var(--shadow-soft)] hover:border-[var(--accent)] hover:shadow-[var(--shadow-card)] transition-all duration-300">
          <div class="space-y-4">
            <span class="inline-block text-xs font-display font-bold uppercase tracking-widest text-[var(--accent)] px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20">
              {card.tag}
            </span>
            <h3 class="text-xl font-display font-bold uppercase tracking-tight text-[var(--foreground)]">
              {card.title}
            </h3>
            <p class="text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
              {card.summary}
            </p>
            <ul class="space-y-2 pt-2 border-t border-[var(--border)]/60">
              {card.bullets.map((bullet) => (
                <li class="flex items-start gap-2 text-xs text-[var(--muted-foreground)] leading-relaxed">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0 mt-1.5"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tool Quick Links -->
          <div class="pt-4 border-t border-[var(--border)]/60">
            <p class="text-[11px] font-display font-bold uppercase tracking-widest text-[var(--foreground)] mb-2">Related Screening Tools:</p>
            <div class="flex flex-wrap gap-2">
              {card.links.map((link) => (
                <a 
                  href={link.href}
                  class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--muted)]/40 text-[var(--foreground)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
                >
                  <span>{link.name}</span>
                  <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Educational & Clinical Notice Box -->
    <div class="rounded-2xl border border-[var(--accent)]/30 bg-[var(--accent)]/5 p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center gap-6 shadow-xs">
      <div class="w-12 h-12 rounded-xl bg-[var(--accent)]/10 border border-[var(--accent)]/20 flex items-center justify-center shrink-0 text-[var(--accent)]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="space-y-1.5">
        <h4 class="text-sm font-display font-bold uppercase tracking-wider text-[var(--foreground)]">
          {current.disclaimerTitle}
        </h4>
        <p class="text-xs md:text-sm text-[var(--muted-foreground)] leading-relaxed font-medium">
          {current.disclaimerText}
        </p>
      </div>
    </div>

  </div>
</section>
