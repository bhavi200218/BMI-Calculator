---
const { currentLocale } = Astro;
const lang = currentLocale || 'en';

const langNames: Record<string, string> = {
  en: '🇬🇧 English',
  es: '🇪🇸 Español',
  fr: '🇫🇷 Français',
  de: '🇩🇪 Deutsch',
  ko: '🇰🇷 한국어',
  hi: '🇮🇳 हिन्दी'
};

const nav: Record<string, Record<string, string>> = {
  en: { home: 'Home', calculators: 'Calculators', blog: 'Articles', about: 'About Us', faq: 'FAQ' },
  es: { home: 'Inicio', calculators: 'Calculadoras', blog: 'Artículos', about: 'Sobre Nosotros', faq: 'FAQ' },
  fr: { home: 'Accueil', calculators: 'Calculateurs', blog: 'Articles', about: 'À Propos de Nous', faq: 'FAQ' },
  de: { home: 'Startseite', calculators: 'Rechner', blog: 'Artikel', about: 'Über Uns', faq: 'FAQ' },
  ko: { home: '홈', calculators: '계산기', blog: '아티클', about: '소개', faq: 'FAQ' },
  hi: { home: 'होम', calculators: 'कैलकुलेटर', blog: 'लेख', about: 'हमारे बारे में', faq: 'FAQ' }
};

const t = nav[lang] || nav.en;
const currentLangDisplay = langNames[lang] || lang;
const homeUrl = `/${lang}/`;
const calcUrl = `/${lang}/#calculators`;
const blogUrl = `/${lang}/blog/`;
const aboutUrl = `/${lang}/about/`;
const faqUrl = `/${lang}/#faq`;
---

<header role="banner" class="site-header fixed inset-x-2 sm:inset-x-6 lg:inset-x-8 top-4 z-50 max-w-[1600px] mx-auto">
  <nav class="relative w-full" aria-label="Main Navigation">
    <div class="flex items-center justify-between px-3 sm:px-5 h-14 rounded-2xl border border-[var(--border)] bg-[var(--card)] backdrop-blur-2xl shadow-[var(--shadow-card)]">

      <!-- Logo & Site Title -->
      <a href={homeUrl} class="logo site-logo flex items-center gap-2 shrink-0 group min-h-[48px] min-w-[48px] py-1" rel="home" aria-label="Real BMI Homepage">
        <picture class="shrink-0 flex items-center">
          <source srcset="/logo.avif" type="image/avif" />
          <source srcset="/logo.webp" type="image/webp" />
          <img src="/logo.webp" alt="Real BMI Logo" width="28" height="28" loading="lazy" decoding="async" class="w-7 h-7 rounded-lg bg-[#D33A18] p-1 object-contain shrink-0 shadow-xs group-hover:scale-105 transition-transform" />
        </picture>
        <span class="site-title font-display font-bold text-sm sm:text-base uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors">Real BMI</span>
      </a>

    <!-- Desktop Links -->
    <div class="hidden lg:flex items-center gap-3 lg:gap-5">
      <a href={homeUrl} class="nav-link">{t.home}<span class="sr-only">. </span></a>
      <a href={calcUrl} class="nav-link">{t.calculators}<span class="sr-only">. </span></a>
      <a href={blogUrl} class="nav-link">{t.blog}<span class="sr-only">. </span></a>
      <a href={aboutUrl} class="nav-link">{t.about}<span class="sr-only">. </span></a>
      <a href={faqUrl} class="nav-link">{t.faq}<span class="sr-only">. </span></a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Lang Dropdown -->
      <div class="relative" id="langDropdownWrapper">
        <button id="langDropdownBtn"
          class="flex items-center gap-1 sm:gap-1.5 text-xs font-display font-semibold uppercase tracking-wider bg-[var(--muted)] px-2.5 sm:px-3.5 py-2 sm:py-2.5 rounded-xl border border-[var(--border)] text-[var(--foreground)] hover:border-[var(--accent)] transition-colors duration-200 cursor-pointer min-h-[48px]"
          aria-haspopup="menu" aria-expanded="false">
          <span id="langCurrentLabel">{currentLangDisplay}</span>
          <svg class="w-3 h-3 opacity-60 transition-transform duration-200" id="langChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div id="langDropdownMenu"
          class="absolute right-0 top-full mt-2 w-48 rounded-xl border border-[var(--border)] bg-[var(--card)] backdrop-blur-2xl shadow-[var(--shadow-card)] p-2 space-y-1 hidden z-50"
          role="menu">
          {Object.entries(langNames).map(([code, name]) => {
            const currentPath = Astro.url.pathname;
            const pathWithoutLang = currentPath.replace(/^\/(en|es|fr|de|ko|hi)(\/|$)/, '/');
            const cleanPath = pathWithoutLang.startsWith('/') ? pathWithoutLang : `/${pathWithoutLang}`;
            
            let targetPath = `/${code}${cleanPath}`.replace(/\/+/g, '/');
            if (code === 'en' && cleanPath === '/') {
              targetPath = '/';
            } else if (cleanPath.startsWith('/404') || cleanPath.startsWith('/500')) {
              targetPath = `/${code}/`;
            } else if (cleanPath.startsWith('/search')) {
              targetPath = '/search/';
            } else if (cleanPath.startsWith('/embed/')) {
              targetPath = cleanPath;
            } else if (cleanPath.startsWith('/author/') && code !== 'en') {
              targetPath = `/${code}/about/`;
            } else if (cleanPath.startsWith('/terms-of-service') || (cleanPath.startsWith('/terms') && !cleanPath.startsWith('/terms-conditions'))) {
              targetPath = `/${code}/terms-conditions/`;
            } else if (cleanPath === '/blog' || cleanPath === '/blog/') {
              targetPath = `/${code}/blog/`;
            } else if (cleanPath.startsWith('/blog/')) {
              targetPath = `/${code}${cleanPath}`.replace(/\/+/g, '/');
            }

            return (
              <a href={targetPath}
                class={`flex items-center gap-2.5 px-3.5 py-3 text-xs font-display font-semibold uppercase tracking-wider rounded-lg hover:bg-[var(--muted)] transition-colors text-[var(--foreground)] cursor-pointer min-h-[48px] ${code === lang ? 'bg-[var(--muted)]' : ''}`}
                role="menuitem">
                {name}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Desktop Theme Toggle -->
      <button id="themeToggleBtn"
        class="hidden lg:flex relative overflow-hidden w-12 h-12 min-w-[48px] min-h-[48px] rounded-xl border border-[var(--border)] bg-[var(--muted)] hover:border-[var(--accent)] transition-colors duration-200 items-center justify-center cursor-pointer"
        aria-label="Toggle Theme">
        <svg id="sunIcon" class="w-4 h-4 absolute text-[var(--foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707.707M12 5a7 7 0 100 14 7 7 0 000-14z" />
        </svg>
        <svg id="moonIcon" class="w-4 h-4 absolute text-[var(--foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Theme Toggle -->
      <button id="mobileThemeToggleBtn" class="lg:hidden relative overflow-hidden w-11 h-11 sm:w-12 sm:h-12 min-w-[44px] min-h-[44px] rounded-xl border border-[var(--border)] bg-[var(--muted)] hover:border-[var(--accent)] transition-colors duration-200 flex items-center justify-center cursor-pointer"
        aria-label="Toggle Theme">
        <svg id="mobileSunIcon" class="w-4 h-4 absolute text-[var(--foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707.707M12 5a7 7 0 100 14 7 7 0 000-14z" />
        </svg>
        <svg id="mobileMoonIcon" class="w-4 h-4 absolute text-[var(--foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button id="mobileMenuBtn" class="lg:hidden w-11 h-11 sm:w-12 sm:h-12 min-w-[44px] min-h-[44px] rounded-2xl border border-[var(--border)] bg-[var(--muted)] hover:border-[var(--accent)] transition-colors duration-200 flex items-center justify-center cursor-pointer"
        aria-label="Toggle Menu" aria-expanded="false">
        <svg class="w-5 h-5 text-[var(--foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
    <!-- End of navbar bar -->
    </div>

    <!-- Mobile Menu Dropdown -->
    <div id="mobileMenu" class="lg:hidden absolute right-0 top-full mt-2 z-50 w-[min(88vw,18rem)] rounded-3xl border border-[var(--border)] bg-[var(--card)]/98 backdrop-blur-2xl hidden flex-col items-stretch gap-2.5 p-4 shadow-[var(--shadow-card)]">
      <div class="flex items-center justify-between pb-2 border-b border-[var(--border)]/60">
        <span class="text-xs font-display font-bold uppercase tracking-wider text-[var(--muted-foreground)]">Navigation</span>
        <button id="closeMobileMenu" class="w-9 h-9 min-w-[36px] min-h-[36px] rounded-full border border-[var(--border)] bg-[var(--muted)] flex items-center justify-center cursor-pointer hover:border-[var(--accent)] transition-colors" aria-label="Close menu">
          <svg class="w-4 h-4 text-[var(--foreground)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <a href={homeUrl} class="w-full min-h-[44px] rounded-xl bg-[var(--muted)]/50 px-4 py-2.5 flex items-center justify-start text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors">
        {t.home}<span class="sr-only">. </span>
      </a>
      <a href={calcUrl} class="w-full min-h-[44px] rounded-xl bg-[var(--muted)]/50 px-4 py-2.5 flex items-center justify-start text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors">
        {t.calculators}<span class="sr-only">. </span>
      </a>
      <a href={blogUrl} class="w-full min-h-[44px] rounded-xl bg-[var(--muted)]/50 px-4 py-2.5 flex items-center justify-start text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors">
        {t.blog}<span class="sr-only">. </span>
      </a>
      <a href={aboutUrl} class="w-full min-h-[44px] rounded-xl bg-[var(--muted)]/50 px-4 py-2.5 flex items-center justify-start text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors">
        {t.about}<span class="sr-only">. </span>
      </a>
      <a href={faqUrl} class="w-full min-h-[44px] rounded-xl bg-[var(--muted)]/50 px-4 py-2.5 flex items-center justify-start text-xs font-display font-bold uppercase tracking-wider text-[var(--foreground)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors">
        {t.faq}<span class="sr-only">. </span>
      </a>
    </div>
  </nav>
</header>

<style>
  .nav-link {
    padding: 0.5rem 1.1rem;
    border-radius: 0.6rem;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--foreground);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--foreground);
    background: var(--muted);
  }

  #sunIcon, #moonIcon, #mobileSunIcon, #mobileMoonIcon {
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  #langDropdownMenu {
    animation: dropIn 0.15s ease-out;
  }
  @keyframes dropIn {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function applyTheme(isDark) {
    const sun = document.getElementById('sunIcon');
    const moon = document.getElementById('moonIcon');
    const mobileSun = document.getElementById('mobileSunIcon');
    const mobileMoon = document.getElementById('mobileMoonIcon');
    const setState = (elOn, elOff) => {
      if (elOn) { elOn.style.opacity = '1'; elOn.style.transform = 'scale(1) rotate(0deg)'; }
      if (elOff) { elOff.style.opacity = '0'; elOff.style.transform = 'scale(0.5) rotate(90deg)'; }
    };
    const setInverse = (elOn, elOff) => {
      if (elOn) { elOn.style.opacity = '1'; elOn.style.transform = 'scale(1) rotate(0deg)'; }
      if (elOff) { elOff.style.opacity = '0'; elOff.style.transform = 'scale(0.5) rotate(-90deg)'; }
    };
    if (isDark) {
      setState(sun, moon);
      setState(mobileSun, mobileMoon);
    } else {
      setInverse(moon, sun);
      setInverse(mobileMoon, mobileSun);
    }
  }

  function initTheme() {
    const stored = localStorage.getItem('theme');
    const isDark = stored !== 'light';
    document.documentElement.classList.toggle('dark', isDark);
    applyTheme(isDark);
  }

  function attachThemeToggle() {
    const desktopBtn = document.getElementById('themeToggleBtn');
    const mobileBtn = document.getElementById('themeToggleBtnMobile') || document.getElementById('mobileThemeToggleBtn');
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      applyTheme(isDark);
    };

    if (desktopBtn) desktopBtn.onclick = toggleTheme;
    if (mobileBtn) mobileBtn.onclick = toggleTheme;
  }

  function attachLangDropdown() {
    const btn = document.getElementById('langDropdownBtn');
    const menu = document.getElementById('langDropdownMenu');
    const chevron = document.getElementById('langChevron');
    if (!btn || !menu) return;
    let isOpen = false;
    const open = () => { isOpen = true; menu.classList.remove('hidden'); chevron && (chevron.style.transform = 'rotate(180deg)'); btn.setAttribute('aria-expanded', 'true'); };
    const close = () => { isOpen = false; menu.classList.add('hidden'); chevron && (chevron.style.transform = 'rotate(0deg)'); btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', (e) => { e.stopPropagation(); isOpen ? close() : open(); });
    document.addEventListener('click', (e) => { if (!btn.contains(e.target) && !menu.contains(e.target)) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        close();
        const href = link.getAttribute('href');
        if (href) {
          const match = href.match(/^\/(en|es|fr|de|ko|hi)\b/);
          if (match) {
            document.documentElement.lang = match[1];
          }
        }
      });
    });
  }

  function attachMobileMenu() {
    const btn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const closeBtn = document.getElementById('closeMobileMenu');
    
    if (!btn || !mobileMenu || !closeBtn) return;
    
    let isOpen = false;
    const open = () => {
      isOpen = true;
      mobileMenu.classList.remove('hidden');
      mobileMenu.classList.add('flex');
      btn.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      isOpen = false;
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
      btn.setAttribute('aria-expanded', 'false');
    };
    
    btn.setAttribute('aria-expanded', 'false');
    
    btn.addEventListener('click', (e) => { e.stopPropagation(); isOpen ? close() : open(); });
    closeBtn.addEventListener('click', (e) => { e.stopPropagation(); close(); });
    document.addEventListener('click', (e) => { if (!btn.contains(e.target) && !mobileMenu.contains(e.target)) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) close(); });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        close();
      });
    });
  }

  function attachSmoothScroll() {
    const links = document.querySelectorAll('a[href*="#"]');
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.includes('#')) return;

        const [path, hash] = href.split('#');
        if (!hash) return;

        const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
        const cleanPath = (path || '').replace(/\/+$/, '') || '/';

        // Check if destination matches the current page (e.g. / vs /en or same locale path)
        const isSamePage = !path ||
          cleanPath === currentPath ||
          (currentPath === '/' && (cleanPath === '/en' || cleanPath === '')) ||
          (cleanPath === '/' && currentPath === '/en');

        if (isSamePage) {
          let target = document.getElementById(hash);
          if (!target && (hash === 'calculators' || hash === 'all-calculators')) {
            target = document.getElementById('calculators') || document.getElementById('all-calculators');
          } else if (!target && (hash === 'faq' || hash === 'faq-standards')) {
            target = document.getElementById('faq') || document.getElementById('faq-standards');
          }

          if (target) {
            e.preventDefault();

            // Ensure mobile menu closes smoothly
            const mobileMenu = document.getElementById('mobileMenu');
            if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
              mobileMenu.classList.add('hidden');
              mobileMenu.classList.remove('flex');
              const mobileBtn = document.getElementById('mobileMenuBtn');
              if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'false');
            }

            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', `#${hash}`);
          }
        }
      });
    });
  }

  function handleInitialHash() {
    if (window.location.hash) {
      const hash = window.location.hash.replace('#', '');
      let target = document.getElementById(hash);
      if (!target && (hash === 'calculators' || hash === 'all-calculators')) {
        target = document.getElementById('calculators') || document.getElementById('all-calculators');
      } else if (!target && (hash === 'faq' || hash === 'faq-standards')) {
        target = document.getElementById('faq') || document.getElementById('faq-standards');
      }
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 120);
      }
    }
  }

  initTheme(); attachThemeToggle(); attachLangDropdown(); attachMobileMenu(); attachSmoothScroll(); handleInitialHash();
  document.addEventListener('astro:after-swap', () => { initTheme(); attachThemeToggle(); attachLangDropdown(); attachMobileMenu(); attachSmoothScroll(); handleInitialHash(); });
</script>
