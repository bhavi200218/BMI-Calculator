---

<footer class="w-full bg-[var(--card)]/95 backdrop-blur-xl border-t border-[var(--border)] mt-8 pt-8 pb-4 text-[var(--foreground)] relative z-20">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Top Brand & Mission Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--border)]/60">
      <div class="flex flex-wrap items-center gap-2">
        <a href={`/${lang}/`} class="inline-flex items-center gap-2 group">
          <div class="w-6 h-6 rounded-md bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform">
            <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <span class="font-display font-extrabold text-xs sm:text-sm uppercase tracking-tight text-[var(--foreground)]">
            Real BMI <span class="text-[var(--accent)]">Calculator</span>
          </span>
        </a>
        <span class="hidden sm:inline text-xs text-[var(--border)]">|</span>
        <p class="text-xs text-[var(--muted-foreground)]">
          {ft.tagline}
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs font-semibold text-[var(--muted-foreground)] self-start sm:self-auto">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>{ft.privacyFooter}</span>
      </div>
    </div>

    <!-- 4 Semantic Columns Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-xs">
      
      <!-- Col 1: Popular Calculators -->
      <div class="space-y-3">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
          {ft.colPopular}
        </p>
        <ul class="space-y-2">
          {ft.popularCalculators.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href={`/${lang}/methodology/`} class="font-semibold text-[var(--accent)] hover:underline underline-offset-2 inline-flex items-center gap-1">
              <span>{ft.viewAllTools}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: Research & Standards -->
      <div class="space-y-3">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          {ft.colGuides}
        </p>
        <ul class="space-y-2">
          {ft.researchGuides.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Company / About -->
      <div class="space-y-3">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          {ft.colCompany}
        </p>
        <ul class="space-y-2">
          {ft.companyLinks.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Policies & Legal -->
      <div class="space-y-3">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          {ft.colLegal}
        </p>
        <ul class="space-y-2">
          {ft.legalLinks.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Bar (Copyright, Attribution, Cookie Prefs) -->
    <div class="pt-4 border-t border-[var(--border)]/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] sm:text-xs text-[var(--muted-foreground)]">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-center sm:text-left">
        <span class="font-display font-semibold text-[var(--foreground)]">{ft.copyright}</span>
        <span class="hidden sm:inline">•</span>
        <span class="text-[11px] sm:text-xs text-[var(--muted-foreground)]/80">{ft.teamAttribution}</span>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          id="openCookiePreferencesBtn"
          type="button"
          class="text-[11px] sm:text-xs font-medium text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors underline decoration-dotted underline-offset-2 cursor-pointer py-0.5"
        >
          {cookiePrefsLabel}
        </button>
        <span>•</span>
        <span class="text-[11px] sm:text-xs opacity-75">{ft.privacyBadge}</span>
      </div>
    </div>

  </div>
</footer>
