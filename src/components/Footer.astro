const cookiePrefsLabels: Record<string, string> = {
  en: 'Cookie Preferences',
  es: 'Preferencias de Cookies',
  fr: 'Préférences de Cookies',
  de: 'Cookie-Einstellungen',
  ko: '쿠키 설정',
  hi: 'कुकी प्राथमिकताएं'
};

const cookiePrefsLabel = cookiePrefsLabels[lang] || cookiePrefsLabels.en;
const ft = footerTranslations[lang] || footerTranslations.en;
const healthToolsLabel = ft.healthTools || 'Health Calculators';

const healthToolsLinks = calculators
  .filter((calc) => calc.slug !== 'one-rep-max-calculator' && calc.slug !== '3d-body-visualizer')
  .map((calc) => {
  let name = calc.name[lang] || calc.name['en'];
  if (lang === 'es') {
    name = name.replace(/^Calculadora de(?:l)?\s+/i, '');
    name = name.charAt(0).toUpperCase() + name.slice(1);
  } else if (lang === 'fr') {
    name = name.replace(/^Calculateur (?:de |d['’])/i, '');
    name = name.charAt(0).toUpperCase() + name.slice(1);
  } else if (lang === 'hi') {
    name = name.replace(/\s+कैलकुलेटर$/i, '');
  } else if (lang === 'ko') {
    name = name.replace(/\s*계산기$/i, '');
  }
  return {
    name,
    href: `/${lang}/${calc.slug}/`
  };
});
---

<footer class="w-full bg-[var(--card)]/95 backdrop-blur-xl border-t border-[var(--border)] mt-8 md:mt-10 pt-5 md:pt-6 pb-4 md:pb-5 text-[var(--foreground)] relative z-20">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 md:space-y-4">

    <!-- Row 1: Brand Info & Quick Links (Single Clean Level on Desktop) -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 pb-3 border-b border-[var(--border)]/60">
      <div class="flex flex-wrap items-center gap-2.5">
        <a href={`/${lang}/`} class="inline-flex items-center gap-2 group min-h-[44px] py-1">
          <div class="w-6 h-6 rounded-md bg-gradient-to-br from-[var(--accent)] to-[#d44f30] flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <span class="font-display font-extrabold text-sm uppercase tracking-tight text-[var(--foreground)]">
            Real BMI <span class="text-[var(--accent)]">Calculator</span>
          </span>
        </a>
        <span class="hidden sm:inline text-xs text-[var(--border)]">|</span>
        <p class="text-xs sm:text-sm text-[var(--muted-foreground)]">
          {ft.tagline}
        </p>
      </div>

      <!-- Quick Trust & Legal Navigation Links -->
      <nav class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-xs sm:text-sm font-medium text-[var(--muted-foreground)]" aria-label="Footer quick links">
        {ft.links.map((link) => (
          <a
            href={link.href}
            class="hover:text-[var(--accent)] transition-colors py-2 px-1 min-h-[44px] inline-flex items-center hover:underline underline-offset-2"
          >
            {link.name}
          </a>
        ))}
      </nav>
    </div>

    <!-- Row 2: Health & Fitness Calculators (Sleek 6-column grid on desktop, 4 on tablet, 2 on mobile) -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <p class="text-xs font-display font-bold uppercase tracking-wider text-[var(--accent)] flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
          {healthToolsLabel}
        </p>
        <div class="hidden sm:flex items-center gap-2.5 text-xs text-[var(--muted-foreground)]">
          <span class="inline-flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            {ft.whoBadge}
          </span>
          <span>•</span>
          <span>{ft.privacyBadge}</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-3 gap-y-2 sm:gap-y-1 text-xs sm:text-sm">
        {healthToolsLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs sm:text-sm text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors py-1.5 px-1 min-h-[44px] inline-flex items-center truncate hover:underline underline-offset-2"
            title={link.name}
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Row 3: Bottom Bar (Copyright, Attribution, Cookie Prefs) -->
    <div class="pt-2.5 border-t border-[var(--border)]/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-[var(--muted-foreground)]">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-center sm:text-left">
        <span class="font-display font-semibold text-[var(--foreground)]">{ft.copyright}</span>
        <span class="hidden sm:inline">•</span>
        <span class="text-xs text-[var(--muted-foreground)]/80">{ft.teamAttribution}</span>
      </div>

      <div class="flex items-center gap-3">
        <button
          id="openCookiePreferencesBtn"
          type="button"
          class="text-xs sm:text-sm font-medium text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors underline decoration-dotted underline-offset-2 cursor-pointer py-2 px-1 min-h-[44px] inline-flex items-center"
        >
          {cookiePrefsLabel}
        </button>
        <span>•</span>
        <span class="text-xs opacity-75">{ft.privacyFooter}</span>
      </div>
    </div>

  </div>
</footer>
