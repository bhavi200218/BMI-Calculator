const cookiePrefsLabel = cookiePrefsLabels[lang] || cookiePrefsLabels.en;
const ft = footerTranslations[lang] || footerTranslations.en;
---

<footer class="w-full bg-[var(--card)]/95 backdrop-blur-xl border-t border-[var(--border)] mt-6 pt-5 pb-3 text-[var(--foreground)] relative z-20">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">

    <!-- Top Brand & Tagline Bar (Compact) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[var(--border)]/50">
      <div class="flex flex-wrap items-center gap-2">
        <a href={`/${lang}/`} class="inline-flex items-center gap-1.5 group">
          <div class="w-5 h-5 rounded-md bg-[#D33A18] flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <span class="font-display font-bold text-xs uppercase tracking-tight text-[var(--foreground)]">
            Real BMI <span class="text-[var(--accent)]">Calculator</span>
          </span>
        </a>
        <span class="hidden sm:inline text-xs text-[var(--border)]">|</span>
        <p class="text-xs text-[var(--muted-foreground)] font-medium">
          {ft.tagline}
        </p>
      </div>

      <div class="flex items-center gap-1.5 text-xs font-semibold text-[var(--muted-foreground)] self-start sm:self-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>{ft.privacyFooter}</span>
      </div>
    </div>

    <!-- 3 Clean Compact Columns -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 sm:gap-8 text-xs">
      
      <!-- Col 1: Popular Calculators -->
      <div class="space-y-2">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs">
          {ft.colPopular}
        </p>
        <ul class="space-y-1.5">
          {ft.popularCalculators.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href={`/${lang}/methodology/`} class="font-semibold text-[var(--accent)] hover:underline underline-offset-2 inline-flex items-center gap-1">
              <span>{ft.viewAllTools}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: Company -->
      <div class="space-y-2">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs">
          {ft.colCompany}
        </p>
        <ul class="space-y-1.5">
          {ft.companyLinks.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Legal & Policies -->
      <div class="space-y-2">
        <p class="font-display font-bold uppercase tracking-wider text-[var(--accent)] text-xs">
          {ft.colLegal}
        </p>
        <ul class="space-y-1.5">
          {ft.legalLinks.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors hover:underline underline-offset-2">
                {item.name}
              </a>
            </li>
          ))}
          <li class="pt-0.5">
            <button
              id="openCookiePreferencesBtn"
              type="button"
              class="text-[11px] font-medium text-[var(--muted-foreground)] hover:text-[var(--accent)] transition-colors underline decoration-dotted underline-offset-2 cursor-pointer py-0.5"
            >
              {cookiePrefsLabel}
            </button>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar (Compact Copyright & Attribution) -->
    <div class="pt-3 border-t border-[var(--border)]/50 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-[var(--muted-foreground)]">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-center sm:text-left">
        <span class="font-display font-semibold text-[var(--foreground)]">{ft.copyright}</span>
        <span class="hidden sm:inline">•</span>
        <span class="text-[11px] text-[var(--muted-foreground)]/80">{ft.teamAttribution}</span>
      </div>

      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
        <span class="text-[11px] opacity-75">{ft.privacyBadge}</span>
      </div>
    </div>

  </div>
</footer>